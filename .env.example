# Copy to .env (never commit it).
OPENROUTER_API_KEY=
# Controlled variables: identical for every harness, enforced by the meter proxy.
BENCH_MODEL=deepseek/deepseek-v4-flash
BENCH_REASONING=medium
# Per-task container limits (identical for every harness).
BENCH_CPUS=4
BENCH_MEM=8g
TASK_TIMEOUT_S=1800
METER_HOST_PORT=18080
# Optional: TinyHumans credential; enables the `openhuman-jev` variant (JEV tool ranking runs on the TinyHumans backend).
TINYHUMANS_API_KEY=
