# Copy to .env (never commit it).
OPENROUTER_API_KEY=
# Controlled variables: identical for every harness, enforced by the meter proxy.
BENCH_MODEL=deepseek/deepseek-v4.1-flash
BENCH_REASONING=high
# OpenRouter provider every call is pinned to (allow_fallbacks=false) so the prompt cache stays warm.
# Pick one that discounts cached tokens; see openrouter.ai/api/v1/models/<model>/endpoints. Empty = unpinned.
BENCH_PROVIDER=DeepSeek
# Per-task container limits (identical for every harness).
BENCH_CPUS=4
BENCH_MEM=8g
TASK_TIMEOUT_S=1800
METER_HOST_PORT=18080
