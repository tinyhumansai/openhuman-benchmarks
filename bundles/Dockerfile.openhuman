# OpenHuman harness bundle, built from this checkout (build context = repo root).
# Ubuntu 22.04 (not the root Dockerfile's bookworm) so the binary's glibc floor
# is compatible with the official SWE-bench instance images.
FROM ubuntu:22.04 AS builder
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake pkg-config libssl-dev libasound2-dev libxdo-dev libxtst-dev \
    libx11-dev libevdev-dev clang mold ca-certificates git curl \
    && rm -rf /var/lib/apt/lists/*
# Toolchain pinned by rust-toolchain.toml.
COPY rust-toolchain.toml /build/rust-toolchain.toml
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal \
    --default-toolchain "$(sed -n 's/^channel *= *"\(.*\)"/\1/p' /build/rust-toolchain.toml)"
ENV PATH=/root/.cargo/bin:$PATH
WORKDIR /build
COPY . .
ARG CARGO_PROFILE=release
# Bench-only: the orchestrator's shipped turn cap (50 tool iterations) can still cut an agent off
# mid-task on long-horizon benchmarks, and the other harnesses are run with no turn cap, so lift
# this one to 200 for the benchmark. Set OH_MAX_ITERATIONS to the shipped value to reproduce the
# product. The rewrite must change the file or the build fails.
ARG OH_MAX_ITERATIONS=200
RUN f=crates/openhuman-core/src/agent/registry/agents/orchestrator/agent.toml \
    && sed -i "s/^max_iterations = [0-9]*\$/max_iterations = ${OH_MAX_ITERATIONS}/" "$f" \
    && grep -q "^max_iterations = ${OH_MAX_ITERATIONS}\$" "$f"
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/build/target \
    cargo build --profile "${CARGO_PROFILE}" -p openhuman-cli --bin openhuman-core \
    && install -D "target/$([ "${CARGO_PROFILE}" = release ] && echo release || echo "${CARGO_PROFILE}")/openhuman-core" /out/openhuman/openhuman-core

# Pinned native modules, staged at build time so benches never fetch them.
FROM node:24-bookworm-slim AS modules
WORKDIR /repo
COPY scripts/lib/module-pins.mjs scripts/lib/module-pins.mjs
COPY scripts/ci/self-hosted/test-module-assets.mjs scripts/ci/self-hosted/test-module-assets.mjs
COPY scripts/release/stage-modules.mjs scripts/release/stage-modules.mjs
COPY crates/openhuman-core/src/modules/registry.rs crates/openhuman-core/src/modules/registry.rs
COPY crates/openhuman-core/src/modules/registry/ crates/openhuman-core/src/modules/registry/
RUN node scripts/release/stage-modules.mjs --output /bundled-modules

FROM ubuntu:22.04 AS bundle
ARG GIT_SHA=unknown
ARG ADAPTER=adapters/openhuman.sh
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates xz-utils \
    && rm -rf /var/lib/apt/lists/*
ARG NODE_MAJOR=24
RUN set -eux; mkdir -p /opt/harness/node; \
    base="https://nodejs.org/dist/latest-v${NODE_MAJOR}.x"; \
    arch="$(uname -m | sed -e s/x86_64/x64/ -e s/aarch64/arm64/)"; \
    file="$(curl -fsSL "$base/SHASUMS256.txt" | awk -v a="linux-$arch.tar.xz" '$2 ~ a {print $2}')"; \
    curl -fsSL "$base/$file" | tar -xJ --strip-components=1 -C /opt/harness/node
COPY --from=builder /out/openhuman /opt/harness/openhuman
# The core finds `bundled-modules/` beside its binary (OPENHUMAN_BUNDLED_MODULES
# overrides), so the extracted bundle stays relocatable.
COPY --from=modules /bundled-modules /opt/harness/openhuman/bundled-modules
COPY bench/harnesses/bundles/adapters/_common.sh /opt/harness/_common.sh
COPY bench/harnesses/bundles/${ADAPTER} /opt/harness/adapter.sh
COPY bench/harnesses/bundles/forward.mjs /opt/harness/forward.mjs
COPY bench/harnesses/bundles/oh-turn.mjs /opt/harness/oh-turn.mjs
RUN echo "${GIT_SHA}" > /opt/harness/openhuman/GIT_SHA
